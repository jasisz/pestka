module Decl
    intent =
        "The second core's entry point: checks a deferred declaration's type"
        "and value against the environment before it, as Check.Decl does with"
        "the first core. The second core is to work on values (terms with"
        "their environment, variables as de Bruijn levels) instead of terms"
        "rewritten by substitution. Inference is the second core's;"
        "definitional equality still goes to the first core's through"
        "Next.Tc's bridge."
    exposes [Facts, empty, check]
    depends [Core.Names, Core.Levels, Core.Exprs, Core.Decls, Core.Cache, Check.State, Check.Tc, Next.Value, Next.Tc]
    effects []

record Facts
    closed: Map<Int, Bucket>

fn empty() -> Facts
    ? "No facts yet: what a worker starts with."
    Facts(closed = Core.Cache.empty())

verify empty
    Core.Cache.size(empty().closed) => 0

fn check(env: Env, upTo: Int, head: Head, value: Option<Expr>, isThm: Bool, facts: Facts) -> Result<Facts, Fail>
    ? "The type is a type, a theorem's type a proposition, and the value's type equal to the declared one, against the constants of env placed before upTo. Returns the facts kept for later declarations."
    st = Next.Tc.start(St.update(Check.State.fresh(env, head.params, Safety.Safe), upTo = upTo, closed = facts.closed))
    t = Next.Tc.infer(st, [], [], head.ty, false)?
    s = Next.Tc.sortOf(t.st, t.v)?
    match value
        Option.None -> Result.Ok(Facts(closed = s.st.old.closed))
        Option.Some(v) -> valueChecks(propIfTheorem(s.st, head.ty, isThm)?, head.ty, v)

verify check
    check(Check.State.envEmpty(), 0, Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), Option.Some(Core.Exprs.sort(Level.Zero)), false, empty()) => Result.Err(Fail.Reject("declaration type mismatch"))
    check(Check.State.envEmpty(), 0, Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), Option.None, false, empty()) == Result.Ok(empty()) => true
    check(Check.State.envEmpty(), 0, Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.natLit(1)), Option.None, false, empty()) => Result.Err(Fail.Reject("type expected"))

fn propIfTheorem(st: NSt, ty: Expr, isThm: Bool) -> Result<NSt, Fail>
    ? "A theorem must state a proposition."
    match isThm
        false -> Result.Ok(st)
        true -> propOrFail(Next.Tc.isProp(st, Next.Value.eval([], ty))?)

verify propIfTheorem
    propIfTheorem(Next.Tc.start(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.sort(Level.Zero), true) => Result.Err(Fail.Reject("theorem type is not Prop"))

fn propOrFail(p: NB) -> Result<NSt, Fail>
    ? "Passes a proposition."
    match p.b
        true -> Result.Ok(p.st)
        false -> Result.Err(Fail.Reject("theorem type is not Prop"))

verify propOrFail
    propOrFail(NB(b = false, st = Next.Tc.start(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)))) => Result.Err(Fail.Reject("theorem type is not Prop"))

fn valueChecks(st: NSt, ty: Expr, v: Expr) -> Result<Facts, Fail>
    ? "The value checked against the declared type."
    eq = Next.Tc.checkAgainst(st, [], [], v, Next.Value.eval([], ty))?
    match eq.b
        true -> Result.Ok(Facts(closed = eq.st.old.closed))
        false -> Result.Err(Fail.Reject("declaration type mismatch"))

verify valueChecks
    valueChecks(Next.Tc.start(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Zero)) => Result.Err(Fail.Reject("declaration type mismatch"))
