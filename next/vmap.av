module VMap
    intent =
        "A persistent hash trie from Int keys to buckets of value pairs, for"
        "the second core's caches; the same trie as Core.PMap. Sixteen-way"
        "branching on four bits of the"
        "key at a time; an update copies one path of at most ten nodes. A"
        "copy of the trie is a copy of its root, so a state record holding"
        "it can be shared freely: an update never copies the whole table,"
        "as a Map whose owner was cloned would. A branch keeps a mask of the"
        "children it has and a vector of just those."
    exposes [VMap, empty, get, add, size, find]
    depends [Next.Value]
    effects []



type VMap
    Empty
    Leaf(Int, List<Tuple<Val, Val>>)
    Branch(Int, Vector<VMap>, Int)

fn empty() -> VMap
    ? "The empty trie."
    VMap.Empty

verify empty
    size(empty()) => 0

fn size(m: VMap) -> Int
    ? "Number of entries."
    match m
        VMap.Empty -> 0
        VMap.Leaf(_, b) -> List.len(b)
        VMap.Branch(_, _, n) -> n

verify size
    size(add(add(empty(), 1, (Val.Nat(0), Val.Nat(1))), 17, (Val.Nat(2), Val.Nat(3)))) => 2

fn sampleTrie(n: Int) -> VMap
    ? "A trie of n entries, the i-th under the key 37 * i, for the laws: the keys share and split nibbles at every level."
    match n <= 0
        true -> VMap.Empty
        false -> add(sampleTrie(n - 1), 37 * (n - 1), (Val.Nat(n - 1), Val.Nat(0)))

verify sampleTrie
    size(sampleTrie(300)) => 300

fn addedSpec(n: Int, i: Int) -> Option<Val>
    ? "What a trie of the first n sample entries holds for the i-th."
    match Bool.and(i >= 0, i < n)
        true -> Option.Some(Val.Nat(0))
        false -> Option.None

verify addedSpec
    addedSpec(3, 3) => Option.None

verify add law findsEachAdded
    given n: Int = [0, 1, 2, 16, 17, 40, 300]
    given i: Int = [0, 1, 15, 16, 39, 299]
    find(sampleTrie(n), 37 * i, Val.Nat(i)) => addedSpec(n, i)

fn nibble(key: Int, shift: Int) -> Int
    ? "Four bits of the key starting at bit shift."
    Bits.and(Result.withDefault(Bits.shiftRight(key, shift), 0), 15)

verify nibble
    nibble(255, 4) => 15
    nibble(16, 4) => 1
    nibble(16, 0) => 0

fn get(m: VMap, key: Int) -> List<Tuple<Val, Val>>
    ? "The bucket stored under key, or an empty one."
    getAt(m, key, 0)

verify get
    get(empty(), 3) => []
    get(add(empty(), 3, (Val.Nat(0), Val.Nat(1))), 3) => [(Val.Nat(0), Val.Nat(1))]
    get(add(add(empty(), 3, (Val.Nat(0), Val.Nat(1))), 19, (Val.Nat(2), Val.Nat(3))), 19) => [(Val.Nat(2), Val.Nat(3))]

fn getAt(m: VMap, key: Int, shift: Int) -> List<Tuple<Val, Val>>
    ? "Descends by the key's nibbles."
    match m
        VMap.Empty -> []
        VMap.Leaf(k, b) -> match k == key
            true -> b
            false -> []
        VMap.Branch(mask, v, _) -> getAt(childAt(mask, v, nibble(key, shift)), key, shift + 4)

verify getAt
    getAt(VMap.Leaf(5, []), 6, 0) => []

fn add(m: VMap, key: Int, entry: Tuple<Val, Val>) -> VMap
    ? "Prepends entry to key's bucket."
    addAt(m, key, entry, 0)

verify add
    size(add(add(empty(), 3, (Val.Nat(0), Val.Nat(1))), 3, (Val.Nat(2), Val.Nat(3)))) => 2

fn addAt(m: VMap, key: Int, entry: Tuple<Val, Val>, shift: Int) -> VMap
    ? "Inserts below this node; a leaf with another key becomes a branch."
    match m
        VMap.Empty -> VMap.Leaf(key, [entry])
        VMap.Leaf(k, b) -> match k == key
            true -> VMap.Leaf(k, List.prepend(entry, b))
            false -> addAt(split(k, b, shift), key, entry, shift)
        VMap.Branch(mask, v, n) -> addBelow(mask, v, n, nibble(key, shift), key, entry, shift)

verify addAt
    size(addAt(VMap.Leaf(1, [(Val.Nat(0), Val.Nat(0))]), 17, (Val.Nat(1), Val.Nat(1)), 0)) => 2

fn addBelow(mask: Int, v: Vector<VMap>, n: Int, nib: Int, key: Int, entry: Tuple<Val, Val>, shift: Int) -> VMap
    ? "Inserts into the child under nib, made when the branch has none."
    bit = bitOf(nib)
    at = Bits.popCount(Bits.and(mask, bit - 1), 16)
    match Bits.and(mask, bit) == 0
        true -> VMap.Branch(Bits.or(mask, bit), inserted(v, at, VMap.Leaf(key, [entry])), n + 1)
        false -> VMap.Branch(mask, setChild(v, at, addAt(Option.withDefault(Vector.get(v, at), VMap.Empty), key, entry, shift + 4)), n + 1)

verify addBelow
    size(addBelow(0, Vector.fromList([]), 0, 3, 3, (Val.Nat(0), Val.Nat(0)), 0)) => 1

fn childAt(mask: Int, v: Vector<VMap>, nib: Int) -> VMap
    ? "The child under nib, or Empty."
    bit = bitOf(nib)
    match Bits.and(mask, bit) == 0
        true -> VMap.Empty
        false -> Option.withDefault(Vector.get(v, Bits.popCount(Bits.and(mask, bit - 1), 16)), VMap.Empty)

verify childAt
    childAt(0, Vector.fromList([]), 5) => VMap.Empty

fn bitOf(nib: Int) -> Int
    ? "The mask bit of a nibble."
    Result.withDefault(Bits.shiftLeft(1, nib), 0)

verify bitOf
    bitOf(3) => 8

fn inserted(v: Vector<VMap>, at: Int, x: VMap) -> Vector<VMap>
    ? "A vector one longer, with x at position at."
    fillInsert(v, at, x, Result.withDefault(Vector.new(Vector.len(v) + 1, VMap.Empty), v), 0)

verify inserted
    Vector.len(inserted(Vector.fromList([VMap.Empty]), 0, VMap.Empty)) => 2

fn fillInsert(src: Vector<VMap>, at: Int, x: VMap, dst: Vector<VMap>, i: Int) -> Vector<VMap>
    ? "Copies src into dst around position at, where x goes."
    match i > Vector.len(src)
        true -> dst
        false -> fillInsert(src, at, x, Option.withDefault(Vector.set(dst, i, picked(src, at, x, i)), dst), i + 1)

verify fillInsert
    Vector.len(fillInsert(Vector.fromList([]), 0, VMap.Empty, Vector.fromList([VMap.Empty]), 0)) => 1

fn picked(src: Vector<VMap>, at: Int, x: VMap, i: Int) -> VMap
    ? "What goes to position i of the longer vector."
    match i == at
        true -> x
        false -> match i < at
            true -> Option.withDefault(Vector.get(src, i), VMap.Empty)
            false -> Option.withDefault(Vector.get(src, i - 1), VMap.Empty)

verify picked
    picked(Vector.fromList([]), 0, VMap.Empty, 0) => VMap.Empty

fn split(k: Int, b: List<Tuple<Val, Val>>, shift: Int) -> VMap
    ? "A branch holding the old leaf under its nibble."
    VMap.Branch(bitOf(nibble(k, shift)), Vector.fromList([VMap.Leaf(k, b)]), List.len(b))

verify split
    size(split(1, [(Val.Nat(0), Val.Nat(0))], 0)) => 1

fn setChild(v: Vector<VMap>, i: Int, child: VMap) -> Vector<VMap>
    ? "Replaces one child; the index is always in range."
    Option.withDefault(Vector.set(v, i, child), v)

verify setChild
    Vector.len(setChild(Vector.fromList([VMap.Empty]), 0, VMap.Empty)) => 1

fn find(m: VMap, key: Int, e: Val) -> Option<Val>
    ? "The value paired with one the same as e in key's bucket."
    findIn(get(m, key), e)

verify find
    find(add(empty(), 4, (Val.Nat(0), Val.Nat(1))), 4, Val.Nat(0)) => Option.Some(Val.Nat(1))
    find(add(empty(), 4, (Val.Nat(0), Val.Nat(1))), 4, Val.Nat(2)) => Option.None

fn findIn(bucket: List<Tuple<Val, Val>>, e: Val) -> Option<Val>
    ? "Linear search of a bucket."
    match bucket
        [] -> Option.None
        [(k, v), ..rest] -> match Next.Value.same(k, e)
            true -> Option.Some(v)
            false -> findIn(rest, e)

verify findIn
    findIn([], Val.Nat(0)) => Option.None
