#!/bin/sh
# Runs the compiled checker and turns its verdict line into the exit status
# the Lean Kernel Arena and `lake comparator` read: 0 accepted, 1 rejected,
# 2 declined.
# Any other ending (a crash, no verdict) is status 3.
bin="${PESTKA_BIN:-$(dirname "$0")/../.build/target/release/main}"
out=$("$bin" "$@")
printf '%s\n' "$out"
case "$(printf '%s\n' "$out" | tail -n 1)" in
  accepted) exit 0 ;;
  rejected:*) exit 1 ;;
  declined:*) exit 2 ;;
  *) exit 3 ;;
esac
