#!/bin/sh
# Builds Pestka as bin/build does, guided by a profile: an instrumented
# build checks the export named by the first argument on one worker, and
# the release build in .build/target then uses what that run measured.
# FLAGS holds further rustc flags for both builds (for example
# "-C target-cpu=native"). Needs llvm-profdata, on PATH or from rustup's
# llvm-tools component. AVER_FLAGS holds further flags for aver compile, as
# for bin/build.
# The profile is taken on one worker although four is the default. Taken
# on four, or on one and then four, it left four workers where they were
# (mathlib 1285.8 G on one, 1285.4 G on four, 1287.6 G on both; Init
# 56.6, 56.4, 56.3 G) and made one worker slower (mathlib 1196.0,
# 1229.4, 1199.6 G; Init 47.4, 49.4, 48.1 G): what four workers do
# beyond one, parsing in rounds, is a small part of the run.
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
train=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")
# shellcheck disable=SC2086 # AVER_FLAGS is a list of flags
"${AVER:-aver}" compile "$root/main.av" --module-root "$root" -o "$root/.build" $AVER_FLAGS >/dev/null
cd "$root/.build"
prof="$root/.build/pgo"
rm -rf "$prof"
mkdir -p "$prof"
RUSTFLAGS="$FLAGS -Cprofile-generate=$prof" cargo build --release --target-dir "$root/.build/target-pgo"
"$root/.build/target-pgo/release/main" "$train" 1 >/dev/null
profdata=$(command -v llvm-profdata || ls "$(rustc --print sysroot)"/lib/rustlib/*/bin/llvm-profdata | head -1)
"$profdata" merge -o "$prof/merged.profdata" "$prof"
RUSTFLAGS="$FLAGS -Cprofile-use=$prof/merged.profdata" cargo build --release
