module Queue
    intent =
        "Checks the runs of deferred declarations on workers taken from a"
        "queue: main keeps one run in flight per worker, each a job of its"
        "own (Runs), and as one ends hands the next run, in order, to that"
        "worker with the facts it found. Main reads the proof blocks a run"
        "needs before handing it out, and the blocks a stopped job wants,"
        "and says what progress there is to say; a worker's run is pure."
        "One worker, or --dealt, checks as Check.Decl does, runs dealt"
        "before checking."
    exposes [checkHeld, checkPart]
    depends [Bytes, Runs, Work, Wait, Core.Names, Core.Decls, Core.Lazy, Check.State, Check.Decl]
    effects [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin, Runs.take, Wait.poll]

decision RunsQueued
    date = "2026-11-24"
    reason =
        "Runs were dealt to the workers before checking, run i to worker i"
        "mod the workers, each worker an element of an independent product"
        "(RunsFinerThanComputation). The estimate the runs are cut by misses"
        "computation, so the dealt shares end apart: CFSG on 32 workers took"
        "4:05:37, its last 30 minutes on one worker, a quarter of the"
        "workers' seconds idle. Now each run is a job (Runs, Work in Aver):"
        "main keeps one in flight per worker and, as one ends, hands the"
        "next run in order to the worker that ended, with the facts that"
        "worker found, so no worker waits while runs are left and the facts"
        "still go from run to run. A job's body is pure: main reads the"
        "blocks of the next run while the workers check, and when a job"
        "stops for a block it does not hold (Wants), main reads it and"
        "begins the rest of the run with it. The earliest failure known is"
        "handed to every run begun, which then checks only what lies before"
        "it; the verdict is still the earliest failure in the file. One"
        "worker checks as before, and so does the wasm build (--dealt),"
        "whose jobs would copy the environment to every one."
    chosen = "RunsQueued"
    rejected = ["RunsDealtBeforeChecking"]
    impacts = [checkHeld, checkPart, queued, launched, came]


fn checkHeld(decls: List<Decl>, workers: Int, memory: Memory, placed: Bool, always: Bool, say: Bool, dealt: Bool) -> Check.Decl.Checking
    ? "Check.Decl.checkHeld with the runs taken from a queue when more than one worker checks and --dealt is not given (RunsQueued)."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin, Runs.take, Wait.poll]
    match Bool.or(workers <= 1, dealt)
        true -> Check.Decl.checkHeld(decls, workers, memory, placed, always, say)
        false -> queuedPlan(Check.Decl.planned(decls, workers, memory, placed, always, say), workers)

fn queuedPlan(p: Check.Decl.Plan, w: Int) -> Check.Decl.Checking
    ? "A planned check on w workers taken from the queue."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin, Runs.take, Wait.poll]
    Check.Decl.checkingOf(p, queued(p.admitted.run.env, p.runs, w))

fn checkPart(decls: List<Decl>, targets: List<Int>, workers: Int, memory: Memory, dealt: Bool, say: Bool) -> Check.Decl.Part
    ? "Check.Decl.checkPart with the runs taken from a queue when more than one worker checks and --dealt is not given (RunsQueued)."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin, Runs.take, Wait.poll]
    match Bool.or(workers <= 1, dealt)
        true -> Check.Decl.checkPart(decls, targets, workers, memory, say)
        false -> queuedPart(Check.Decl.planPart(decls, targets, workers, memory, say), workers)

fn queuedPart(p: Check.Decl.Plan, w: Int) -> Check.Decl.Part
    ? "A planned subset check on w workers taken from the queue."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin, Runs.take, Wait.poll]
    Check.Decl.partOf(p, queued(p.admitted.run.env, p.runs, w))


record Next
    limits: Limits
    jobs: List<Check.Decl.Pre>

record Queue
    env: Env
    ahead: List<Check.Decl.Job>
    left: Int
    template: Limits
    share: Int
    made: Int
    spills: List<Next>
    pending: Map<Int, Wait.Item>
    busy: Map<Int, Limits>
    began: Map<Int, Int>
    most: Map<Int, Int>
    idle: List<Idle>
    start: Int
    waits: Int
    handled: Int
    workMs: Int
    wsum: Int
    csum: Int
    best: Option<Fail>
    at: Int
    count: Int
    lanes: List<Check.Decl.Checked>
    say: Bool
    since: Int
    owns: List<Own>

record Own
    worker: Int
    jobs: List<Check.Decl.Pre>
    keep: Int

decision QuantaOfWork
    date = "2026-11-24"
    reason =
        "Runs or portions cut before checking end apart, since the cost"
        "they are cut by misses computation: the bound of a fixed cut is its"
        "costliest piece (CFSG's run349, 256 runs a worker: one run of 375"
        "declarations, 434 s, about the whole check), and guided portions"
        "(Polychronopoulos and Kuck, 1987), large at first, lost the tail by"
        "180 to 560 s on run349 and run124. So a job's portion only says"
        "where it may go; how far it goes is a quantum of work. Work is what"
        "a check counts anyway, the whnf results it stores (Facts.work). The"
        "quantum is 100 times how long a job waits on main, turned into work"
        "at the rate the workers worked. A job waits on main as long as main"
        "spends a job, over the share of its time main is free: main's time"
        "is the time since checking began less the time it waited in"
        "Wait.poll, over the jobs it took, and the share free is the time it"
        "waited over the time since checking began (a queue of one server,"
        "whose answer takes its service time over one less its load). The"
        "rate is the work the jobs did over the milliseconds they ran. So a"
        "job's wait on main is at most 1% of the job by construction, and no"
        "worker runs more than a quantum and one declaration past the others"
        "while anything is left. The 100 is that bound, not a tuned number."
        "With main's time a job alone the bound held only while main was"
        "seldom busy: as it got busier a job's milliseconds, taken when main"
        "got to it, grew with main's delay, the rate fell, the quantum with"
        "it and main got busier still (run349 on AWS: about 15000 on 16"
        "workers, 0 to 2 on 32, 74 to 78 thousand jobs of one declaration in"
        "the first 7.5 s, the machine 72% busy). With the share free in it"
        "the quantum grows as main gets busy, so main is never the bound,"
        "and while main is mostly free it stays as it was: making it as many"
        "times larger as there are workers kept main free as well, but made"
        "jobs twelve times as long on 12 workers whether main was busy or"
        "not."
        "Before the rate is known a worker's job may check one"
        "declaration, then two, four and so on, and do as much work as it"
        "may check declarations: declarations that store no whnf result"
        "would otherwise grow the count until one job of thousands ran on"
        "with no bound at all (run349 on 8 workers: a job of 11536"
        "declarations begun before any work was seen ran 283 s while the"
        "other workers ended at 60 s). The same number bounds both, so"
        "every job has a bound, passed by one declaration at most, and no"
        "number is added. The count is never more than all jobs have"
        "checked so far: a worker whose jobs of cheap declarations ended at"
        "once doubled its count 38 times in the first 0.1 s, and its job"
        "of 11536 declarations at the start of run349 ran 282 s on 8 workers"
        "with that as its bound. A job that reaches its"
        "quantum, or the first declaration whose block main has not read,"
        "hands the rest of its portion back. Main reads only what a quantum"
        "needs, at the rate cost came with work, so the blocks held are a"
        "quantum's, not a portion's. A rest handed back goes to the workers"
        "that wait, split evenly among them, one declaration each when it"
        "has no more than there are workers waiting, before any new portion"
        "(halving it left 22 declarations as 11, 6, 3, 1, 1, 1 with 60"
        "workers waiting, the heavy ones run three or four after another); a worker with nothing to do waits, its facts kept, while"
        "any job is in flight, since a job may yet hand work back. New"
        "portions are guided, the cost left over twice the workers"
        "(factoring), in the order the runs had. Every job is said with"
        "--progress: its number, worker, the positions of its first and"
        "last declarations and its budget, so a schedule can be read back."
        "Which declarations a job checks depends on the work those before"
        "it took and on time; the verdict is still the earliest failure in"
        "the file."
    chosen = "QuantaOfWork"
    rejected = ["RunsPerWorkerFixed", "PortionsGuided", "PortionsSpilledToTheSameWorker"]
    impacts = [queued, dispatched, splitFor, evenPart, given, mostOf, quantumOf, budgetOf, came, idled, waited]

fn queued(env: Env, runs: List<Check.Decl.Chunk>, w: Int) -> List<Check.Decl.Checked>
    ? "The runs on w workers, as jobs of a quantum of work each (QuantaOfWork)."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin, Runs.take, Wait.poll]
    jobs = jobsOf(runs, [])
    q = Queue.update(emptyQueue(), env = env, ahead = jobs, left = Check.Decl.costOf(jobs, 0), template = templateOf(runs), share = 2 * Int.max(w, 1), start = Time.unixMs(), say = sayOf(runs), since = sinceOf(runs))
    waited(opened(q, 0, w))

fn emptyQueue() -> Queue
    ? "A queue with nothing to do, for examples."
    none: Map<Int, Wait.Item> = {}
    Queue(env = Check.State.envEmpty(), ahead = [], left = 0, template = Check.State.limitsOf(1, Memory.Fast), share = 2, made = 0, spills = [], pending = none, busy = {}, began = {}, most = {}, idle = [], start = 0, waits = 0, handled = 0, workMs = 0, wsum = 0, csum = 0, best = Option.None, at = 0, count = 0, lanes = [], say = false, since = 0, owns = [])

verify emptyQueue
    emptyQueue().count => 0

fn jobsOf(runs: List<Check.Decl.Chunk>, acc: List<Check.Decl.Job>) -> List<Check.Decl.Job>
    ? "The runs' jobs one run after another, in the order the runs had."
    match runs
        [] -> List.reverse(acc)
        [c, ..rest] -> jobsOf(rest, ontoJobs(c.jobs, acc))

verify jobsOf
    jobsOf([], []) => []

fn ontoJobs(js: List<Check.Decl.Job>, acc: List<Check.Decl.Job>) -> List<Check.Decl.Job>
    ? "js put in front of acc one by one."
    match js
        [] -> acc
        [j, ..rest] -> ontoJobs(rest, List.prepend(j, acc))

verify ontoJobs
    ontoJobs([], []) => []

fn templateOf(runs: List<Check.Decl.Chunk>) -> Limits
    ? "The limits every job is checked with, as the runs had them."
    match runs
        [] -> Check.State.limitsOf(1, Memory.Fast)
        [c, .._] -> c.limits

verify templateOf
    templateOf([]).worker => 0

fn sayOf(runs: List<Check.Decl.Chunk>) -> Bool
    ? "Whether progress is asked for, as the runs' limits say."
    match runs
        [] -> false
        [c, .._] -> c.limits.say

verify sayOf
    sayOf([]) => false

fn sinceOf(runs: List<Check.Decl.Chunk>) -> Int
    ? "When checking began, as the runs' limits say."
    match runs
        [] -> 0
        [c, .._] -> c.limits.since

verify sinceOf
    sinceOf([]) => 0

fn opened(q: Queue, s: Int, w: Int) -> Queue
    ? "Each worker from s on waiting, then work handed to every one."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin]
    match s >= w
        true -> dispatched(q)
        false -> opened(idled(q, s, Check.Decl.noFacts(), {}), s + 1, w)

record Idle
    worker: Int
    kept: Check.Decl.Facts
    held: Map<Int, Bytes>

decision IdleWorkersListed
    date = "2026-11-24"
    reason =
        "The workers that wait are a list in the order of their numbers, not"
        "maps from worker to facts and blocks: the wasm-gc build compiles"
        "an equality and a hash for every map's values, and Facts holds maps,"
        "which it has none for, so the build stopped although the wasm build"
        "never queues (--dealt). A list needs neither; there are as many"
        "entries as workers."
    chosen = "IdleWorkersListed"
    rejected = ["IdleWorkersMapped"]
    impacts = [idled, idleInto, idleOf, idleWithout]

fn idled(q: Queue, s: Int, kept: Check.Decl.Facts, held: Map<Int, Bytes>) -> Queue
    ? "Worker s waits for work with its facts and blocks kept (QuantaOfWork, IdleWorkersListed)."
    Queue.update(q, idle = idleInto(q.idle, Idle(worker = s, kept = kept, held = held), []))

verify idled
    List.len(idled(emptyQueue(), 1, Check.Decl.noFacts(), {}).idle) => 1
    List.len(idled(idled(emptyQueue(), 1, Check.Decl.noFacts(), {}), 1, Check.Decl.noFacts(), {}).idle) => 1

fn idleInto(xs: List<Idle>, i: Idle, acc: List<Idle>) -> List<Idle>
    ? "i put among the waiting workers in the order of their numbers, in place of the entry it had."
    match xs
        [] -> List.reverse(List.prepend(i, acc))
        [x, ..rest] -> match x.worker < i.worker
            true -> idleInto(rest, i, List.prepend(x, acc))
            false -> match x.worker == i.worker
                true -> ontoIdle(acc, List.prepend(i, rest))
                false -> ontoIdle(acc, List.prepend(i, xs))

verify idleInto
    List.len(idleInto([], Idle(worker = 2, kept = Check.Decl.noFacts(), held = {}), [])) => 1
    workersOf(idleInto([Idle(worker = 1, kept = Check.Decl.noFacts(), held = {}), Idle(worker = 3, kept = Check.Decl.noFacts(), held = {})], Idle(worker = 2, kept = Check.Decl.noFacts(), held = {}), [])) => [1, 2, 3]

fn ontoIdle(acc: List<Idle>, xs: List<Idle>) -> List<Idle>
    ? "acc, newest first, put back in front of xs."
    match acc
        [] -> xs
        [a, ..rest] -> ontoIdle(rest, List.prepend(a, xs))

verify ontoIdle
    List.len(ontoIdle([], [])) => 0

fn workersOf(xs: List<Idle>) -> List<Int>
    ? "The numbers of the waiting workers."
    match xs
        [] -> []
        [x, ..rest] -> List.prepend(x.worker, workersOf(rest))

verify workersOf
    workersOf([]) => []

fn idleOf(xs: List<Idle>, s: Int) -> Option<Idle>
    ? "Worker s's entry among the waiting, when it waits."
    match xs
        [] -> Option.None
        [x, ..rest] -> match x.worker == s
            true -> Option.Some(x)
            false -> idleOf(rest, s)

verify idleOf
    idleOf([], 1) == Option.None => true

fn idleWithout(xs: List<Idle>, s: Int, acc: List<Idle>) -> List<Idle>
    ? "The waiting workers but s."
    match xs
        [] -> List.reverse(acc)
        [x, ..rest] -> match x.worker == s
            true -> ontoIdle(acc, rest)
            false -> idleWithout(rest, s, List.prepend(x, acc))

verify idleWithout
    workersOf(idleWithout([Idle(worker = 1, kept = Check.Decl.noFacts(), held = {}), Idle(worker = 2, kept = Check.Decl.noFacts(), held = {})], 1, [])) => [2]

record Portion
    jobs: List<Check.Decl.Job>
    rest: List<Check.Decl.Job>
    cost: Int

fn portion(jobs: List<Check.Decl.Job>, want: Int, acc: List<Check.Decl.Job>, cost: Int) -> Portion
    ? "The jobs from the front until their cost reaches want, at least one."
    match jobs
        [] -> Portion(jobs = List.reverse(acc), rest = [], cost = cost)
        [j, ..rest] -> match Bool.and(cost >= want, acc != [])
            true -> Portion(jobs = List.reverse(acc), rest = jobs, cost = cost)
            false -> portion(rest, want, List.prepend(j, acc), cost + Check.Decl.jobCost(j))

verify portion
    portion([], 5, [], 0).cost => 0

fn latered(js: List<Check.Decl.Job>, acc: List<Check.Decl.Pre>) -> List<Check.Decl.Pre>
    ? "Jobs whose blocks are not read yet."
    match js
        [] -> List.reverse(acc)
        [j, ..rest] -> latered(rest, List.prepend(Check.Decl.Pre.Later(j), acc))

verify latered
    latered([], []) => []

fn dispatched(q: Queue) -> Queue
    ? "Work handed to the waiting workers while there is any: a rest handed back first, split evenly among the workers that wait, then a new portion, the cost left over twice the workers; with neither, the rest of a job run past its time taken back (QuantaOfWork, RestTakenFromLongJobs)."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin]
    match workersOf(q.idle)
        [] -> q
        [s, ..others] -> match q.spills
            [n, ..rest] -> splitFor(Queue.update(q, spills = rest), s, n, List.len(others))
            [] -> match q.ahead
                [] -> stolen(q, Time.unixMs())
                _ -> fresh(q, s, portion(q.ahead, Result.withDefault(Int.div(q.left + q.share - 1, q.share), q.left), [], 0))

decision RestTakenFromLongJobs
    date = "2026-11-24"
    reason =
        "A job checks its declarations in order, so the ones behind a long"
        "declaration wait for it: on run349 at 64 workers a lane 27.8 s in"
        "one declaration held 19 to 53 behind it while some 60 lanes had"
        "nothing to do, and handed them back only when it ended. A job is"
        "pure and holds no channel back to main (Work in Aver), so main"
        "cannot tell it to stop, and generated Rust does not stop a"
        "cancelled job. But main knows how long jobs run: the milliseconds"
        "the jobs it took ran, over those jobs. A job past that time has"
        "most likely done its quantum of work (QuantaOfWork), and then it"
        "hands back at its next declaration whatever is behind it. The"
        "quantum's own time, 100 times main's milliseconds a job times the"
        "workers, was too short a measure: jobs ran about ten times longer"
        "on run349 at 12 workers, since the rate is an average over work"
        "that comes at very different speeds, and jobs taken from were"
        "still going and checked 905 declarations a second time. So when workers wait and"
        "nothing is left to hand out, main takes back the back half of what"
        "such a job holds and hands it out as a rest, split evenly among the workers that wait, and again while"
        "workers wait, down to the declaration the job is likely in. Taking"
        "all but its first at once moved a heavy family on run349 at 4"
        "workers one declaration a job from worker to worker, each without"
        "the facts the one before left (195 s against 171 s, stopped by the"
        "guard at 12 GB); taking halves leaves both the job and the one that took"
        "from it a run in file order, and a job over its quantum that hands"
        "back its rest gets it back itself when it is the only worker that"
        "waits. A job with nothing to take is"
        "left alone, and main's wait ends when the next job in flight"
        "passes its time. When the job ends, what it hands back is cut to"
        "the declarations it still holds, and a declaration it checked"
        "after main took it back is counted only once, by the job it went"
        "to: with no failure every declaration a job got and passed was"
        "checked, and with a failure the count is not said. A declaration"
        "checked twice costs time, never the verdict: checking is pure, and"
        "the earliest failure in the file is kept whichever job found it."
    chosen = "RestTakenFromLongJobs"
    rejected = ["RestHandedBackWhenTheJobEnds", "JobsCancelledAndBegunAgain", "OneDeclarationJobsInTheTail"]
    impacts = [dispatched, stolen, victimOf, targetMs, came, trimmed, twice, waited, timeoutOf]

fn stolen(q: Queue, now: Int) -> Queue
    ? "With workers waiting and nothing to hand out, the back half of what it holds taken back from the job run past its time with the most declarations, and handed out as a rest (RestTakenFromLongJobs)."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin]
    match victimOf(q.owns, q.began, now, targetMs(q, now), Option.None)
        Option.None -> q
        Option.Some(o) -> tookBack(q, o, Option.withDefault(Map.get(q.busy, o.worker), q.template))

fn tookBack(q: Queue, o: Own, l: Limits) -> Queue
    ? "The back half of what o holds handed out as a rest, o left holding the front half, said when asked (RestTakenFromLongJobs)."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin]
    front = evenPart(o.keep, 2)
    Check.Decl.said(l, "job {l.run} on worker {o.worker + 1}: {o.keep - front} declarations taken back")
    dispatched(Queue.update(q, owns = ownsWith(q.owns, Own.update(o, keep = front), []), spills = List.prepend(Next(limits = l, jobs = List.drop(List.take(o.jobs, o.keep), front)), q.spills)))

fn victimOf(os: List<Own>, began: Map<Int, Int>, now: Int, target: Int, best: Option<Own>) -> Option<Own>
    ? "The job run past its time that holds the most declarations past its first, when any does (RestTakenFromLongJobs)."
    match os
        [] -> best
        [o, ..rest] -> match Bool.and(Bool.and(target > 0, o.keep > 1), now - Option.withDefault(Map.get(began, o.worker), now) >= target)
            false -> victimOf(rest, began, now, target, best)
            true -> victimOf(rest, began, now, target, moreHeld(o, best))

verify victimOf
    victimOf([], {}, 5, 1, Option.None) == Option.None => true
    victimOf([Own(worker = 0, jobs = [], keep = 3)], {0 => 0}, 5, 10, Option.None) == Option.None => true
    victimOf([Own(worker = 0, jobs = [], keep = 3)], {0 => 0}, 15, 10, Option.None) == Option.Some(Own(worker = 0, jobs = [], keep = 3)) => true
    victimOf([Own(worker = 0, jobs = [], keep = 1)], {0 => 0}, 15, 10, Option.None) == Option.None => true

fn moreHeld(o: Own, best: Option<Own>) -> Option<Own>
    ? "o, or best when that holds more."
    match best
        Option.Some(b) -> match b.keep >= o.keep
            true -> best
            false -> Option.Some(o)
        Option.None -> Option.Some(o)

verify moreHeld
    moreHeld(Own(worker = 1, jobs = [], keep = 2), Option.Some(Own(worker = 0, jobs = [], keep = 3))) == Option.Some(Own(worker = 0, jobs = [], keep = 3)) => true

fn ownsWith(os: List<Own>, o: Own, acc: List<Own>) -> List<Own>
    ? "The jobs in flight with o in place of the entry its worker had, or added."
    match os
        [] -> List.reverse(List.prepend(o, acc))
        [x, ..rest] -> match x.worker == o.worker
            true -> List.reverse(ontoOwns(acc, List.prepend(o, rest)))
            false -> ownsWith(rest, o, List.prepend(x, acc))

verify ownsWith
    List.len(ownsWith([Own(worker = 0, jobs = [], keep = 3)], Own(worker = 0, jobs = [], keep = 1), [])) => 1
    List.len(ownsWith([Own(worker = 0, jobs = [], keep = 3)], Own(worker = 1, jobs = [], keep = 1), [])) => 2

fn ontoOwns(acc: List<Own>, xs: List<Own>) -> List<Own>
    ? "xs put in front of acc one by one, so reversing the result gives acc's order back followed by xs."
    match xs
        [] -> acc
        [x, ..rest] -> ontoOwns(List.prepend(x, acc), rest)

verify ontoOwns
    ontoOwns([], []) => []

fn ownOf(os: List<Own>, k: Int) -> Option<Own>
    ? "Worker k's job in flight, as main handed it out."
    match os
        [] -> Option.None
        [o, ..rest] -> match o.worker == k
            true -> Option.Some(o)
            false -> ownOf(rest, k)

verify ownOf
    ownOf([], 1) == Option.None => true

fn ownsWithout(os: List<Own>, k: Int, acc: List<Own>) -> List<Own>
    ? "The jobs in flight but worker k's."
    match os
        [] -> List.reverse(acc)
        [o, ..rest] -> match o.worker == k
            true -> List.reverse(ontoOwns(acc, rest))
            false -> ownsWithout(rest, k, List.prepend(o, acc))

verify ownsWithout
    List.len(ownsWithout([Own(worker = 0, jobs = [], keep = 3), Own(worker = 1, jobs = [], keep = 3)], 0, [])) => 1

fn splitFor(q: Queue, s: Int, n: Next, waiting: Int) -> Queue
    ? "Worker s gets a rest, or its even part among s and the other workers that wait, rounded up, the others' parts put first again (QuantaOfWork)."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin]
    part = evenPart(List.len(n.jobs), waiting + 1)
    match part < List.len(n.jobs)
        false -> dispatched(given(q, s, n))
        true -> dispatched(given(Queue.update(q, spills = List.prepend(Next(limits = n.limits, jobs = List.drop(n.jobs, part)), q.spills)), s, Next(limits = n.limits, jobs = List.take(n.jobs, part))))

fn evenPart(n: Int, ways: Int) -> Int
    ? "n split ways ways, rounded up: one each while n is no more than ways."
    Result.withDefault(Int.div(n + ways - 1, Int.max(ways, 1)), n)

verify evenPart
    evenPart(22, 60) => 1
    evenPart(22, 1) => 22
    evenPart(22, 4) => 6
    evenPart(0, 3) => 0

fn fresh(q: Queue, s: Int, p: Portion) -> Queue
    ? "Worker s gets a new portion."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin]
    dispatched(given(Queue.update(q, ahead = p.rest, left = q.left - p.cost), s, Next(limits = q.template, jobs = latered(p.jobs, []))))

fn given(q: Queue, s: Int, n: Next) -> Queue
    ? "Worker s, waiting, begins a job on n with the facts it kept: within a quantum of work once the rate is known, else within its next count of declarations and as much work, the blocks read for that much (QuantaOfWork)."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin]
    i = Option.withDefault(idleOf(q.idle, s), Idle(worker = s, kept = Check.Decl.noFacts(), held = {}))
    kept = i.kept
    held = i.held
    quantum = quantumOf(q, Time.unixMs())
    most = mostOf(Option.withDefault(Map.get(q.most, s), 1), q.count)
    l = Limits.update(n.limits, worker = s + 1, run = q.made + 1)
    jobs = readFor(q, n.jobs, quantum, most)
    q2 = Queue.update(q, idle = idleWithout(q.idle, s, []), made = q.made + 1, began = Map.set(q.began, s, Time.unixMs()), most = Map.set(q.most, s, 2 * most), owns = ownsWith(q.owns, Own(worker = s, jobs = jobs, keep = List.len(jobs)), []))
    launched(q2, s, Check.Decl.taskOf(q2.env, held, jobs, l, kept, q2.best, q2.at, budgetOf(quantum, most), countOf(quantum, most)), l, jobs, quantum)

fn mostOf(doubled: Int, checked: Int) -> Int
    ? "How many declarations a job may check before the rate is known: the worker's count doubled with each of its jobs, but never more than all jobs have checked so far (QuantaOfWork)."
    Int.min(doubled, Int.max(checked, 1))

verify mostOf
    mostOf(1, 0) => 1
    mostOf(1099511627776, 5000) => 5000
    mostOf(8, 5000) => 8

fn countOf(quantum: Int, most: Int) -> Int
    ? "How many declarations a job may check: none set once there is a quantum."
    match quantum >= 0
        true -> -1
        false -> most

verify countOf
    countOf(5, 4) => -1
    countOf(-1, 4) => 4

fn budgetOf(quantum: Int, most: Int) -> Int
    ? "How much work a job may do: the quantum once there is one, else as much as the declarations it may check, so no job is without a bound (QuantaOfWork)."
    match quantum >= 0
        true -> quantum
        false -> most

verify budgetOf
    budgetOf(5, 4) => 5
    budgetOf(-1, 4) => 4

fn readFor(q: Queue, jobs: List<Check.Decl.Pre>, quantum: Int, most: Int) -> List<Check.Decl.Pre>
    ? "The blocks of the jobs a quantum is expected to reach read, at the rate cost came with work; with no quantum yet, those of the count allowed."
    ! [Console.error, Disk.readBytesAt, Time.unixMs]
    match quantum >= 0
        true -> Check.Decl.readPrefix(jobs, Result.withDefault(Int.div(quantum * q.csum, Int.max(q.wsum, 1)), 0), 1, [])
        false -> Check.Decl.readPrefix(jobs, 0, most, [])

fn quantumOf(q: Queue, now: Int) -> Int
    ? "The quantum of work: 100 times how long a job waits on main, main's milliseconds a job over the share of the time main waited, at the work a millisecond the workers did; -1 until both are measured (QuantaOfWork)."
    match Bool.or(Bool.or(q.handled == 0, q.workMs == 0), q.wsum == 0)
        true -> -1
        false -> Result.withDefault(Int.div(100 * mainMs(q, now) * Int.max(now - q.start, 1) * q.wsum, q.handled * q.workMs * Int.max(q.waits, 1)), -1)

verify quantumOf
    quantumOf(emptyQueue(), 5) => -1
    quantumOf(Queue.update(emptyQueue(), handled = 10, workMs = 1000, wsum = 5000, waits = 9), 10) => 55
    quantumOf(Queue.update(emptyQueue(), handled = 10, workMs = 1000, wsum = 5000, waits = 5), 10) => 500

fn targetMs(q: Queue, now: Int) -> Int
    ? "How long a job runs, in milliseconds: as long as the jobs taken ran on average; -1 before any job ended (RestTakenFromLongJobs)."
    match q.handled == 0
        true -> -1
        false -> Result.withDefault(Int.div(q.workMs, q.handled), -1)

verify targetMs
    targetMs(emptyQueue(), 5) => -1
    targetMs(Queue.update(emptyQueue(), handled = 10, workMs = 4000), 10) => 400

fn mainMs(q: Queue, now: Int) -> Int
    ? "What main spent so far, at now: the time since checking began less the time it waited."
    Int.max(now - q.start - q.waits, 0)

verify mainMs
    mainMs(emptyQueue(), 7) => 7

fn told(q: Queue, what: String) -> Unit
    ? "One line of progress when asked for (ProgressFromWorkers in Check.Decl)."
    ! [Console.error, Time.unixMs]
    Check.Decl.said(Limits.update(Check.State.limitsOf(1, Memory.Fast), say = q.say, since = q.since), what)

fn launched(q: Queue, s: Int, t: Check.Decl.Task, l: Limits, jobs: List<Check.Decl.Pre>, quantum: Int) -> Queue
    ? "The job begun on worker s, said with its schedule when asked; a job that cannot begin declines the check."
    ! [Console.error, Time.unixMs, Runs.begin]
    scheduled(l, jobs, quantum)
    match Runs.begin(t)
        Result.Ok(job) -> Queue.update(q, pending = Map.set(q.pending, s, Wait.Item.Job(job)), busy = Map.set(q.busy, s, l))
        Result.Err(e) -> failedAll(q, "cannot begin a run: {e}")

fn scheduled(l: Limits, jobs: List<Check.Decl.Pre>, quantum: Int) -> Unit
    ? "The schedule line of a job: its number, worker, the positions of its first and last declarations, how many, and its quantum (QuantaOfWork)."
    ! [Console.error, Time.unixMs]
    match l.say
        false -> Unit
        true -> Check.Decl.said(l, "job {l.run} begun by worker {l.worker}: positions {firstPos(jobs)}..{lastPos(jobs)}, {List.len(jobs)} declarations, quantum {quantum}")

fn firstPos(jobs: List<Check.Decl.Pre>) -> Int
    ? "The position of the first job."
    match jobs
        [] -> -1
        [p, .._] -> Check.Decl.posOf(p)

verify firstPos
    firstPos([]) => -1

fn lastPos(jobs: List<Check.Decl.Pre>) -> Int
    ? "The position of the last job."
    match List.reverse(jobs)
        [] -> -1
        [p, .._] -> Check.Decl.posOf(p)

verify lastPos
    lastPos([]) => -1

fn failedAll(q: Queue, why: String) -> Queue
    ? "A failure of the queue itself, before every declaration: the check declines."
    Queue.update(q, best = Option.Some(Fail.Decline(why)), at = -1)

verify failedAll
    failedAll(emptyQueue(), "x").at => -1

fn waited(q: Queue) -> List<Check.Decl.Checked>
    ? "Waits for jobs to end and takes them, until none is in flight; then what all of them found, and each worker's facts held (FactsHeldToExit)."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin, Runs.take, Wait.poll]
    match Map.len(q.pending) == 0
        true -> List.prepend(Check.Decl.tally(q.best, q.at, q.count), lanesHeld(q.idle, q.lanes))
        false -> answered(q, Time.unixMs(), Wait.poll(q.pending, timeoutOf(q, Time.unixMs())))

fn timeoutOf(q: Queue, now: Int) -> Int
    ? "How long main waits for a job to end: until the next job in flight with declarations to take back passes its time while workers wait with nothing to hand out, else an hour (RestTakenFromLongJobs)."
    match Bool.and(Bool.and(List.len(q.idle) > 0, nothingSpilt(q.spills)), Bool.and(nothingAhead(q.ahead), targetMs(q, now) > 0))
        false -> 3600000
        true -> Int.max(1, Int.min(3600000, nextDue(q.owns, q.began, targetMs(q, now), 3600000 + now) - now))

fn nothingSpilt(xs: List<Next>) -> Bool
    ? "No rest is waiting to be handed out."
    match xs
        [] -> true
        _ -> false

verify nothingSpilt
    nothingSpilt([]) => true

fn nothingAhead(xs: List<Check.Decl.Job>) -> Bool
    ? "No new portion is left."
    match xs
        [] -> true
        _ -> false

verify nothingAhead
    nothingAhead([]) => true

verify timeoutOf
    timeoutOf(emptyQueue(), 5) => 3600000

fn nextDue(os: List<Own>, began: Map<Int, Int>, target: Int, best: Int) -> Int
    ? "When the first job in flight with declarations past its first passes its time."
    match os
        [] -> best
        [o, ..rest] -> match o.keep > 1
            false -> nextDue(rest, began, target, best)
            true -> nextDue(rest, began, target, Int.min(best, Option.withDefault(Map.get(began, o.worker), 0) + target))

verify nextDue
    nextDue([], {}, 10, 99) => 99
    nextDue([Own(worker = 0, jobs = [], keep = 2)], {0 => 5}, 10, 99) => 15

fn lanesHeld(ks: List<Idle>, acc: List<Check.Decl.Checked>) -> List<Check.Decl.Checked>
    ? "Each waiting worker's facts, held to the end."
    match ks
        [] -> acc
        [k, ..rest] -> lanesHeld(rest, List.prepend(Check.Decl.laneEnded(k.kept), acc))

verify lanesHeld
    lanesHeld([], []) => []

fn answered(q: Queue, t0: Int, r: Result<List<Int>, String>) -> List<Check.Decl.Checked>
    ? "The workers whose jobs are ready taken, the wait counted as main's waiting; a wait that fails declines the check."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin, Runs.take, Wait.poll]
    match r
        Result.Ok(ks) -> waited(dispatched(takenAll(Queue.update(q, waits = q.waits + Int.max(Time.unixMs() - t0, 0)), ks)))
        Result.Err(e) -> List.prepend(Check.Decl.tally(Option.Some(Fail.Decline("cannot wait for the workers: {e}")), -1, q.count), q.lanes)

fn takenAll(q: Queue, ks: List<Int>) -> Queue
    ? "Each ready worker's job taken."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin, Runs.take]
    match ks
        [] -> q
        [k, ..rest] -> takenAll(takenOne(q, k, Map.get(q.pending, k)), rest)

fn takenOne(q: Queue, k: Int, item: Option<Wait.Item>) -> Queue
    ? "Worker k's job taken, when it has one."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin, Runs.take]
    match item
        Option.Some(Wait.Item.Job(job)) -> took(q, k, Runs.take(job))
        _ -> q

fn took(q: Queue, k: Int, r: Result<Option<Check.Decl.Done>, String>) -> Queue
    ? "A job that ended goes on; one not ended yet is asked again later; one whose answer is lost declines the check."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin]
    match r
        Result.Ok(Option.None) -> q
        Result.Ok(Option.Some(d)) -> came(Queue.update(q, pending = Map.remove(q.pending, k), handled = q.handled + 1), k, d)
        Result.Err(e) -> failedAll(Queue.update(q, pending = Map.remove(q.pending, k)), "a run ended without its answer: {e}")

fn came(q: Queue, k: Int, d0: Check.Decl.Done) -> Queue
    ? "What worker k's job found, cut to the declarations it still held (RestTakenFromLongJobs): its failure kept when it is the earliest; a block it wanted read and the rest begun with it on the same worker; otherwise its rest handed back and the worker waiting for work (QuantaOfWork)."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin]
    d = trimmed(d0, ownOf(q.owns, k))
    l = Option.withDefault(Map.get(q.busy, k), Check.State.limitsOf(1, Memory.Fast))
    twice(l, k, d0.count - d.count)
    q2 = Queue.update(earliest(q, l, d.fail, d.at), count = q.count + d.count, busy = Map.remove(q.busy, k), owns = ownsWithout(q.owns, k, []), workMs = q.workMs + Int.max(Time.unixMs() - Option.withDefault(Map.get(q.began, k), Time.unixMs()), 0), wsum = q.wsum + d.work, csum = q.csum + d.cost)
    match d.wants
        Option.Some(w) -> wanted(q2, k, l, w, Check.Decl.readSpot(w), d)
        Option.None -> ranOut(q2, k, l, d)

fn trimmed(d: Check.Decl.Done, o: Option<Own>) -> Check.Decl.Done
    ? "A job's answer cut to the declarations it still held when main took some back: its rest only up to them, and those it checked past them not counted, as the job they went to counts them; a block wanted past them not wanted (RestTakenFromLongJobs)."
    match o
        Option.None -> d
        Option.Some(own) -> cutAt(d, List.len(own.jobs) - List.len(d.left), own.keep)

verify trimmed
    trimmed(Check.Decl.Done(kept = Check.Decl.noFacts(), held = {}, count = 4, fail = Option.None, at = 0, wants = Option.None, left = [], work = 0, cost = 0), Option.None).count => 4

fn cutAt(d: Check.Decl.Done, passed: Int, keep: Int) -> Check.Decl.Done
    ? "d of a job that passed passed declarations and still held its first keep."
    match passed >= keep
        true -> Check.Decl.Done.update(d, count = d.count - (passed - keep), left = [], wants = Option.None)
        false -> Check.Decl.Done.update(d, left = List.take(d.left, keep - passed))

verify cutAt
    cutAt(Check.Decl.Done(kept = Check.Decl.noFacts(), held = {}, count = 5, fail = Option.None, at = 0, wants = Option.None, left = [], work = 0, cost = 0), 5, 2).count => 2
    cutAt(Check.Decl.Done(kept = Check.Decl.noFacts(), held = {}, count = 5, fail = Option.None, at = 0, wants = Option.None, left = [], work = 0, cost = 0), 5, 5).count => 5

fn twice(l: Limits, k: Int, n: Int) -> Unit
    ? "How many declarations a job checked after main took them back, said when asked and there are any (RestTakenFromLongJobs)."
    ! [Console.error, Time.unixMs]
    match n > 0
        false -> Unit
        true -> Check.Decl.said(l, "job {l.run} on worker {k + 1}: {n} declarations checked again")

fn ranOut(q: Queue, k: Int, l: Limits, d: Check.Decl.Done) -> Queue
    ? "A job done, said when asked; its rest goes back first, and worker k waits for work."
    ! [Console.error, Time.unixMs]
    Check.Decl.said(l, "job {l.run} done by worker {k + 1}: {d.count} declarations, work {d.work}, {List.len(d.left)} handed back")
    idled(handedBack(q, l, d.left), k, d.kept, d.held)

fn handedBack(q: Queue, l: Limits, left: List<Check.Decl.Pre>) -> Queue
    ? "A rest handed back, put first."
    match left
        [] -> q
        _ -> Queue.update(q, spills = List.prepend(Next(limits = l, jobs = left), q.spills))

verify handedBack
    List.len(handedBack(emptyQueue(), Check.State.limitsOf(1, Memory.Fast), []).spills) => 0

fn wanted(q: Queue, k: Int, l: Limits, w: Spot, r: Result<Bytes, Fail>, d: Check.Decl.Done) -> Queue
    ? "The rest begun again on worker k with the block it wanted held from now on, or, when the block cannot be read, with the job that wanted it declined (BlockReadForItsCheck in Check.Decl)."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin]
    match r
        Result.Ok(b) -> given(idled(q, k, d.kept, Map.set(d.held, w.decl, b)), k, Next(limits = l, jobs = d.left))
        Result.Err(e) -> resumed(q, k, l, Check.Decl.blockMissing(d, e))

fn resumed(q: Queue, k: Int, l: Limits, d: Check.Decl.Done) -> Queue
    ? "The rest of a job begun again after its job was declined."
    ! [Console.error, Disk.readBytesAt, Time.unixMs, Runs.begin]
    q2 = earliest(q, l, d.fail, d.at)
    match d.left
        [] -> idled(q2, k, d.kept, d.held)
        _ -> given(idled(q2, k, d.kept, d.held), k, Next(limits = l, jobs = d.left))

fn earliest(q: Queue, l: Limits, f: Option<Fail>, at: Int) -> Queue
    ? "The earliest failure in the file found so far, said when it is new."
    ! [Console.error, Time.unixMs]
    match f
        Option.None -> q
        Option.Some(e) -> match Bool.or(q.best == Option.None, at < q.at)
            false -> q
            true -> failedAt(q, l, e, at)

fn failedAt(q: Queue, l: Limits, e: Fail, at: Int) -> Queue
    ? "A new earliest failure, said when asked (ProgressFromWorkers in Check.Decl)."
    ! [Console.error, Time.unixMs]
    Check.Decl.said(l, "failed: {Check.Decl.failText(e)}")
    Queue.update(q, best = Option.Some(e), at = at)
