module Shapes
    intent =
        "The shapes the reduction machine runs a casesOn or a sparse"
        "casesOn by, found once for a constant at its levels and kept in the"
        "checker's state for the rest of the declaration: where its major"
        "premise and minor premises sit among its arguments, and each minor"
        "premise's body under its fields. And what the machine knows of a"
        "definition it unfolds often: how often it has, and the rule derived"
        "for it, a tree of constructor patterns with a reduct at each leaf."
    exposes [Shape, CasesOn, SparseOn, MinorOn, Hot, Guard, Branch]
    depends [Core.Names, Core.Levels, Core.Exprs, Core.Decls]
    effects []

record CasesOn
    rv: Rec
    total: Int
    majorAt: Int
    minorsAt: Int

type Shape
    Plain
    Cases(CasesOn)
    Sparse(SparseOn)

record SparseOn
    rv: Rec
    n: Int
    major: Int
    minors: List<Option<MinorOn>>

record MinorOn
    nf: Int
    hyps: Int
    body: Expr

type Hot
    Count(Int)
    Never
    Rule(Int, Guard)

type Guard
    Leaf(Expr)
    Split(Int, List<Branch>)

record Branch
    ctor: Name
    levels: List<Level>
    nargs: Int
    node: Guard
