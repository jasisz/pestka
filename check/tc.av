module Tc
    intent =
        "The type checker: type inference, weak head normalization and"
        "definitional equality, following Lean's reference kernel step by"
        "step. The three call each other (whnf infers types for iota on"
        "structures, equality normalizes, inference checks equality), so"
        "they live in one module. Every function threads the checker state."
    exposes [RI, LD, inferType, check, valueFits, ensureSort, isProp, whnf, whnfCore, isDefEq, sortLevel, withFacts, recFacts, majorInduct]
    depends [Core.Names, Core.Levels, Core.Exprs, Core.Univ, Core.Subst, Core.Apps, Core.Decls, Core.Cache, Check.State, Check.Lits, Core.Hash, Check.Shapes]
    effects []

decision CongruenceAfterSteps
    date = "2026-10-21"
    reason =
        "After a reduction step the reference kernel asks whether the two"
        "sides are made of parts already found equal, through its"
        "equivalence manager. Without that, two applications of the same"
        "coercion whose arguments were each proved equal went down the whole"
        "chain of instances again for every new combination of arguments:"
        "the heaviest mathlib declaration took 198 s and 4.9 GB, with 6.9"
        "million unfoldings of distinct terms. Checking the parts against"
        "identity and remembered equalities first, it takes 12 s and 0.5 GB;"
        "all of mathlib 16 minutes instead of 31."
    chosen = "CongruenceAfterSteps"
    rejected = ["WholePairsOnly"]
    impacts = [quickParts, afterStep, eqCoreWhnf]

record RI
    i: Int
    st: St

record LD
    status: Int
    t: Expr
    s: Expr
    st: St

fn bad(msg: String) -> Fail
    ? "A kernel error: the declaration is rejected."
    Fail.Reject(msg)

verify bad
    bad("x") => Fail.Reject("x")

fn inferType(st: St, e: Expr) -> Result<RE, Fail>
    ? "The type of e, trusting e (the reference infer_type)."
    infer(st, e, true)

verify inferType
    resultExpr(inferType(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero))) => Core.Exprs.sort(Level.Succ(Level.Zero))

fn check(st: St, e: Expr) -> Result<RE, Fail>
    ? "The type of e, checking e on the way."
    infer(st, e, false)

verify check
    check(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0)) => Result.Err(Fail.Reject("the type checker met a loose bound variable"))

fn infer(st: St, e: Expr, only: Bool) -> Result<RE, Fail>
    ? "Cached inference; terms with loose bound variables are refused. A stored range of 16383 or more may be saturated, an upper bound only (a variable 16382 binders deep closed by them all keeps it), so the term is then walked for the exact answer."
    match Core.Exprs.looseRange(e) > 0
        true -> match Bool.and(Core.Exprs.looseRange(e) >= 16383, Bool.not(Core.Subst.hasLoose(e)))
            true -> inferCached(st, e, only, cachedType(st, e, only))
            false -> Result.Err(bad("the type checker met a loose bound variable"))
        false -> inferCached(st, e, only, cachedType(st, e, only))

verify infer
    resultExpr(infer(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.natLit(3), true)) => Core.Exprs.cnst(Check.Lits.name1("Nat"), [])

fn cachedType(st: St, e: Expr, only: Bool) -> Option<Expr>
    ? "A known type of e: from the cache of closed terms checked in earlier declarations, else from this declaration's cache for the mode; inference also takes the type found by checking e, which is a type of e."
    match shared(e)
        true -> orCached(Check.State.cacheGet(st.closed, e), st, e, only)
        false -> orChecked(typeGet(st, only, e), st, e, only)

verify cachedType
    cachedType(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.natLit(1), true) => Option.None

fn orChecked(hit: Option<Expr>, st: St, e: Expr, only: Bool) -> Option<Expr>
    ? "The answer for the mode, or for inference the one checking found."
    match hit
        Option.Some -> hit
        Option.None -> match only
            true -> typeGet(st, false, e)
            false -> Option.None

verify orChecked
    orChecked(Option.None, St.update(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), checkCache = Check.State.cachePut(Core.Cache.empty(), Core.Exprs.natLit(2), Core.Exprs.natLit(3))), Core.Exprs.natLit(2), true) => Option.Some(Core.Exprs.natLit(3))
    orChecked(Option.None, St.update(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), inferCache = Check.State.cachePut(Core.Cache.empty(), Core.Exprs.natLit(2), Core.Exprs.natLit(3))), Core.Exprs.natLit(2), false) => Option.None

fn orCached(hit: Option<Expr>, st: St, e: Expr, only: Bool) -> Option<Expr>
    ? "The shared answer, or this declaration's."
    match hit
        Option.Some -> hit
        Option.None -> typeGet(st, only, e)

verify orCached
    orCached(Option.Some(Core.Exprs.natLit(1)), Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.natLit(2), true) => Option.Some(Core.Exprs.natLit(1))

fn shared(e: Expr) -> Bool
    ? "A term whose checked type is kept across declarations: closed, with no free variable, whose numbers mean something else in every declaration, and no universe parameter, whose names do too; and large enough that checking it again would cost."
    Bool.and(Core.Exprs.treeSize(e) >= 32, Bool.and(Bool.not(Core.Exprs.hasFVar(e)), Bool.not(Core.Exprs.hasParam(e))))

verify shared
    shared(Core.Exprs.natLit(1)) => false

fn cacheFor(st: St, only: Bool) -> Map<Core.Exprs.Key, Bucket>
    ? "Inference and checking keep separate caches."
    match only
        true -> st.inferCache
        false -> st.checkCache

verify cacheFor
    Core.Cache.size(cacheFor(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), true)) => 0

decision ParamsInTheKey
    date = "2026-10-25"
    reason =
        "Checking a term with a universe parameter asks whether the parameter"
        "is the declaration's own, so what it finds holds for declarations with"
        "the same parameters. Such results were kept in a cache of their own,"
        "taken up again by a declaration with the same parameters from the last"
        "four lists kept, and emptied with the variables. Now they are kept with"
        "every other checked type, under the term applied to the declaration's"
        "parameters as a term (paramsTagOf): a declaration finds only those of"
        "its own parameters, from any list met before, with no cache switched."
        "Leaving the parameters out of the key, which is not sound, was"
        "measured as the bound: etale 35.7 G to 34.4 G instructions, Init"
        "95.4 G to 93.6 G."
    chosen = "ParamsInTheKey"
    rejected = ["ParamGenerations", "ParamsCheckedOnce"]
    impacts = [typeGet, checkedKept, openHit]

fn typeGet(st: St, only: Bool, e: Expr) -> Option<Expr>
    ? "The type kept for e in the cache for the mode: under e applied to the declaration's parameters when checking a term with a universe parameter (ParamsInTheKey), else under e."
    match Bool.and(Bool.not(only), Bool.and(st.checkParams, Core.Exprs.hasParam(e)))
        true -> openIn(Map.get(st.checkCache, Core.Exprs.key(Core.Exprs.appHash(e, st.paramsTag))), e, st.paramsTag)
        false -> Check.State.cacheGet(cacheFor(st, only), e)

verify typeGet
    typeGet(checkedKept(RE(e = Core.Exprs.natLit(1), st = Check.State.fresh(Check.State.envEmpty(), [Core.Names.anon()], Safety.Safe)), Core.Exprs.sort(Level.Param(Core.Names.anon())), Core.Exprs.sort(Level.Param(Core.Names.anon()))).st, false, Core.Exprs.sort(Level.Param(Core.Names.anon()))) => Option.Some(Core.Exprs.natLit(1))
    typeGet(St.update(checkedKept(RE(e = Core.Exprs.natLit(1), st = Check.State.fresh(Check.State.envEmpty(), [Core.Names.anon()], Safety.Safe)), Core.Exprs.sort(Level.Param(Core.Names.anon())), Core.Exprs.sort(Level.Param(Core.Names.anon()))).st, paramsTag = Check.State.paramsTagOf([])), false, Core.Exprs.sort(Level.Param(Core.Names.anon()))) => Option.None

fn inferCached(st: St, e: Expr, only: Bool, hit: Option<Expr>) -> Result<RE, Fail>
    ? "Uses a cached type or infers and records one."
    match hit
        Option.Some(t) -> Result.Ok(RE(e = t, st = st))
        Option.None -> Result.Ok(remember(inferCore(st, e, [], only)?, e, only))

verify inferCached
    resultExpr(inferCached(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), true, Option.Some(Core.Exprs.bvar(1)))) => Core.Exprs.bvar(1)

fn remember(r: RE, e: Expr, only: Bool) -> RE
    ? "Records the inferred type: into the cache for the mode, or the shared one for closed terms. Every term gets an entry: a cache is a map changed in place, and an entry costs less than finding even a small term's type again."
    match only
        true -> RE(e = r.e, st = St.update(r.st, inferCache = Check.State.cachePut(r.st.inferCache, e, r.e)))
        false -> match shared(e)
            true -> RE(e = r.e, st = St.update(r.st, closed = Check.State.cachePut(r.st.closed, e, r.e)))
            false -> checkedKept(r, e, e)

verify remember
    Core.Cache.size(remember(RE(e = Core.Exprs.bvar(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.bvar(0), true).st.inferCache) => 1

fn inferCore(st: St, e: Expr, env: List<Expr>, only: Bool) -> Result<RE, Fail>
    ? "One inference step by the shape of e, whose loose bound variables stand for the free variables in env, the innermost first."
    match e
        Expr.BVar(i) -> boundType(st, List.drop(env, i))
        Expr.FVar(id) -> Result.Ok(RE(e = Check.State.localType(st.lctx, id)?, st = st))
        Expr.Sort(l) -> inferSort(st, l, only)
        Expr.Const(_, n, ls) -> inferConst(st, e, n, ls, only)
        Expr.App(_, f, a) -> inferApp(st, e, f, a, env, only)
        Expr.Lam -> lamLoop(st, e, env, [], only)
        Expr.Pi -> piLoop(st, e, env, [], [], only)
        Expr.Let -> letLoop(st, e, env, [], only)
        Expr.NatLit -> Result.Ok(RE(e = Core.Exprs.cnst(Check.Lits.nat, []), st = st))
        Expr.StrLit -> Result.Ok(RE(e = Core.Exprs.cnst(Check.Lits.string, []), st = st))
        Expr.Proj(_, s, i, x) -> inferProj(st, s, i, x, env, only)

verify inferCore
    inferCore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.strLit("a"), [], true) => Result.Ok(RE(e = Core.Exprs.cnst(Check.Lits.name1("String"), []), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)))
    resultExpr(inferCore(Check.State.names(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.natLit(7), Option.None, Binder.Default).st, Core.Exprs.bvar(0), [Core.Exprs.fvar(0)], true)) => Core.Exprs.natLit(7)

fn boundType(st: St, rest: List<Expr>) -> Result<RE, Fail>
    ? "The type of the free variable a bound variable stands for; with none, the variable is loose."
    match rest
        [] -> Result.Err(bad("the type checker met a loose bound variable"))
        [x, .._] -> Result.Ok(RE(e = Check.State.localType(st.lctx, fvarId(x))?, st = st))

verify boundType
    boundType(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), []) => Result.Err(Fail.Reject("the type checker met a loose bound variable"))

fn inferIn(st: St, e: Expr, env: List<Expr>, only: Bool) -> Result<RE, Fail>
    ? "Inference under binders, used past the depth where bodies stop being copied: the loose bound variables of e stand for the free variables in env, the innermost first. Checking walks a body as it is. Inference alone puts the variables in, since it is asked about terms that reduction built, which find the types of their parts only in that form. A closed part goes the usual way."
    match Core.Exprs.isClosed(e)
        true -> infer(st, e, only)
        false -> match only
            true -> infer(st, minst(e, env), only)
            false -> openKeyed(st, e, env, only)

verify inferIn
    resultExpr(inferIn(Check.State.names(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.sort(Level.Zero), Option.None, Binder.Default).st, Core.Exprs.lam(Core.Names.anon(), Core.Exprs.bvar(0), Core.Exprs.bvar(0), Binder.Default), [Core.Exprs.fvar(0)], false)) => Core.Exprs.pi(Core.Names.anon(), Core.Exprs.fvar(0), Core.Exprs.fvar(0), Binder.Default)
    inferIn(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.bvar(0), Core.Exprs.bvar(0)), [], true) => Result.Err(Fail.Reject("the type checker met a loose bound variable"))

fn openKeyed(st: St, e: Expr, env: List<Expr>, only: Bool) -> Result<RE, Fail>
    ? "With no variables around, nothing to key on."
    match env
        [] -> inferCore(st, e, env, only)
        _ -> openCached(st, e, env, only)

verify openKeyed
    openKeyed(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), [], true) => Result.Err(Fail.Reject("the type checker met a loose bound variable"))

fn openCached(st: St, e: Expr, env: List<Expr>, only: Bool) -> Result<RE, Fail>
    ? "An open term's type is cached under the term applied to st.opened, the variables of the binders open around it past the depth where bodies stop being copied, as one application spine (see deepBody). env is its innermost part, so the spine fixes what every loose bound variable of e stands for, and the key is found by its hash and compared from the pointer in: a lookup costs the same however many binders are open. A term shared under the same binders, as a DAG shares it, is found again. The key keeps e's loose bound variables, so it is never a term that is checked."
    around = st.opened
    match openHit(st, e, around, only)
        Option.Some(t) -> Result.Ok(RE(e = t, st = st))
        Option.None -> Result.Ok(rememberOpen(inferCore(st, e, env, only)?, Core.Exprs.app(e, around), only))

verify openCached
    resultExpr(openCached(Check.State.names(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.natLit(7), Option.None, Binder.Default).st, Core.Exprs.bvar(0), [Core.Exprs.fvar(1)], true)) => Core.Exprs.natLit(7)

fn openHit(st: St, e: Expr, around: Expr, only: Bool) -> Option<Expr>
    ? "The cached type of e under around, looked up apart: the cache handed out for the lookup is let go when this returns, before the caller infers and keeps a type, which would otherwise find the cache with two owners and copy all of it."
    match Bool.and(Bool.not(only), Bool.and(st.checkParams, Core.Exprs.hasParam(e)))
        true -> taggedIn(Map.get(st.checkCache, Core.Exprs.key(Core.Exprs.appHash3(e, around, st.paramsTag))), e, around, st.paramsTag)
        false -> openIn(Map.get(cacheFor(st, only), Core.Exprs.key(Core.Exprs.appHash(e, around))), e, around)

verify openHit
    openHit(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), Core.Exprs.fvar(1), false) => Option.None

fn rememberOpen(r: RE, key: Expr, only: Bool) -> RE
    ? "Records an open term's type under its key, in the cache for the mode."
    match only
        true -> RE(e = r.e, st = St.update(r.st, inferCache = Check.State.cachePut(r.st.inferCache, key, r.e)))
        false -> checkedKept(r, key, key)

verify rememberOpen
    Core.Cache.size(rememberOpen(RE(e = Core.Exprs.bvar(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.bvar(0), false).st.checkCache) => 1

fn checkedKept(r: RE, key: Expr, e: Expr) -> RE
    ? "Records a checked type under key, applied to the declaration's parameters when e has a universe parameter (ParamsInTheKey)."
    match Bool.and(r.st.checkParams, Core.Exprs.hasParam(e))
        true -> RE(e = r.e, st = St.update(r.st, checkCache = Check.State.cachePut(r.st.checkCache, Core.Exprs.app(key, r.st.paramsTag), r.e)))
        false -> RE(e = r.e, st = St.update(r.st, checkCache = Check.State.cachePut(r.st.checkCache, key, r.e)))

verify checkedKept
    Core.Cache.size(checkedKept(RE(e = Core.Exprs.bvar(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.bvar(0), Core.Exprs.bvar(0)).st.checkCache) => 1

fn openIn(o: Option<Bucket>, e: Expr, around: Expr) -> Option<Expr>
    ? "findOpen on the bucket the map holds, read in place (BucketsReadInPlace)."
    match o
        Option.Some(k) -> findOpen(k, e, around)
        Option.None -> Option.None

verify openIn
    openIn(Option.None, Core.Exprs.bvar(0), Core.Exprs.fvar(1)) => Option.None

fn taggedIn(o: Option<Bucket>, e: Expr, around: Expr, tag: Expr) -> Option<Expr>
    ? "findTagged on the bucket the map holds, read in place."
    match o
        Option.Some(k) -> findTagged(k, e, around, tag)
        Option.None -> Option.None

verify taggedIn
    taggedIn(Option.None, Core.Exprs.bvar(0), Core.Exprs.fvar(1), Core.Exprs.natLit(0)) => Option.None

fn findOpen(bucket: Bucket, e: Expr, around: Expr) -> Option<Expr>
    ? "The value stored under e applied to around, compared without building it."
    match bucket
        Bucket.NoEntry -> Option.None
        Bucket.OneEntry((key, v)) -> match isOpenKey(key, e, around)
            true -> Option.Some(v)
            false -> Option.None
        Bucket.Entries(es) -> findOpenIn(es, e, around)

verify findOpen
    findOpen(Bucket.OneEntry((Core.Exprs.app(Core.Exprs.bvar(0), Core.Exprs.fvar(2)), Core.Exprs.natLit(1))), Core.Exprs.bvar(0), Core.Exprs.fvar(2)) => Option.Some(Core.Exprs.natLit(1))
    findOpen(Bucket.OneEntry((Core.Exprs.app(Core.Exprs.bvar(0), Core.Exprs.fvar(2)), Core.Exprs.natLit(1))), Core.Exprs.bvar(0), Core.Exprs.fvar(3)) => Option.None

fn findTagged(bucket: Bucket, e: Expr, around: Expr, tag: Expr) -> Option<Expr>
    ? "The value stored under e applied to around and then to tag, compared without building it."
    match bucket
        Bucket.NoEntry -> Option.None
        Bucket.OneEntry((key, v)) -> match isTaggedKey(key, e, around, tag)
            true -> Option.Some(v)
            false -> Option.None
        Bucket.Entries(es) -> findTaggedIn(es, e, around, tag)

verify findTagged
    findTagged(Bucket.OneEntry((Core.Exprs.app(Core.Exprs.app(Core.Exprs.bvar(0), Core.Exprs.fvar(2)), Core.Exprs.natLit(5)), Core.Exprs.natLit(1))), Core.Exprs.bvar(0), Core.Exprs.fvar(2), Core.Exprs.natLit(5)) => Option.Some(Core.Exprs.natLit(1))
    findTagged(Bucket.OneEntry((Core.Exprs.app(Core.Exprs.app(Core.Exprs.bvar(0), Core.Exprs.fvar(2)), Core.Exprs.natLit(5)), Core.Exprs.natLit(1))), Core.Exprs.bvar(0), Core.Exprs.fvar(2), Core.Exprs.natLit(6)) => Option.None

fn findTaggedIn(es: List<Tuple<Expr, Expr>>, e: Expr, around: Expr, tag: Expr) -> Option<Expr>
    ? "findTagged over a bucket's entries."
    match es
        [] -> Option.None
        [(key, v), ..rest] -> match isTaggedKey(key, e, around, tag)
            true -> Option.Some(v)
            false -> findTaggedIn(rest, e, around, tag)

verify findTaggedIn
    findTaggedIn([], Core.Exprs.bvar(0), Core.Exprs.fvar(3), Core.Exprs.natLit(1)) => Option.None

fn isTaggedKey(key: Expr, e: Expr, around: Expr, tag: Expr) -> Bool
    ? "Whether key is e applied to around and then to tag."
    match key
        Expr.App(_, f, t) -> match t == tag
            true -> isOpenKey(f, e, around)
            false -> false
        _ -> false

verify isTaggedKey
    isTaggedKey(Core.Exprs.bvar(0), Core.Exprs.bvar(0), Core.Exprs.fvar(2), Core.Exprs.natLit(1)) => false

fn findOpenIn(es: List<Tuple<Expr, Expr>>, e: Expr, around: Expr) -> Option<Expr>
    ? "findOpen over a bucket's entries."
    match es
        [] -> Option.None
        [(key, v), ..rest] -> match isOpenKey(key, e, around)
            true -> Option.Some(v)
            false -> findOpenIn(rest, e, around)

verify findOpenIn
    findOpenIn([(Core.Exprs.bvar(0), Core.Exprs.natLit(1))], Core.Exprs.bvar(0), Core.Exprs.fvar(3)) => Option.None

fn isOpenKey(key: Expr, e: Expr, around: Expr) -> Bool
    ? "Whether key is e applied to around, the spine compared first: the spines of one stretch of binders are one node."
    match key
        Expr.App(_, f, a) -> match a == around
            true -> f == e
            false -> false
        _ -> false

verify isOpenKey
    isOpenKey(Core.Exprs.app(Core.Exprs.bvar(0), Core.Exprs.fvar(2)), Core.Exprs.bvar(0), Core.Exprs.fvar(2)) => true
    isOpenKey(Core.Exprs.bvar(0), Core.Exprs.bvar(0), Core.Exprs.fvar(2)) => false

fn checkLevel(st: St, l: Level) -> Result<Unit, Fail>
    ? "Every universe parameter must be one of the declaration's."
    match st.checkParams
        false -> Result.Ok(Unit)
        true -> match Core.Univ.undefParam(l, st.params)
            Option.Some(n) -> Result.Err(bad("undefined universe level parameter '{Core.Names.render(n)}'"))
            Option.None -> Result.Ok(Unit)

verify checkLevel
    checkLevel(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Level.Param(Core.Names.str(Core.Names.anon(), "u"))) => Result.Err(Fail.Reject("undefined universe level parameter 'u'"))

fn checkLevels(st: St, ls: List<Level>) -> Result<Unit, Fail>
    ? "checkLevel on each."
    match ls
        [] -> Result.Ok(Unit)
        [l, ..rest] -> afterLevel(checkLevel(st, l)?, st, rest)

verify checkLevels
    checkLevels(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), []) => Result.Ok(Unit)

fn afterLevel(u: Unit, st: St, rest: List<Level>) -> Result<Unit, Fail>
    ? "Continues after one level passed."
    checkLevels(st, rest)

verify afterLevel
    afterLevel(Unit, Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), []) => Result.Ok(Unit)

fn inferSort(st: St, l: Level, only: Bool) -> Result<RE, Fail>
    ? "Sort u : Sort (u+1)."
    match only
        true -> Result.Ok(RE(e = Core.Exprs.sort(Level.Succ(l)), st = st))
        false -> sortChecked(checkLevel(st, l)?, st, l)

verify inferSort
    inferSort(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Level.Zero, false) => Result.Ok(RE(e = Core.Exprs.sort(Level.Succ(Level.Zero)), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)))

fn sortChecked(u: Unit, st: St, l: Level) -> Result<RE, Fail>
    ? "The type of a checked sort."
    Result.Ok(RE(e = Core.Exprs.sort(Level.Succ(l)), st = st))

verify sortChecked
    resultExpr(sortChecked(Unit, Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Level.Zero)) => Core.Exprs.sort(Level.Succ(Level.Zero))

fn inferConst(st: St, e: Expr, n: Name, ls: List<Level>, only: Bool) -> Result<RE, Fail>
    ? "The type of e, the constant n at the levels ls."
    match Check.State.lookup(st, n)
        Option.None -> Result.Err(bad("unknown constant '{Core.Names.render(n)}'"))
        Option.Some(c) -> constType(st, e, c, Check.State.headOf(c), ls, only)

verify inferConst
    inferConst(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Core.Names.str(Core.Names.anon(), "x"), []), Core.Names.str(Core.Names.anon(), "x"), [], true) => Result.Err(Fail.Reject("unknown constant 'x'"))

fn constType(st: St, e: Expr, c: Const, h: Head, ls: List<Level>, only: Bool) -> Result<RE, Fail>
    ? "Checks the level count, and in checking mode safety and levels."
    match List.len(h.params) == List.len(ls)
        false -> Result.Err(bad("incorrect number of universe levels for '{Core.Names.render(h.name)}'"))
        true -> match only
            true -> Result.Ok(levelledType(st, e, h, ls))
            false -> constSafety(st, e, c, h, ls)

verify constType
    constType(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Core.Names.anon(), [Level.Zero]), Const.CAxiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), false), Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), [Level.Zero], true) => Result.Err(Fail.Reject("incorrect number of universe levels for '[anonymous]'"))

fn constSafety(st: St, e: Expr, c: Const, h: Head, ls: List<Level>) -> Result<RE, Fail>
    ? "A safe declaration may use neither unsafe nor partial constants."
    match Bool.and(Check.State.isUnsafe(c), st.safety != Safety.Unsafe)
        true -> Result.Err(bad("invalid declaration, it uses unsafe declaration '{Core.Names.render(h.name)}'"))
        false -> match Bool.and(Check.State.isPartial(c), st.safety == Safety.Safe)
            true -> Result.Err(bad("invalid declaration, safe declaration must not contain partial declaration '{Core.Names.render(h.name)}'"))
            false -> constLevels(checkLevels(st, ls)?, st, e, h, ls)

verify constSafety
    constSafety(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Core.Names.anon(), []), Const.CAxiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), true), Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), []) => Result.Err(Fail.Reject("invalid declaration, it uses unsafe declaration '[anonymous]'"))

fn constLevels(u: Unit, st: St, e: Expr, h: Head, ls: List<Level>) -> Result<RE, Fail>
    ? "The instantiated type once the levels passed."
    Result.Ok(levelledType(st, e, h, ls))

verify constLevels
    resultExpr(constLevels(Unit, Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Core.Names.anon(), []), Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), [])) => Core.Exprs.sort(Level.Zero)

fn levelledType(st: St, e: Expr, h: Head, ls: List<Level>) -> RE
    ? "The type of e, the constant of h at the levels ls, once its levels passed their checks. It depends on the levels as written, not on what their parameters mean in a declaration, so it is instantiated once and kept from one declaration to the next."
    match ls
        [] -> RE(e = h.ty, st = st)
        _ -> match Check.State.cacheGet(st.levelTypes, e)
            Option.Some(t) -> RE(e = t, st = st)
            Option.None -> keptType(st, e, Core.Subst.instLevelParams(h.ty, h.params, ls))

verify levelledType
    levelledType(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Core.Names.anon(), []), Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), []).e => Core.Exprs.sort(Level.Zero)
    Core.Cache.size(levelledType(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Core.Names.anon(), [Level.Zero]), Head(name = Core.Names.anon(), params = [Core.Names.anon()], ty = Core.Exprs.sort(Level.Param(Core.Names.anon()))), [Level.Zero]).st.levelTypes) => 1

fn keptType(st: St, e: Expr, t: Expr) -> RE
    ? "The instantiated type, recorded for e."
    RE(e = t, st = St.update(st, levelTypes = Check.State.cachePut(st.levelTypes, e, t)))

verify keptType
    keptType(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), Core.Exprs.bvar(1)).e => Core.Exprs.bvar(1)

fn fvarId(e: Expr) -> Int
    ? "The number of a free variable."
    match e
        Expr.FVar(id) -> id
        _ -> -1

verify fvarId
    fvarId(Core.Exprs.fvar(4)) => 4

fn domainOf(e: Expr) -> Expr
    ? "Binder domain of a lambda or pi."
    match e
        Expr.Lam(_, d, _) -> d
        Expr.Pi(_, d, _) -> d
        _ -> e

verify domainOf
    domainOf(Core.Exprs.pi(Core.Names.anon(), Core.Exprs.bvar(9), Core.Exprs.bvar(0), Binder.Default)) => Core.Exprs.bvar(9)

fn bodyOf(e: Expr) -> Expr
    ? "Binder body of a lambda or pi."
    match e
        Expr.Lam(_, _, b) -> b
        Expr.Pi(_, _, b) -> b
        _ -> e

verify bodyOf
    bodyOf(Core.Exprs.pi(Core.Names.anon(), Core.Exprs.bvar(9), Core.Exprs.bvar(0), Binder.Default)) => Core.Exprs.bvar(0)

fn sortLevel(e: Expr) -> Level
    ? "The level of a sort."
    match e
        Expr.Sort(l) -> l
        _ -> Level.Zero

verify sortLevel
    sortLevel(Core.Exprs.sort(Level.Succ(Level.Zero))) => Level.Succ(Level.Zero)

decision TelescopeOnce
    date = "2026-10-24"
    reason =
        "A definition's value was checked by inferring its type, which opens"
        "the value's lambdas, infers the body under their variables and closes"
        "the body's type over them into a pi; that pi was then compared with"
        "the declared type, which opens both pis again. When the lambdas'"
        "domains are the declared pis' domains as written, which on etale, qb9"
        "and Init holds for 99.8% of them, the pi built is the declared one"
        "with the inferred body, and comparing it is comparing the bodies under"
        "the same variables: the counted variables of equal domains are the"
        "very ones the lambdas got. So the body's type is compared with the"
        "declared body under the lambdas' variables, and no pi is built or"
        "opened again. Closing the root body's type over its variables alone"
        "was 1.4 G on etale and 2.8 G on qb9. Instructions retired, one"
        "worker, on Aver 58a0c12f: etale 51.0 G to 49.3 G, qb9 97.5 G to"
        "94.2 G, Init 128.6 G to 127.7 G."
    chosen = "TelescopeOnce"
    rejected = ["BuildThenCompare"]
    impacts = [valueFits, lamOpen, openedFits]

fn valueFits(st: St, v: Expr, ty: Expr) -> Result<RB, Fail>
    ? "Whether the value v checks and has the declared type ty. When v's lambdas have ty's pis' domains as written, the body's type is compared with ty's body under their variables (TelescopeOnce); otherwise, or when v's type is already known, v's type is compared with ty."
    match Bool.or(Core.Exprs.looseRange(v) > 0, cachedType(st, v, false) != Option.None)
        true -> plainFits(check(st, v)?, ty)
        false -> match telescopeRest(v, ty)
            Option.Some(rest) -> openedFits(lamOpen(st, v, [], [])?, rest)
            Option.None -> plainFits(check(st, v)?, ty)

verify valueFits
    resultBool(valueFits(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Core.Exprs.pi(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Zero), Binder.Default))) => true
    resultBool(valueFits(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Core.Exprs.pi(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default))) => false
    resultBool(valueFits(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Succ(Level.Zero)))) => true

fn plainFits(r: RE, ty: Expr) -> Result<RB, Fail>
    ? "The value's inferred type against the declared one."
    isDefEq(r.st, r.e, ty)

verify plainFits
    resultBool(plainFits(RE(e = Core.Exprs.sort(Level.Zero), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.sort(Level.Zero))) => true

fn telescopeRest(v: Expr, ty: Expr) -> Option<Expr>
    ? "When v is lambdas whose domains are, as written, the domains of as many leading pis of ty: ty past those pis."
    match v
        Expr.Lam(_, d, b) -> match ty
            Expr.Pi(_, e, c) -> match d == e
                true -> telescopeOn(b, c)
                false -> Option.None
            _ -> Option.None
        _ -> Option.None

verify telescopeRest
    telescopeRest(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Core.Exprs.pi(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Implicit)) => Option.Some(Core.Exprs.bvar(0))
    telescopeRest(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Core.Exprs.pi(Core.Names.anon(), Core.Exprs.bvar(0), Core.Exprs.bvar(0), Binder.Default)) => Option.None
    telescopeRest(Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Zero)) => Option.None

fn telescopeOn(b: Expr, c: Expr) -> Option<Expr>
    ? "telescopeRest past the first lambda: the rest of ty once v's lambdas end."
    match b
        Expr.Lam(_, d, b2) -> match c
            Expr.Pi(_, e, c2) -> match d == e
                true -> telescopeOn(b2, c2)
                false -> Option.None
            _ -> Option.None
        _ -> Option.Some(c)

verify telescopeOn
    telescopeOn(Core.Exprs.bvar(0), Core.Exprs.bvar(1)) => Option.Some(Core.Exprs.bvar(1))

record Opened
    t: Expr
    rev: List<Expr>
    ids: List<Int>
    st: St

decision DomainsCheckedWithType
    date = "2026-10-25"
    reason =
        "lamOpen runs only when every lambda of a declaration's value has, as"
        "written, the domain of the declared type's pi at its place"
        "(TelescopeOnce), and the declared type is checked before the value:"
        "each of its domains was found to be a type under the variables of the"
        "domains before it. The lambdas' variables are those very variables,"
        "since counted variables of equal domains are equal, so each lambda's"
        "domain, put in as the pi's was, is a term already found to be a type."
        "Checking it again found the same cached answer, after comparing the"
        "domain built again with the one built for the type. Instructions"
        "retired, one worker: etale 44.5 G to 44.3 G, contdiff 32.0 G to"
        "31.9 G, Init 116.6 G to 116.3 G."
    chosen = "DomainsCheckedWithType"
    rejected = ["DomainsCheckedAgain"]
    impacts = [lamOpenStep]

fn lamOpen(st: St, e: Expr, rev: List<Expr>, ids: List<Int>) -> Result<Opened, Fail>
    ? "lamLoop in checking mode, left open: the lambdas' variables declared and the body's type inferred under them, not closed into a pi."
    match e
        Expr.Lam(_, d, b) -> lamOpenStep(st, Core.Subst.instantiate(d, rev), b, rev, ids)
        _ -> openedEnd(bodyType(st, e, rev, List.len(ids), false)?, rev, ids)

verify lamOpen
    lamOpen(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), [], []) == Result.Err(Fail.Reject("the type checker met a loose bound variable")) => true

fn lamOpenStep(st: St, d: Expr, b: Expr, rev: List<Expr>, ids: List<Int>) -> Result<Opened, Fail>
    ? "Declares the variable, as lamStep, without checking the domain is a type: it is the declared type's domain as written, under the same variables, and checking the type found it one (DomainsCheckedWithType)."
    loc = Check.State.namesAt(st, Core.Names.anon(), d, Option.None, Binder.Default)
    lamOpen(loc.st, b, List.prepend(loc.e, rev), List.prepend(fvarId(loc.e), ids))

verify lamOpenStep
    lamOpenStep(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), Core.Exprs.natLit(1), [], []) == Result.Err(Fail.Reject("the type checker met a loose bound variable")) => false
    lamOpenStep(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(1), [], []) == Result.Err(Fail.Reject("the type checker met a loose bound variable")) => true

fn openedEnd(r: RE, rev: List<Expr>, ids: List<Int>) -> Result<Opened, Fail>
    ? "The body's type with the variables still open."
    Result.Ok(Opened(t = cheapBeta(r.e), rev = rev, ids = ids, st = r.st))

verify openedEnd
    openedEnd(RE(e = Core.Exprs.sort(Level.Zero), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), [], []) == Result.Ok(Opened(t = Core.Exprs.sort(Level.Zero), rev = [], ids = [], st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe))) => true

decision DeclaredBodyUnbuilt
    date = "2026-10-25"
    reason =
        "openedFits built the declared body with the lambdas' variables put"
        "in, a second copy of it after the one checking the type had built,"
        "only to find it the same term as the body's type, as it nearly"
        "always is. fitsUnder tells that without building, but only for"
        "terms under 63 nodes, and a theorem's statement is rarely that"
        "small. fitsWithin compares the same way with a budget of nodes"
        "visited instead, so that a body sharing parts cannot make the walk"
        "long; the body is built and compared in full only when the walk"
        "finds a difference or the budget runs out. Instructions retired,"
        "one worker: etale 46.0 G to 45.8 G, contdiff 32.3 G to 32.2 G, Init"
        "117.3 G to 117.0 G. The same budget in place of the size limit in"
        "argFits gained nothing (etale 45.8 G, Init 117.3 G) and is not"
        "used there."
    chosen = "DeclaredBodyUnbuilt"
    rejected = ["DeclaredBodyBuilt", "ArgumentsWithinBudget"]
    impacts = [openedFits, fitsWithin]

fn openedFits(o: Opened, rest: Expr) -> Result<RB, Fail>
    ? "The body's type against the declared body under the same variables, which are then closed; found the same term without building the declared body when it is (DeclaredBodyUnbuilt)."
    match fitsWithin(o.t, rest, o.rev, 0, 4096) >= 0
        true -> Result.Ok(RB(b = true, st = Check.State.closeVars(o.st, List.len(o.ids))))
        false -> openedBuilt(o, rest)

verify openedFits
    resultBool(openedFits(Opened(t = Core.Exprs.sort(Level.Zero), rev = [], ids = [], st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.sort(Level.Zero))) => true

fn openedBuilt(o: Opened, rest: Expr) -> Result<RB, Fail>
    ? "The declared body built under the variables and compared in full."
    r = isDefEq(o.st, o.t, Core.Subst.instantiate(rest, o.rev))?
    Result.Ok(RB(b = r.b, st = Check.State.closeVars(r.st, List.len(o.ids))))

verify openedBuilt
    resultBool(openedBuilt(Opened(t = Core.Exprs.sort(Level.Zero), rev = [], ids = [], st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.sort(Level.Zero))) => true
    resultBool(openedBuilt(Opened(t = Core.Exprs.sort(Level.Zero), rev = [], ids = [], st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.sort(Level.Succ(Level.Zero)))) => false

fn lamLoop(st: St, e: Expr, rev: List<Expr>, ids: List<Int>, only: Bool) -> Result<RE, Fail>
    ? "Opens nested lambdas with their variables, then infers the body and closes it as a pi."
    match e
        Expr.Lam(_, d, b) -> lamStep(st, Core.Names.anon(), Core.Subst.instantiate(d, rev), b, Binder.Default, rev, ids, only)
        _ -> lamEnd(st, e, rev, ids, only)

verify lamLoop
    resultExpr(lamLoop(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), [], [], false)) => Core.Exprs.pi(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Zero), Binder.Default)

fn lamStep(st: St, n: Name, d: Expr, b: Expr, bi: Binder, rev: List<Expr>, ids: List<Int>, only: Bool) -> Result<RE, Fail>
    ? "Checks the domain is a type, then declares the variable."
    st1 = domainChecked(st, d, only)?
    loc = Check.State.namesAt(st1, n, d, Option.None, bi)
    lamLoop(loc.st, b, List.prepend(loc.e, rev), List.prepend(fvarId(loc.e), ids), only)

verify lamStep
    lamStep(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.bvar(0), Core.Exprs.bvar(0), Binder.Default, [], [], false) => Result.Err(Fail.Reject("the type checker met a loose bound variable"))

fn domainChecked(st: St, d: Expr, only: Bool) -> Result<St, Fail>
    ? "In checking mode the domain must be a type."
    match only
        true -> Result.Ok(st)
        false -> sortStateOf(check(st, d)?)

verify domainChecked
    domainChecked(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), true) => Result.Ok(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe))

fn sortStateOf(t: RE) -> Result<St, Fail>
    ? "Requires a sort and keeps only the state."
    Result.Ok(ensureSort(t.st, t.e)?.st)

verify sortStateOf
    sortStateOf(RE(e = Core.Exprs.sort(Level.Zero), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe))) => Result.Ok(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe))

fn lamEnd(st: St, e: Expr, rev: List<Expr>, ids: List<Int>, only: Bool) -> Result<RE, Fail>
    ? "Infers the body under its variables and closes the type over them."
    r = bodyType(st, e, rev, List.len(ids), only)?
    closed = Check.State.mkBinding(r.st.lctx, List.reverse(ids), cheapBeta(r.e), false, false)
    Result.Ok(RE(e = closed, st = Check.State.closeVars(r.st, List.len(ids))))

verify lamEnd
    resultExpr(lamEnd(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), [], [], true)) => Core.Exprs.sort(Level.Succ(Level.Zero))

decision BodiesCopied
    date = "2026-10-26"
    reason =
        "Inferring a body under its variables as it is, instead of copying it"
        "with them put in (minst), was built and measured on the branch"
        "fable/open-inference (commits 6752eb3 and 7f19c39): the open-term"
        "cache keyed by the hash the term would have with its variables put"
        "in, found without putting them in (hashUnder, with a memo per scope),"
        "a hit confirmed through the variables (eqUnder, eqOpen), the"
        "environment a vector in the state, applications under variables"
        "checked as whole spines. It answers as the copying does (the Arena's"
        "171 small tests, 0 wrong) and costs far more: one worker on Aver"
        "02771bf5, etale 31.8 G to 59.0 G instructions, Init 78.5 G to"
        "190.8 G, perf/beta-ladder 0.62 G to 3.99 G, perf/app-lam 2.14 G to"
        "29.3 G. The type of an application needs its arguments closed"
        "wherever the function's type depends on them, so each such argument"
        "is put into its variables again at every application above it: on"
        "etale the arguments alone took 19.0 M nodes against the 5.6 M of the"
        "copied bodies, the whole check 44.4 M against 26.4 M; on Init 88.2 M"
        "against 17.5 M, and 142.6 M against 54.6 M. A memo of the"
        "copies per scope could bring that back to the bodies' count, not"
        "below it, and the keys, confirmations and variable spines cost about"
        "a tenth on top. Copying a body once makes every closed part of it"
        "shared by pointer from then on, which the caches and comparisons"
        "live on; what inference under the environment would save, the parts"
        "never needed closed, is less than that."
    chosen = "BodiesCopied"
    rejected = ["BodiesUnderVariables"]
    impacts = [bodyType, deepBody, minst]

fn bodyType(st: St, e: Expr, rev: List<Expr>, k: Int, only: Bool) -> Result<RE, Fail>
    ? "The type of a body under k binders just opened. While at most 128 binders are open around it, the body is copied with its variables put in and inferred as usual. Deeper than that it is inferred under its variables as it is: a body nested that deep would be copied once for every binder above it, and the copies of the levels above stay alive while the levels below are checked."
    was = st.open
    match was + k > 128
        true -> deepBody(st, e, rev, k, only)
        false -> openAgain(infer(St.update(st, open = was + k), minst(e, rev), only)?, was)

verify bodyType
    resultExpr(bodyType(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.natLit(1), [], 1, true)) => Core.Exprs.cnst(Check.Lits.name1("Nat"), [])

fn deepBody(st: St, e: Expr, rev: List<Expr>, k: Int, only: Bool) -> Result<RE, Fail>
    ? "A body inferred under its variables as it is. st.opened gets the k variables just opened, the outermost first, as arguments, one node each, and is put back after: around the first body this deep it holds no variable, so it always holds the variables of rev, the innermost last, after those of any closed term this stretch went into, which only make a key narrower. The open-term cache keys on it."
    was = st.open
    around = st.opened
    r = inferIn(St.update(st, open = was + k, opened = Core.Apps.mkApps(around, List.reverse(List.take(rev, k)))), e, rev, only)?
    Result.Ok(RE(e = r.e, st = St.update(r.st, open = was, opened = around)))

verify deepBody
    resultExpr(deepBody(Check.State.names(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.natLit(7), Option.None, Binder.Default).st, Core.Exprs.bvar(0), [Core.Exprs.fvar(1)], 1, false)) => Core.Exprs.natLit(7)

fn openAgain(r: RE, open: Int) -> Result<RE, Fail>
    ? "The count of open binders as it was before the body."
    Result.Ok(RE(e = r.e, st = St.update(r.st, open = open)))

verify openAgain
    resultExpr(openAgain(RE(e = Core.Exprs.natLit(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), 0)) => Core.Exprs.natLit(1)

fn piLoop(st: St, e: Expr, rev: List<Expr>, ids: List<Int>, us: List<Level>, only: Bool) -> Result<RE, Fail>
    ? "Opens nested pis collecting the domains' levels; the result is the imax of them all."
    match e
        Expr.Pi(_, d, b) -> piStep(st, Core.Names.anon(), Core.Subst.instantiate(d, rev), b, Binder.Default, rev, ids, us, only)
        _ -> piEnd(st, e, rev, us, only)

verify piLoop
    resultExpr(piLoop(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.pi(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Zero), Binder.Default), [], [], [], false)) => Core.Exprs.sort(Level.Succ(Level.Zero))

fn piStep(st: St, n: Name, d: Expr, b: Expr, bi: Binder, rev: List<Expr>, ids: List<Int>, us: List<Level>, only: Bool) -> Result<RE, Fail>
    ? "The domain's sort, then the variable for it."
    t = infer(st, d, only)?
    s = ensureSort(t.st, t.e)?
    loc = Check.State.namesAt(s.st, n, d, Option.None, bi)
    piLoop(loc.st, b, List.prepend(loc.e, rev), List.prepend(fvarId(loc.e), ids), List.prepend(sortLevel(s.e), us), only)

verify piStep
    piStep(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.bvar(0), Core.Exprs.bvar(0), Binder.Default, [], [], [], true) => Result.Err(Fail.Reject("the type checker met a loose bound variable"))

fn piEnd(st: St, e: Expr, rev: List<Expr>, us: List<Level>, only: Bool) -> Result<RE, Fail>
    ? "imax of the domain levels and the codomain's, inferred under the variables."
    t = bodyType(st, e, rev, List.len(us), only)?
    s = ensureSort(t.st, t.e)?
    Result.Ok(RE(e = Core.Exprs.sort(imaxFold(us, sortLevel(s.e))), st = Check.State.closeVars(s.st, List.len(us))))

verify piEnd
    resultExpr(piEnd(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), [], [Level.Zero], true)) => Core.Exprs.sort(Level.Succ(Level.Zero))

fn imaxFold(us: List<Level>, r: Level) -> Level
    ? "imax u_i r from the innermost domain out."
    match us
        [] -> r
        [u, ..rest] -> imaxFold(rest, Core.Univ.mkImax(u, r))

verify imaxFold
    imaxFold([Level.Succ(Level.Zero)], Level.Zero) => Level.Zero

fn inferApp(st: St, e: Expr, f: Expr, a: Expr, env: List<Expr>, only: Bool) -> Result<RE, Fail>
    ? "Inference walks the whole spine; so does checking, unless the term's bound variables stand for variables around it, where it checks one application at a time."
    match only
        false -> match env
            [] -> spineChecked(st, e)
            _ -> appChecked(st, f, a, env)
        true -> appSpine(st, e, env)

verify inferApp
    inferApp(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.natLit(1), Core.Exprs.natLit(2)), Core.Exprs.natLit(1), Core.Exprs.natLit(2), [], false) => Result.Err(Fail.Reject("function expected"))

fn appChecked(st: St, f: Expr, a: Expr, env: List<Expr>) -> Result<RE, Fail>
    ? "The argument's type must equal the function's domain."
    ft = inferIn(st, f, env, false)?
    p = ensurePi(ft.st, ft.e)?
    at = inferIn(p.st, a, env, false)?
    ok = defEqMaybeEager(at.st, at.e, domainOf(p.e), isEagerReduce(a))?
    match ok.b
        true -> Result.Ok(RE(e = argInto(bodyOf(p.e), a, env), st = ok.st))
        false -> Result.Err(bad("application type mismatch"))

verify appChecked
    appChecked(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Zero), []) => Result.Err(Fail.Reject("function expected"))

decision DomainsNotBuilt
    date = "2026-10-23"
    reason =
        "Checking an application one argument at a time put each argument"
        "into the whole rest of the function's type, to read the next domain"
        "off it: on qb9, 97% of the nodes argInto built were such rests, a"
        "quarter of all the nodes the checker built. Putting the arguments"
        "into each domain instead built as much. Now the spine is checked from"
        "its head: each argument's type is compared with its domain as the"
        "earlier arguments would make it, without building it (fitsUnder), and"
        "only a domain that is not met so is built and compared in full; the"
        "type of the whole application is built once. Nine comparisons in ten"
        "find the types the same."
    chosen = "DomainsNotBuilt"
    rejected = ["OneApplicationAtATime", "DomainsBuilt"]
    impacts = [spineChecked, argsChecked, fitsUnder]

fn spineChecked(st: St, e: Expr) -> Result<RE, Fail>
    ? "A closed application checked as a whole spine: the head, then each argument against its domain."
    ft = infer(st, Core.Apps.fnOf(e), false)?
    argsChecked(ft.st, ft.e, Core.Apps.argsOf(e), [])

verify spineChecked
    spineChecked(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.natLit(1), Core.Exprs.natLit(2))) => Result.Err(Fail.Reject("function expected"))

fn argsChecked(st: St, ft: Expr, args: List<Expr>, pending: List<Expr>) -> Result<RE, Fail>
    ? "pending holds the arguments checked and not yet put into ft, newest first. A type that is not syntactically a pi gets them first and is then normalized."
    match args
        [] -> Result.Ok(RE(e = argsInto(ft, pending, []), st = st))
        [x, ..rest] -> match ft
            Expr.Pi(_, d, b) -> argChecked(st, x, d, b, rest, pending)
            _ -> argsAfterWhnf(ensurePi(st, argsInto(ft, pending, []))?, args)

verify argsChecked
    resultExpr(argsChecked(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), [], [Core.Exprs.natLit(7)])) => Core.Exprs.natLit(7)

fn argChecked(st: St, x: Expr, d: Expr, b: Expr, rest: List<Expr>, pending: List<Expr>) -> Result<RE, Fail>
    ? "The argument's type must equal the domain with the arguments before it put in."
    at = infer(st, x, false)?
    ok = argFits(at.st, at.e, d, pending, x)?
    match ok.b
        true -> argsChecked(ok.st, b, rest, List.prepend(x, pending))
        false -> Result.Err(bad("application type mismatch"))

verify argChecked
    argChecked(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), [], []) => Result.Err(Fail.Reject("application type mismatch"))
    resultExpr(argChecked(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Succ(Level.Zero)), Core.Exprs.bvar(0), [], [])) => Core.Exprs.sort(Level.Zero)

fn argFits(st: St, at: Expr, d: Expr, pending: List<Expr>, x: Expr) -> Result<RB, Fail>
    ? "The argument's type against the domain: the same term as the domain would be with the arguments put in, found without building it; otherwise the domain is built and compared in full, eagerly for an eagerReduce argument."
    eager = isEagerReduce(x)
    match Bool.and(Bool.not(eager), fitsUnder(at, d, pending, 0))
        true -> Result.Ok(RB(b = true, st = st))
        false -> defEqMaybeEager(st, at, argsInto(d, pending, []), eager)

verify argFits
    resultBool(argFits(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.natLit(1), Core.Exprs.bvar(0), [Core.Exprs.natLit(1)], Core.Exprs.natLit(0))) => true

fn fitsUnder(t: Expr, d: Expr, subst: List<Expr>, off: Int) -> Bool
    ? "Whether t is d under off binders with its loose bound variables put in as argsInto puts closed arguments in (subst newest first, at index off and up), binder names and annotations aside. Parts of d the substitution does not reach are compared as they are. Small domains only: a large one, which may share parts, is left to be built."
    match Core.Exprs.within(d, off)
        true -> sameTerm(t, d)
        false -> match Core.Exprs.treeSize(d) < 63
            false -> false
            true -> fitsNode(t, d, subst, off)

verify fitsUnder
    fitsUnder(Core.Exprs.app(Core.Exprs.natLit(1), Core.Exprs.natLit(2)), Core.Exprs.app(Core.Exprs.natLit(1), Core.Exprs.bvar(0)), [Core.Exprs.natLit(2)], 0) => true
    fitsUnder(Core.Exprs.app(Core.Exprs.natLit(1), Core.Exprs.natLit(3)), Core.Exprs.app(Core.Exprs.natLit(1), Core.Exprs.bvar(0)), [Core.Exprs.natLit(2)], 0) => false
    fitsUnder(Core.Exprs.natLit(5), Core.Exprs.bvar(1), [Core.Exprs.natLit(4), Core.Exprs.natLit(5)], 0) => true
    fitsUnder(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.natLit(2), Core.Exprs.bvar(0), Binder.Default), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.bvar(0), Core.Exprs.bvar(0), Binder.Default), [Core.Exprs.natLit(2)], 0) => true

verify fitsUnder law sameAsBuilt
    given i: Int = [0, 1, 2]
    given j: Int = [0, 1, 2]
    fitsUnder(Core.Subst.instantiate(fitSample(i), [Core.Exprs.natLit(7), Core.Exprs.fvar(3)]), fitSample(j), [Core.Exprs.natLit(7), Core.Exprs.fvar(3)], 0) => Core.Subst.instantiate(fitSample(i), [Core.Exprs.natLit(7), Core.Exprs.fvar(3)]) == Core.Subst.instantiate(fitSample(j), [Core.Exprs.natLit(7), Core.Exprs.fvar(3)])

fn fitsWithin(t: Expr, d: Expr, subst: List<Expr>, off: Int, left: Int) -> Int
    ? "fitsUnder with a budget of nodes of d visited instead of a limit on d's size: what is left of the budget when t is d with subst put in, or -1 when it is not or the budget runs out, as it may on a domain that shares parts."
    match left <= 0
        true -> -1
        false -> match Core.Exprs.within(d, off)
            true -> match sameTerm(t, d)
                true -> left - 1
                false -> -1
            false -> fitsWithinNode(t, d, subst, off, left - 1)

verify fitsWithin
    fitsWithin(Core.Exprs.app(Core.Exprs.natLit(1), Core.Exprs.natLit(2)), Core.Exprs.app(Core.Exprs.natLit(1), Core.Exprs.bvar(0)), [Core.Exprs.natLit(2)], 0, 10) >= 0 => true
    fitsWithin(Core.Exprs.app(Core.Exprs.natLit(1), Core.Exprs.natLit(3)), Core.Exprs.app(Core.Exprs.natLit(1), Core.Exprs.bvar(0)), [Core.Exprs.natLit(2)], 0, 10) => -1
    fitsWithin(Core.Exprs.app(Core.Exprs.natLit(1), Core.Exprs.natLit(2)), Core.Exprs.app(Core.Exprs.natLit(1), Core.Exprs.bvar(0)), [Core.Exprs.natLit(2)], 0, 1) => -1

fn fitsWithinNode(t: Expr, d: Expr, subst: List<Expr>, off: Int, left: Int) -> Int
    ? "fitsWithin one node of d down, as fitsNode, the budget passed from part to part."
    match d
        Expr.BVar(i) -> match fitsVar(t, i, subst, off)
            true -> left
            false -> -1
        Expr.App(_, f, a) -> match t
            Expr.App(_, g, b) -> fitsWithin(b, a, subst, off, fitsWithin(g, f, subst, off, left))
            _ -> -1
        Expr.Lam(_, dt, db) -> match t
            Expr.Lam(_, tt, tb) -> fitsWithin(tb, db, subst, off + 1, fitsWithin(tt, dt, subst, off, left))
            _ -> -1
        Expr.Pi(_, dt, db) -> match t
            Expr.Pi(_, tt, tb) -> fitsWithin(tb, db, subst, off + 1, fitsWithin(tt, dt, subst, off, left))
            _ -> -1
        Expr.Let(_, dt, dv, db) -> match t
            Expr.Let(_, tt, tv, tb) -> fitsWithin(tb, db, subst, off + 1, fitsWithin(tv, dv, subst, off, fitsWithin(tt, dt, subst, off, left)))
            _ -> -1
        Expr.Proj(_, s, i, dx) -> match t
            Expr.Proj(_, s2, i2, tx) -> match Bool.and(s == s2, i == i2)
                true -> fitsWithin(tx, dx, subst, off, left)
                false -> -1
            _ -> -1
        _ -> -1

verify fitsWithinNode
    fitsWithinNode(Core.Exprs.natLit(1), Core.Exprs.natLit(1), [], 0, 5) => -1

fn fitSample(k: Int) -> Expr
    ? "Domains for the law: bound variables in head, argument and binder position."
    match k
        0 -> Core.Exprs.app(Core.Exprs.bvar(0), Core.Exprs.bvar(1))
        1 -> Core.Exprs.app(Core.Exprs.bvar(1), Core.Exprs.bvar(0))
        _ -> Core.Exprs.pi(Core.Names.anon(), Core.Exprs.bvar(1), Core.Exprs.app(Core.Exprs.bvar(0), Core.Exprs.bvar(2)), Binder.Default)

verify fitSample
    fitSample(0) == fitSample(1) => false

fn fitsNode(t: Expr, d: Expr, subst: List<Expr>, off: Int) -> Bool
    ? "fitsUnder one node of d down: a bound variable takes its argument or drops by the substitution's length, a compound node compares its parts."
    match d
        Expr.BVar(i) -> fitsVar(t, i, subst, off)
        Expr.App(_, f, a) -> match t
            Expr.App(_, g, b) -> Bool.and(fitsUnder(g, f, subst, off), fitsUnder(b, a, subst, off))
            _ -> false
        Expr.Lam(_, dt, db) -> match t
            Expr.Lam(_, tt, tb) -> Bool.and(fitsUnder(tt, dt, subst, off), fitsUnder(tb, db, subst, off + 1))
            _ -> false
        Expr.Pi(_, dt, db) -> match t
            Expr.Pi(_, tt, tb) -> Bool.and(fitsUnder(tt, dt, subst, off), fitsUnder(tb, db, subst, off + 1))
            _ -> false
        Expr.Let(_, dt, dv, db) -> match t
            Expr.Let(_, tt, tv, tb) -> Bool.and(Bool.and(fitsUnder(tt, dt, subst, off), fitsUnder(tv, dv, subst, off)), fitsUnder(tb, db, subst, off + 1))
            _ -> false
        Expr.Proj(_, s, i, dx) -> match t
            Expr.Proj(_, s2, i2, tx) -> Bool.and(Bool.and(s == s2, i == i2), fitsUnder(tx, dx, subst, off))
            _ -> false
        _ -> false

verify fitsNode
    fitsNode(Core.Exprs.natLit(1), Core.Exprs.natLit(1), [], 0) => false

fn fitsVar(t: Expr, i: Int, subst: List<Expr>, off: Int) -> Bool
    ? "A bound variable of d past off: an argument, closed, so it needs no lifting; past the arguments it drops by their number."
    match i - off < List.len(subst)
        true -> sameTerm(t, nth(subst, i - off))
        false -> t == Core.Exprs.bvar(i - List.len(subst))

verify fitsVar
    fitsVar(Core.Exprs.natLit(4), 0, [Core.Exprs.natLit(4)], 0) => true
    fitsVar(Core.Exprs.bvar(1), 2, [Core.Exprs.natLit(4)], 0) => true

fn argsAfterWhnf(p: RE, args: List<Expr>) -> Result<RE, Fail>
    ? "Goes on with the normalized pi; every argument before is in it."
    argsChecked(p.st, p.e, args, [])

verify argsAfterWhnf
    resultExpr(argsAfterWhnf(RE(e = Core.Exprs.natLit(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), [])) => Core.Exprs.natLit(1)

fn argInto(body: Expr, a: Expr, env: List<Expr>) -> Expr
    ? "The pi's body with the argument put in. Only then, when the body uses it, does the argument get its own variables put in."
    match Core.Exprs.isClosed(body)
        true -> body
        false -> Core.Subst.instantiate1(body, minst(a, env))

verify argInto
    argInto(Core.Exprs.natLit(1), Core.Exprs.bvar(0), [Core.Exprs.fvar(2)]) => Core.Exprs.natLit(1)
    argInto(Core.Exprs.bvar(0), Core.Exprs.bvar(0), [Core.Exprs.fvar(2)]) => Core.Exprs.fvar(2)

fn isEagerReduce(a: Expr) -> Bool
    ? "An argument of the form eagerReduce _ _."
    Bool.and(Core.Apps.isConst(Core.Apps.fnOf(a), Check.Lits.eagerReduce), Core.Apps.numArgs(a) == 2)

verify isEagerReduce
    isEagerReduce(Core.Exprs.bvar(0)) => false

fn defEqMaybeEager(st: St, x: Expr, y: Expr, eager: Bool) -> Result<RB, Fail>
    ? "Definitional equality, in eager mode when asked; the mode is restored after."
    was = st.eager
    match eager
        false -> isDefEq(st, x, y)
        true -> restoreEager(isDefEq(St.update(st, eager = true), x, y)?, was)

verify defEqMaybeEager
    resultBool(defEqMaybeEager(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), Core.Exprs.bvar(0), true)) => true

fn restoreEager(r: RB, eager: Bool) -> Result<RB, Fail>
    ? "Puts the eager flag back."
    Result.Ok(RB(b = r.b, st = St.update(r.st, eager = eager)))

verify restoreEager
    resultBool(restoreEager(RB(b = true, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), false)) => true

fn appSpine(st: St, e: Expr, env: List<Expr>) -> Result<RE, Fail>
    ? "Infers f's type and peels one pi per argument, normalizing only when needed."
    ft = inferIn(st, Core.Apps.fnOf(e), env, true)?
    appWalk(ft.st, ft.e, Core.Apps.argsOf(e), [], env)

verify appSpine
    appSpine(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.natLit(1), Core.Exprs.natLit(2)), []) => Result.Err(Fail.Reject("function expected"))

fn appWalk(st: St, ft: Expr, args: List<Expr>, pending: List<Expr>, env: List<Expr>) -> Result<RE, Fail>
    ? "pending holds the arguments not yet substituted, newest first."
    match args
        [] -> Result.Ok(RE(e = argsInto(ft, pending, env), st = st))
        [x, ..rest] -> match ft
            Expr.Pi(_, _, b) -> appWalk(st, b, rest, List.prepend(x, pending), env)
            _ -> appWalkWhnf(st, argsInto(ft, pending, env), x, rest, env)

verify appWalk
    resultExpr(appWalk(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.pi(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), [Core.Exprs.natLit(1)], [], [])) => Core.Exprs.natLit(1)

fn appWalkWhnf(st: St, ft: Expr, x: Expr, rest: List<Expr>, env: List<Expr>) -> Result<RE, Fail>
    ? "The function type was not syntactically a pi: normalize it."
    p = ensurePi(st, ft)?
    appWalk(p.st, bodyOf(p.e), rest, [x], env)

verify appWalkWhnf
    appWalkWhnf(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), Core.Exprs.natLit(1), [], []) => Result.Err(Fail.Reject("function expected"))

fn argsInto(ft: Expr, pending: List<Expr>, env: List<Expr>) -> Expr
    ? "The walked pis' body with the arguments put in. Only then, when the body uses some, do the arguments get their own variables put in."
    match Core.Exprs.isClosed(ft)
        true -> ft
        false -> Core.Subst.instantiate(ft, minstAll(pending, env))

verify argsInto
    argsInto(Core.Exprs.bvar(1), [Core.Exprs.bvar(0), Core.Exprs.natLit(3)], [Core.Exprs.fvar(2)]) => Core.Exprs.natLit(3)
    argsInto(Core.Exprs.bvar(0), [Core.Exprs.bvar(0), Core.Exprs.natLit(3)], [Core.Exprs.fvar(2)]) => Core.Exprs.fvar(2)

fn minstAll(xs: List<Expr>, env: List<Expr>) -> List<Expr>
    ? "minst on each."
    match env
        [] -> xs
        _ -> minstEach(xs, env)

verify minstAll
    minstAll([Core.Exprs.bvar(0)], []) => [Core.Exprs.bvar(0)]

fn minstEach(xs: List<Expr>, env: List<Expr>) -> List<Expr>
    ? "Puts env's values in each term, keeping the order."
    match xs
        [] -> []
        [x, ..rest] -> List.prepend(Core.Subst.instantiate(x, env), minstEach(rest, env))

verify minstEach
    minstEach([Core.Exprs.bvar(0), Core.Exprs.natLit(1)], [Core.Exprs.fvar(4)]) => [Core.Exprs.fvar(4), Core.Exprs.natLit(1)]

fn letLoop(st: St, e: Expr, rev: List<Expr>, ids: List<Int>, only: Bool) -> Result<RE, Fail>
    ? "Opens nested lets as let variables, then infers the body."
    match e
        Expr.Let(_, t, v, b) -> letStep(st, Core.Names.anon(), Core.Subst.instantiate(t, rev), Core.Subst.instantiate(v, rev), b, rev, ids, only)
        _ -> letEnd(st, e, rev, ids, only)

verify letLoop
    resultExpr(letLoop(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.letE(Core.Names.anon(), Core.Exprs.sort(Level.Succ(Level.Zero)), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0)), [], [], false)) => Core.Exprs.sort(Level.Succ(Level.Zero))

fn letStep(st: St, n: Name, t: Expr, v: Expr, b: Expr, rev: List<Expr>, ids: List<Int>, only: Bool) -> Result<RE, Fail>
    ? "Checks the let's type and value, then declares it."
    st1 = letChecked(st, t, v, only)?
    loc = Check.State.namesAt(st1, n, t, Option.Some(v), Binder.Default)
    letLoop(loc.st, b, List.prepend(loc.e, rev), List.prepend(fvarId(loc.e), ids), only)

verify letStep
    letStep(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), [], [], false) => Result.Err(Fail.Reject("let value type mismatch"))

fn letChecked(st: St, t: Expr, v: Expr, only: Bool) -> Result<St, Fail>
    ? "The type is a type and the value has it."
    match only
        true -> Result.Ok(st)
        false -> letValue(sortStateOf(check(st, t)?)?, t, v)

verify letChecked
    letChecked(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), Core.Exprs.bvar(0), true) => Result.Ok(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe))

fn letValue(st: St, t: Expr, v: Expr) -> Result<St, Fail>
    ? "The value's type must equal the declared type."
    vt = check(st, v)?
    eq = isDefEq(vt.st, vt.e, t)?
    match eq.b
        true -> Result.Ok(eq.st)
        false -> Result.Err(bad("let value type mismatch"))

verify letValue
    letValue(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Zero)) => Result.Err(Fail.Reject("let value type mismatch"))

fn letEnd(st: St, e: Expr, rev: List<Expr>, ids: List<Int>, only: Bool) -> Result<RE, Fail>
    ? "Infers the body under its variables and closes the type with the lets it still uses."
    r = bodyType(st, e, rev, List.len(ids), only)?
    closed = Check.State.mkBinding(r.st.lctx, List.reverse(ids), cheapBeta(r.e), false, true)
    Result.Ok(RE(e = closed, st = Check.State.closeVars(r.st, List.len(ids))))

verify letEnd
    resultExpr(letEnd(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), [], [], true)) => Core.Exprs.sort(Level.Succ(Level.Zero))

fn cheapBeta(e: Expr) -> Expr
    ? "Beta reduces a head lambda only when the result needs no substitution."
    match Core.Apps.fnOf(e)
        Expr.Lam -> cheapPeel(e, Core.Apps.fnOf(e), Core.Apps.argsOf(e), 0)
        _ -> e

verify cheapBeta
    cheapBeta(Core.Exprs.app(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Zero), Binder.Default), Core.Exprs.natLit(1))) => Core.Exprs.sort(Level.Zero)
    cheapBeta(Core.Exprs.app(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Core.Exprs.natLit(1))) => Core.Exprs.natLit(1)

fn cheapPeel(e: Expr, f: Expr, args: List<Expr>, i: Int) -> Expr
    ? "Skips as many lambdas as there are arguments."
    match f
        Expr.Lam(_, _, b) -> match i < List.len(args)
            true -> cheapPeel(e, b, args, i + 1)
            false -> cheapDone(e, f, args, i)
        _ -> cheapDone(e, f, args, i)

verify cheapPeel
    cheapPeel(Core.Exprs.bvar(0), Core.Exprs.sort(Level.Zero), [], 0) => Core.Exprs.sort(Level.Zero)

fn cheapDone(e: Expr, f: Expr, args: List<Expr>, i: Int) -> Expr
    ? "A closed body, or a body that is one of the bound variables."
    match Core.Exprs.isClosed(f)
        true -> Core.Apps.mkApps(f, List.drop(args, i))
        false -> match f
            Expr.BVar(j) -> Core.Apps.mkApps(nth(args, i - j - 1), List.drop(args, i))
            _ -> e

verify cheapDone
    cheapDone(Core.Exprs.bvar(9), Core.Exprs.bvar(0), [Core.Exprs.natLit(5)], 1) => Core.Exprs.natLit(5)

fn nth(xs: List<Expr>, k: Int) -> Expr
    ? "The k-th element; callers keep k in range."
    match List.drop(xs, k)
        [x, .._] -> x
        [] -> Core.Exprs.bvar(0)

verify nth
    nth([Core.Exprs.natLit(1)], 0) => Core.Exprs.natLit(1)

fn ensureSort(st: St, e: Expr) -> Result<RE, Fail>
    ? "e as a sort, normalizing if needed."
    match e
        Expr.Sort -> Result.Ok(RE(e = e, st = st))
        _ -> sortAfterWhnf(whnf(st, e)?)

verify ensureSort
    ensureSort(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.natLit(1)) => Result.Err(Fail.Reject("type expected"))

fn sortAfterWhnf(w: RE) -> Result<RE, Fail>
    ? "The normal form must be a sort."
    match w.e
        Expr.Sort -> Result.Ok(w)
        _ -> Result.Err(bad("type expected"))

verify sortAfterWhnf
    sortAfterWhnf(RE(e = Core.Exprs.natLit(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe))) => Result.Err(Fail.Reject("type expected"))

fn ensurePi(st: St, e: Expr) -> Result<RE, Fail>
    ? "e as a pi, normalizing if needed."
    match e
        Expr.Pi -> Result.Ok(RE(e = e, st = st))
        _ -> piAfterWhnf(whnf(st, e)?)

verify ensurePi
    ensurePi(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.natLit(1)) => Result.Err(Fail.Reject("function expected"))

fn piAfterWhnf(w: RE) -> Result<RE, Fail>
    ? "The normal form must be a pi."
    match w.e
        Expr.Pi -> Result.Ok(w)
        _ -> Result.Err(bad("function expected"))

verify piAfterWhnf
    piAfterWhnf(RE(e = Core.Exprs.natLit(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe))) => Result.Err(Fail.Reject("function expected"))

fn isProp(st: St, e: Expr) -> Result<RB, Fail>
    ? "Whether e is a proposition: its type is a sort whose level is zero up to normalization."
    t = inferType(st, e)?
    s = ensureSort(t.st, t.e)?
    Result.Ok(RB(b = Core.Univ.normalizesToZero(sortLevel(s.e)), st = s.st))

verify isProp
    resultBool(isProp(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero))) => false

fn badProj() -> Fail
    ? "The one error every malformed projection gives."
    Fail.Reject("invalid projection")

verify badProj
    badProj() => Fail.Reject("invalid projection")

fn inferProj(st: St, s: Name, idx: Int, x: Expr, env: List<Expr>, only: Bool) -> Result<RE, Fail>
    ? "x.idx where x's type is the structure s applied to its parameters; the field types may mention x, so it gets its variables put in."
    t = inferIn(st, x, env, only)?
    w = whnf(t.st, t.e)?
    projFrom(w.st, s, idx, minst(x, env), w.e, Core.Apps.fnOf(w.e), Core.Apps.argsOf(w.e))

verify inferProj
    inferProj(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Names.anon(), 0, Core.Exprs.natLit(1), [], true) => Result.Err(Fail.Reject("invalid projection"))

fn projFrom(st: St, s: Name, idx: Int, x: Expr, ty: Expr, head: Expr, args: List<Expr>) -> Result<RE, Fail>
    ? "The type's head must be the projection's structure."
    match head
        Expr.Const(_, n, ls) -> match n == s
            true -> projInduct(st, idx, x, ty, ls, args, Check.State.lookup(st, n))
            false -> Result.Err(badProj())
        _ -> Result.Err(badProj())

verify projFrom
    projFrom(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Names.anon(), 0, Core.Exprs.natLit(1), Core.Exprs.bvar(0), Core.Exprs.bvar(0), []) => Result.Err(Fail.Reject("invalid projection"))

fn projInduct(st: St, idx: Int, x: Expr, ty: Expr, ls: List<Level>, args: List<Expr>, c: Option<Const>) -> Result<RE, Fail>
    ? "A structure: one constructor, fully applied to parameters and indices."
    match c
        Option.Some(Const.CInduct(iv)) -> match iv.ctors
            [k] -> match List.len(args) == iv.numParams + iv.numIndices
                true -> projCtor(st, idx, x, ty, ls, List.take(args, iv.numParams), iv.head.name, Check.State.lookup(st, k))
                false -> Result.Err(badProj())
            _ -> Result.Err(badProj())
        _ -> Result.Err(badProj())

verify projInduct
    projInduct(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), 0, Core.Exprs.natLit(1), Core.Exprs.bvar(0), [], [], Option.None) => Result.Err(Fail.Reject("invalid projection"))

fn projCtor(st: St, idx: Int, x: Expr, ty: Expr, ls: List<Level>, params: List<Expr>, sname: Name, c: Option<Const>) -> Result<RE, Fail>
    ? "Walks the constructor type past the parameters and the earlier fields."
    match c
        Option.Some(Const.CCtor(k)) -> projWalk(st, idx, x, ty, sname, Core.Subst.instLevelParams(k.head.ty, k.head.params, ls), params)
        _ -> Result.Err(badProj())

verify projCtor
    projCtor(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), 0, Core.Exprs.natLit(1), Core.Exprs.bvar(0), [], [], Core.Names.anon(), Option.None) => Result.Err(Fail.Reject("invalid projection"))

fn projWalk(st: St, idx: Int, x: Expr, ty: Expr, sname: Name, r: Expr, params: List<Expr>) -> Result<RE, Fail>
    ? "Parameters, then fields, then the field's own type."
    p = projParams(st, r, params)?
    pp = isProp(p.st, ty)?
    f = projFields(pp.st, p.e, sname, x, 0, idx, pp.b)?
    w = whnf(f.st, f.e)?
    match w.e
        Expr.Pi(_, d, _) -> projResult(w.st, d, pp.b)
        _ -> Result.Err(badProj())

verify projWalk
    projWalk(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), 0, Core.Exprs.natLit(1), Core.Exprs.sort(Level.Zero), Core.Names.anon(), Core.Exprs.sort(Level.Zero), []) => Result.Err(Fail.Reject("invalid projection"))

fn projParams(st: St, r: Expr, params: List<Expr>) -> Result<RE, Fail>
    ? "Instantiates the constructor's parameter binders."
    match params
        [] -> Result.Ok(RE(e = r, st = st))
        [p, ..rest] -> projParam(whnf(st, r)?, p, rest)

verify projParams
    resultExpr(projParams(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), [])) => Core.Exprs.bvar(0)

fn projParam(w: RE, p: Expr, rest: List<Expr>) -> Result<RE, Fail>
    ? "One parameter binder."
    match w.e
        Expr.Pi(_, _, b) -> projParams(w.st, Core.Subst.instantiate1(b, p), rest)
        _ -> Result.Err(badProj())

verify projParam
    projParam(RE(e = Core.Exprs.natLit(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.natLit(1), []) => Result.Err(Fail.Reject("invalid projection"))

fn projFields(st: St, r: Expr, sname: Name, x: Expr, i: Int, idx: Int, propType: Bool) -> Result<RE, Fail>
    ? "Earlier fields are replaced by projections of x; out of a proof only proofs may be projected."
    match i >= idx
        true -> Result.Ok(RE(e = r, st = st))
        false -> projField(whnf(st, r)?, sname, x, i, idx, propType)

verify projFields
    resultExpr(projFields(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), Core.Names.anon(), Core.Exprs.bvar(0), 0, 0, false)) => Core.Exprs.bvar(0)

fn projField(w: RE, sname: Name, x: Expr, i: Int, idx: Int, propType: Bool) -> Result<RE, Fail>
    ? "One earlier field."
    match w.e
        Expr.Pi(_, d, b) -> match Core.Exprs.looseRange(b) > 0
            true -> projDependent(w.st, d, b, sname, x, i, idx, propType)
            false -> projFields(w.st, b, sname, x, i + 1, idx, propType)
        _ -> Result.Err(badProj())

verify projField
    projField(RE(e = Core.Exprs.natLit(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Names.anon(), Core.Exprs.bvar(0), 0, 1, false) => Result.Err(Fail.Reject("invalid projection"))

fn projDependent(st: St, d: Expr, b: Expr, sname: Name, x: Expr, i: Int, idx: Int, propType: Bool) -> Result<RE, Fail>
    ? "A field later fields depend on."
    match propType
        false -> projFields(st, Core.Subst.instantiate1(b, Core.Exprs.proj(sname, i, x)), sname, x, i + 1, idx, propType)
        true -> projDependentProp(isProp(st, d)?, b, sname, x, i, idx)

verify projDependent
    resultExpr(projDependent(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), Core.Exprs.bvar(0), Core.Names.anon(), Core.Exprs.bvar(0), 0, 1, false)) => Core.Exprs.proj(Core.Names.anon(), 0, Core.Exprs.bvar(0))

fn projDependentProp(p: RB, b: Expr, sname: Name, x: Expr, i: Int, idx: Int) -> Result<RE, Fail>
    ? "Out of a proof, a field later fields depend on must be a proof too."
    match p.b
        true -> projFields(p.st, Core.Subst.instantiate1(b, Core.Exprs.proj(sname, i, x)), sname, x, i + 1, idx, true)
        false -> Result.Err(badProj())

verify projDependentProp
    projDependentProp(RB(b = false, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.bvar(0), Core.Names.anon(), Core.Exprs.bvar(0), 0, 1) => Result.Err(Fail.Reject("invalid projection"))

fn projResult(st: St, d: Expr, propType: Bool) -> Result<RE, Fail>
    ? "The field's type; out of a proof it must be a proposition."
    match propType
        false -> Result.Ok(RE(e = d, st = st))
        true -> projResultProp(isProp(st, d)?, d)

verify projResult
    resultExpr(projResult(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), false)) => Core.Exprs.bvar(0)

fn projResultProp(p: RB, d: Expr) -> Result<RE, Fail>
    ? "Only a proposition may be projected out of a proof."
    match p.b
        true -> Result.Ok(RE(e = d, st = p.st))
        false -> Result.Err(badProj())

verify projResultProp
    projResultProp(RB(b = false, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.bvar(0)) => Result.Err(Fail.Reject("invalid projection"))

decision StateOwnedThroughWhnfCore
    date = "2026-10-29"
    reason =
        "whnfCore went to letVar for a free variable and letVar back to"
        "whnfCore for its value. The compiled mutual tail call held the state"
        "behind a reference, as it passed it on unchanged, so every way out"
        "copied the whole state: a new box and a count raised on each of its"
        "maps, on one of the most frequent calls. A let variable's chain of"
        "values is now followed in the local context alone (letChain), and"
        "whnfCore calls headCore once, with the state its own."
    chosen = "StateOwnedThroughWhnfCore"
    rejected = ["LetVarMutual"]
    impacts = [whnfCore, letChain, headCore]

fn whnfCore(st: St, e: Expr, cheapRec: Bool, cheapProj: Bool) -> Result<RE, Fail>
    ? "Beta, zeta, iota, quotient and projection reduction at the head, without unfolding definitions. A let variable is first replaced by the end of its chain of values (StateOwnedThroughWhnfCore)."
    match e
        Expr.FVar -> headCore(st, letChain(st.lctx, e), cheapRec, cheapProj)
        _ -> headCore(st, e, cheapRec, cheapProj)

verify whnfCore
    resultExpr(whnfCore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Core.Exprs.natLit(3)), false, false)) => Core.Exprs.natLit(3)
    resultExpr(whnfCore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.letE(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.natLit(1), Core.Exprs.bvar(0)), false, false)) => Core.Exprs.natLit(1)

fn rigidHead(st: St, f: Expr) -> Bool
    ? "A head under which whnfCore can do nothing: a constant that is neither a recursor nor part of the quotient package, a free variable without a let value, a sort, a pi or a literal. An application with such a head is its own whnfCore, so it skips the cache."
    match f
        Expr.Const(_, n, _) -> match Check.State.lookup(st, n)
            Option.Some(Const.CRec) -> false
            Option.Some(Const.CQuot) -> false
            _ -> true
        Expr.FVar(id) -> Check.State.localValue(st.lctx, id) == Option.None
        Expr.Sort -> true
        Expr.Pi -> true
        Expr.NatLit -> true
        Expr.StrLit -> true
        _ -> false

verify rigidHead
    rigidHead(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Core.Names.anon(), [])) => true
    rigidHead(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0)) => true
    rigidHead(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default)) => false
    rigidHead(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.proj(Core.Names.anon(), 0, Core.Exprs.fvar(0))) => false

fn letChain(lctx: Locals, e: Expr) -> Expr
    ? "A let variable's value, and that value's value while it is a let variable too: the first term on the chain that is not a let variable."
    match e
        Expr.FVar(id) -> match Check.State.localValue(lctx, id)
            Option.Some(x) -> letChain(lctx, x)
            Option.None -> e
        _ -> e

verify letChain
    letChain(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe).lctx, Core.Exprs.fvar(0)) => Core.Exprs.fvar(0)
    letChain(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe).lctx, Core.Exprs.natLit(2)) => Core.Exprs.natLit(2)

fn headCore(st: St, e: Expr, cheapRec: Bool, cheapProj: Bool) -> Result<RE, Fail>
    ? "whnfCore of a term that is not a let variable: an application under a rigid head is its own, a let, a projection or another application goes through the cache, and anything else is already in whnfCore."
    match e
        Expr.App -> match rigidHead(st, Core.Apps.fnOf(e))
            true -> Result.Ok(RE(e = e, st = st))
            false -> coreCached(st, e, cheapRec, cheapProj)
        Expr.Let -> coreCached(st, e, cheapRec, cheapProj)
        Expr.Proj -> coreCached(st, e, cheapRec, cheapProj)
        _ -> Result.Ok(RE(e = e, st = st))

verify headCore
    resultExpr(headCore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0), false, false)) => Core.Exprs.fvar(0)

fn coreCached(st: St, e: Expr, cheapRec: Bool, cheapProj: Bool) -> Result<RE, Fail>
    ? "Looks in the cache; only full (non-cheap) results are stored."
    match Check.State.cacheGet(st.coreCache, e)
        Option.Some(r) -> Result.Ok(RE(e = r, st = st))
        Option.None -> coreStore(coreWork(st, e, cheapRec, cheapProj)?, e, Bool.or(cheapRec, cheapProj))

verify coreCached
    resultExpr(coreCached(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.proj(Core.Names.anon(), 0, Core.Exprs.bvar(0)), false, true)) => Core.Exprs.proj(Core.Names.anon(), 0, Core.Exprs.bvar(0))

fn coreStore(r: RE, e: Expr, cheap: Bool) -> Result<RE, Fail>
    ? "Caches a full whnfCore result."
    match cheap
        true -> Result.Ok(r)
        false -> Result.Ok(RE(e = r.e, st = St.update(r.st, coreCache = Check.State.cachePut(r.st.coreCache, e, r.e))))

verify coreStore
    Core.Cache.size(coreStore(RE(e = Core.Exprs.bvar(0), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.bvar(1), false)?.st.coreCache) => 1

fn coreWork(st: St, e: Expr, cheapRec: Bool, cheapProj: Bool) -> Result<RE, Fail>
    ? "One whnfCore step by shape."
    match e
        Expr.App -> coreApp(st, e, Core.Apps.fnOf(e), Core.Apps.argsOf(e), cheapRec, cheapProj)
        Expr.Let(_, _, v, b) -> whnfCore(st, Core.Subst.instantiate1(b, v), cheapRec, cheapProj)
        Expr.Proj(_, s, i, x) -> coreProj(st, e, s, i, x, cheapRec, cheapProj)
        _ -> Result.Ok(RE(e = e, st = st))

verify coreWork
    resultExpr(coreWork(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), false, false)) => Core.Exprs.bvar(0)

fn coreApp(st: St, e: Expr, f0: Expr, args: List<Expr>, cheapRec: Bool, cheapProj: Bool) -> Result<RE, Fail>
    ? "Reduces the head; a lambda head is beta reduced, an unchanged head tries the recursor rules."
    f = whnfCore(st, f0, cheapRec, cheapProj)?
    match f.e
        Expr.Lam -> whnfCore(f.st, beta(f.e, args, []), cheapRec, cheapProj)
        _ -> match f.e == f0
            true -> coreRec(f.st, e, cheapRec, cheapProj)
            false -> whnfCore(f.st, Core.Apps.mkApps(f.e, args), cheapRec, cheapProj)

verify coreApp
    resultExpr(coreApp(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.natLit(1)), Core.Exprs.fvar(0), [Core.Exprs.natLit(1)], false, false)) => Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.natLit(1))

fn beta(f: Expr, args: List<Expr>, consumed: List<Expr>) -> Expr
    ? "Consumes one argument per lambda; consumed is newest first."
    match f
        Expr.Lam(_, _, b) -> match args
            [a, ..rest] -> beta(b, rest, List.prepend(a, consumed))
            [] -> Core.Subst.instantiate(f, consumed)
        _ -> Core.Apps.mkApps(Core.Subst.instantiate(f, consumed), args)

verify beta
    beta(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(1), Binder.Default), Binder.Default), [Core.Exprs.natLit(1), Core.Exprs.natLit(2), Core.Exprs.natLit(3)], []) => Core.Exprs.app(Core.Exprs.natLit(1), Core.Exprs.natLit(3))

fn coreRec(st: St, e: Expr, cheapRec: Bool, cheapProj: Bool) -> Result<RE, Fail>
    ? "Recursor and quotient rules; reduces on if one fires."
    r = reduceRecursor(st, e, cheapRec, cheapProj)?
    match r.o
        Option.Some(x) -> whnfCore(r.st, x, cheapRec, cheapProj)
        Option.None -> Result.Ok(RE(e = e, st = r.st))

verify coreRec
    resultExpr(coreRec(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0), false, false)) => Core.Exprs.fvar(0)

fn coreProj(st: St, e: Expr, s: Name, i: Int, x: Expr, cheapRec: Bool, cheapProj: Bool) -> Result<RE, Fail>
    ? "A projection of a constructor application reduces to the field."
    r = reduceProj(st, s, i, x, cheapRec, cheapProj)?
    match r.o
        Option.Some(m) -> whnfCore(r.st, m, cheapRec, cheapProj)
        Option.None -> Result.Ok(RE(e = e, st = r.st))

verify coreProj
    resultExpr(coreProj(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), Core.Names.anon(), 0, Core.Exprs.fvar(0), false, true)) => Core.Exprs.bvar(0)

fn reduceProj(st: St, s: Name, i: Int, x: Expr, cheapRec: Bool, cheapProj: Bool) -> Result<RO, Fail>
    ? "Normalizes the structure (cheaply when asked) and picks the field."
    c = majorOfProj(st, x, cheapRec, cheapProj)?
    Result.Ok(RO(o = projCore(c.st, c.e, s, i), st = c.st))

verify reduceProj
    resultOpt(reduceProj(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Names.anon(), 0, Core.Exprs.fvar(0), false, true)) => Option.None

fn majorOfProj(st: St, x: Expr, cheapRec: Bool, cheapProj: Bool) -> Result<RE, Fail>
    ? "whnfCore when cheap, whnf otherwise; a string literal becomes its constructor form."
    c = whnfMaybe(st, x, cheapRec, cheapProj, cheapProj)?
    match c.e
        Expr.StrLit(s) -> whnf(c.st, Check.Lits.strToCtor(s))
        _ -> Result.Ok(c)

verify majorOfProj
    resultExpr(majorOfProj(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0), false, true)) => Core.Exprs.fvar(0)

fn whnfMaybe(st: St, e: Expr, cheapRec: Bool, cheapProj: Bool, cheap: Bool) -> Result<RE, Fail>
    ? "whnfCore with the flags when cheap, else full whnf."
    match cheap
        true -> whnfCoreM(st, e, cheapRec, cheapProj)
        false -> whnf(st, e)

verify whnfMaybe
    resultExpr(whnfMaybe(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0), false, false, true)) => Core.Exprs.fvar(0)

fn projCore(st: St, c: Expr, s: Name, i: Int) -> Option<Expr>
    ? "Field i of a constructor application of structure s."
    match Core.Apps.fnOf(c)
        Expr.Const(_, n, _) -> projOfCtor(Check.State.lookup(st, n), Core.Apps.argsOf(c), s, i)
        _ -> Option.None

verify projCore
    projCore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0), Core.Names.anon(), 0) => Option.None

fn projOfCtor(c: Option<Const>, args: List<Expr>, s: Name, i: Int) -> Option<Expr>
    ? "The argument after the parameters."
    match c
        Option.Some(Const.CCtor(k)) -> match Bool.and(k.induct == s, k.numParams + i < List.len(args))
            true -> Option.Some(nth(args, k.numParams + i))
            false -> Option.None
        _ -> Option.None

verify projOfCtor
    projOfCtor(Option.None, [], Core.Names.anon(), 0) => Option.None

fn reduceRecursor(st: St, e: Expr, cheapRec: Bool, cheapProj: Bool) -> Result<RO, Fail>
    ? "Quotient rules once the quotient is declared, then inductive recursor rules."
    q = quotReduce(st, e)?
    match q.o
        Option.Some -> Result.Ok(q)
        Option.None -> inductiveReduce(q.st, e, cheapRec, cheapProj)

verify reduceRecursor
    resultOpt(reduceRecursor(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0), false, false)) => Option.None

fn quotReady(st: St) -> Bool
    ? "The quotient package has been added."
    match Check.State.lookup(st, Check.Lits.quot)
        Option.Some(Const.CQuot) -> true
        _ -> false

verify quotReady
    quotReady(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)) => false

fn quotReduce(st: St, e: Expr) -> Result<RO, Fail>
    ? "Quot.lift f h (Quot.mk r a) reduces to f a, and Quot.ind likewise."
    match quotReady(st)
        false -> Result.Ok(RO(o = Option.None, st = st))
        true -> match Core.Apps.fnOf(e)
            Expr.Const(_, Name.Str(Name.Str(Name.Anon, "Quot", _), "lift", _), _) -> quotApply(st, Core.Apps.argsOf(e), 5)
            Expr.Const(_, Name.Str(Name.Str(Name.Anon, "Quot", _), "ind", _), _) -> quotApply(st, Core.Apps.argsOf(e), 4)
            _ -> Result.Ok(RO(o = Option.None, st = st))

verify quotReduce
    resultOpt(quotReduce(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0))) => Option.None

fn quotApply(st: St, args: List<Expr>, mkPos: Int) -> Result<RO, Fail>
    ? "Needs the Quot.mk argument at mkPos; the function is argument 3."
    match List.len(args) > mkPos
        false -> Result.Ok(RO(o = Option.None, st = st))
        true -> quotMk(whnf(st, nth(args, mkPos))?, args, mkPos)

verify quotApply
    resultOpt(quotApply(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), [], 5)) => Option.None

fn quotMk(mk: RE, args: List<Expr>, mkPos: Int) -> Result<RO, Fail>
    ? "Fires only on Quot.mk with its three arguments."
    match Bool.and(Core.Apps.isConst(Core.Apps.fnOf(mk.e), Check.Lits.quotMk), Core.Apps.numArgs(mk.e) == 3)
        true -> Result.Ok(RO(o = Option.Some(Core.Apps.mkApps(Core.Exprs.app(nth(args, 3), lastArg(mk.e)), List.drop(args, mkPos + 1))), st = mk.st))
        false -> Result.Ok(RO(o = Option.None, st = mk.st))

verify quotMk
    resultOpt(quotMk(RE(e = Core.Exprs.fvar(0), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), [], 5)) => Option.None

fn lastArg(e: Expr) -> Expr
    ? "The argument of an application node."
    match e
        Expr.App(_, _, a) -> a
        _ -> e

verify lastArg
    lastArg(Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.fvar(1))) => Core.Exprs.fvar(1)

fn inductiveReduce(st: St, e: Expr, cheapRec: Bool, cheapProj: Bool) -> Result<RO, Fail>
    ? "Iota: a recursor applied to a constructor reduces by that constructor's rule."
    match Core.Apps.fnOf(e)
        Expr.Const(_, n, ls) -> recOf(st, e, ls, Check.State.lookup(st, n), cheapRec, cheapProj)
        _ -> Result.Ok(RO(o = Option.None, st = st))

verify inductiveReduce
    resultOpt(inductiveReduce(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0), false, false)) => Option.None

fn recOf(st: St, e: Expr, ls: List<Level>, c: Option<Const>, cheapRec: Bool, cheapProj: Bool) -> Result<RO, Fail>
    ? "Only recursors with their major premise present reduce."
    match c
        Option.Some(Const.CRec(rv)) -> recMajor(st, e, ls, rv, Core.Apps.argsOf(e), rv.numParams + rv.numMotives + rv.numMinors + rv.numIndices, cheapRec, cheapProj)
        _ -> Result.Ok(RO(o = Option.None, st = st))

verify recOf
    resultOpt(recOf(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0), [], Option.None, false, false)) => Option.None

fn recMajor(st: St, e: Expr, ls: List<Level>, rv: Rec, args: List<Expr>, majorIdx: Int, cheapRec: Bool, cheapProj: Bool) -> Result<RO, Fail>
    ? "Brings the major premise to constructor form: K-like types, literals, structures."
    match majorIdx >= List.len(args)
        true -> Result.Ok(RO(o = Option.None, st = st))
        false -> recFire(majorToCtor(st, rv, nth(args, majorIdx), cheapRec, cheapProj)?, ls, rv, args, majorIdx)

verify recMajor
    resultOpt(recMajor(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0), [], Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), [], 0, false, false)) => Option.None

decision CtorMajorAsIs
    date = "2026-10-24"
    reason =
        "Every time a recursor fired, its major premise went through"
        "structure eta, an equality check, whnf (with a store into the whnf"
        "cache) and structure expansion, even when it already was a"
        "constructor application, as a list's tail is at every step of a"
        "lookup: each of those steps leaves a constructor application as it is."
        "Now a literal becomes its constructor and a constructor application"
        "fires at once; Nat.succ is left to the old path, where whnf may fold"
        "it into a literal. Instructions retired, one worker, on Aver 58a0c12f:"
        "perf/magma-list-deep-n36 227.5 G to 218.0 G, all 30 perf tests 393.5 G"
        "to 381.8 G, Init 127.8 G to 127.1 G, etale and qb9 unchanged."
    chosen = "CtorMajorAsIs"
    rejected = ["EveryMajorReduced"]
    impacts = [majorToCtor, majorSlow]

fn majorToCtor(st: St, rv: Rec, major: Expr, cheapRec: Bool, cheapProj: Bool) -> Result<RE, Fail>
    ? "K first; a literal is its constructor and a constructor application other than Nat.succ is already what every later step would leave it (CtorMajorAsIs); otherwise structure eta before any reduction of the major, so that a major with no weak head normal form does not stop the recursor (lean4#15351); then whnf, and literal or structure expansion."
    m1 = kMajor(st, rv, major)?
    match m1.e
        Expr.NatLit(n) -> Result.Ok(RE(e = Check.Lits.natLitToCtor(n), st = m1.st))
        _ -> match Bool.and(ruleHeaded(rv.rules, Core.Apps.fnOf(m1.e)), Bool.not(Core.Apps.isConst(Core.Apps.fnOf(m1.e), Check.Lits.natSucc)))
            true -> Result.Ok(m1)
            false -> majorSlow(m1, rv, cheapRec, cheapProj)

fn ruleHeaded(rules: List<RecRule>, h: Expr) -> Bool
    ? "A head that is the constructor of one of the rules: the major premise is then that constructor applied, and only the rules' names are read, not the environment (CtorMajorAsIs)."
    match h
        Expr.Const(_, n, _) -> ruleNamed(rules, n) != Option.None
        _ -> false

verify ruleHeaded
    ruleHeaded([RecRule(ctor = Check.Lits.natZero, nfields = 0, rhs = Core.Exprs.bvar(0))], Core.Exprs.cnst(Check.Lits.natZero, [])) => true
    ruleHeaded([], Core.Exprs.cnst(Check.Lits.natZero, [])) => false

fn majorSlow(m1: RE, rv: Rec, cheapRec: Bool, cheapProj: Bool) -> Result<RE, Fail>
    ? "A major that is neither a literal nor a constructor application, or is Nat.succ of something: structure eta first, then whnf and expansion."
    m0 = etaBeforeWhnf(m1.st, rv, m1.e)?
    match m0.e == m1.e
        false -> Result.Ok(m0)
        true -> majorReduced(whnfMaybe(m0.st, m1.e, cheapRec, cheapProj, cheapRec)?, rv)

verify majorSlow
    resultExpr(majorSlow(RE(e = Core.Exprs.natLit(2), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), false, false)) => Check.Lits.natLitToCtor(2)

fn majorReduced(m2: RE, rv: Rec) -> Result<RE, Fail>
    ? "After whnf: a literal becomes its constructor, a structure value is eta expanded."
    match m2.e
        Expr.NatLit(n) -> Result.Ok(RE(e = Check.Lits.natLitToCtor(n), st = m2.st))
        Expr.StrLit(s) -> whnf(m2.st, Check.Lits.strToCtor(s))
        _ -> toCtorWhenStructure(m2.st, rv, m2.e)

verify majorReduced
    resultExpr(majorReduced(RE(e = Core.Exprs.natLit(0), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false))) => Core.Exprs.cnst(Check.Lits.name2("Nat", "zero"), [])

fn etaBeforeWhnf(st: St, rv: Rec, e: Expr) -> Result<RE, Fail>
    ? "A major of a non-recursive structure that is not a constructor application becomes mk params e.0 ... e.(n-1) without being reduced. A proof only when the recursor eliminates into any sort: then every field is a proof and its projection is a proof; a proof of a structure that eliminates only into Prop, such as Exists, keeps the reference order."
    match rv.majorIsStruct
        false -> Result.Ok(RE(e = e, st = st))
        true -> match isCtorApp(st, e)
            true -> Result.Ok(RE(e = e, st = st))
            false -> etaStructure(st, rv, e)

fn etaStructure(st: St, rv: Rec, e: Expr) -> Result<RE, Fail>
    ? "A structure's major premise not built by its constructor: its fields under elimination into any sort, otherwise by its type."
    match rv.elimAnySort
        true -> Result.Ok(RE(e = etaFields(st, rv.major, e), st = st))
        false -> structTyped(whnfOf(inferType(st, e)?)?, rv.major, e)

verify etaStructure
    resultExpr(etaStructure(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = true, elimAnySort = true), Core.Exprs.fvar(0))) => Core.Exprs.fvar(0)

verify etaBeforeWhnf
    resultExpr(etaBeforeWhnf(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), Core.Exprs.fvar(0))) => Core.Exprs.fvar(0)

fn etaFields(st: St, induct: Name, e: Expr) -> Expr
    ? "mk e.0 ... e.(n-1) without the parameters and with no type inferred (FieldsWithoutType): the major of a well-typed recursor application has the structure's type, a large-eliminating recursor expands values and proofs alike, and a rule takes only the fields, the last arguments."
    match firstCtor(st, induct)
        Option.Some(c) -> match Check.State.lookup(st, c)
            Option.Some(Const.CCtor(kv)) -> projApps(Core.Exprs.cnst(c, []), induct, e, 0, kv.numFields)
            _ -> e
        Option.None -> e

verify etaFields
    etaFields(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.fvar(0)) => Core.Exprs.fvar(0)

decision FactsOnTheRecursor
    date = "2026-10-25"
    reason =
        "Every major premise not in constructor form asked again which type"
        "it belongs to, walking the recursor's type past its parameters,"
        "motives, minor premises and indices, then looked that type up to"
        "see whether it is a non-recursive structure, and looked it up once"
        "more to see whether the recursor eliminates into any sort: eleven"
        "million binders walked and two and a half million lookups on"
        "reachability. These are facts about the recursor, so they are"
        "found once, when the recursor enters the environment, derived or"
        "admitted as stated, and read off it at every step. One worker on"
        "Aver 06639a5e: reachability 54.2 G to 52.5 G instructions,"
        "magma-list-pair-n21 52.7 G to 51.7 G, std and con-leche 0.3%"
        "fewer."
    chosen = "FactsOnTheRecursor"
    rejected = ["FactsAtEveryStep"]
    impacts = [withFacts, recFacts, etaBeforeWhnf, toCtorWhenStructure, toCtorWhenK]

decision FieldsWithoutType
    date = "2026-10-25"
    reason =
        "A structure's major premise under a recursor that eliminates into"
        "any sort is expanded whatever its type, value or proof, and the"
        "rule then takes only the fields, its last arguments. Its type was"
        "still inferred and brought to whnf, and whether it is a proof"
        "computed and dropped, only to fill in parameters nobody reads. The"
        "type's head is the structure whenever the application is well"
        "typed, which every term the kernel reduces is. The type is now"
        "inferred only under a recursor into Prop alone, where a proof stays"
        "as it is. Measured no change on the large tests; kept because it"
        "does strictly less."
    chosen = "FieldsWithoutType"
    rejected = ["FieldsFromInferredType"]
    impacts = [etaBeforeWhnf, etaFields]

fn withFacts(st: St, rv: Rec) -> Rec
    ? "The recursor as it enters the environment, with its facts found."
    recFacts(rv, Check.State.lookup(st, majorInduct(rv)))

verify withFacts
    withFacts(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = true, elimAnySort = true)).majorIsStruct => false

fn recFacts(rv: Rec, c: Option<Const>) -> Rec
    ? "What reduction asks of a recursor at every step, found once from c, the constant its major premise's type names (FactsOnTheRecursor): that type; whether it is a non-recursive structure; whether the recursor has one more universe parameter than the type, so that the motive may land in any sort."
    match c
        Option.Some(Const.CInduct(iv)) -> Rec.update(rv, major = majorInduct(rv), majorIsStruct = structureLike(iv), elimAnySort = List.len(rv.head.params) > List.len(iv.head.params))
        _ -> Rec.update(rv, major = majorInduct(rv), majorIsStruct = false, elimAnySort = false)

verify recFacts
    recFacts(Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = true, elimAnySort = true), Option.None).elimAnySort => false

verify majorToCtor
    resultExpr(majorToCtor(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), Core.Exprs.natLit(0), false, false)) => Core.Exprs.cnst(Check.Lits.name2("Nat", "zero"), [])

fn kMajor(st: St, rv: Rec, major: Expr) -> Result<RE, Fail>
    ? "For a K-like recursor the major premise may be replaced by the nullary constructor."
    match rv.k
        false -> Result.Ok(RE(e = major, st = st))
        true -> toCtorWhenK(st, rv, major)

verify kMajor
    resultExpr(kMajor(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), Core.Exprs.fvar(3))) => Core.Exprs.fvar(3)

fn majorInduct(rv: Rec) -> Name
    ? "The inductive type of the major premise, read off the recursor's type."
    majorAfter(rv.head.ty, rv.numParams + rv.numMotives + rv.numMinors + rv.numIndices)

verify majorInduct
    majorInduct(Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.pi(Core.Names.anon(), Core.Exprs.cnst(Check.Lits.name1("Nat"), []), Core.Exprs.bvar(0), Binder.Default)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false)) => Check.Lits.name1("Nat")

fn majorAfter(t: Expr, n: Int) -> Name
    ? "Skips n binders and names the head of the next domain."
    match t
        Expr.Pi(_, d, b) -> match n == 0
            true -> Option.withDefault(Core.Apps.constName(Core.Apps.fnOf(d)), Core.Names.anon())
            false -> majorAfter(b, n - 1)
        _ -> Core.Names.anon()

verify majorAfter
    majorAfter(Core.Exprs.bvar(0), 0) => Core.Names.anon()

fn toCtorWhenK(st: St, rv: Rec, e: Expr) -> Result<RE, Fail>
    ? "e : I params indices with I K-like becomes I's constructor when the types agree."
    t = inferType(st, e)?
    w = whnf(t.st, t.e)?
    match Core.Apps.isConst(Core.Apps.fnOf(w.e), rv.major)
        false -> Result.Ok(RE(e = e, st = w.st))
        true -> kCandidate(w.st, w.e, e, nullaryCtor(w.st, w.e, rv.numParams))

verify toCtorWhenK
    resultExpr(toCtorWhenK(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = true, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), Core.Exprs.sort(Level.Zero))) => Core.Exprs.sort(Level.Zero)

fn kCandidate(st: St, appType: Expr, e: Expr, cand: Option<Expr>) -> Result<RE, Fail>
    ? "Uses the constructor only when its type equals e's."
    match cand
        Option.None -> Result.Ok(RE(e = e, st = st))
        Option.Some(c) -> kCheck(appType, e, c, inferType(st, c)?)

verify kCandidate
    resultExpr(kCandidate(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), Core.Exprs.fvar(1), Option.None)) => Core.Exprs.fvar(1)

fn kCheck(appType: Expr, e: Expr, c: Expr, ct: RE) -> Result<RE, Fail>
    ? "The equality test of toCtorWhenK."
    eq = isDefEq(ct.st, appType, ct.e)?
    match eq.b
        true -> Result.Ok(RE(e = c, st = eq.st))
        false -> Result.Ok(RE(e = e, st = eq.st))

verify kCheck
    resultExpr(kCheck(Core.Exprs.sort(Level.Zero), Core.Exprs.fvar(1), Core.Exprs.fvar(2), RE(e = Core.Exprs.sort(Level.Zero), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)))) => Core.Exprs.fvar(2)

fn firstCtor(st: St, n: Name) -> Option<Name>
    ? "The first constructor of an inductive type."
    match Check.State.lookup(st, n)
        Option.Some(Const.CInduct(iv)) -> match iv.ctors
            [k, .._] -> Option.Some(k)
            [] -> Option.None
        _ -> Option.None

verify firstCtor
    firstCtor(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Names.anon()) => Option.None

fn nullaryCtor(st: St, ty: Expr, nparams: Int) -> Option<Expr>
    ? "The type's first constructor applied to its parameters."
    match Core.Apps.fnOf(ty)
        Expr.Const(_, n, ls) -> nullaryOf(firstCtor(st, n), ls, List.take(Core.Apps.argsOf(ty), nparams))
        _ -> Option.None

verify nullaryCtor
    nullaryCtor(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0), 0) => Option.None

fn nullaryOf(k: Option<Name>, ls: List<Level>, params: List<Expr>) -> Option<Expr>
    ? "Builds the application."
    match k
        Option.Some(c) -> Option.Some(Core.Apps.mkApps(Core.Exprs.cnst(c, ls), params))
        Option.None -> Option.None

verify nullaryOf
    nullaryOf(Option.None, [], []) => Option.None

fn isNonRecStructure(st: St, n: Name) -> Bool
    ? "One constructor, no indices, not recursive."
    match Check.State.lookup(st, n)
        Option.Some(Const.CInduct(iv)) -> structureLike(iv)
        _ -> false

verify isNonRecStructure
    isNonRecStructure(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Names.anon()) => false

fn structureLike(iv: IndType) -> Bool
    ? "One constructor, no indices, not recursive."
    Bool.and(List.len(iv.ctors) == 1, Bool.and(iv.numIndices == 0, Bool.not(iv.isRec)))

verify structureLike
    structureLike(IndType(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), numParams = 0, numIndices = 0, all = [], ctors = [], numNested = 0, isRec = false, isUnsafe = false, isReflexive = false)) => false

fn isCtorApp(st: St, e: Expr) -> Bool
    ? "Headed by a constructor."
    match Core.Apps.fnOf(e)
        Expr.Const(_, n, _) -> match Check.State.lookup(st, n)
            Option.Some(Const.CCtor) -> true
            _ -> false
        _ -> false

verify isCtorApp
    isCtorApp(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0)) => false

fn toCtorWhenStructure(st: St, rv: Rec, e: Expr) -> Result<RE, Fail>
    ? "A value of a non-recursive structure becomes mk e.1 ... e.n (not for proofs)."
    match rv.majorIsStruct
        false -> Result.Ok(RE(e = e, st = st))
        true -> match isCtorApp(st, e)
            true -> Result.Ok(RE(e = e, st = st))
            false -> structTyped(whnfOf(inferType(st, e)?)?, rv.major, e)

verify toCtorWhenStructure
    resultExpr(toCtorWhenStructure(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), Core.Exprs.fvar(0))) => Core.Exprs.fvar(0)

fn whnfOf(r: RE) -> Result<RE, Fail>
    ? "whnf of an inferred type."
    whnf(r.st, r.e)

verify whnfOf
    resultExpr(whnfOf(RE(e = Core.Exprs.sort(Level.Zero), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)))) => Core.Exprs.sort(Level.Zero)

fn structTyped(w: RE, induct: Name, e: Expr) -> Result<RE, Fail>
    ? "Only when the type really is the structure and not a proposition."
    match Core.Apps.isConst(Core.Apps.fnOf(w.e), induct)
        false -> Result.Ok(RE(e = e, st = w.st))
        true -> structExpand(isProp(w.st, w.e)?, w.e, e)

verify structTyped
    resultExpr(structTyped(RE(e = Core.Exprs.fvar(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Names.anon(), Core.Exprs.fvar(0))) => Core.Exprs.fvar(0)

fn structExpand(p: RB, ty: Expr, e: Expr) -> Result<RE, Fail>
    ? "Eta expands unless e is a proof."
    match p.b
        true -> Result.Ok(RE(e = e, st = p.st))
        false -> Result.Ok(RE(e = expandEtaStruct(p.st, ty, e), st = p.st))

verify structExpand
    resultExpr(structExpand(RB(b = true, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.fvar(1), Core.Exprs.fvar(0))) => Core.Exprs.fvar(0)

fn expandEtaStruct(st: St, ty: Expr, e: Expr) -> Expr
    ? "mk params e.0 ... e.(n-1)."
    match Core.Apps.fnOf(ty)
        Expr.Const(_, n, ls) -> etaWith(st, n, ls, Core.Apps.argsOf(ty), e, firstCtor(st, n))
        _ -> e

verify expandEtaStruct
    expandEtaStruct(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(0)) => Core.Exprs.fvar(0)

fn etaWith(st: St, n: Name, ls: List<Level>, args: List<Expr>, e: Expr, k: Option<Name>) -> Expr
    ? "Needs the constructor's parameter and field counts."
    match k
        Option.Some(c) -> match Check.State.lookup(st, c)
            Option.Some(Const.CCtor(kv)) -> projApps(Core.Apps.mkApps(Core.Exprs.cnst(c, ls), List.take(args, kv.numParams)), n, e, 0, kv.numFields)
            _ -> e
        Option.None -> e

verify etaWith
    etaWith(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Names.anon(), [], [], Core.Exprs.fvar(0), Option.None) => Core.Exprs.fvar(0)

fn projApps(acc: Expr, n: Name, e: Expr, i: Int, count: Int) -> Expr
    ? "Applies e.i for i below count."
    match i >= count
        true -> acc
        false -> projApps(Core.Exprs.app(acc, Core.Exprs.proj(n, i, e)), n, e, i + 1, count)

verify projApps
    projApps(Core.Exprs.fvar(9), Core.Names.anon(), Core.Exprs.fvar(0), 0, 1) => Core.Exprs.app(Core.Exprs.fvar(9), Core.Exprs.proj(Core.Names.anon(), 0, Core.Exprs.fvar(0)))

fn recFire(m: RE, ls: List<Level>, rv: Rec, args: List<Expr>, majorIdx: Int) -> Result<RO, Fail>
    ? "Picks the rule of the major premise's constructor and builds its right-hand side."
    match ruleFor(rv.rules, Core.Apps.fnOf(m.e))
        Option.None -> Result.Ok(RO(o = Option.None, st = m.st))
        Option.Some(rule) -> Result.Ok(ruleRhs(m.st, rule, ls, rv, args, majorIdx, Core.Apps.argsOf(m.e)))

verify recFire
    resultOpt(recFire(RE(e = Core.Exprs.fvar(0), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), [], Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), [], 0)) => Option.None

fn ruleFor(rules: List<RecRule>, head: Expr) -> Option<RecRule>
    ? "The rule for the constructor at the head."
    match rules
        [] -> Option.None
        [r, ..rest] -> match Core.Apps.isConst(head, r.ctor)
            true -> Option.Some(r)
            false -> ruleFor(rest, head)

verify ruleFor
    ruleFor([], Core.Exprs.fvar(0)) => Option.None

fn ruleRhs(st: St, rule: RecRule, ls: List<Level>, rv: Rec, args: List<Expr>, majorIdx: Int, majorArgs: List<Expr>) -> RO
    ? "rhs params motives minors fields extra-arguments."
    match Bool.or(rule.nfields > List.len(majorArgs), List.len(ls) != List.len(rv.head.params))
        true -> RO(o = Option.None, st = st)
        false -> ruleApplied(ruleAt(st, rule, Core.Exprs.cnst(rv.head.name, ls), rv, ls), rule, rv, args, majorIdx, majorArgs)

verify ruleRhs
    ruleRhs(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), RecRule(ctor = Core.Names.anon(), nfields = 1, rhs = Core.Exprs.bvar(0)), [], Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), [], 0, []).o => Option.None

fn ruleApplied(r: RE, rule: RecRule, rv: Rec, args: List<Expr>, majorIdx: Int, majorArgs: List<Expr>) -> RO
    ? "The instantiated right-hand side applied to the recursor's arguments and the constructor's fields."
    RO(o = Option.Some(Core.Apps.mkApps(Core.Apps.mkApps(Core.Apps.mkApps(r.e, List.take(args, rv.numParams + rv.numMotives + rv.numMinors)), List.drop(majorArgs, List.len(majorArgs) - rule.nfields)), List.drop(args, majorIdx + 1))), st = r.st)

verify ruleApplied
    ruleApplied(RE(e = Core.Exprs.bvar(0), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), RecRule(ctor = Core.Names.anon(), nfields = 1, rhs = Core.Exprs.bvar(0)), Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), [], 0, [Core.Exprs.natLit(3)]).o => Option.Some(Core.Exprs.app(Core.Exprs.bvar(0), Core.Exprs.natLit(3)))

fn ruleAt(st: St, rule: RecRule, f: Expr, rv: Rec, ls: List<Level>) -> RE
    ? "The rule's right-hand side at the recursor's levels. Like an unfolded value, it is remembered for the rest of the declaration, since instantiating the levels walks all of it each time."
    match ls
        [] -> RE(e = rule.rhs, st = st)
        _ -> ruleCached(st, rule, rv, ls, f, Core.Exprs.keyAt(f, ruleNumber(rv.rules, rule.ctor, 1)))

verify ruleAt
    ruleAt(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), RecRule(ctor = Core.Names.anon(), nfields = 0, rhs = Core.Exprs.natLit(1)), Core.Exprs.cnst(Core.Names.anon(), []), Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), []).e => Core.Exprs.natLit(1)

fn ruleCached(st: St, rule: RecRule, rv: Rec, ls: List<Level>, f: Expr, k: Core.Exprs.Key) -> RE
    ? "Shares the unfolding cache: the recursor at its levels f under its key at the rule's place among the rules, made without building a term (KeysUnbuilt)."
    match Check.State.cacheGetAt(st.unfoldCache, k, f)
        Option.Some(v) -> RE(e = v, st = st)
        Option.None -> keptAt(st, k, f, Core.Subst.instLevelParams(rule.rhs, rv.head.params, ls))

verify ruleCached
    Core.Cache.size(ruleCached(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), RecRule(ctor = Core.Names.anon(), nfields = 0, rhs = Core.Exprs.natLit(1)), Rec(head = Head(name = Core.Names.anon(), params = [Core.Names.anon()], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), [Level.Zero], Core.Exprs.natLit(9), Core.Exprs.keyAt(Core.Exprs.natLit(9), 1)).st.unfoldCache) => 1

decision KeysUnbuilt
    date = "2026-10-25"
    reason =
        "Every unfolding at levels looked up the body under its first k"
        "lambdas under the constant applied to the literal k, and every rule"
        "of a recursor under the recursor applied to its constructor: two or"
        "three nodes built, hashed and compared for each lookup, the"
        "constructor's with its name and levels hashed again. In a"
        "computation by decide that is several times per element of a list"
        "walked. The key is now made from the constant already built and the"
        "count, or the rule's place among the rules, without building a term,"
        "and the entry is told apart by the constant alone. The first k"
        "arguments become the body's environment in one pass. One worker on"
        "Aver d2a1db25: perf/magma-list-deep-n36 221.1 G to 214.2 G"
        "instructions, magma-string-pair-n9 52.6 G to 50.8 G, reachability"
        "72.1 G to 70.1 G, Init 92.8 G to 92.3 G."
    chosen = "KeysUnbuilt"
    rejected = ["KeysBuilt"]
    impacts = [peeledBody, ruleAt, ruleCached, keptAt, envOf]

fn ruleNumber(rules: List<RecRule>, ctor: Name, i: Int) -> Int
    ? "The place of ctor's rule among the rules, from i."
    match rules
        [] -> i
        [r, ..rest] -> match r.ctor == ctor
            true -> i
            false -> ruleNumber(rest, ctor, i + 1)

verify ruleNumber
    ruleNumber([RecRule(ctor = Core.Names.anon(), nfields = 0, rhs = Core.Exprs.natLit(1))], Core.Names.anon(), 1) => 1

fn keptAt(st: St, k: Core.Exprs.Key, f: Expr, v: Expr) -> RE
    ? "v kept in the unfolding cache for f under the key k: a value under its first lambdas under f's key at their count, a recursor's rule under its key at the rule's place (KeysUnbuilt)."
    RE(e = v, st = St.update(st, unfoldCache = Check.State.cachePutAt(st.unfoldCache, k, f, v)))

verify keptAt
    keptAt(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.keyAt(Core.Exprs.natLit(9), 1), Core.Exprs.natLit(9), Core.Exprs.natLit(1)).e => Core.Exprs.natLit(1)

fn envOf(stack: List<Clo>, k: Int, acc: List<Clo>) -> List<Clo>
    ? "The first k closures of the stack as an environment, the last first, as beta would push them: List.reverse(List.take(stack, k)) in one pass."
    match k <= 0
        true -> acc
        false -> match stack
            [c, ..rest] -> envOf(rest, k - 1, List.prepend(c, acc))
            [] -> acc

verify envOf
    envOf([Clo.Clo(-1, Core.Exprs.natLit(1), []), Clo.Clo(-1, Core.Exprs.natLit(2), []), Clo.Clo(-1, Core.Exprs.natLit(3), [])], 2, []) => [Clo.Clo(-1, Core.Exprs.natLit(2), []), Clo.Clo(-1, Core.Exprs.natLit(1), [])]

fn whnf(st: St, e: Expr) -> Result<RE, Fail>
    ? "Weak head normal form: whnfCore, Nat literal arithmetic and definition unfolding, until none applies."
    match e
        Expr.BVar -> Result.Ok(RE(e = e, st = st))
        Expr.Sort -> Result.Ok(RE(e = e, st = st))
        Expr.Pi -> Result.Ok(RE(e = e, st = st))
        Expr.NatLit -> Result.Ok(RE(e = e, st = st))
        Expr.StrLit -> Result.Ok(RE(e = e, st = st))
        Expr.FVar(id) -> match Check.State.localValue(st.lctx, id)
            Option.None -> Result.Ok(RE(e = e, st = st))
            Option.Some -> whnfCached(st, e)
        _ -> whnfCached(st, e)

verify whnf
    resultExpr(whnf(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.app(Core.Exprs.cnst(Check.Lits.name2("Nat", "add"), []), Core.Exprs.natLit(2)), Core.Exprs.natLit(3)))) => Core.Exprs.natLit(5)

fn whnfCached(st: St, e: Expr) -> Result<RE, Fail>
    ? "Uses or fills the whnf cache."
    match Check.State.cacheGet(st.whnfCache, e)
        Option.Some(r) -> Result.Ok(RE(e = r, st = st))
        Option.None -> whnfLoop(st, e, e)

decision ValuesInTheKey
    date = "2026-10-26"
    reason =
        "A computation by decide asks Nat arithmetic for the value of the"
        "same operand again and again, each time as another term: on"
        "perf/magma-list-deep-n36, table[a.val * 36 + b.val]! for 5184 pairs"
        "of a and b that take only 1296 values, each walking the table cell"
        "by cell through List.get!Internal. The whnf cache, keyed by the"
        "term, missed every time. An operand of Nat arithmetic now comes to"
        "its value under a second key on a miss: its closed arithmetic"
        "arguments brought to whnf first, and the application to them looked"
        "up and kept as well. The two applications are definitionally equal"
        "by congruence, so the whnf of one is a whnf of the other. Only an"
        "operand that has to come to a literal anyway is treated so; doing"
        "it on every whnf miss also took pair-n21 from 34.8 G to 30.1 G, but"
        "cost reachability 2.5% and con-leche 0.4%. A key that only left"
        "proofs out of the term gained nothing, since the repeated values"
        "come from different terms. Instructions retired, one worker, Aver"
        "02771bf5, without a profile: n21 4.0 G to 1.5 G, n36 65.9 G to"
        "17.1 G, string-pair-n9 20.4 G to 8.9 G; pair-n21, reachability,"
        "etale, con-leche and std as they were. Built as the Arena builds:"
        "n36 58.1 G to 15.1 G, the 30 perf tests 124.6 G to 69.3 G."
    chosen = "ValuesInTheKey"
    rejected = ["ValuesForEveryMiss", "ProofsLeftOutOfTheKey"]
    impacts = [whnfValue, valuesFirst, byValues, reduceNat, natBin, natFirst]

fn whnfValue(st: St, e: Expr) -> Result<RE, Fail>
    ? "whnf of an operand of Nat arithmetic, which has to come to a literal: on a cache miss, its closed arithmetic arguments come to their values first and the operand is looked up under them (ValuesInTheKey)."
    match e
        Expr.App -> match Check.State.cacheGet(st.whnfCache, e)
            Option.Some(r) -> Result.Ok(RE(e = r, st = st))
            Option.None -> match valueArgs(e)
                true -> valuesFirst(st, e, Core.Apps.argsOf(e), [], false)
                false -> whnfLoop(st, e, e)
        _ -> whnf(st, e)

verify whnfValue
    resultExpr(whnfValue(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.natLit(1))) => Core.Exprs.natLit(1)

fn valueArgs(e: Expr) -> Bool
    ? "An application of a constant with a closed arithmetic argument, whose value would make a better key (ValuesInTheKey)."
    match e
        Expr.App(_, f, _) -> match Core.Apps.fnOf(f)
            Expr.Const -> anyArith(Core.Apps.argsOf(e))
            _ -> false
        _ -> false

verify valueArgs
    valueArgs(Core.Exprs.natLit(1)) => false
    valueArgs(Core.Exprs.app(Core.Exprs.cnst(Check.Lits.name1("f"), []), Core.Exprs.app(Core.Exprs.app(Core.Exprs.cnst(Check.Lits.name2("Nat", "add"), []), Core.Exprs.natLit(1)), Core.Exprs.natLit(2)))) => true

fn anyArith(args: List<Expr>) -> Bool
    ? "Whether some argument is closed arithmetic."
    match args
        [] -> false
        [a, ..rest] -> match isArith(a)
            true -> true
            false -> anyArith(rest)

verify anyArith
    anyArith([]) => false

fn isArith(a: Expr) -> Bool
    ? "A closed application of Nat arithmetic, of its notation classes, or of Fin.val: a term whose whnf is cheap and usually a literal."
    match Core.Exprs.hasFVar(a)
        true -> false
        false -> match Core.Apps.fnOf(a)
            Expr.Const(_, Name.Str(Name.Str(Name.Anon, ns, _), op, _), _) -> arithName(ns, op)
            _ -> false

verify isArith
    isArith(Core.Exprs.natLit(1)) => false
    isArith(Core.Exprs.app(Core.Exprs.cnst(Check.Lits.name2("Fin", "val"), []), Core.Exprs.natLit(1))) => true

fn arithName(ns: String, op: String) -> Bool
    ? "Nat's operations, their notation classes and Fin.val."
    match ns
        "Nat" -> Bool.or(Bool.or(Bool.or(op == "add", op == "mul"), Bool.or(op == "sub", op == "mod")), Bool.or(op == "div", op == "succ"))
        "HAdd" -> op == "hAdd"
        "HMul" -> op == "hMul"
        "HSub" -> op == "hSub"
        "HMod" -> op == "hMod"
        "HDiv" -> op == "hDiv"
        "Fin" -> op == "val"
        _ -> false

verify arithName
    arithName("HAdd", "hAdd") => true
    arithName("List", "get") => false

fn valuesFirst(st: St, e: Expr, args: List<Expr>, done: List<Expr>, moved: Bool) -> Result<RE, Fail>
    ? "The arguments in order, each closed arithmetic one brought to whnf; then the application to them is looked up, unless no argument changed."
    match args
        [] -> match moved
            true -> byValues(st, e, Core.Apps.mkApps(headOf(e), List.reverse(done)))
            false -> whnfLoop(st, e, e)
        [a, ..rest] -> match isArith(a)
            true -> valueThen(whnf(st, a)?, a, e, rest, done, moved)
            false -> valuesFirst(st, e, rest, List.prepend(a, done), moved)

verify valuesFirst
    resultExpr(valuesFirst(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.natLit(1), [], [], false)) == Core.Exprs.natLit(1) => true

fn valueThen(r: RE, a: Expr, e: Expr, rest: List<Expr>, done: List<Expr>, moved: Bool) -> Result<RE, Fail>
    ? "Goes on with the argument's whnf, noting whether it differs from the argument."
    valuesFirst(r.st, e, rest, List.prepend(r.e, done), Bool.or(moved, Bool.and(isLit(r.e), r.e != a)))

verify valueThen
    resultExpr(valueThen(RE(e = Core.Exprs.natLit(2), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.natLit(1), Core.Exprs.natLit(1), [], [], false)) == Core.Exprs.natLit(1) => false

fn isLit(e: Expr) -> Bool
    ? "A Nat literal."
    match e
        Expr.NatLit -> true
        _ -> false

verify isLit
    isLit(Core.Exprs.natLit(1)) => true
    isLit(Core.Exprs.bvar(0)) => false

fn headOf(e: Expr) -> Expr
    ? "The head of an application."
    Core.Apps.fnOf(e)

verify headOf
    headOf(Core.Exprs.natLit(1)) => Core.Exprs.natLit(1)

fn byValues(st: St, e: Expr, v: Expr) -> Result<RE, Fail>
    ? "The application to the arguments' values is definitionally e, by congruence, so its whnf is a whnf of e: found or worked out under v, and kept for e too."
    match Check.State.cacheGet(st.whnfCache, v)
        Option.Some(r) -> Result.Ok(whnfStore(st, e, r))
        Option.None -> alsoFor(whnfLoop(st, v, v)?, e)

verify byValues
    resultExpr(byValues(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.natLit(1), Core.Exprs.natLit(1))) => Core.Exprs.natLit(1)

fn alsoFor(r: RE, e: Expr) -> Result<RE, Fail>
    ? "Keeps the result for e as well."
    Result.Ok(whnfStore(r.st, e, r.e))

verify alsoFor
    resultExpr(alsoFor(RE(e = Core.Exprs.natLit(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.natLit(2))) => Core.Exprs.natLit(1)

verify whnfCached
    resultExpr(whnfCached(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0))) => Core.Exprs.fvar(0)

fn whnfLoop(st: St, orig: Expr, t: Expr) -> Result<RE, Fail>
    ? "The reduction machine with definitions unfolded: whnfCore's steps, then Nat arithmetic on literals, then unfolding the head, in that order, until none applies; the result is stored for orig. An application whose head nothing can reduce is its own whnf."
    match t
        Expr.App -> match deltaRigid(st, Core.Apps.fnOf(t))
            true -> Result.Ok(whnfStore(st, orig, t))
            false -> whnfRun(st, orig, t)
        _ -> whnfRun(st, orig, t)

fn whnfRun(st: St, orig: Expr, t: Expr) -> Result<RE, Fail>
    ? "Runs the machine with unfolding and stores its result."
    r = lcore(st, t, [], [], MS(next = 0, forced = {}), true, false, false)?
    Result.Ok(whnfStore(r.st, orig, r.e))

verify whnfRun
    resultExpr(whnfRun(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.natLit(1), Core.Exprs.app(Core.Exprs.app(Core.Exprs.cnst(Check.Lits.name2("Nat", "mul"), []), Core.Exprs.natLit(2)), Core.Exprs.natLit(3)))) => Core.Exprs.natLit(6)

fn deltaRigid(st: St, f: Expr) -> Bool
    ? "A head under which whnf can do nothing: a constructor other than Nat.succ, an inductive type, an axiom, an opaque constant, a free variable without a let value, a sort, a pi or a literal."
    match f
        Expr.Const(_, n, _) -> match Core.Apps.isConst(f, Check.Lits.natSucc)
            true -> false
            false -> match Check.State.lookup(st, n)
                Option.Some(Const.CInduct) -> true
                Option.Some(Const.CCtor) -> true
                Option.Some(Const.CAxiom) -> true
                Option.Some(Const.COpaque) -> true
                _ -> false
        Expr.FVar(id) -> Check.State.localValue(st.lctx, id) == Option.None
        Expr.Sort -> true
        Expr.Pi -> true
        Expr.NatLit -> true
        Expr.StrLit -> true
        _ -> false

verify deltaRigid
    deltaRigid(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0)) => true
    deltaRigid(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name2("Nat", "succ"), [])) => false

verify whnfLoop
    resultExpr(whnfLoop(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0), Core.Exprs.fvar(0))) => Core.Exprs.fvar(0)

fn mcore(st: St, t: Expr, env: List<Expr>, stack: List<Expr>, cheapRec: Bool, cheapProj: Bool) -> Result<RE, Fail>
    ? "whnfCore as a machine: the head term, the values of its loose bound variables (index 0 first), and the arguments waiting for it (first argument first). The machine keeps them as closures, built only when needed; see lcore."
    lcore(st, t, closedAll(env, []), closedAll(stack, []), MS(next = 0, forced = {}), false, cheapRec, cheapProj)

type Clo
    Clo(Int, Expr, List<Clo>)

record MS
    next: Int
    forced: Map<Int, Expr>

record MX
    e: Expr
    ms: MS

record MXs
    es: List<Expr>
    ms: MS

fn lcore(st: St, t: Expr, env: List<Clo>, stack: List<Clo>, ms: MS, delta: Bool, cheapRec: Bool, cheapProj: Bool) -> Result<RE, Fail>
    ? "The machine on closures. An argument or a let value is a term with the environment it was met in, numbered so that it is built at most once; beta and let push such a closure, and a bound variable in head position goes on as its closure; past the environment it is loose, as in the value of a definition not checked yet, and is stuck, dropped by the environment's length as matTerm drops it. At a constant: a recursor applied to a constructor takes its rule's right-hand side with the other arguments still closures; then, when delta is on, Nat arithmetic on literals and unfolding a definition, again with the arguments as they are. Terms are built only when the head is stuck, for the major premise of a recursor, and for the arguments of quotient rules and Nat arithmetic."
    match t
        Expr.App(_, f, a) -> lcore(st, f, env, List.prepend(closure(a, env, ms.next), stack), MS.update(ms, next = ms.next + 1), delta, cheapRec, cheapProj)
        Expr.Lam(_, _, body) -> match stack
            [c, ..rest] -> lcore(st, body, List.prepend(c, env), rest, ms, delta, cheapRec, cheapProj)
            [] -> Result.Ok(RE(e = matTerm(t, env, ms).e, st = st))
        Expr.BVar(i) -> match List.drop(env, i)
            [c, .._] -> lclo(st, c, stack, ms, delta, cheapRec, cheapProj)
            [] -> Result.Ok(RE(e = lstuck(MX(e = Core.Exprs.bvar(i - List.len(env)), ms = ms), stack), st = st))
        Expr.Let(_, _, v, body) -> lcore(st, body, List.prepend(closure(v, env, ms.next), env), stack, MS.update(ms, next = ms.next + 1), delta, cheapRec, cheapProj)
        Expr.FVar(id) -> lvar(st, t, Check.State.localValue(st.lctx, id), stack, ms, delta, cheapRec, cheapProj)
        Expr.Const(_, n, ls) -> lconst(st, t, ls, Check.State.lookup(st, n), stack, ms, delta, cheapRec, cheapProj)
        Expr.Proj(_, s, i, x) -> lproject(st, s, i, matTerm(x, env, ms), stack, delta, cheapRec, cheapProj)
        _ -> Result.Ok(RE(e = lstuck(matTerm(t, env, ms), stack), st = st))

verify lcore
    resultExpr(lcore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), [Clo.Clo(-1, Core.Exprs.natLit(1), [])], [], MS(next = 0, forced = {}), false, false, false)) => Core.Exprs.natLit(1)
    resultExpr(lcore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.app(Core.Exprs.cnst(Check.Lits.name2("Nat", "add"), []), Core.Exprs.natLit(2)), Core.Exprs.natLit(3)), [], [], MS(next = 0, forced = {}), true, false, false)) => Core.Exprs.natLit(5)
    resultExpr(lcore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.bvar(0), Core.Exprs.natLit(1)), [], [], MS(next = 0, forced = {}), true, false, false)) => Core.Exprs.app(Core.Exprs.bvar(0), Core.Exprs.natLit(1))

fn lclo(st: St, c: Clo, stack: List<Clo>, ms: MS, delta: Bool, cheapRec: Bool, cheapProj: Bool) -> Result<RE, Fail>
    ? "A closure in head position: its term, in its own environment."
    match c
        Clo.Clo(_, e, cenv) -> lcore(st, e, cenv, stack, ms, delta, cheapRec, cheapProj)

verify lclo
    resultExpr(lclo(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Clo.Clo(-1, Core.Exprs.natLit(2), []), [], MS(next = 0, forced = {}), false, false, false)) => Core.Exprs.natLit(2)

fn lvar(st: St, t: Expr, v: Option<Expr>, stack: List<Clo>, ms: MS, delta: Bool, cheapRec: Bool, cheapProj: Bool) -> Result<RE, Fail>
    ? "A let-bound free variable goes on as its value; any other is stuck."
    match v
        Option.Some(x) -> lcore(st, x, [], stack, ms, delta, cheapRec, cheapProj)
        Option.None -> Result.Ok(RE(e = lstuck(MX(e = t, ms = ms), stack), st = st))

verify lvar
    resultExpr(lvar(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0), Option.None, [], MS(next = 0, forced = {}), false, false, false)) => Core.Exprs.fvar(0)

decision RigidHeadsStuck
    date = "2026-10-25"
    reason =
        "A constructor, an inductive type or an axiom at the head went the"
        "way of a definition: Nat arithmetic tried, the constant looked up"
        "again, its value asked for and the unfolding cache searched, before"
        "the machine found nothing to unfold and stopped. A computation by"
        "decide meets a constructor at the head at every value it builds,"
        "eight hundred thousand times on reachability. Such a head is now"
        "stuck at once; Nat.succ still goes to the arithmetic on literals."
        "One worker on Aver 06639a5e: reachability 55.0 G to 54.2 G"
        "instructions, the rest as it was."
    chosen = "RigidHeadsStuck"
    rejected = ["RigidHeadsUnfoldTried"]
    impacts = [lconst]

fn lconst(st: St, f: Expr, ls: List<Level>, c: Option<Const>, stack: List<Clo>, ms: MS, delta: Bool, cheapRec: Bool, cheapProj: Bool) -> Result<RE, Fail>
    ? "A constant head: a recursor's rule, a quotient rule, or, with delta, Nat arithmetic and unfolding. A constructor other than Nat.succ, an inductive type and an axiom have nothing to unfold and are stuck at once (RigidHeadsStuck). Where the machine goes is worked out by constGo, and it takes one step there (UnfoldPicked)."
    g = constGo(st, f, ls, c, stack, ms, delta, cheapRec, cheapProj)?
    match g.run
        true -> lcore(g.st, g.t, g.env, g.rest, g.ms, delta, cheapRec, cheapProj)
        false -> Result.Ok(RE(e = lstuck(MX(e = g.t, ms = g.ms), g.rest), st = g.st))

verify lconst
    resultExpr(lconst(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("c"), []), [], Option.None, [], MS(next = 0, forced = {}), true, false, false)) => Core.Exprs.cnst(Check.Lits.name1("c"), [])

fn constGo(st: St, f: Expr, ls: List<Level>, c: Option<Const>, stack: List<Clo>, ms: MS, delta: Bool, cheapRec: Bool, cheapProj: Bool) -> Result<Go, Fail>
    ? "Where the machine goes from the constant f, found as c, with the waiting arguments."
    match c
        Option.Some(Const.CRec(rv)) -> recGo(st, f, ls, rv, stack, ms, cheapRec, cheapProj)
        Option.Some(Const.CQuot) -> quotGo(st, f, matStack(stack, ms, []))
        Option.Some(Const.CCtor) -> match Core.Apps.isConst(f, Check.Lits.natSucc)
            true -> natGo(st, f, c, stack, ms, delta, cheapRec, cheapProj)
            false -> Result.Ok(stuckGo(st, f, stack, ms))
        Option.Some(Const.CInduct) -> Result.Ok(stuckGo(st, f, stack, ms))
        Option.Some(Const.CAxiom) -> Result.Ok(stuckGo(st, f, stack, ms))
        _ -> natGo(st, f, c, stack, ms, delta, cheapRec, cheapProj)

verify constGo
    Result.withDefault(constGo(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("c"), []), [], Option.None, [], MS(next = 0, forced = {}), true, false, false), Go(st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), ms = MS(next = 0, forced = {}), run = true, t = Core.Exprs.cnst(Check.Lits.name1("c"), []), env = [], rest = [])).run => false

fn recGo(st: St, f: Expr, ls: List<Level>, rv: Rec, stack: List<Clo>, ms: MS, cheapRec: Bool, cheapProj: Bool) -> Result<Go, Fail>
    ? "A recursor reduces only with its major premise present; the major premise is built and brought to constructor form, the other arguments stay closures."
    majorIdx = rv.numParams + rv.numMotives + rv.numMinors + rv.numIndices
    match majorIdx >= List.len(stack)
        true -> Result.Ok(stuckGo(st, f, stack, ms))
        false -> majorGo(st, f, ls, rv, stack, majorIdx, matClo(nthClo(stack, majorIdx), ms), cheapRec, cheapProj)

verify recGo
    Result.withDefault(recGo(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("c"), []), [], Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), [], MS(next = 0, forced = {}), false, false), Go(st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), ms = MS(next = 0, forced = {}), run = true, t = Core.Exprs.cnst(Check.Lits.name1("c"), []), env = [], rest = [])).run => false

fn majorGo(st: St, f: Expr, ls: List<Level>, rv: Rec, stack: List<Clo>, majorIdx: Int, major: MX, cheapRec: Bool, cheapProj: Bool) -> Result<Go, Fail>
    ? "The major premise in constructor form, as the reference reduces it, picks the rule; rhs params motives minors fields extra-arguments, as ruleRhs builds it, with the recursor's own arguments still closures. Without a rule the recursor is stuck as it was met. The rule is picked by plain functions, not by steps of the machine (PickedNotStepped)."
    p = recPick(st, f, ls, rv, stack, majorIdx, major.e, cheapRec, cheapProj)?
    match p.ok
        true -> Result.Ok(Go(st = p.st, ms = major.ms, run = true, t = p.body, env = p.env, rest = p.rest))
        false -> Result.Ok(stuckGo(p.st, f, stack, major.ms))

verify majorGo
    Result.withDefault(majorGo(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("r"), []), [], Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), [], 0, MX(e = Core.Exprs.fvar(0), ms = MS(next = 0, forced = {})), false, false), Go(st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), ms = MS(next = 0, forced = {}), run = true, t = Core.Exprs.cnst(Check.Lits.name1("c"), []), env = [], rest = [])).run => false

fn quotGo(st: St, f: Expr, args: MXs) -> Result<Go, Fail>
    ? "A quotient rule on built arguments; nothing else reduces a quotient constant."
    q = quotReduce(st, Core.Apps.mkApps(f, args.es))?
    match q.o
        Option.Some(x) -> Result.Ok(Go(st = q.st, ms = args.ms, run = true, t = x, env = [], rest = []))
        Option.None -> Result.Ok(Go(st = q.st, ms = args.ms, run = false, t = Core.Apps.mkApps(f, args.es), env = [], rest = []))

verify quotGo
    Result.withDefault(quotGo(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("q"), []), MXs(es = [], ms = MS(next = 0, forced = {}))), Go(st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), ms = MS(next = 0, forced = {}), run = true, t = Core.Exprs.cnst(Check.Lits.name1("c"), []), env = [], rest = [])).run => false

fn natGo(st: St, f: Expr, c: Option<Const>, stack: List<Clo>, ms: MS, delta: Bool, cheapRec: Bool, cheapProj: Bool) -> Result<Go, Fail>
    ? "With delta: Nat.succ of one argument or a Nat operation of two is tried on literals first, as whnf does; otherwise the head, c as found, unfolds. Without delta the constant is stuck."
    match delta
        false -> Result.Ok(stuckGo(st, f, stack, ms))
        true -> match natArity(f, stack)
            0 -> unfoldGo(st, f, c, stack, ms, cheapRec, cheapProj)
            k -> natTryGo(st, f, c, stack, matStack(List.take(stack, k), ms, []), cheapRec, cheapProj)

verify natGo
    Result.withDefault(natGo(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("c"), []), Option.None, [], MS(next = 0, forced = {}), false, false, false), Go(st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), ms = MS(next = 0, forced = {}), run = true, t = Core.Exprs.cnst(Check.Lits.name1("c"), []), env = [], rest = [])).run => false

fn natTryGo(st: St, f: Expr, c: Option<Const>, stack: List<Clo>, args: MXs, cheapRec: Bool, cheapProj: Bool) -> Result<Go, Fail>
    ? "Nat arithmetic on the built arguments; a literal result is the answer, otherwise the head unfolds."
    n = reduceNat(st, Core.Apps.mkApps(f, args.es))?
    match n.o
        Option.Some(v) -> Result.Ok(Go(st = n.st, ms = args.ms, run = false, t = v, env = [], rest = []))
        Option.None -> unfoldGo(n.st, f, c, stack, args.ms, cheapRec, cheapProj)

verify natTryGo
    Result.withDefault(natTryGo(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name2("Nat", "add"), []), Option.None, [], MXs(es = [Core.Exprs.natLit(1), Core.Exprs.natLit(2)], ms = MS(next = 0, forced = {})), false, false), Go(st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), ms = MS(next = 0, forced = {}), run = true, t = Core.Exprs.cnst(Check.Lits.name1("c"), []), env = [], rest = [])).t => Core.Exprs.natLit(3)


record RPick
    st: St
    ok: Bool
    body: Expr
    env: List<Clo>
    rest: List<Clo>

decision PickedNotStepped
    date = "2026-10-25"
    reason =
        "Firing a recursor took four steps of the machine (major premise,"
        "rule, checks, right-hand side) and a sparse casesOn two, each a"
        "turn of the machine's loop that carries all its arguments; and"
        "every arm the loop has costs the rest of the checker too, Init,"
        "std and con-leche about 1% for two arms. The rule, its"
        "right-hand side and the environment it runs in are now worked out"
        "by plain functions, and the machine takes one step to them; a"
        "literal of Nat goes to its rule at once there too. One worker on"
        "Aver 06639a5e, after LiteralCases: perf total 189.0 G to 188.0 G"
        "instructions, reachability 47.8 G to 47.5 G, Init 87.2 G to"
        "87.0 G, std 148.8 G to 148.4 G, con-leche 141.8 G to 141.5 G."
    chosen = "PickedNotStepped"
    rejected = ["PickedByMachineSteps"]
    impacts = [majorGo, recPick, sparseGo, sparsePick, casesOnGo, casesPick]

fn recPick(st: St, f: Expr, ls: List<Level>, rv: Rec, stack: List<Clo>, majorIdx: Int, e: Expr, cheapRec: Bool, cheapProj: Bool) -> Result<RPick, Fail>
    ? "The right-hand side to run for the major premise e, with its environment and the arguments left; a literal of Nat goes to its rule at once (LiteralCases)."
    match e
        Expr.NatLit(n) -> match Bool.and(rv.major == Check.Lits.nat, List.len(rv.rules) == 2)
            true -> Result.Ok(recRuled(st, f, ls, rv, stack, majorIdx, ruleNamed(rv.rules, litCtor(n)), litArgs(n)))
            false -> Result.Ok(recBuilt(f, ls, rv, stack, majorIdx, majorToCtor(st, rv, e, cheapRec, cheapProj)?))
        _ -> Result.Ok(recBuilt(f, ls, rv, stack, majorIdx, majorToCtor(st, rv, e, cheapRec, cheapProj)?))

verify recPick
    Result.withDefault(recPick(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("r"), []), [], Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), [], 0, Core.Exprs.fvar(0), false, false), RPick(st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), ok = true, body = Core.Exprs.bvar(0), env = [], rest = [])).ok => false

fn recBuilt(f: Expr, ls: List<Level>, rv: Rec, stack: List<Clo>, majorIdx: Int, m: RE) -> RPick
    ? "The rule of the constructor at the head of m, the major premise built."
    recRuled(m.st, f, ls, rv, stack, majorIdx, ruleFor(rv.rules, Core.Apps.fnOf(m.e)), Core.Apps.argsOf(m.e))

verify recBuilt
    recBuilt(Core.Exprs.cnst(Check.Lits.name1("r"), []), [], Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), [], 0, RE(e = Core.Exprs.fvar(0), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe))).ok => false

fn recRuled(st: St, f: Expr, ls: List<Level>, rv: Rec, stack: List<Clo>, majorIdx: Int, r: Option<RecRule>, majorArgs: List<Expr>) -> RPick
    ? "A rule that has the constructor's fields and the recursor's levels gives its right-hand side; otherwise nothing fires."
    match r
        Option.Some(rule) -> match Bool.or(rule.nfields > List.len(majorArgs), List.len(ls) != List.len(rv.head.params))
            true -> RPick(st = st, ok = false, body = f, env = [], rest = [])
            false -> rhsPick(ruleAt(st, rule, f, rv, ls), rule, rv, stack, majorIdx, majorArgs)
        Option.None -> RPick(st = st, ok = false, body = f, env = [], rest = [])

verify recRuled
    recRuled(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("r"), []), [], Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), [], 0, Option.None, []).ok => false

decision RuleLambdasAtOnce
    date = "2026-10-25"
    reason =
        "A recursor's rule fired with its right-hand side, lambdas over the"
        "parameters, motives, minor premises and the constructor's fields,"
        "pushed on the stack: the machine then took the lambdas off one step"
        "each, each step moving one closure from the stack to the"
        "environment. For a list that is six steps per element walked. The"
        "lambdas now come off at once and those closures become the"
        "environment in one pass, as an unfolded value's do. One worker on"
        "Aver 06639a5e: perf/magma-list-deep-n36 180.9 G to 168.0 G"
        "instructions, magma-string-pair-n9 44.0 G to 41.6 G, reachability"
        "61.1 G to 59.6 G, all 30 perf tests 309.7 G to 293.1 G, Init 89.0 G"
        "to 88.5 G."
    chosen = "RuleLambdasAtOnce"
    rejected = ["RuleLambdasOneByOne"]
    impacts = [rhsPick]

fn rhsPick(r: RE, rule: RecRule, rv: Rec, stack: List<Clo>, majorIdx: Int, majorArgs: List<Expr>) -> RPick
    ? "The right-hand side takes the parameters, motives and minor premises, the constructor's fields and the arguments after the major premise; its lambdas over them come off at once, those arguments its environment, the last first, as beta would leave them (RuleLambdasAtOnce)."
    n = rv.numParams + rv.numMotives + rv.numMinors
    l = n + rule.nfields
    match lamsUpTo(r.e, l, 0) == l
        true -> RPick(st = r.st, ok = true, body = peelLams(r.e, l), env = envOf(closedAll(List.drop(majorArgs, List.len(majorArgs) - rule.nfields), []), rule.nfields, envOf(stack, n, [])), rest = List.drop(stack, majorIdx + 1))
        false -> RPick(st = r.st, ok = true, body = r.e, env = [], rest = List.concat(List.take(stack, n), List.concat(closedAll(List.drop(majorArgs, List.len(majorArgs) - rule.nfields), []), List.drop(stack, majorIdx + 1))))

verify rhsPick
    rhsPick(RE(e = Core.Exprs.natLit(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), RecRule(ctor = Core.Names.anon(), nfields = 0, rhs = Core.Exprs.natLit(1)), Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), [], 0, []).body => Core.Exprs.natLit(1)

fn ruleNamed(rules: List<RecRule>, ctor: Name) -> Option<RecRule>
    ? "The rule of the constructor named ctor."
    match rules
        [] -> Option.None
        [r, ..rest] -> match r.ctor == ctor
            true -> Option.Some(r)
            false -> ruleNamed(rest, ctor)

verify ruleNamed
    ruleNamed([], Check.Lits.natZero) => Option.None

fn litCtor(n: Int) -> Name
    ? "The constructor a literal stands for."
    match n == 0
        true -> Check.Lits.natZero
        false -> Check.Lits.natSucc

verify litCtor
    litCtor(0) => Check.Lits.natZero
    litCtor(3) => Check.Lits.natSucc

fn litArgs(n: Int) -> List<Expr>
    ? "Its arguments: none for 0, the literal n for n+1."
    match n == 0
        true -> []
        false -> [Core.Exprs.natLit(n - 1)]

verify litArgs
    litArgs(0) => []
    litArgs(3) => [Core.Exprs.natLit(2)]

fn natArity(f: Expr, stack: List<Clo>) -> Int
    ? "How many arguments reduceNat takes for this head and the waiting arguments: 1 for Nat.succ, 2 for a binary Nat operation, 0 when it does not apply; the arguments are counted only for a Nat operation."
    match f
        Expr.Const(_, Name.Str(Name.Str(Name.Anon, "Nat", _), op, _), []) -> natArityAt(op, List.len(stack))
        _ -> 0

verify natArity
    natArity(Core.Exprs.cnst(Check.Lits.name2("Nat", "add"), []), [Clo.Clo(-1, Core.Exprs.natLit(1), []), Clo.Clo(-1, Core.Exprs.natLit(2), [])]) => 2
    natArity(Core.Exprs.cnst(Check.Lits.name1("c"), []), []) => 0

fn natArityAt(op: String, n: Int) -> Int
    ? "1 for succ of one argument, 2 for a binary operation of two, else 0."
    match Bool.and(op == "succ", n == 1)
        true -> 1
        false -> match Bool.and(Check.Lits.isNatOp(op), n == 2)
            true -> 2
            false -> 0

verify natArityAt
    natArityAt("add", 2) => 2
    natArityAt("succ", 1) => 1
    natArityAt("add", 3) => 0

record Go
    st: St
    ms: MS
    run: Bool
    t: Expr
    env: List<Clo>
    rest: List<Clo>

decision UnfoldPicked
    date = "2026-10-25"
    reason =
        "Unfolding a definition went through up to nine steps of the"
        "machine before the first step of its value: the constant found,"
        "with levels or without, its value, its shape, the shape kept, the"
        "casesOn's major premise, its minor premise, the body peeled, the"
        "body run; thirteen arms of the machine's loop, every one of which"
        "costs the rest of the checker too. Where the machine goes next,"
        "a term with its environment and the arguments left, or stuck as"
        "it was met, is now worked out by plain functions, and the machine"
        "takes one step there; what each of them decides is as before. The"
        "loop goes from 24 arms to 11. One worker on Aver 06639a5e:"
        "magma-list-deep-n36 87.9 G to 81.7 G instructions, reachability"
        "47.5 G to 45.2 G, magma-string-pair-n9 26.9 G to 25.4 G, perf"
        "total 188.0 G to 177.5 G; Init 87.0 G to 86.7 G, std 148.4 G to"
        "148.0 G, con-leche 141.5 G to 140.8 G. A constant met at the head"
        "goes the same way (constGo): recursor, quotient, Nat arithmetic"
        "and unfolding are one step of a loop of 5 arms, and the constant"
        "found is handed on instead of looked up again. On Aver 798bd0e1:"
        "magma-list-deep-n36 82.4 G to 76.7 G, reachability 45.7 G to"
        "44.2 G, perf total 179.2 G to 170.4 G; Init 87.8 G to 87.4 G, std"
        "149.7 G to 149.1 G, con-leche 142.4 G to 141.9 G."
    chosen = "UnfoldPicked"
    rejected = ["UnfoldStepped"]
    impacts = [lconst, constGo, natGo, unfoldGo, atGo, bareGo, casesGo, shapedGo, casesOnGo, sparseGo, minorGo, peeledGo, wholeGo]

fn stuckGo(st: St, f: Expr, stack: List<Clo>, ms: MS) -> Go
    ? "Stuck as it was met: f with the waiting arguments."
    Go(st = st, ms = ms, run = false, t = f, env = [], rest = stack)

verify stuckGo
    stuckGo(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("c"), []), [], MS(next = 0, forced = {})).run => false

fn unfoldGo(st: St, f: Expr, c: Option<Const>, stack: List<Clo>, ms: MS, cheapRec: Bool, cheapProj: Bool) -> Result<Go, Fail>
    ? "The constant f, found as c: at universe levels through its shape and the unfolding cache; without levels its value as written, through the cache only when a matcher heads its body (MatchersInlined). A definition's value takes the waiting arguments as they are; anything else is stuck. At universe levels, the lambdas the arguments meet come off the value as written, and only what is under them gets the levels (DomainsDropped)."
    match f
        Expr.Const(_, _, ls) -> match List.len(ls) > 0
            true -> atGo(st, f, ls, c, stack, ms, cheapRec, cheapProj)
            false -> Result.Ok(bareGo(st, f, c, stack, ms))
        _ -> Result.Ok(wholeGo(st, f, stack, ms))

verify unfoldGo
    Result.withDefault(unfoldGo(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("c"), []), Option.None, [], MS(next = 0, forced = {}), false, false), Go(st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), ms = MS(next = 0, forced = {}), run = true, t = Core.Exprs.cnst(Check.Lits.name1("c"), []), env = [], rest = [])).run => false

fn bareGo(st: St, f: Expr, c: Option<Const>, stack: List<Clo>, ms: MS) -> Go
    ? "A constant without levels: a value takes the waiting arguments; anything else is stuck."
    match c
        Option.Some(k) -> match unfoldValue(c, [])
            Option.Some(v) -> bareOnGo(st, f, Check.State.headOf(k), v, lamsUpTo(v, List.len(stack), 0), stack, ms)
            Option.None -> stuckGo(st, f, stack, ms)
        Option.None -> stuckGo(st, f, stack, ms)

verify bareGo
    bareGo(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("c"), []), Option.None, [], MS(next = 0, forced = {})).run => false

fn bareOnGo(st: St, f: Expr, h: Head, v: Expr, k: Int, stack: List<Clo>, ms: MS) -> Go
    ? "With a matcher at the head of the body under the k lambdas met, the body from the unfolding cache with the matcher in it; otherwise the value as written."
    match Bool.and(k > 0, matcherHeaded(peelLams(v, k)))
        true -> bodyGo(peeledBody(st, f, h, v, k, []), k, stack, ms)
        false -> Go(st = st, ms = ms, run = true, t = v, env = [], rest = stack)

verify bareOnGo
    bareOnGo(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("c"), []), Head(name = Check.Lits.name1("c"), params = [], ty = Core.Exprs.sort(Level.Zero)), Core.Exprs.natLit(3), 0, [], MS(next = 0, forced = {})).t => Core.Exprs.natLit(3)

fn bodyGo(b: RE, k: Int, stack: List<Clo>, ms: MS) -> Go
    ? "A body whose k lambdas met the first k arguments: those its environment, the innermost first, as beta pushes them."
    Go(st = b.st, ms = ms, run = true, t = b.e, env = envOf(stack, k, []), rest = List.drop(stack, k))

verify bodyGo
    bodyGo(RE(e = Core.Exprs.bvar(0), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), 1, [Clo.Clo(-1, Core.Exprs.natLit(2), [])], MS(next = 0, forced = {})).rest => []

fn atGo(st: St, f: Expr, ls: List<Level>, c: Option<Const>, stack: List<Clo>, ms: MS, cheapRec: Bool, cheapProj: Bool) -> Result<Go, Fail>
    ? "A constant at levels: a definition or theorem with a value goes by its shape."
    match c
        Option.Some(k) -> match Check.State.valueOf(k)
            Option.Some(v) -> casesGo(st, f, Check.State.headOf(k), v, ls, stack, ms, cheapRec, cheapProj)
            Option.None -> Result.Ok(wholeGo(st, f, stack, ms))
        Option.None -> Result.Ok(wholeGo(st, f, stack, ms))

verify atGo
    Result.withDefault(atGo(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("c"), []), [Level.Zero], Option.None, [], MS(next = 0, forced = {}), false, false), Go(st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), ms = MS(next = 0, forced = {}), run = true, t = Core.Exprs.cnst(Check.Lits.name1("c"), []), env = [], rest = [])).run => false

fn casesGo(st: St, f: Expr, h: Head, v: Expr, ls: List<Level>, stack: List<Clo>, ms: MS, cheapRec: Bool, cheapProj: Bool) -> Result<Go, Fail>
    ? "A constant at levels by its shape, found once per run of the machine and kept (ShapesKept): a casesOn whose value is its recursor's goes to its minor premise (CasesOnDirect), a sparse casesOn likewise (RecHeadedDirect), anything else unfolds."
    match casesNamed(h.name)
        false -> Result.Ok(peeledGo(st, f, h, v, lamsUpTo(v, List.len(stack), 0), ls, stack, ms))
        true -> match shapeKept(Map.get(st.shapes, Core.Exprs.hashKey(f)), f)
            Option.Some(sh) -> shapedGo(st, f, h, v, ls, sh, stack, ms, cheapRec, cheapProj)
            Option.None -> newShapeGo(shapeOf(st, f, h, v, ls), f, h, v, ls, stack, ms, cheapRec, cheapProj)

verify casesGo
    Result.withDefault(casesGo(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("c"), []), Head(name = Check.Lits.name1("c"), params = [], ty = Core.Exprs.sort(Level.Zero)), Core.Exprs.natLit(5), [], [], MS(next = 0, forced = {}), false, false), Go(st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), ms = MS(next = 0, forced = {}), run = true, t = Core.Exprs.cnst(Check.Lits.name1("c"), []), env = [], rest = [])).run => false

fn newShapeGo(sa: ShapeAt, f: Expr, h: Head, v: Expr, ls: List<Level>, stack: List<Clo>, ms: MS, cheapRec: Bool, cheapProj: Bool) -> Result<Go, Fail>
    ? "A shape just found, kept for the rest of the declaration."
    shapedGo(St.update(sa.st, shapes = Map.set(sa.st.shapes, Core.Exprs.hashKey(f), (f, sa.sh))), f, h, v, ls, sa.sh, stack, ms, cheapRec, cheapProj)

verify newShapeGo
    Result.withDefault(newShapeGo(ShapeAt(st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), sh = Shape.Plain), Core.Exprs.cnst(Check.Lits.name1("c"), []), Head(name = Check.Lits.name1("c"), params = [], ty = Core.Exprs.sort(Level.Zero)), Core.Exprs.natLit(5), [], [], MS(next = 0, forced = {}), false, false), Go(st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), ms = MS(next = 0, forced = {}), run = true, t = Core.Exprs.cnst(Check.Lits.name1("c"), []), env = [], rest = [])).run => false

fn shapedGo(st: St, f: Expr, h: Head, v: Expr, ls: List<Level>, sh: Shape, stack: List<Clo>, ms: MS, cheapRec: Bool, cheapProj: Bool) -> Result<Go, Fail>
    ? "The constant by its shape when it has all its arguments; otherwise unfolded."
    match sh
        Shape.Cases(cs) -> match Bool.and(List.len(stack) >= cs.total, List.len(h.params) == List.len(ls))
            true -> casesOnGo(st, f, h, v, ls, cs, stack, matClo(nthClo(stack, cs.majorAt), ms), cheapRec, cheapProj)
            false -> Result.Ok(peeledGo(st, f, h, v, lamsUpTo(v, List.len(stack), 0), ls, stack, ms))
        Shape.Sparse(sp) -> match List.len(stack) >= sp.n
            true -> sparseGo(st, f, h, v, ls, sp, envOf(stack, sp.n, []), stack, ms, cheapRec, cheapProj)
            false -> Result.Ok(peeledGo(st, f, h, v, lamsUpTo(v, List.len(stack), 0), ls, stack, ms))
        Shape.Plain -> Result.Ok(peeledGo(st, f, h, v, lamsUpTo(v, List.len(stack), 0), ls, stack, ms))

verify shapedGo
    Result.withDefault(shapedGo(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("c"), []), Head(name = Check.Lits.name1("c"), params = [], ty = Core.Exprs.sort(Level.Zero)), Core.Exprs.natLit(5), [], Shape.Plain, [], MS(next = 0, forced = {}), false, false), Go(st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), ms = MS(next = 0, forced = {}), run = true, t = Core.Exprs.cnst(Check.Lits.name1("c"), []), env = [], rest = [])).run => false

fn casesOnGo(st: St, f: Expr, h: Head, v: Expr, ls: List<Level>, cs: CasesOn, stack: List<Clo>, major: MX, cheapRec: Bool, cheapProj: Bool) -> Result<Go, Fail>
    ? "The major premise brought to its constructor as the recursor brings it, a literal at once (LiteralCases): the minor premise of its rule takes its fields and the arguments after the casesOn's own; with no rule for its head, the casesOn unfolds as before."
    p = casesPick(st, cs, major.e, cheapRec, cheapProj)?
    match p.ok
        true -> Result.Ok(minorGo(p.st, nthClo(stack, cs.minorsAt + p.at), p.fields, p.nf, List.drop(stack, cs.total), major.ms))
        false -> Result.Ok(peeledGo(p.st, f, h, v, lamsUpTo(v, List.len(stack), 0), ls, stack, major.ms))

verify casesOnGo
    Result.withDefault(casesOnGo(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("c"), [Level.Zero]), Head(name = Check.Lits.name1("c"), params = [Core.Names.anon()], ty = Core.Exprs.sort(Level.Zero)), Core.Exprs.natLit(5), [Level.Zero], CasesOn(rv = Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 1, numMinors = 1, rules = [RecRule(ctor = Check.Lits.name2("Nat", "zero"), nfields = 0, rhs = Core.Exprs.bvar(0))], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), total = 1, majorAt = 0, minorsAt = 0), [Clo.Clo(-1, Core.Exprs.natLit(7), [])], MX(e = Core.Exprs.natLit(0), ms = MS(next = 0, forced = {})), false, false), Go(st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), ms = MS(next = 0, forced = {}), run = false, t = Core.Exprs.cnst(Check.Lits.name1("c"), []), env = [], rest = [])).t => Core.Exprs.natLit(7)

fn minorGo(st: St, minor: Clo, fields: List<Clo>, nf: Int, rest: List<Clo>, ms: MS) -> Go
    ? "The minor premise takes the fields: a closure whose term has a lambda for each takes them all at once into its environment (RuleLambdasAtOnce); any other is applied to them."
    match minor
        Clo.Clo(_, e, cenv) -> match lamsUpTo(e, nf, 0) == nf
            true -> Go(st = st, ms = ms, run = true, t = peelLams(e, nf), env = envOf(fields, nf, cenv), rest = rest)
            false -> Go(st = st, ms = ms, run = true, t = e, env = cenv, rest = List.concat(fields, rest))

verify minorGo
    minorGo(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Clo.Clo(-1, Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), []), [Clo.Clo(-1, Core.Exprs.natLit(2), [])], 1, [], MS(next = 0, forced = {})).t => Core.Exprs.bvar(0)

fn sparseGo(st: St, f: Expr, h: Head, v: Expr, ls: List<Level>, sp: SparseOn, env0: List<Clo>, stack: List<Clo>, ms: MS, cheapRec: Bool, cheapProj: Bool) -> Result<Go, Fail>
    ? "The major premise, one of the definition's arguments env0, brought to its constructor as the recursor brings it: the ready minor premise runs at the definition's arguments with the fields, the hypotheses standing for nothing, and the arguments after the definition's; a minor premise not ready unfolds the definition."
    major = matClo(nthClo(env0, sp.major), ms)
    p = sparsePick(st, sp, major.e, env0, cheapRec, cheapProj)?
    match p.ok
        true -> Result.Ok(Go(st = p.st, ms = major.ms, run = true, t = p.body, env = p.env, rest = List.drop(stack, sp.n)))
        false -> Result.Ok(peeledGo(p.st, f, h, v, lamsUpTo(v, List.len(stack), 0), ls, stack, major.ms))

verify sparseGo
    Result.withDefault(sparseGo(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("c"), []), Head(name = Check.Lits.name1("c"), params = [], ty = Core.Exprs.sort(Level.Zero)), Core.Exprs.natLit(5), [], SparseOn(rv = Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 1, numMinors = 1, rules = [RecRule(ctor = Check.Lits.natZero, nfields = 0, rhs = Core.Exprs.bvar(0))], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), n = 1, major = 0, minors = [Option.Some(MinorOn(nf = 0, hyps = 0, body = Core.Exprs.natLit(8)))]), [Clo.Clo(-1, Core.Exprs.natLit(0), [])], [Clo.Clo(-1, Core.Exprs.natLit(0), [])], MS(next = 0, forced = {}), false, false), Go(st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), ms = MS(next = 0, forced = {}), run = false, t = Core.Exprs.cnst(Check.Lits.name1("c"), []), env = [], rest = [])).t => Core.Exprs.natLit(8)

fn peeledGo(st: St, f: Expr, h: Head, v: Expr, k: Int, ls: List<Level>, stack: List<Clo>, ms: MS) -> Go
    ? "With k lambdas met, the body under them at the levels, run with the first k arguments as its environment; with none, or levels of the wrong count, the whole value as before."
    match Bool.and(k > 0, List.len(h.params) == List.len(ls))
        false -> wholeGo(st, f, stack, ms)
        true -> bodyGo(peeledBody(st, f, h, v, k, ls), k, stack, ms)

verify peeledGo
    peeledGo(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("c"), []), Head(name = Check.Lits.name1("c"), params = [], ty = Core.Exprs.sort(Level.Zero)), Core.Exprs.natLit(5), 0, [], [], MS(next = 0, forced = {})).run => false

fn wholeGo(st: St, f: Expr, stack: List<Clo>, ms: MS) -> Go
    ? "The whole value at its levels takes the waiting arguments; anything else is stuck."
    u = unfoldConst(st, f)
    match u.o
        Option.Some(v) -> Go(st = u.st, ms = ms, run = true, t = v, env = [], rest = stack)
        Option.None -> stuckGo(u.st, f, stack, ms)

verify wholeGo
    wholeGo(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("c"), []), [], MS(next = 0, forced = {})).run => false


fn matcherHeaded(e: Expr) -> Bool
    ? "A matcher at the head."
    match Core.Apps.fnOf(e)
        Expr.Const(_, n, _) -> matcherNamed(n)
        _ -> false

verify matcherHeaded
    matcherHeaded(Core.Exprs.app(Core.Exprs.cnst(Check.Lits.name2("f", "match_2"), []), Core.Exprs.bvar(0))) => true

decision DomainsDropped
    date = "2026-10-25"
    reason =
        "Unfolding a constant at universe levels instantiated the levels in"
        "its whole value, the domains of its leading lambdas too, and the"
        "machine then met those lambdas with the waiting arguments: beta"
        "never reads a domain, so they were built to be dropped. On etale"
        "the domains were 37% of what instantiating values cost, 1.33 G of"
        "46 G. Now, with k arguments waiting, the value as written loses"
        "its first k lambdas, the body under them gets the levels, and the"
        "machine starts on it with the k arguments as the body's"
        "environment, as k steps of beta would leave it. The body is kept"
        "in the unfolding cache under the constant applied to k; the lazy"
        "delta step unfolds the same way. Instructions retired, one worker:"
        "etale 46.0 G to 44.6 G, rep14 5.7 G to 5.4 G, contdiff 32.3 G to"
        "32.1 G, Init 117.3 G to 116.9 G."
    chosen = "DomainsDropped"
    rejected = ["ValueInstantiated"]
    impacts = [unfoldGo, atGo, peeledGo, unfoldStep, stepPeeled]

decision CasesOnDirect
    date = "2026-10-25"
    reason =
        "A casesOn, unfolded, is its recursor applied to its arguments, each"
        "minor premise wrapped in lambdas that take the constructor's fields"
        "and the induction hypotheses and pass the fields on: the machine"
        "unfolded it, pushed every argument, fired the recursor's rule, ran"
        "its right-hand side and the wrapper, a few dozen steps for one"
        "choice. A computation by decide meets one per number it takes"
        "apart. When a definition named casesOn has exactly that value (its"
        "recursor at its own levels, the arguments in that order, each minor"
        "premise a wrapper of that shape), the major premise is brought to"
        "its constructor as the recursor would and the minor premise of that"
        "constructor gets the fields and the remaining arguments: what"
        "unfolding, the rule and beta give. Any other value is unfolded as"
        "before. One worker on Aver d2a1db25: perf/magma-list-deep-n36"
        "214.2 G to 203.9 G instructions, magma-list-pair-n21 60.2 G to"
        "56.5 G, reachability 70.1 G to 65.8 G, all 30 perf tests 360.3 G to"
        "343.0 G; etale and Init as they were."
    chosen = "CasesOnDirect"
    rejected = ["CasesOnUnfolded"]
    impacts = [casesGo, casesOf, casesOnGo]

fn casesNamed(n: Name) -> Bool
    ? "A name a casesOn or a sparse casesOn has: only such constants have their shape looked up, and the name alone decides nothing."
    match n
        Name.Str(_, s, _) -> Bool.or(s == "casesOn", String.startsWith(s, "_sparseCasesOn"))
        _ -> false

verify casesNamed
    casesNamed(Core.Names.str(Core.Names.anon(), "casesOn")) => true
    casesNamed(Core.Names.str(Core.Names.anon(), "_sparseCasesOn_2")) => true
    casesNamed(Core.Names.str(Core.Names.anon(), "rec")) => false


decision RecHeadedDirect
    date = "2026-10-25"
    reason =
        "The compiler's sparse casesOn, by which a match reads only the"
        "constructors it names, is a recursor applied to minor premises"
        "written for it, an else handler taken after: unfolded, the machine"
        "pushed every argument, fired the rule, ran its right-hand side and"
        "the minor premise's lambdas. Its value is lambdas over a recursor"
        "whose major premise is one of them, and the minor premise of each"
        "constructor stands in the value itself. So the major premise is"
        "brought to its constructor and that minor premise, at the"
        "definition's arguments, takes the fields at once; the induction"
        "hypotheses it is given have to go unused, and stand for nothing."
        "What unfolding, the rule and beta give. A value of another shape,"
        "or a minor premise that reads a hypothesis, unfolds as before."
    chosen = "RecHeadedDirect"
    rejected = ["SparseCasesUnfolded"]
    impacts = [sparseShape, minorOn, sparseGo, sparseFields]

fn isSparseCases(n: Name) -> Bool
    ? "A name the compiler gives a sparse casesOn: the name only spares other definitions the look (RecHeadedDirect)."
    match n
        Name.Str(_, s, _) -> String.startsWith(s, "_sparseCasesOn")
        _ -> false

verify isSparseCases
    isSparseCases(Core.Names.str(Core.Names.anon(), "_sparseCasesOn_1")) => true
    isSparseCases(Core.Names.str(Core.Names.anon(), "casesOn")) => false

record ShapeAt
    st: St
    sh: Shape

decision ShapesKept
    date = "2026-10-25"
    reason =
        "Whether a constant is a casesOn or a sparse casesOn of the shape"
        "the machine takes straight to a minor premise was found again at"
        "every unfolding, the value's lambdas and the recursor's arguments"
        "walked and every minor premise's body searched for its hypotheses:"
        "as much work as the steps it saved. The shape of a constant at its"
        "levels, with the minor premises' bodies ready, is now found once"
        "per run of the machine and kept with the closures it numbers, and"
        "only a constant named casesOn or _sparseCasesOn is looked up. One"
        "worker on Aver 06639a5e, with RecHeadedDirect:"
        "perf/magma-list-deep-n36 163.3 G to 124.1 G instructions,"
        "magma-string-pair-n9 40.7 G to 34.1 G, reachability 59.0 G to"
        "55.0 G, all 30 perf tests 286.9 G to 239.4 G; Init, std and"
        "con-leche as they were. Kept per run of the machine, a shape was"
        "still found again in every whnf that met the constant, two million"
        "runs on reachability; it is now kept in the checker's state for"
        "the whole declaration. With the test of a structure's major"
        "premise for its constructor made only for a structure, on Aver"
        "3f9fd6df: magma-list-pair-n21 42.0 G to 35.9 G, reachability"
        "40.6 G to 37.5 G, perf total 155.9 G to 147.8 G, Init 82.7 G to"
        "82.0 G, std 141.4 G to 140.1 G, con-leche 134.9 G to 133.6 G."
    chosen = "ShapesKept"
    rejected = ["ShapesFoundEachTime"]
    impacts = [casesGo, shapeOf, shapedGo]

fn shapeKept(o: Option<Tuple<Expr, Shape>>, f: Expr) -> Option<Shape>
    ? "The shape kept for f, if the entry is f's."
    match o
        Option.Some((g, sh)) -> match g == f
            true -> Option.Some(sh)
            false -> Option.None
        Option.None -> Option.None

verify shapeKept
    shapeKept(Option.Some((Core.Exprs.bvar(0), Shape.Plain)), Core.Exprs.bvar(0)) => Option.Some(Shape.Plain)
    shapeKept(Option.Some((Core.Exprs.bvar(0), Shape.Plain)), Core.Exprs.bvar(1)) => Option.None

fn shapeOf(st: St, f: Expr, h: Head, v: Expr, ls: List<Level>) -> ShapeAt
    ? "The shape of the constant f: a casesOn (casesOf), a sparse casesOn (sparseShape), or plain."
    match casesOf(st, h, v)
        Option.Some(cs) -> ShapeAt(st = st, sh = Shape.Cases(cs))
        Option.None -> match Bool.and(isSparseCases(h.name), List.len(h.params) == List.len(ls))
            true -> sparseShape(st, f, h, v, ls, lamsUpTo(v, 1099511627776, 0))
            false -> ShapeAt(st = st, sh = Shape.Plain)

verify shapeOf
    shapeOf(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("c"), []), Head(name = Check.Lits.name1("c"), params = [], ty = Core.Exprs.sort(Level.Zero)), Core.Exprs.natLit(1), []).sh => Shape.Plain

fn sparseShape(st: St, f: Expr, h: Head, v: Expr, ls: List<Level>, n: Int) -> ShapeAt
    ? "A sparse casesOn's shape: its body under its n lambdas, at the levels, a recursor of one motive applied to all its arguments with the major premise among the lambdas; each minor premise ready when it takes the fields and hypotheses and reads no hypothesis."
    match n > 0
        false -> ShapeAt(st = st, sh = Shape.Plain)
        true -> sparseBody(peeledBody(st, f, h, v, n, ls), n)

verify sparseShape
    sparseShape(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("c"), []), Head(name = Check.Lits.name1("c"), params = [], ty = Core.Exprs.sort(Level.Zero)), Core.Exprs.natLit(1), [], 0).sh => Shape.Plain

fn sparseBody(b: RE, n: Int) -> ShapeAt
    ? "The recursor at the head of the body, when the rest fits."
    match Core.Apps.fnOf(b.e)
        Expr.Const(_, r, _) -> match Check.State.lookup(b.st, r)
            Option.Some(Const.CRec(rv)) -> ShapeAt(st = b.st, sh = sparseFits(rv, n, Core.Apps.argsOf(b.e)))
            _ -> ShapeAt(st = b.st, sh = Shape.Plain)
        _ -> ShapeAt(st = b.st, sh = Shape.Plain)

verify sparseBody
    sparseBody(RE(e = Core.Exprs.natLit(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), 1).sh => Shape.Plain

fn sparseFits(rv: Rec, n: Int, args: List<Expr>) -> Shape
    ? "Sparse when the recursor has one motive, all its arguments, and a major premise among the n lambdas."
    majorPos = rv.numParams + rv.numMotives + rv.numMinors + rv.numIndices
    match Bool.and(Bool.and(rv.numMotives == 1, List.len(args) == majorPos + 1), majorVar(nth(args, majorPos), n))
        true -> Shape.Sparse(SparseOn(rv = rv, n = n, major = bvarIndex(nth(args, majorPos)), minors = minorsOn(args, rv, rv.rules, 0)))
        false -> Shape.Plain

verify sparseFits
    sparseFits(Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), 1, []) => Shape.Plain

fn minorsOn(args: List<Expr>, rv: Rec, rules: List<RecRule>, j: Int) -> List<Option<MinorOn>>
    ? "Each rule's minor premise ready (minorOn), in the rules' order."
    match rules
        [] -> []
        [r, ..rest] -> List.prepend(minorOn(nth(args, rv.numParams + 1 + j), r, rv, j), minorsOn(args, rv, rest, j + 1))

verify minorsOn
    minorsOn([], Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 1, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), [], 0) => []

fn minorOn(minor: Expr, r: RecRule, rv: Rec, j: Int) -> Option<MinorOn>
    ? "The j-th minor premise, picked by the j-th rule, under lambdas for the fields and the hypotheses, reading no hypothesis: its body under them."
    w = r.nfields + hypsOf(r, rv)
    match Bool.and(Bool.and(ruleSelects(r, rv.numParams, rv.numMinors, j), lamsUpTo(minor, w, 0) == w), unusedBelow(peelLams(minor, w), w - r.nfields))
        true -> Option.Some(MinorOn(nf = r.nfields, hyps = w - r.nfields, body = peelLams(minor, w)))
        false -> Option.None

verify minorOn
    minorOn(Core.Exprs.natLit(8), RecRule(ctor = Core.Names.anon(), nfields = 0, rhs = Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Binder.Default)), Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 1, numMinors = 1, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), 0) => Option.Some(MinorOn(nf = 0, hyps = 0, body = Core.Exprs.natLit(8)))

fn sparsePick(st: St, sp: SparseOn, e: Expr, env0: List<Clo>, cheapRec: Bool, cheapProj: Bool) -> Result<RPick, Fail>
    ? "The minor premise for the major premise e and the environment it runs in; a literal of Nat goes to its rule at once (LiteralCases)."
    match e
        Expr.NatLit(n) -> match Bool.and(sp.rv.major == Check.Lits.nat, List.len(sp.rv.rules) == 2)
            true -> Result.Ok(sparseFields(st, nthMinor(sp.minors, ruleNumber(sp.rv.rules, litCtor(n), 0)), litArgs(n), env0))
            false -> Result.Ok(sparseBuilt(sp, majorToCtor(st, sp.rv, e, cheapRec, cheapProj)?, env0))
        _ -> Result.Ok(sparseBuilt(sp, majorToCtor(st, sp.rv, e, cheapRec, cheapProj)?, env0))

verify sparsePick
    Result.withDefault(sparsePick(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), SparseOn(rv = Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), n = 1, major = 0, minors = []), Core.Exprs.fvar(0), [], false, false), RPick(st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), ok = true, body = Core.Exprs.bvar(0), env = [], rest = [])).ok => false

fn sparseBuilt(sp: SparseOn, m: RE, env0: List<Clo>) -> RPick
    ? "The minor premise of the constructor at the head of m, the major premise built."
    match ruleFor(sp.rv.rules, Core.Apps.fnOf(m.e))
        Option.Some(rule) -> sparseFields(m.st, nthMinor(sp.minors, ruleNumber(sp.rv.rules, rule.ctor, 0)), Core.Apps.argsOf(m.e), env0)
        Option.None -> RPick(st = m.st, ok = false, body = m.e, env = [], rest = [])

verify sparseBuilt
    sparseBuilt(SparseOn(rv = Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), n = 1, major = 0, minors = []), RE(e = Core.Exprs.fvar(0), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), []).ok => false

fn sparseFields(st: St, mo: Option<MinorOn>, majorArgs: List<Expr>, env0: List<Clo>) -> RPick
    ? "A ready minor premise given the constructor's fields: its body, with the hypotheses standing for nothing, the fields and the definition's arguments as its environment."
    match mo
        Option.Some(k) -> match k.nf <= List.len(majorArgs)
            true -> RPick(st = st, ok = true, body = k.body, env = envOf(nothingFor(k.hyps, []), k.hyps, envOf(closedAll(List.drop(majorArgs, List.len(majorArgs) - k.nf), []), k.nf, env0)), rest = [])
            false -> RPick(st = st, ok = false, body = k.body, env = [], rest = [])
        Option.None -> RPick(st = st, ok = false, body = Core.Exprs.bvar(0), env = [], rest = [])

verify sparseFields
    sparseFields(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Option.None, [], []).ok => false

fn nthMinor(xs: List<Option<MinorOn>>, j: Int) -> Option<MinorOn>
    ? "The j-th rule's minor premise, if ready."
    match List.drop(xs, j)
        [x, .._] -> x
        [] -> Option.None

verify nthMinor
    nthMinor([], 0) => Option.None

fn majorVar(e: Expr, n: Int) -> Bool
    ? "Whether e is one of the n lambdas' variables."
    match e
        Expr.BVar(i) -> i < n
        _ -> false

verify majorVar
    majorVar(Core.Exprs.bvar(1), 2) => true
    majorVar(Core.Exprs.bvar(2), 2) => false

fn bvarIndex(e: Expr) -> Int
    ? "A bound variable's index."
    match e
        Expr.BVar(i) -> i
        _ -> 0

verify bvarIndex
    bvarIndex(Core.Exprs.bvar(3)) => 3

fn hypsOf(rule: RecRule, rv: Rec) -> Int
    ? "How many induction hypotheses the rule hands its minor premise: the arguments of its right-hand side's body past the fields."
    Core.Apps.numArgs(peelLams(rule.rhs, rv.numParams + rv.numMotives + rv.numMinors + rule.nfields)) - rule.nfields

verify hypsOf
    hypsOf(RecRule(ctor = Core.Names.anon(), nfields = 0, rhs = Core.Exprs.bvar(0)), Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 0, numMinors = 0, rules = [], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false)) => 0

fn unusedBelow(e: Expr, k: Int) -> Bool
    ? "Whether none of the bound variables 0 to k - 1 occurs loose in e."
    match k <= 0
        true -> true
        false -> Bool.and(Bool.not(Core.Subst.hasLooseBVar(e, k - 1)), unusedBelow(e, k - 1))

verify unusedBelow
    unusedBelow(Core.Exprs.bvar(2), 2) => true
    unusedBelow(Core.Exprs.bvar(1), 2) => false

fn nothingFor(k: Int, acc: List<Clo>) -> List<Clo>
    ? "k closures standing for hypotheses nothing reads."
    match k <= 0
        true -> acc
        false -> nothingFor(k - 1, List.prepend(Clo.Clo(-1, Core.Exprs.sort(Level.Zero), []), acc))

verify nothingFor
    List.len(nothingFor(2, [])) => 2

record Pick
    st: St
    ok: Bool
    at: Int
    fields: List<Clo>
    nf: Int

decision LiteralCases
    date = "2026-10-25"
    reason =
        "Nat's casesOn on a literal, as a decide over Fin meets at every"
        "list index and every compared number, built Nat.succ of the"
        "literal below, looked for that constructor's rule among the rules"
        "by its head, and took the literal back out as the field. A literal"
        "0 now goes to the zero minor premise and n+1 to the succ one with"
        "the literal n as its field, as that rule would give it. The rule"
        "is picked by a plain function, not by more steps of the machine:"
        "two more arms in its loop cost Init, std and con-leche 1% by"
        "themselves, and one of them, handed the state it did not read,"
        "copied the caches at every literal (magma-list-pair-n7 4.2 G to"
        "17.2 G). One worker on Aver 06639a5e: magma-list-deep-n36 93.5 G"
        "to 88.3 G instructions, magma-string-pair-n9 27.9 G to 27.0 G,"
        "perf total 195.5 G to 189.0 G; Init, std, con-leche and etale as"
        "they were."
    chosen = "LiteralCases"
    rejected = ["LiteralBuiltAsSucc", "LiteralCasesAsMachineSteps"]
    impacts = [casesOnGo, casesPick, litPick]

fn casesPick(st: St, cs: CasesOn, e: Expr, cheapRec: Bool, cheapProj: Bool) -> Result<Pick, Fail>
    ? "The minor premise for the major premise e, by its place among the rules, with the fields it takes."
    match e
        Expr.NatLit(n) -> match Bool.and(cs.rv.major == Check.Lits.nat, List.len(cs.rv.rules) == 2)
            true -> Result.Ok(litPick(st, cs.rv.rules, n))
            false -> Result.Ok(ruledPick(cs.rv.rules, majorToCtor(st, cs.rv, e, cheapRec, cheapProj)?))
        _ -> Result.Ok(ruledPick(cs.rv.rules, majorToCtor(st, cs.rv, e, cheapRec, cheapProj)?))

verify casesPick
    Result.withDefault(casesPick(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), CasesOn(rv = Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 1, numMinors = 2, rules = [RecRule(ctor = Check.Lits.name2("Nat", "zero"), nfields = 0, rhs = Core.Exprs.bvar(0)), RecRule(ctor = Check.Lits.name2("Nat", "succ"), nfields = 1, rhs = Core.Exprs.bvar(0))], k = false, isUnsafe = false, major = Check.Lits.nat, majorIsStruct = false, elimAnySort = false), total = 2, majorAt = 0, minorsAt = 0), Core.Exprs.natLit(3), false, false), Pick(st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), ok = false, at = 9, fields = [], nf = 9)).at => 1
    Result.withDefault(casesPick(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), CasesOn(rv = Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 1, numMinors = 1, rules = [RecRule(ctor = Check.Lits.name2("Nat", "zero"), nfields = 0, rhs = Core.Exprs.bvar(0))], k = false, isUnsafe = false, major = Check.Lits.nat, majorIsStruct = false, elimAnySort = false), total = 1, majorAt = 0, minorsAt = 0), Core.Exprs.natLit(0), false, false), Pick(st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), ok = false, at = 9, fields = [], nf = 9)).ok => true

fn litPick(st: St, rules: List<RecRule>, n: Int) -> Pick
    ? "A literal of Nat: 0 the zero rule, n+1 the succ rule with the literal n as its field."
    match n == 0
        true -> Pick(st = st, ok = true, at = ruleNumber(rules, Check.Lits.natZero, 0), fields = [], nf = 0)
        false -> Pick(st = st, ok = true, at = ruleNumber(rules, Check.Lits.natSucc, 0), fields = [Clo.Clo(-1, Core.Exprs.natLit(n - 1), [])], nf = 1)

verify litPick
    litPick(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), [RecRule(ctor = Check.Lits.name2("Nat", "zero"), nfields = 0, rhs = Core.Exprs.bvar(0)), RecRule(ctor = Check.Lits.name2("Nat", "succ"), nfields = 1, rhs = Core.Exprs.bvar(0))], 4).fields => [Clo.Clo(-1, Core.Exprs.natLit(3), [])]

fn ruledPick(rules: List<RecRule>, m: RE) -> Pick
    ? "The rule of the constructor at m's head, when there is one and m gives it all its fields."
    match ruleFor(rules, Core.Apps.fnOf(m.e))
        Option.Some(rule) -> fieldsPick(m.st, rules, rule, Core.Apps.argsOf(m.e))
        Option.None -> Pick(st = m.st, ok = false, at = 0, fields = [], nf = 0)

verify ruledPick
    ruledPick([RecRule(ctor = Check.Lits.name2("Nat", "zero"), nfields = 0, rhs = Core.Exprs.bvar(0))], RE(e = Core.Exprs.fvar(0), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe))).ok => false

fn fieldsPick(st: St, rules: List<RecRule>, rule: RecRule, args: List<Expr>) -> Pick
    ? "The rule's fields, the last of the constructor's arguments."
    match rule.nfields > List.len(args)
        true -> Pick(st = st, ok = false, at = 0, fields = [], nf = 0)
        false -> Pick(st = st, ok = true, at = ruleNumber(rules, rule.ctor, 0), fields = closedAll(List.drop(args, List.len(args) - rule.nfields), []), nf = rule.nfields)

verify fieldsPick
    fieldsPick(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), [RecRule(ctor = Check.Lits.name2("Nat", "zero"), nfields = 0, rhs = Core.Exprs.bvar(0)), RecRule(ctor = Check.Lits.name2("Nat", "succ"), nfields = 1, rhs = Core.Exprs.bvar(0))], RecRule(ctor = Check.Lits.name2("Nat", "succ"), nfields = 1, rhs = Core.Exprs.bvar(0)), [Core.Exprs.natLit(2)]).at => 1

fn casesOf(st: St, h: Head, v: Expr) -> Option<CasesOn>
    ? "The casesOn shape of a definition named casesOn: its value is lambdas over its recursor applied, at its own levels, to the parameters, the motive, the minor premises each wrapped (minorFits), the indices and the major premise, in that order. The name only spares other definitions the look."
    match h.name
        Name.Str(_, "casesOn", _) -> casesBody(st, h, lamsUpTo(v, 1099511627776, 0), v)
        _ -> Option.None

verify casesOf
    casesOf(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Head(name = Core.Names.str(Core.Names.anon(), "casesOn"), params = [], ty = Core.Exprs.sort(Level.Zero)), Core.Exprs.natLit(1)) => Option.None

fn casesBody(st: St, h: Head, n: Int, v: Expr) -> Option<CasesOn>
    ? "The recursor at the head of the body under the value's n lambdas."
    body = peelLams(v, n)
    match Core.Apps.fnOf(body)
        Expr.Const(_, r, rls) -> match Check.State.lookup(st, r)
            Option.Some(Const.CRec(rv)) -> casesFits(rv, rls == Check.State.paramLevels(h.params), n, Core.Apps.argsOf(body))
            _ -> Option.None
        _ -> Option.None

verify casesBody
    casesBody(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), 0, Core.Exprs.natLit(1)) => Option.None

fn casesFits(rv: Rec, levelsOwn: Bool, n: Int, args: List<Expr>) -> Option<CasesOn>
    ? "Whether the recursor's arguments are the casesOn's own: parameters and motive, minor premises, indices and major premise, the bound variables at their places; a casesOn of a recursor with several motives is left to unfold."
    p = rv.numParams
    i = rv.numIndices
    nm = rv.numMinors
    total = p + i + nm + 2
    match Bool.and(Bool.and(levelsOwn, rv.numMotives == 1), Bool.and(n == total, List.len(args) == total))
        false -> Option.None
        true -> match Bool.and(Bool.and(varsFrom(args, n - 1, p + 1), varsFrom(List.drop(args, p + 1 + nm), n - p - 2, i + 1)), minorsFit(List.drop(args, p + 1), rv.rules, n - p - i - 3, nm, p, 0))
            true -> Option.Some(CasesOn(rv = rv, total = total, majorAt = p + i + 1, minorsAt = p + i + 2))
            false -> Option.None

verify casesFits
    casesFits(Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 1, numMinors = 1, rules = [RecRule(ctor = Core.Names.anon(), nfields = 0, rhs = Core.Exprs.bvar(0))], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), true, 3, [Core.Exprs.bvar(2), Core.Exprs.bvar(0), Core.Exprs.bvar(1)]) == Option.None => false
    casesFits(Rec(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), all = [], numParams = 0, numIndices = 0, numMotives = 1, numMinors = 1, rules = [RecRule(ctor = Core.Names.anon(), nfields = 0, rhs = Core.Exprs.bvar(0))], k = false, isUnsafe = false, major = Core.Names.anon(), majorIsStruct = false, elimAnySort = false), true, 3, [Core.Exprs.bvar(2), Core.Exprs.bvar(1), Core.Exprs.bvar(0)]) => Option.None

fn varsFrom(xs: List<Expr>, top: Int, count: Int) -> Bool
    ? "Whether the first count terms are the bound variables top, top - 1, and so on down."
    match count <= 0
        true -> true
        false -> match xs
            [x, ..rest] -> Bool.and(x == Core.Exprs.bvar(top), varsFrom(rest, top - 1, count - 1))
            [] -> false

verify varsFrom
    varsFrom([Core.Exprs.bvar(3), Core.Exprs.bvar(2)], 3, 2) => true
    varsFrom([Core.Exprs.bvar(3), Core.Exprs.bvar(1)], 3, 2) => false

fn minorsFit(ws: List<Expr>, rules: List<RecRule>, top: Int, count: Int, p: Int, j: Int) -> Bool
    ? "Whether each of the count minor premises is the casesOn's own, the bound variable top, top - 1, and so on, wrapped for its rule (minorFits), and the j-th rule of the recursor picks the j-th minor premise (ruleSelects)."
    match count <= 0
        true -> true
        false -> match ws
            [w, ..wrest] -> match rules
                [r, ..rrest] -> Bool.and(Bool.and(minorFits(w, r.nfields, top), ruleSelects(r, p, count + j, j)), minorsFit(wrest, rrest, top - 1, count - 1, p, j + 1))
                [] -> false
            [] -> false

verify minorsFit
    minorsFit([Core.Exprs.bvar(1)], [RecRule(ctor = Core.Names.anon(), nfields = 0, rhs = Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Binder.Default))], 1, 1, 0, 0) => true

fn ruleSelects(r: RecRule, p: Int, nm: Int, j: Int) -> Bool
    ? "Whether the rule's right-hand side, under its parameters, motive, nm minor premises and fields, is headed by its j-th minor premise."
    l = p + 1 + nm + r.nfields
    Core.Apps.fnOf(peelLams(r.rhs, l)) == Core.Exprs.bvar(l - 1 - (p + 1 + j))

verify ruleSelects
    ruleSelects(RecRule(ctor = Core.Names.anon(), nfields = 0, rhs = Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Binder.Default)), 0, 1, 0) => true
    ruleSelects(RecRule(ctor = Core.Names.anon(), nfields = 0, rhs = Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(1), Binder.Default), Binder.Default)), 0, 1, 0) => false

fn minorFits(w: Expr, nf: Int, minor: Int) -> Bool
    ? "Whether w is lambdas over the constructor's nf fields and its induction hypotheses whose body is the bound variable minor applied to the fields, in order: the minor premise taking the fields and dropping the hypotheses."
    k = lamsUpTo(w, 1099511627776, 0)
    body = peelLams(w, k)
    Bool.and(Bool.and(k >= nf, Core.Apps.fnOf(body) == Core.Exprs.bvar(minor + k)), Bool.and(Core.Apps.numArgs(body) == nf, varsFrom(Core.Apps.argsOf(body), k - 1, nf)))

verify minorFits
    minorFits(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.app(Core.Exprs.bvar(2), Core.Exprs.bvar(1)), Binder.Default), Binder.Default), 1, 0) => true
    minorFits(Core.Exprs.bvar(1), 0, 1) => true
    minorFits(Core.Exprs.app(Core.Exprs.bvar(1), Core.Exprs.bvar(0)), 0, 1) => false


fn peeledBody(st: St, f: Expr, h: Head, v: Expr, k: Int, ls: List<Level>) -> RE
    ? "The value under its first k lambdas at the levels, from the unfolding cache or instantiated now and kept there for the constant under its key at k, made without building a term (KeysUnbuilt)."
    match Check.State.cacheGetAt(st.unfoldCache, Core.Exprs.keyAt(f, k), f)
        Option.Some(b) -> RE(e = b, st = st)
        Option.None -> keptAt(st, Core.Exprs.keyAt(f, k), f, inlined(st, Core.Subst.instLevelParams(peelLams(v, k), h.params, ls), 4))

verify peeledBody
    peeledBody(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.natLit(1), Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), Core.Exprs.bvar(0), 0, []).e => Core.Exprs.bvar(0)

decision MatchersInlined
    date = "2026-10-25"
    reason =
        "A function compiled from pattern matching passes its arguments and"
        "one lambda per alternative to a matcher, and the matcher hands them"
        "to a casesOn: at every call the machine unfolded the function,"
        "pushed a closure per argument, unfolded the matcher, pushed them"
        "all again, and beta-reduced the chosen alternative on the fields."
        "None of that depends on the arguments. The body a definition"
        "unfolds to, kept in the unfolding cache, now has a matcher at its"
        "head unfolded into it once, and the redexes this leaves of an"
        "alternative on variables reduced; delta and beta only, so the body"
        "is the same function. Only redexes on atoms are reduced, so nothing"
        "is copied and the body does not grow past the matcher's. One"
        "worker on Aver 06639a5e: magma-list-deep-n36 124.3 G to 92.4 G"
        "instructions, magma-string-pair-n9 33.9 G to 27.7 G, reachability"
        "52.5 G to 48.8 G, perf total 237.6 G to 197.5 G; Init 1.5%, std"
        "1.1% and con-leche 2.5% fewer. A constant without universe levels"
        "went the old way, its value as written met lambda by lambda; one"
        "whose body has a matcher at its head now goes through the"
        "unfolding cache as well: magma-list-pair-n21 51.6 G to 48.6 G,"
        "reachability 48.8 G to 48.1 G, Init and con-leche as they were."
        "Handing the constant already found on to the unfolding, instead of"
        "looking it up again, cost Init 1% and was left out."
    chosen = "MatchersInlined"
    rejected = ["MatchersUnfoldedAtEveryCall"]
    impacts = [peeledBody, inlined, atomBetas, bareGo, bareOnGo]

fn inlined(st: St, e: Expr, fuel: Int) -> Expr
    ? "A body under its leading lambdas with a matcher at its head unfolded into it, at most fuel times, the redexes this leaves on atoms reduced (MatchersInlined); a body without one is kept as it is."
    Option.withDefault(inlinedIn(st, e, fuel), e)

verify inlined
    inlined(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.cnst(Check.Lits.name1("match_1"), []), Core.Exprs.bvar(0)), 4) => Core.Exprs.app(Core.Exprs.cnst(Check.Lits.name1("match_1"), []), Core.Exprs.bvar(0))

fn inlinedIn(st: St, e: Expr, fuel: Int) -> Option<Expr>
    ? "The body with the matcher unfolded into it, or None when there is none to unfold."
    match e
        Expr.Lam(_, t, b) -> lamAround(t, inlinedIn(st, b, fuel))
        _ -> match fuel > 0
            true -> inlinedAt(st, e, Core.Apps.fnOf(e), fuel)
            false -> Option.None

verify inlinedIn
    inlinedIn(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), 4) => Option.None

fn inlinedAt(st: St, e: Expr, head: Expr, fuel: Int) -> Option<Expr>
    ? "A matcher at the head is unfolded when it is a safe definition at its levels with an argument for each of its lambdas; any other head stays."
    match head
        Expr.Const(_, n, ls) -> match matcherNamed(n)
            true -> matcherInto(st, e, Check.State.lookup(st, n), ls, fuel)
            false -> Option.None
        _ -> Option.None

verify inlinedAt
    inlinedAt(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), Core.Exprs.bvar(0), 4) => Option.None

fn matcherInto(st: St, e: Expr, c: Option<Const>, ls: List<Level>, fuel: Int) -> Option<Expr>
    ? "The matcher's value at the levels takes e's arguments."
    match c
        Option.Some(Const.CDefn(h, v, _, Safety.Safe)) -> match Bool.and(List.len(h.params) == List.len(ls), lamsUpTo(v, Core.Apps.numArgs(e) + 1, 0) <= Core.Apps.numArgs(e))
            true -> Option.Some(inlined(st, atomBetas(beta(Core.Subst.instLevelParams(v, h.params, ls), Core.Apps.argsOf(e), [])), fuel - 1))
            false -> Option.None
        _ -> Option.None

verify matcherInto
    matcherInto(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), Option.None, [], 4) => Option.None
    matcherInto(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.cnst(Check.Lits.name1("m"), []), Core.Exprs.bvar(3)), Option.Some(Const.CDefn(Head(name = Check.Lits.name1("m"), params = [], ty = Core.Exprs.sort(Level.Zero)), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.app(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Core.Exprs.bvar(0)), Binder.Default), Hints.Abbrev, Safety.Safe)), [], 4) => Option.Some(Core.Exprs.bvar(3))

fn matcherNamed(n: Name) -> Bool
    ? "A name a matcher has, match_ and its number."
    match n
        Name.Str(_, s, _) -> String.startsWith(s, "match_")
        _ -> false

verify matcherNamed
    matcherNamed(Check.Lits.name2("List", "match_1")) => true
    matcherNamed(Check.Lits.name2("List", "casesOn")) => false

fn atomBetas(e: Expr) -> Expr
    ? "Every redex whose arguments are atoms reduced, inside out. Such a redex never grows, and substituting atoms makes no new one; types are left as they are, and so is every subterm without such a redex."
    Option.withDefault(betasIn(e), e)

verify atomBetas
    atomBetas(Core.Exprs.app(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Core.Exprs.bvar(5))) => Core.Exprs.bvar(5)
    atomBetas(Core.Exprs.app(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Core.Exprs.app(Core.Exprs.bvar(5), Core.Exprs.bvar(5)))) => Core.Exprs.app(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Core.Exprs.app(Core.Exprs.bvar(5), Core.Exprs.bvar(5)))

fn betasIn(e: Expr) -> Option<Expr>
    ? "e with its redexes on atoms reduced, or None when it has none."
    match e
        Expr.App(_, _, _) -> appBetas(Core.Apps.fnOf(e), Core.Apps.argsOf(e), betasIn(Core.Apps.fnOf(e)), betasAll(Core.Apps.argsOf(e), [], false))
        Expr.Lam(_, t, b) -> lamAround(t, betasIn(b))
        Expr.Let(_, t, v, b) -> letBetas(t, v, b, betasIn(v), betasIn(b))
        Expr.Proj(_, s, i, x) -> projBetas(s, i, betasIn(x))
        _ -> Option.None

verify betasIn
    betasIn(Core.Exprs.app(Core.Exprs.bvar(5), Core.Exprs.bvar(5))) => Option.None

fn betasAll(es: List<Expr>, acc: List<Expr>, touched: Bool) -> Option<List<Expr>>
    ? "betasIn of each, in order, or None when none touched."
    match es
        [] -> match touched
            true -> Option.Some(List.reverse(acc))
            false -> Option.None
        [x, ..rest] -> betasNext(rest, acc, touched, x, betasIn(x))

verify betasAll
    betasAll([Core.Exprs.bvar(1)], [], false) => Option.None

fn betasNext(rest: List<Expr>, acc: List<Expr>, touched: Bool, x: Expr, r: Option<Expr>) -> Option<List<Expr>>
    ? "One more, as it was or touched."
    match r
        Option.Some(y) -> betasAll(rest, List.prepend(y, acc), true)
        Option.None -> betasAll(rest, List.prepend(x, acc), touched)

verify betasNext
    betasNext([], [], false, Core.Exprs.bvar(1), Option.Some(Core.Exprs.bvar(2))) => Option.Some([Core.Exprs.bvar(2)])

fn appBetas(f: Expr, args: List<Expr>, fr: Option<Expr>, ar: Option<List<Expr>>) -> Option<Expr>
    ? "The head and arguments after theirs; a lambda on atoms then takes them."
    appRedex(Option.withDefault(fr, f), Option.withDefault(ar, args), Bool.or(fr != Option.None, ar != Option.None))

verify appBetas
    appBetas(Core.Exprs.bvar(0), [Core.Exprs.bvar(1)], Option.None, Option.None) => Option.None

fn appRedex(f: Expr, args: List<Expr>, touched: Bool) -> Option<Expr>
    ? "A lambda on atoms takes them; otherwise the application, rebuilt only when a part touched."
    match atomRedex(f, args)
        true -> Option.Some(beta(f, args, []))
        false -> match touched
            true -> Option.Some(Core.Apps.mkApps(f, args))
            false -> Option.None

verify appRedex
    appRedex(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), [Core.Exprs.bvar(4)], false) => Option.Some(Core.Exprs.bvar(4))

fn atomRedex(f: Expr, args: List<Expr>) -> Bool
    ? "A lambda whose arguments, as many as it takes, are atoms."
    match f
        Expr.Lam(_, _, _) -> allAtoms(List.take(args, lamsUpTo(f, List.len(args), 0)))
        _ -> false

verify atomRedex
    atomRedex(Core.Exprs.bvar(0), [Core.Exprs.bvar(1)]) => false

fn lamAround(t: Expr, r: Option<Expr>) -> Option<Expr>
    ? "A lambda around a changed body."
    match r
        Option.Some(b) -> Option.Some(Core.Exprs.lam(Core.Names.anon(), t, b, Binder.Default))
        Option.None -> Option.None

verify lamAround
    lamAround(Core.Exprs.sort(Level.Zero), Option.None) => Option.None

fn letBetas(t: Expr, v: Expr, b: Expr, rv: Option<Expr>, rb: Option<Expr>) -> Option<Expr>
    ? "A let around a changed value or body."
    match Bool.and(rv == Option.None, rb == Option.None)
        true -> Option.None
        false -> Option.Some(Core.Exprs.letE(Core.Names.anon(), t, Option.withDefault(rv, v), Option.withDefault(rb, b)))

verify letBetas
    letBetas(Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Core.Exprs.bvar(0), Option.None, Option.None) => Option.None

fn projBetas(s: Name, i: Int, r: Option<Expr>) -> Option<Expr>
    ? "A projection of a changed term."
    match r
        Option.Some(x) -> Option.Some(Core.Exprs.proj(s, i, x))
        Option.None -> Option.None

verify projBetas
    projBetas(Core.Names.anon(), 0, Option.None) => Option.None

fn allAtoms(es: List<Expr>) -> Bool
    ? "Variables, constants, sorts and literals only."
    match es
        [] -> true
        [x, ..rest] -> match x
            Expr.BVar(_) -> allAtoms(rest)
            Expr.FVar(_) -> allAtoms(rest)
            Expr.Const(_, _, _) -> allAtoms(rest)
            Expr.Sort(_) -> allAtoms(rest)
            Expr.NatLit(_) -> allAtoms(rest)
            _ -> false

verify allAtoms
    allAtoms([Core.Exprs.bvar(1), Core.Exprs.natLit(2)]) => true
    allAtoms([Core.Exprs.app(Core.Exprs.bvar(1), Core.Exprs.bvar(1))]) => false

fn lamsUpTo(e: Expr, n: Int, k: Int) -> Int
    ? "How many leading lambdas e has past the k counted, up to n."
    match k >= n
        true -> k
        false -> match e
            Expr.Lam(_, _, b) -> lamsUpTo(b, n, k + 1)
            _ -> k

verify lamsUpTo
    lamsUpTo(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), 3, 0) => 1
    lamsUpTo(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), 0, 0) => 0

fn peelLams(e: Expr, k: Int) -> Expr
    ? "e under its first k lambdas."
    match k <= 0
        true -> e
        false -> match e
            Expr.Lam(_, _, b) -> peelLams(b, k - 1)
            _ -> e

verify peelLams
    peelLams(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), 1) => Core.Exprs.bvar(0)

fn lproject(st: St, s: Name, i: Int, x: MX, stack: List<Clo>, delta: Bool, cheapRec: Bool, cheapProj: Bool) -> Result<RE, Fail>
    ? "A projection of a built structure; the field takes the waiting arguments as they are."
    r = reduceProj(st, s, i, x.e, cheapRec, cheapProj)?
    match r.o
        Option.Some(m) -> lcore(r.st, m, [], stack, x.ms, delta, cheapRec, cheapProj)
        Option.None -> Result.Ok(RE(e = lstuck(MX(e = Core.Exprs.proj(s, i, x.e), ms = x.ms), stack), st = r.st))

verify lproject
    resultExpr(lproject(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Check.Lits.name1("P"), 0, MX(e = Core.Exprs.fvar(0), ms = MS(next = 0, forced = {})), [], false, false, false)) => Core.Exprs.proj(Check.Lits.name1("P"), 0, Core.Exprs.fvar(0))

fn lstuck(h: MX, stack: List<Clo>) -> Expr
    ? "A stuck head applied to the waiting arguments, all built."
    Core.Apps.mkApps(h.e, matStack(stack, h.ms, []).es)

verify lstuck
    lstuck(MX(e = Core.Exprs.fvar(0), ms = MS(next = 0, forced = {})), []) => Core.Exprs.fvar(0)

decision VariableIsItsClosure
    date = "2026-10-24"
    reason =
        "An argument that was a bound variable got a closure of its own over"
        "the whole environment, with a number of its own: one more allocation"
        "per argument, the environment kept alive by it, and, once built, a"
        "second memo entry for what the variable's closure already had. Most"
        "arguments inside matchers and structural recursion are variables. A"
        "variable of the environment now is its closure there, which builds to"
        "the same term. Instructions retired, one worker, on Aver 58a0c12f:"
        "perf/magma-list-deep-n36 218.0 G to 204.9 G, all 30 perf tests"
        "381.8 G to 361.8 G, Init 127.1 G to 126.6 G, qb9 94.5 G to 94.2 G."
    chosen = "VariableIsItsClosure"
    rejected = ["ClosureForEveryArgument"]
    impacts = [closure, varClosure]

fn closure(a: Expr, env: List<Clo>, id: Int) -> Clo
    ? "a as a closure over env; a term with no loose bound variable needs no environment, and is its own value; a variable of env is its closure there, built at most once under that closure's number (VariableIsItsClosure)."
    match a
        Expr.BVar(i) -> varClosure(List.drop(env, i), a, env, id)
        _ -> match Core.Exprs.isClosed(a)
            true -> Clo.Clo(-1, a, [])
            false -> Clo.Clo(id, a, env)

fn varClosure(from: List<Clo>, a: Expr, env: List<Clo>, id: Int) -> Clo
    ? "The closure a variable stands for, or, past the environment, the variable itself over it as before."
    match from
        [c, .._] -> c
        [] -> Clo.Clo(id, a, env)

verify varClosure
    varClosure([Clo.Clo(-1, Core.Exprs.natLit(2), [])], Core.Exprs.bvar(0), [], 3) => Clo.Clo(-1, Core.Exprs.natLit(2), [])
    varClosure([], Core.Exprs.bvar(4), [], 3) => Clo.Clo(3, Core.Exprs.bvar(4), [])

verify closure
    closure(Core.Exprs.natLit(1), [Clo.Clo(-1, Core.Exprs.natLit(2), [])], 5) => Clo.Clo(-1, Core.Exprs.natLit(1), [])
    closure(Core.Exprs.bvar(0), [Clo.Clo(7, Core.Exprs.bvar(1), [])], 5) => Clo.Clo(7, Core.Exprs.bvar(1), [])

fn closedAll(xs: List<Expr>, acc: List<Clo>) -> List<Clo>
    ? "Built terms as closures, in order."
    match xs
        [] -> List.reverse(acc)
        [x, ..rest] -> closedAll(rest, List.prepend(Clo.Clo(-1, x, []), acc))

verify closedAll
    closedAll([Core.Exprs.natLit(1)], []) => [Clo.Clo(-1, Core.Exprs.natLit(1), [])]

fn nthClo(env: List<Clo>, k: Int) -> Clo
    ? "The k-th closure; callers keep k in range."
    match List.drop(env, k)
        [c, .._] -> c
        [] -> Clo.Clo(-1, Core.Exprs.bvar(0), [])

verify nthClo
    nthClo([Clo.Clo(-1, Core.Exprs.natLit(1), [])], 0) => Clo.Clo(-1, Core.Exprs.natLit(1), [])

fn matTerm(t: Expr, env: List<Clo>, ms: MS) -> MX
    ? "t with its loose bound variables replaced by their closures, built; a closure is built when its variable is met, so those t never uses stay closures."
    match Core.Exprs.isClosed(t)
        true -> MX(e = t, ms = ms)
        false -> fromLS(lgo(t, 0, env, ms, {}))

verify matTerm
    matTerm(Core.Exprs.bvar(0), [Clo.Clo(-1, Core.Exprs.natLit(3), [])], MS(next = 0, forced = {})).e => Core.Exprs.natLit(3)
    matTerm(Core.Exprs.bvar(1), [Clo.Clo(5, Core.Exprs.bvar(0), [Clo.Clo(-1, Core.Exprs.natLit(1), [])]), Clo.Clo(-1, Core.Exprs.natLit(2), [])], MS(next = 0, forced = {})).ms.forced => {}

record LS
    e: Expr
    ms: MS
    memo: Map<Core.Exprs.Key, Tuple<Expr, Expr>>

fn fromLS(r: LS) -> MX
    ? "The built term and the machine's memory."
    MX(e = r.e, ms = r.ms)

verify fromLS
    fromLS(LS(e = Core.Exprs.natLit(1), ms = MS(next = 0, forced = {}), memo = {})).e => Core.Exprs.natLit(1)

fn lgo(e: Expr, off: Int, env: List<Clo>, ms: MS, memo: Map<Core.Exprs.Key, Tuple<Expr, Expr>>) -> LS
    ? "As Core.Subst.go for instantiation: what has no loose bound variable at or above off is left alone."
    match Core.Exprs.within(e, off)
        true -> LS(e = e, ms = ms, memo = memo)
        false -> lvisit(e, off, env, ms, memo)

verify lgo
    lgo(Core.Exprs.natLit(1), 0, [], MS(next = 0, forced = {}), {}).e => Core.Exprs.natLit(1)

fn lvisit(e: Expr, off: Int, env: List<Clo>, ms: MS, memo: Map<Core.Exprs.Key, Tuple<Expr, Expr>>) -> LS
    ? "A variable takes its closure's value; large compound nodes go through the memo, as in Core.Subst."
    match e
        Expr.BVar(i) -> lbvar(List.drop(env, i - off), i, env, ms, memo)
        _ -> match Core.Exprs.isSmall(e)
            true -> lbuild(e, off, env, ms, memo)
            false -> lmemoed(e, off, env, ms, memo, Core.Exprs.keyAt(e, off))

verify lvisit
    lvisit(Core.Exprs.bvar(0), 0, [Clo.Clo(-1, Core.Exprs.natLit(2), [])], MS(next = 0, forced = {}), {}).e => Core.Exprs.natLit(2)

fn lbvar(from: List<Clo>, i: Int, env: List<Clo>, ms: MS, memo: Map<Core.Exprs.Key, Tuple<Expr, Expr>>) -> LS
    ? "The variable's closure, built on first use. A value has no loose bound variable, so it needs no lifting; a variable past the environment drops by its length."
    match from
        [c, .._] -> lvalue(matClo(c, ms), memo)
        [] -> LS(e = Core.Exprs.bvar(i - List.len(env)), ms = ms, memo = memo)

verify lbvar
    lbvar([], 3, [Clo.Clo(-1, Core.Exprs.natLit(2), [])], MS(next = 0, forced = {}), {}).e => Core.Exprs.bvar(2)

fn lvalue(x: MX, memo: Map<Core.Exprs.Key, Tuple<Expr, Expr>>) -> LS
    ? "A built value with the walk's memo."
    LS(e = x.e, ms = x.ms, memo = memo)

verify lvalue
    lvalue(MX(e = Core.Exprs.natLit(1), ms = MS(next = 0, forced = {})), {}).e => Core.Exprs.natLit(1)

fn lmemoed(e: Expr, off: Int, env: List<Clo>, ms: MS, memo: Map<Core.Exprs.Key, Tuple<Expr, Expr>>, key: Core.Exprs.Key) -> LS
    ? "A node already rebuilt at this depth is reused."
    match lhit(Map.get(memo, key), e)
        Option.Some(r) -> LS(e = r, ms = ms, memo = memo)
        Option.None -> lremember(lbuild(e, off, env, ms, memo), e, key)

verify lmemoed
    lmemoed(Core.Exprs.bvar(0), 0, [Clo.Clo(-1, Core.Exprs.natLit(2), [])], MS(next = 0, forced = {}), {}, Core.Exprs.hashKey(Core.Exprs.bvar(7))).e => Core.Exprs.bvar(0)

fn lremember(r: LS, e: Expr, key: Core.Exprs.Key) -> LS
    ? "Records a rebuilt node."
    LS(e = r.e, ms = r.ms, memo = Map.set(r.memo, key, (e, r.e)))

verify lremember
    Map.len(lremember(LS(e = Core.Exprs.natLit(1), ms = MS(next = 0, forced = {}), memo = {}), Core.Exprs.natLit(2), Core.Exprs.hashKey(Core.Exprs.bvar(4))).memo) => 1

fn lhit(entry: Option<Tuple<Expr, Expr>>, e: Expr) -> Option<Expr>
    ? "The remembered result when the entry is for this very node."
    match entry
        Option.Some((k, v)) -> match k == e
            true -> Option.Some(v)
            false -> Option.None
        Option.None -> Option.None

verify lhit
    lhit(Option.None, Core.Exprs.natLit(1)) => Option.None

fn lbuild(e: Expr, off: Int, env: List<Clo>, ms: MS, memo: Map<Core.Exprs.Key, Tuple<Expr, Expr>>) -> LS
    ? "Rebuilds one node, one binder deeper in binding positions."
    match e
        Expr.App(_, f, a) -> lapp2(lgo(f, off, env, ms, memo), a, off, env)
        Expr.Lam(_, t, b) -> lbinder(lgo(t, off, env, ms, memo), Core.Names.anon(), b, Binder.Default, off, env, true)
        Expr.Pi(_, t, b) -> lbinder(lgo(t, off, env, ms, memo), Core.Names.anon(), b, Binder.Default, off, env, false)
        Expr.Let(_, t, v, b) -> llet(lgo(t, off, env, ms, memo), Core.Names.anon(), v, b, off, env)
        Expr.Proj(_, s, i, x) -> lproj2(lgo(x, off, env, ms, memo), s, i)
        _ -> LS(e = e, ms = ms, memo = memo)

verify lbuild
    lbuild(Core.Exprs.app(Core.Exprs.bvar(0), Core.Exprs.bvar(0)), 0, [Clo.Clo(-1, Core.Exprs.natLit(2), [])], MS(next = 0, forced = {}), {}).e => Core.Exprs.app(Core.Exprs.natLit(2), Core.Exprs.natLit(2))

fn lapp2(rf: LS, a: Expr, off: Int, env: List<Clo>) -> LS
    ? "The argument after the function."
    ra = lgo(a, off, env, rf.ms, rf.memo)
    LS(e = Core.Exprs.app(rf.e, ra.e), ms = ra.ms, memo = ra.memo)

verify lapp2
    lapp2(LS(e = Core.Exprs.natLit(1), ms = MS(next = 0, forced = {}), memo = {}), Core.Exprs.natLit(2), 0, []).e => Core.Exprs.app(Core.Exprs.natLit(1), Core.Exprs.natLit(2))

fn lbinder(rt: LS, n: Name, b: Expr, bi: Binder, off: Int, env: List<Clo>, isLam: Bool) -> LS
    ? "The body one deeper, after the domain."
    rb = lgo(b, off + 1, env, rt.ms, rt.memo)
    match isLam
        true -> LS(e = Core.Exprs.lam(n, rt.e, rb.e, bi), ms = rb.ms, memo = rb.memo)
        false -> LS(e = Core.Exprs.pi(n, rt.e, rb.e, bi), ms = rb.ms, memo = rb.memo)

verify lbinder
    lbinder(LS(e = Core.Exprs.sort(Level.Zero), ms = MS(next = 0, forced = {}), memo = {}), Core.Names.anon(), Core.Exprs.bvar(0), Binder.Default, 0, [], true).e => Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default)

fn llet(rt: LS, n: Name, v: Expr, b: Expr, off: Int, env: List<Clo>) -> LS
    ? "The value at this depth, then the body one deeper."
    rv = lgo(v, off, env, rt.ms, rt.memo)
    rb = lgo(b, off + 1, env, rv.ms, rv.memo)
    LS(e = Core.Exprs.letE(n, rt.e, rv.e, rb.e), ms = rb.ms, memo = rb.memo)

verify llet
    llet(LS(e = Core.Exprs.sort(Level.Zero), ms = MS(next = 0, forced = {}), memo = {}), Core.Names.anon(), Core.Exprs.natLit(1), Core.Exprs.bvar(0), 0, []).e => Core.Exprs.letE(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.natLit(1), Core.Exprs.bvar(0))

fn lproj2(r: LS, s: Name, i: Int) -> LS
    ? "The projected structure rebuilt."
    LS(e = Core.Exprs.proj(s, i, r.e), ms = r.ms, memo = r.memo)

verify lproj2
    lproj2(LS(e = Core.Exprs.fvar(0), ms = MS(next = 0, forced = {}), memo = {}), Check.Lits.name1("P"), 0).e => Core.Exprs.proj(Check.Lits.name1("P"), 0, Core.Exprs.fvar(0))

fn matClo(c: Clo, ms: MS) -> MX
    ? "A closure built, at most once: a numbered closure is remembered once built."
    match c
        Clo.Clo(id, e, cenv) -> match id < 0
            true -> MX(e = e, ms = ms)
            false -> match Map.get(ms.forced, id)
                Option.Some(x) -> MX(e = x, ms = ms)
                Option.None -> remembered1(matTerm(e, cenv, ms), id)

verify matClo
    matClo(Clo.Clo(-1, Core.Exprs.natLit(1), []), MS(next = 0, forced = {})).e => Core.Exprs.natLit(1)
    matClo(Clo.Clo(3, Core.Exprs.bvar(0), [Clo.Clo(-1, Core.Exprs.natLit(7), [])]), MS(next = 0, forced = {})).ms.forced => {3 => Core.Exprs.natLit(7)}

fn remembered1(x: MX, id: Int) -> MX
    ? "Records a built closure."
    MX(e = x.e, ms = MS.update(x.ms, forced = Map.set(x.ms.forced, id, x.e)))

verify remembered1
    remembered1(MX(e = Core.Exprs.natLit(1), ms = MS(next = 0, forced = {})), 2).ms.forced => {2 => Core.Exprs.natLit(1)}

fn matStack(stack: List<Clo>, ms: MS, acc: List<Expr>) -> MXs
    ? "Every waiting argument built, first argument first."
    match stack
        [] -> MXs(es = List.reverse(acc), ms = ms)
        [c, ..rest] -> matStackNext(matClo(c, ms), rest, acc)

verify matStack
    matStack([Clo.Clo(-1, Core.Exprs.natLit(1), [])], MS(next = 0, forced = {}), []).es => [Core.Exprs.natLit(1)]

fn matStackNext(x: MX, rest: List<Clo>, acc: List<Expr>) -> MXs
    ? "One more built argument."
    matStack(rest, x.ms, List.prepend(x.e, acc))

verify matStackNext
    matStackNext(MX(e = Core.Exprs.natLit(1), ms = MS(next = 0, forced = {})), [], []).es => [Core.Exprs.natLit(1)]

verify mcore
    resultExpr(mcore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.app(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.app(Core.Exprs.bvar(0), Core.Exprs.bvar(1)), Binder.Default), Binder.Default), Core.Exprs.fvar(1)), Core.Exprs.fvar(2)), [], [], false, false)) => Core.Exprs.app(Core.Exprs.fvar(2), Core.Exprs.fvar(1))
    resultExpr(mcore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.letE(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.natLit(1), Core.Exprs.bvar(0)), [], [], false, false)) => Core.Exprs.natLit(1)
    resultExpr(mcore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(1), Binder.Default), Binder.Default), Core.Exprs.fvar(3)), [], [], false, false)) => Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.fvar(3), Binder.Default)
    resultExpr(mcore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.app(Core.Exprs.cnst(Check.Lits.name2("Nat", "add"), []), Core.Exprs.natLit(2)), Core.Exprs.natLit(3)), [], [], false, false)) => resultExpr(whnfCore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.app(Core.Exprs.cnst(Check.Lits.name2("Nat", "add"), []), Core.Exprs.natLit(2)), Core.Exprs.natLit(3)), false, false))

verify mcore law sameAsWhnfCore
    given a: Int = [0, 1, 5]
    given b: Int = [2, 7]
    resultExpr(mcore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.app(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.letE(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.app(Core.Exprs.bvar(1), Core.Exprs.bvar(0)), Binder.Default)), Binder.Default), Core.Exprs.natLit(a)), Core.Exprs.fvar(b)), [], [], false, false)) => resultExpr(whnfCore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.app(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.letE(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.app(Core.Exprs.bvar(1), Core.Exprs.bvar(0)), Binder.Default)), Binder.Default), Core.Exprs.natLit(a)), Core.Exprs.fvar(b)), false, false))

fn whnfCoreM(st: St, e: Expr, cheapRec: Bool, cheapProj: Bool) -> Result<RE, Fail>
    ? "whnfCore through the machine. A term the machine cannot change comes back as it is, without taking its spine apart."
    match e
        Expr.App -> match rigidHead(st, Core.Apps.fnOf(e))
            true -> Result.Ok(RE(e = e, st = st))
            false -> mcached(st, e, cheapRec, cheapProj)
        Expr.Let -> mcached(st, e, cheapRec, cheapProj)
        Expr.Proj -> mcached(st, e, cheapRec, cheapProj)
        Expr.FVar(id) -> lvar(st, e, Check.State.localValue(st.lctx, id), [], MS(next = 0, forced = {}), false, cheapRec, cheapProj)
        _ -> Result.Ok(RE(e = e, st = st))

verify whnfCoreM
    resultExpr(whnfCoreM(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.natLit(1)), false, false)) => Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.natLit(1))
    resultExpr(whnfCoreM(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.letE(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.natLit(1), Core.Exprs.bvar(0)), false, true)) => Core.Exprs.natLit(1)

fn mcached(st: St, e: Expr, cheapRec: Bool, cheapProj: Bool) -> Result<RE, Fail>
    ? "Runs the machine. Its results are not cached: keeping every intermediate result is what the machine saves, and on reduction-heavy proofs the cache cost gigabytes."
    mcore(st, e, [], [], cheapRec, cheapProj)

verify mcached
    resultExpr(mcached(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.proj(Core.Names.anon(), 0, Core.Exprs.fvar(0)), false, true)) => Core.Exprs.proj(Core.Names.anon(), 0, Core.Exprs.fvar(0))



fn minst(t: Expr, env: List<Expr>) -> Expr
    ? "t with the machine's values put in for its loose bound variables."
    match env
        [] -> t
        _ -> Core.Subst.instantiate(t, env)

verify minst
    minst(Core.Exprs.bvar(0), [Core.Exprs.natLit(4)]) => Core.Exprs.natLit(4)
    minst(Core.Exprs.bvar(0), []) => Core.Exprs.bvar(0)

fn whnfStore(st: St, orig: Expr, r: Expr) -> RE
    ? "Caches a whnf result."
    RE(e = r, st = St.update(st, whnfCache = Check.State.cachePut(st.whnfCache, orig, r)))

verify whnfStore
    Core.Cache.size(whnfStore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0), Core.Exprs.fvar(1)).st.whnfCache) => 1

fn unfoldDefinition(st: St, e: Expr) -> RO
    ? "Unfolds the head constant if it is a definition or theorem at the right number of levels."
    u = unfoldConst(st, Core.Apps.fnOf(e))
    match u.o
        Option.Some(f) -> RO(o = Option.Some(Core.Apps.mkApps(f, Core.Apps.argsOf(e))), st = u.st)
        Option.None -> u

verify unfoldDefinition
    unfoldDefinition(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0)).o => Option.None

fn unfoldConst(st: St, f: Expr) -> RO
    ? "The instantiated value of a constant. A value at universe levels is remembered for the rest of the declaration, since instantiating the levels walks the whole value each time."
    match f
        Expr.Const(_, n, ls) -> match ls
            [] -> RO(o = unfoldValue(Check.State.lookup(st, n), ls), st = st)
            _ -> unfoldCached(st, f, n, ls, Check.State.cacheGet(st.unfoldCache, f))
        _ -> RO(o = Option.None, st = st)

verify unfoldConst
    unfoldConst(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Core.Names.anon(), [])).o => Option.None
    unfoldConst(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Core.Names.anon(), [Level.Zero])).o => Option.None

fn unfoldCached(st: St, f: Expr, n: Name, ls: List<Level>, hit: Option<Expr>) -> RO
    ? "A remembered value, or the value instantiated now and remembered."
    match hit
        Option.Some(v) -> RO(o = Option.Some(v), st = st)
        Option.None -> unfoldStore(st, f, unfoldValue(Check.State.lookup(st, n), ls))

verify unfoldCached
    unfoldCached(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Core.Names.anon(), [Level.Zero]), Core.Names.anon(), [Level.Zero], Option.Some(Core.Exprs.natLit(1))).o => Option.Some(Core.Exprs.natLit(1))

fn unfoldStore(st: St, f: Expr, v: Option<Expr>) -> RO
    ? "Remembers an unfolded value under its constant."
    match v
        Option.Some(x) -> RO(o = v, st = St.update(st, unfoldCache = Check.State.cachePut(st.unfoldCache, f, x)))
        Option.None -> RO(o = v, st = st)

verify unfoldStore
    Core.Cache.size(unfoldStore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.cnst(Core.Names.anon(), []), Option.Some(Core.Exprs.natLit(1))).st.unfoldCache) => 1

fn unfoldValue(c: Option<Const>, ls: List<Level>) -> Option<Expr>
    ? "Value at the given levels, when the counts agree."
    match c
        Option.None -> Option.None
        Option.Some(k) -> match Check.State.valueOf(k)
            Option.Some(v) -> valueAt(Check.State.headOf(k), v, ls)
            Option.None -> Option.None

verify unfoldValue
    unfoldValue(Option.None, []) => Option.None

fn valueAt(h: Head, v: Expr, ls: List<Level>) -> Option<Expr>
    ? "Instantiates the universe parameters."
    match List.len(h.params) == List.len(ls)
        true -> Option.Some(Core.Subst.instLevelParams(v, h.params, ls))
        false -> Option.None

verify valueAt
    valueAt(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), Core.Exprs.natLit(1), []) => Option.Some(Core.Exprs.natLit(1))

fn isDelta(st: St, e: Expr) -> Option<Const>
    ? "The head's definition, when delta reduction can unfold it."
    match Core.Apps.fnOf(e)
        Expr.Const(_, n, ls) -> deltaConst(Check.State.lookup(st, n), ls)
        _ -> Option.None

verify isDelta
    isDelta(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0)) => Option.None

fn deltaConst(c: Option<Const>, ls: List<Level>) -> Option<Const>
    ? "Has a value and the right number of levels."
    match c
        Option.Some(k) -> match Check.State.valueOf(k)
            Option.Some -> match List.len(Check.State.headOf(k).params) == List.len(ls)
                true -> Option.Some(k)
                false -> Option.None
            Option.None -> Option.None
        Option.None -> Option.None

verify deltaConst
    deltaConst(Option.None, []) => Option.None

fn reduceNat(st: St, e: Expr) -> Result<RO, Fail>
    ? "Nat.succ and the binary Nat functions on literal arguments."
    match e
        Expr.App(_, Expr.Const(_, Name.Str(Name.Str(Name.Anon, "Nat", _), "succ", _), []), a) -> natSucc(whnfValue(st, a)?)
        Expr.App(_, Expr.App(_, Expr.Const(_, Name.Str(Name.Str(Name.Anon, "Nat", _), op, _), []), a), b) -> natBin(st, op, a, b)
        _ -> Result.Ok(RO(o = Option.None, st = st))

verify reduceNat
    resultOpt(reduceNat(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.cnst(Check.Lits.name2("Nat", "succ"), []), Core.Exprs.natLit(4)))) => Option.Some(Core.Exprs.natLit(5))

fn natSucc(a: RE) -> Result<RO, Fail>
    ? "succ of a literal."
    match Check.Lits.natValue(a.e)
        Option.Some(n) -> Result.Ok(RO(o = Option.Some(Core.Exprs.natLit(n + 1)), st = a.st))
        Option.None -> Result.Ok(RO(o = Option.None, st = a.st))

verify natSucc
    resultOpt(natSucc(RE(e = Core.Exprs.fvar(0), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)))) => Option.None

fn natBin(st: St, op: String, a: Expr, b: Expr) -> Result<RO, Fail>
    ? "Both arguments are normalized and must be literals."
    match Check.Lits.isNatOp(op)
        false -> Result.Ok(RO(o = Option.None, st = st))
        true -> natFirst(whnfValue(st, a)?, op, b)

verify natBin
    resultOpt(natBin(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), "log2", Core.Exprs.natLit(1), Core.Exprs.natLit(1))) => Option.None

fn natFirst(x: RE, op: String, b: Expr) -> Result<RO, Fail>
    ? "The first argument as a literal."
    match Check.Lits.natValue(x.e)
        Option.None -> Result.Ok(RO(o = Option.None, st = x.st))
        Option.Some(va) -> natSecond(whnfValue(x.st, b)?, op, va)

verify natFirst
    resultOpt(natFirst(RE(e = Core.Exprs.fvar(0), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), "add", Core.Exprs.natLit(1))) => Option.None

fn natSecond(y: RE, op: String, va: Int) -> Result<RO, Fail>
    ? "The second argument as a literal, then the operation."
    match Check.Lits.natValue(y.e)
        Option.None -> Result.Ok(RO(o = Option.None, st = y.st))
        Option.Some(vb) -> Result.Ok(RO(o = Option.Some(Check.Lits.natOp(op, va, vb)?), st = y.st))

verify natSecond
    resultOpt(natSecond(RE(e = Core.Exprs.natLit(2), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), "mul", 3)) => Option.Some(Core.Exprs.natLit(6))

fn resultExpr(r: Result<RE, Fail>) -> Expr
    ? "Test helper: the expression of a successful result."
    match r
        Result.Ok(x) -> x.e
        Result.Err -> Core.Exprs.bvar(999999)

verify resultExpr
    resultExpr(Result.Err(Fail.Reject("x"))) => Core.Exprs.bvar(999999)

fn resultBool(r: Result<RB, Fail>) -> Bool
    ? "Test helper: the answer of a successful result; false on an error."
    match r
        Result.Ok(x) -> x.b
        Result.Err -> false

verify resultBool
    resultBool(Result.Err(Fail.Reject("x"))) => false

fn resultOpt(r: Result<RO, Fail>) -> Option<Expr>
    ? "Test helper: the optional expression of a successful result."
    match r
        Result.Ok(x) -> x.o
        Result.Err -> Option.Some(Core.Exprs.bvar(999999))

verify resultOpt
    resultOpt(Result.Err(Fail.Reject("x"))) => Option.Some(Core.Exprs.bvar(999999))

fn yes(st: St) -> Result<RB, Fail>
    ? "Equal."
    Result.Ok(RB(b = true, st = st))

verify yes
    resultBool(yes(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe))) => true

fn no(st: St) -> Result<RB, Fail>
    ? "Not equal."
    Result.Ok(RB(b = false, st = st))

verify no
    resultBool(no(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe))) => false

fn decided(i: Int) -> Bool
    ? "A three-way answer (0 unknown, 1 equal, 2 different) that is known."
    i != 0

verify decided
    decided(0) => false

fn tri(b: Bool) -> Int
    ? "A boolean as a known three-way answer."
    match b
        true -> 1
        false -> 2

verify tri
    tri(false) => 2

fn isDefEq(st: St, t: Expr, s: Expr) -> Result<RB, Fail>
    ? "Definitional equality; successes that took real work are cached, those the quick check finds are not."
    q = quick(st, t, s)?
    match decided(q.i)
        true -> Result.Ok(RB(b = q.i == 1, st = q.st))
        false -> remembered(eqBoolTrue(q.st, t, s)?, t, s)

fn remembered(r: RB, t: Expr, s: Expr) -> Result<RB, Fail>
    ? "Records either answer for this declaration, and keeps it for later declarations when both terms are closed."
    match r.b
        true -> yes(St.update(r.st, eqOk = Check.State.pairPut(r.st.eqOk, t, s), closed = keptPair(r.st.closed, t, s)))
        false -> Result.Ok(RB(b = false, st = St.update(r.st, closed = keptFail(r.st.closed, t, s), eqNo = keptNo(r.st.eqNo, t, s))))

verify remembered
    resultBool(remembered(RB(b = false, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.bvar(0), Core.Exprs.bvar(1))) => false

fn keptNo(fails: Map<Core.Exprs.Key, Bucket>, t: Expr, s: Expr) -> Map<Core.Exprs.Key, Bucket>
    ? "Failures of this declaration. Its free variables are its own, each with one type and value, so a pair that was different stays different; terms with loose bound variables are left out."
    match Bool.and(Core.Exprs.isClosed(t), Core.Exprs.isClosed(s))
        false -> fails
        true -> Check.State.pairPut(fails, t, s)

verify keptNo
    Core.Cache.size(keptNo(Core.Cache.empty(), Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.app(Core.Exprs.fvar(1), Core.Exprs.fvar(2))), Core.Exprs.fvar(3))) => 1
    Core.Cache.size(keptNo(Core.Cache.empty(), Core.Exprs.app(Core.Exprs.bvar(0), Core.Exprs.app(Core.Exprs.fvar(1), Core.Exprs.fvar(2))), Core.Exprs.fvar(3))) => 0
    Core.Cache.size(keptNo(Core.Cache.empty(), Core.Exprs.fvar(0), Core.Exprs.fvar(3))) => 1

verify isDefEq
    resultBool(isDefEq(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Max(Level.Zero, Level.Zero)), Core.Exprs.bvar(0), Binder.Implicit))) => true
    resultBool(isDefEq(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.natLit(5), Core.Exprs.natLit(4))) => false
    resultBool(isDefEq(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Core.Exprs.natLit(1)), Core.Exprs.natLit(1))) => true

fn keptPair(closed: Map<Core.Exprs.Key, Bucket>, t: Expr, s: Expr) -> Map<Core.Exprs.Key, Bucket>
    ? "The cache kept across declarations, with the pair when it belongs there."
    match sharedPair(t, s)
        true -> Check.State.closedPairPut(closed, t, s)
        false -> closed

verify keptPair
    Core.Cache.size(keptPair(Core.Cache.empty(), Core.Exprs.natLit(1), Core.Exprs.fvar(0))) => 0
    Core.Cache.size(keptPair(Core.Cache.empty(), Core.Exprs.natLit(1), Core.Exprs.natLit(2))) => 1

fn keptFail(closed: Map<Core.Exprs.Key, Bucket>, t: Expr, s: Expr) -> Map<Core.Exprs.Key, Bucket>
    ? "The cache kept across declarations, with the pair as different when it belongs there."
    match sharedPair(t, s)
        true -> Check.State.closedFailPut(closed, t, s)
        false -> closed

verify keptFail
    Core.Cache.size(keptFail(Core.Cache.empty(), Core.Exprs.natLit(1), Core.Exprs.fvar(0))) => 0
    Core.Cache.size(keptFail(Core.Cache.empty(), Core.Exprs.natLit(1), Core.Exprs.natLit(2))) => 1

fn sharedPair(t: Expr, s: Expr) -> Bool
    ? "A pair whose equality holds in every later declaration of a worker: both terms with no free variable, whose numbers mean something else in every declaration. Universe parameters may occur: definitional equality never checks them against the declaration's own, and compares levels by their names alone. The worker meets declarations in file order and the environment only grows, so nothing the answer used changes."
    match Core.Exprs.hasFVar(t)
        true -> false
        false -> Bool.not(Core.Exprs.hasFVar(s))

verify sharedPair
    sharedPair(Core.Exprs.natLit(1), Core.Exprs.fvar(0)) => false
    sharedPair(Core.Exprs.sort(Level.Param(Core.Names.str(Core.Names.anon(), "u"))), Core.Exprs.natLit(1)) => true

fn closedTerm(e: Expr) -> Bool
    ? "No free variable and no universe parameter."
    Bool.and(Bool.not(Core.Exprs.hasFVar(e)), Bool.not(Core.Exprs.hasParam(e)))

verify closedTerm
    closedTerm(Core.Exprs.natLit(1)) => true

fn defEqCore(st: St, t: Expr, s: Expr) -> Result<RB, Fail>
    ? "The reference is_def_eq_core, step by step."
    q = quick(st, t, s)?
    match decided(q.i)
        true -> Result.Ok(RB(b = q.i == 1, st = q.st))
        false -> eqBoolTrue(q.st, t, s)

verify defEqCore
    resultBool(defEqCore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Zero))) => true

fn eqBoolTrue(st: St, t: Expr, s: Expr) -> Result<RB, Fail>
    ? "Proof by reflection: a closed term against Bool.true is evaluated."
    match Bool.and(Bool.or(Bool.not(Core.Exprs.hasFVar(t)), st.eager), Core.Apps.isConst(s, Check.Lits.boolTrue))
        true -> eqBoolTrueWhnf(whnf(st, t)?, t, s)
        false -> eqCoreWhnf(st, t, s)

verify eqBoolTrue
    resultBool(eqBoolTrue(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.app(Core.Exprs.cnst(Check.Lits.name2("Nat", "beq"), []), Core.Exprs.natLit(2)), Core.Exprs.natLit(2)), Check.Lits.boolExpr(true))) => true

fn eqBoolTrueWhnf(w: RE, t: Expr, s: Expr) -> Result<RB, Fail>
    ? "Equal if it evaluated to Bool.true; otherwise the general path."
    match Core.Apps.isConst(w.e, Check.Lits.boolTrue)
        true -> yes(w.st)
        false -> eqCoreWhnf(w.st, t, s)

verify eqBoolTrueWhnf
    resultBool(eqBoolTrueWhnf(RE(e = Check.Lits.boolExpr(true), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.bvar(0), Core.Exprs.bvar(0))) => true

fn eqCoreWhnf(st: St, t: Expr, s: Expr) -> Result<RB, Fail>
    ? "Cheap whnfCore on both sides (projections without whnf), and the easy cases again if anything changed."
    tn = whnfCoreM(st, t, false, true)?
    sn = whnfCoreM(tn.st, s, false, true)?
    match Bool.or(tn.e != t, sn.e != s)
        true -> eqAfterQuick(quickParts(sn.st, tn.e, sn.e)?, tn.e, sn.e)
        false -> eqProofIrrel(sn.st, tn.e, sn.e)

verify eqCoreWhnf
    resultBool(eqCoreWhnf(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Core.Exprs.sort(Level.Zero)), Core.Exprs.sort(Level.Zero))) => true

fn eqAfterQuick(q: RI, tn: Expr, sn: Expr) -> Result<RB, Fail>
    ? "Stops on a known answer."
    match decided(q.i)
        true -> Result.Ok(RB(b = q.i == 1, st = q.st))
        false -> eqProofIrrel(q.st, tn, sn)

verify eqAfterQuick
    resultBool(eqAfterQuick(RI(i = 1, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.bvar(0), Core.Exprs.bvar(0))) => true

fn eqProofIrrel(st: St, tn: Expr, sn: Expr) -> Result<RB, Fail>
    ? "Two proofs of the same proposition are equal."
    p = proofIrrel(st, tn, sn)?
    match decided(p.i)
        true -> Result.Ok(RB(b = p.i == 1, st = p.st))
        false -> eqLazy(lazyDelta(p.st, tn, sn)?)

verify eqProofIrrel
    resultBool(eqProofIrrel(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Succ(Level.Zero)))) => false

fn eqLazy(ld: LD) -> Result<RB, Fail>
    ? "After lazy delta: a known answer, or the remaining structural cases."
    match ld.status
        1 -> yes(ld.st)
        2 -> no(ld.st)
        _ -> eqAfterDelta(ld.st, ld.t, ld.s)

verify eqLazy
    resultBool(eqLazy(LD(status = 2, t = Core.Exprs.bvar(0), s = Core.Exprs.bvar(0), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)))) => false

fn eqAfterDelta(st: St, tn: Expr, sn: Expr) -> Result<RB, Fail>
    ? "Same constant at equivalent levels, same free variable, or same projection."
    match sameConst(tn, sn)
        true -> yes(st)
        false -> match sameFVar(tn, sn)
            true -> yes(st)
            false -> eqProj(st, tn, sn)

verify eqAfterDelta
    resultBool(eqAfterDelta(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(1))) => true

fn sameConst(t: Expr, s: Expr) -> Bool
    ? "The same constant at equivalent levels."
    match t
        Expr.Const(_, a, la) -> match s
            Expr.Const(_, b, lb) -> Bool.and(a == b, Core.Univ.isEquivList(la, lb))
            _ -> false
        _ -> false

verify sameConst
    sameConst(Core.Exprs.cnst(Core.Names.anon(), [Level.Max(Level.Zero, Level.Succ(Level.Zero))]), Core.Exprs.cnst(Core.Names.anon(), [Level.Succ(Level.Zero)])) => true

fn sameFVar(t: Expr, s: Expr) -> Bool
    ? "The same free variable."
    match t
        Expr.FVar(a) -> match s
            Expr.FVar(b) -> a == b
            _ -> false
        _ -> false

verify sameFVar
    sameFVar(Core.Exprs.fvar(1), Core.Exprs.fvar(2)) => false

fn eqProj(st: St, tn: Expr, sn: Expr) -> Result<RB, Fail>
    ? "Projections of the same field compare their structures lazily first."
    match tn
        Expr.Proj(_, s1, i1, c1) -> match sn
            Expr.Proj(_, s2, i2, c2) -> match Bool.and(s1 == s2, i1 == i2)
                true -> eqProjAfter(lazyDeltaProj(st, c1, c2, s1, i1)?, tn, sn)
                false -> eqRewhnf(st, tn, sn)
            _ -> eqRewhnf(st, tn, sn)
        _ -> eqRewhnf(st, tn, sn)

verify eqProj
    resultBool(eqProj(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.proj(Core.Names.anon(), 0, Core.Exprs.fvar(1)), Core.Exprs.proj(Core.Names.anon(), 0, Core.Exprs.fvar(1)))) => true

fn eqProjAfter(r: RB, tn: Expr, sn: Expr) -> Result<RB, Fail>
    ? "Equal structures settle it; otherwise go on."
    match r.b
        true -> yes(r.st)
        false -> eqRewhnf(r.st, tn, sn)

verify eqProjAfter
    resultBool(eqProjAfter(RB(b = true, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.bvar(0), Core.Exprs.bvar(0))) => true

fn eqRewhnf(st: St, tn: Expr, sn: Expr) -> Result<RB, Fail>
    ? "whnfCore again, now normalizing projections fully; anything new starts over."
    a = whnfCoreM(st, tn, false, false)?
    b = whnfCoreM(a.st, sn, false, false)?
    match Bool.or(a.e != tn, b.e != sn)
        true -> defEqCore(b.st, a.e, b.e)
        false -> eqFinal(b.st, tn, sn)

verify eqRewhnf
    resultBool(eqRewhnf(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(2))) => false

fn eqFinal(st: St, tn: Expr, sn: Expr) -> Result<RB, Fail>
    ? "Both sides are in weak head normal form: congruence, eta, structure eta, string literals, unit-like types."
    a = defEqApp(st, tn, sn)?
    match a.b
        true -> yes(a.st)
        false -> eqEta(etaExpansion(a.st, tn, sn)?, tn, sn)

verify eqFinal
    resultBool(eqFinal(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.fvar(1), Core.Exprs.natLit(2)), Core.Exprs.app(Core.Exprs.fvar(1), Core.Exprs.natLit(2)))) => true

fn eqEta(r: RB, tn: Expr, sn: Expr) -> Result<RB, Fail>
    ? "After eta expansion."
    match r.b
        true -> yes(r.st)
        false -> eqEtaStruct(etaStruct(r.st, tn, sn)?, tn, sn)

verify eqEta
    resultBool(eqEta(RB(b = true, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.bvar(0), Core.Exprs.bvar(0))) => true

fn eqEtaStruct(r: RB, tn: Expr, sn: Expr) -> Result<RB, Fail>
    ? "After structure eta."
    match r.b
        true -> yes(r.st)
        false -> eqString(stringLitExpansion(r.st, tn, sn)?, tn, sn)

verify eqEtaStruct
    resultBool(eqEtaStruct(RB(b = true, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.bvar(0), Core.Exprs.bvar(0))) => true

fn eqString(q: RI, tn: Expr, sn: Expr) -> Result<RB, Fail>
    ? "After string literal expansion; the last resort is a unit-like type."
    match decided(q.i)
        true -> Result.Ok(RB(b = q.i == 1, st = q.st))
        false -> unitLike(q.st, tn, sn)

verify eqString
    resultBool(eqString(RI(i = 2, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.bvar(0), Core.Exprs.bvar(0))) => false

fn quick(st: St, t: Expr, s: Expr) -> Result<RI, Fail>
    ? "Equal terms, a cached success, or a case decided by shape alone. Equal means equal up to binder names and annotations, as in the reference kernel's first check: two copies of a term that differ only in a bound name are the same term to Lean, and comparing them as different terms makes some proofs exponential."
    match Bool.or(sameTerm(t, s), known(st, t, s))
        true -> Result.Ok(RI(i = 1, st = st))
        false -> match knownDifferent(st, t, s)
            true -> Result.Ok(RI(i = 2, st = st))
            false -> quickKinds(st, t, s)

verify quick
    quick(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.natLit(1), Core.Exprs.strLit("1")) => Result.Ok(RI(i = 2, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)))

fn quickParts(st: St, t: Expr, s: Expr) -> Result<RI, Fail>
    ? "The easy cases, and then equal parts: an application or projection whose children are pairwise identical or already found equal is equal, as the reference's equivalence check after a reduction step finds. Definitional equality is a congruence, so this holds whatever was compared before."
    q = quick(st, t, s)?
    match decided(q.i)
        true -> Result.Ok(q)
        false -> match congruentParts(q.st, t, s)
            true -> Result.Ok(RI(i = 1, st = q.st))
            false -> Result.Ok(q)

verify quickParts
    quickParts(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.fvar(1)), Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.fvar(2))) => Result.Ok(RI(i = 0, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)))
    resultInt(quickParts(St.update(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), eqOk = Check.State.pairPut(Core.Cache.empty(), Core.Exprs.fvar(1), Core.Exprs.fvar(2))), Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.fvar(1)), Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.fvar(2)))) => 1

fn congruent(st: St, t: Expr, s: Expr) -> Bool
    ? "Identical, already found equal, or made of such parts."
    match sameTerm(t, s)
        true -> true
        false -> match known(st, t, s)
            true -> true
            false -> congruentParts(st, t, s)

verify congruent
    congruent(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(1)) => true
    congruent(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(2)) => false

fn congruentParts(st: St, t: Expr, s: Expr) -> Bool
    ? "Two applications with congruent functions and arguments, or two projections of the same field of congruent structures."
    match t
        Expr.App(_, f, a) -> match s
            Expr.App(_, g, b) -> match congruent(st, f, g)
                true -> congruent(st, a, b)
                false -> false
            _ -> false
        Expr.Proj(_, n, i, x) -> match s
            Expr.Proj(_, m, j, y) -> match Bool.and(n == m, i == j)
                true -> congruent(st, x, y)
                false -> false
            _ -> false
        _ -> false

verify congruentParts
    congruentParts(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.proj(Core.Names.anon(), 0, Core.Exprs.fvar(1)), Core.Exprs.proj(Core.Names.anon(), 0, Core.Exprs.fvar(1))) => true
    congruentParts(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.proj(Core.Names.anon(), 0, Core.Exprs.fvar(1)), Core.Exprs.proj(Core.Names.anon(), 1, Core.Exprs.fvar(1))) => false
    congruentParts(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(1)) => false

fn known(st: St, t: Expr, s: Expr) -> Bool
    ? "A success recorded in this declaration, or one an earlier declaration kept for closed terms."
    match Check.State.pairGet(st.eqOk, t, s)
        true -> true
        false -> match sharedPair(t, s)
            true -> Check.State.closedPairGet(st.closed, t, s)
            false -> false

verify known
    known(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.natLit(1), Core.Exprs.natLit(2)) => false

fn knownDifferent(st: St, t: Expr, s: Expr) -> Bool
    ? "Closed terms an earlier declaration found different, or terms this declaration found different. Not while reducing eagerly: that finds more equalities, so a failure without it does not hold with it."
    match sharedPair(t, s)
        true -> Check.State.closedFailGet(st.closed, t, s)
        false -> Bool.and(Bool.not(st.eager), Check.State.pairGet(st.eqNo, t, s))

verify knownDifferent
    knownDifferent(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.natLit(1), Core.Exprs.natLit(2)) => false

fn sameTerm(t: Expr, s: Expr) -> Bool
    ? "Identical. Terms keep no binder names or annotations (BindersUnnamed), so identical is equal up to them."
    t == s

verify sameTerm
    sameTerm(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Core.Exprs.lam(Core.Names.str(Core.Names.anon(), "x"), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Implicit)) => true
    sameTerm(Core.Exprs.bvar(0), Core.Exprs.bvar(1)) => false

fn quickKinds(st: St, t: Expr, s: Expr) -> Result<RI, Fail>
    ? "Binders, sorts and literals of the same kind."
    match t
        Expr.Lam -> match s
            Expr.Lam -> bindingEq(st, t, s, true)
            _ -> Result.Ok(RI(i = 0, st = st))
        Expr.Pi -> match s
            Expr.Pi -> bindingEq(st, t, s, false)
            _ -> Result.Ok(RI(i = 0, st = st))
        Expr.Sort(a) -> match s
            Expr.Sort(b) -> Result.Ok(RI(i = tri(Core.Univ.isEquiv(a, b)), st = st))
            _ -> Result.Ok(RI(i = 0, st = st))
        Expr.NatLit(a) -> match s
            Expr.NatLit(b) -> Result.Ok(RI(i = tri(a == b), st = st))
            Expr.StrLit -> Result.Ok(RI(i = 2, st = st))
            _ -> Result.Ok(RI(i = 0, st = st))
        Expr.StrLit(a) -> match s
            Expr.StrLit(b) -> Result.Ok(RI(i = tri(a == b), st = st))
            Expr.NatLit -> Result.Ok(RI(i = 2, st = st))
            _ -> Result.Ok(RI(i = 0, st = st))
        _ -> Result.Ok(RI(i = 0, st = st))

verify quickKinds
    quickKinds(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Succ(Level.Zero))) => Result.Ok(RI(i = 2, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)))

fn bindingEq(st: St, t: Expr, s: Expr, isLam: Bool) -> Result<RI, Fail>
    ? "Binders compare domain by domain, then bodies under shared variables, which are closed again after, however the comparison ended. The answer is recorded as isDefEq records one, though it is found on the quick path: the same pair met again is not opened again."
    ks = st.kinds
    b = bindLoop(st, t, s, [], isLam)?
    r = remembered(RB(b = b.b, st = St.update(b.st, kinds = ks)), t, s)?
    Result.Ok(RI(i = tri(r.b), st = r.st))

verify bindingEq
    resultInt(bindingEq(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.pi(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Core.Exprs.pi(Core.Names.str(Core.Names.anon(), "y"), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Implicit), false)) => 1

fn sameBinder(e: Expr, isLam: Bool) -> Bool
    ? "A lambda (or a pi) as asked."
    match e
        Expr.Lam -> isLam
        Expr.Pi -> Bool.not(isLam)
        _ -> false

verify sameBinder
    sameBinder(Core.Exprs.bvar(0), true) => false

fn bindLoop(st: St, t: Expr, s: Expr, rev: List<Expr>, isLam: Bool) -> Result<RB, Fail>
    ? "While both sides are binders of the kind."
    match Bool.and(sameBinder(t, isLam), sameBinder(s, isLam))
        false -> isDefEq(st, Core.Subst.instantiate(t, rev), Core.Subst.instantiate(s, rev))
        true -> bindStep(st, t, s, rev, isLam)

verify bindLoop
    resultBool(bindLoop(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.natLit(1), Core.Exprs.natLit(1), [], true)) => true

fn bindStep(st: St, t: Expr, s: Expr, rev: List<Expr>, isLam: Bool) -> Result<RB, Fail>
    ? "Domains that are syntactically equal need no check."
    match domainOf(t) == domainOf(s)
        true -> bindVar(st, t, s, rev, isLam, Option.None)
        false -> bindDomains(st, t, s, rev, isLam, Core.Subst.instantiate(domainOf(s), rev), Core.Subst.instantiate(domainOf(t), rev))

verify bindStep
    resultBool(bindStep(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.natLit(1), Binder.Default), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Succ(Level.Zero)), Core.Exprs.natLit(1), Binder.Default), [], true)) => false

fn bindDomains(st: St, t: Expr, s: Expr, rev: List<Expr>, isLam: Bool, tyS: Expr, tyT: Expr) -> Result<RB, Fail>
    ? "Different domains must be equal."
    r = isDefEq(st, tyT, tyS)?
    match r.b
        false -> no(r.st)
        true -> bindVar(r.st, t, s, rev, isLam, Option.Some(tyS))

verify bindDomains
    resultBool(bindDomains(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.bvar(0), Core.Exprs.bvar(0), [], true, Core.Exprs.natLit(1), Core.Exprs.natLit(2))) => false

fn bindVar(st: St, t: Expr, s: Expr, rev: List<Expr>, isLam: Bool, tyS: Option<Expr>) -> Result<RB, Fail>
    ? "A variable only when a body uses it; otherwise a placeholder."
    match Bool.or(Core.Exprs.looseRange(bodyOf(t)) > 0, Core.Exprs.looseRange(bodyOf(s)) > 0)
        true -> bindFresh(Check.State.namesAt(st, Core.Names.anon(), Option.withDefault(tyS, Core.Subst.instantiate(domainOf(s), rev)), Option.None, Binder.Default), t, s, rev, isLam)
        false -> bindLoop(st, bodyOf(t), bodyOf(s), List.prepend(Core.Exprs.cnst(Check.Lits.dontcare, []), rev), isLam)

verify bindVar
    resultBool(bindVar(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), [], true, Option.None)) => true

fn bindFresh(loc: RE, t: Expr, s: Expr, rev: List<Expr>, isLam: Bool) -> Result<RB, Fail>
    ? "Continues under the variable."
    bindLoop(loc.st, bodyOf(t), bodyOf(s), List.prepend(loc.e, rev), isLam)

verify bindFresh
    resultBool(bindFresh(RE(e = Core.Exprs.fvar(0), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.natLit(1), Core.Exprs.natLit(1), [], true)) => true

fn proofIrrel(st: St, t: Expr, s: Expr) -> Result<RI, Fail>
    ? "If t proves a proposition, t and s are equal exactly when their types are. When the declarations of t's head constant already say that t is no proof, its type is not built to find that out (notProofByHead)."
    match notProofByHead(st, t)
        true -> Result.Ok(RI(i = 0, st = st))
        false -> proofIrrelInferred(st, t, s)

verify proofIrrel
    resultInt(proofIrrel(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Zero))) => 0

fn proofIrrelInferred(st: St, t: Expr, s: Expr) -> Result<RI, Fail>
    ? "proofIrrel by inferring t's type and its sort."
    tt = inferType(st, t)?
    p = isProp(tt.st, tt.e)?
    match p.b
        false -> Result.Ok(RI(i = 0, st = p.st))
        true -> proofTypes(p.st, tt.e, s)

verify proofIrrelInferred
    resultInt(proofIrrelInferred(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Zero))) => 0

decision NoProofReadFromTypes
    date = "2026-10-24"
    reason =
        "Before comparing two terms by proof irrelevance, the checker asks"
        "whether the first is a proof. notProofByHead answered that from the"
        "head constant's type only when it ended in a sort or in a constant"
        "family; everything else had its type inferred and its sort found,"
        "most often to hear no. On qb9 30 thousand projections x.i cost 2.6 G"
        "that way, about 90 thousand instructions each, inferring the type of"
        "a whole instance. A projection is now read from its field's type in"
        "the structure's constructor, with a sort that is never zero at any"
        "levels; a type ending in a type variable (HAdd.hAdd ends in its"
        "gamma, bound with Type u) by that variable's domain; a free variable"
        "head by its type; a partial application by the rest of its pis."
        "Instructions retired, one worker: etale 53.9 G to 52.4 G, qb9 103.3 G"
        "to 100.2 G, Init 132.4 G to 132.1 G."
    chosen = "NoProofReadFromTypes"
    rejected = ["ConstantFamiliesOnly"]
    impacts = [notProofByHead, typeSays, projSays]

fn notProofByHead(st: St, t: Expr) -> Bool
    ? "Whether t is surely no proof by its shape and the declarations of its head alone. A sort and a pi are types, whose type is a sort, and a literal is a number or a string, whose type is an inductive type in Type: none is a proof. Let t be a constant c at levels applied to exactly as many arguments as c's type has syntactic pis. If the type then ends in a sort, t is a type; if it ends in a constant D applied to as many arguments as D's type has syntactic pis, ending in Sort v, then t's type has sort v at the levels as written in c's type and then at t's levels. Inference finds t's type and its sort just so, peeling those pis without normalizing, and t is a proof exactly when that sort is zero; the arguments of t never enter. Anything else is left to inference."
    match t
        Expr.Sort -> true
        Expr.Pi -> true
        Expr.NatLit -> true
        Expr.StrLit -> true
        _ -> match Core.Apps.fnOf(t)
            Expr.Const(_, n, ls) -> headSays(st, Check.State.lookup(st, n), ls, Core.Apps.numArgs(t))
            Expr.FVar(id) -> localSays(st, id, Core.Apps.numArgs(t))
            Expr.Proj(_, sn, i, _) -> projSays(st, sn, i, Core.Apps.numArgs(t))
            _ -> false

verify notProofByHead
    notProofByHead(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.cnst(Check.Lits.name1("F"), []), Core.Exprs.sort(Level.Zero))) => true
    notProofByHead(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("F"), [])) => true
    notProofByHead(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("v"), [])) => true
    notProofByHead(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("p"), [])) => false
    notProofByHead(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.fvar(0)) => false
    notProofByHead(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.sort(Level.Zero)) => true
    notProofByHead(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.pi(Core.Names.anon(), Core.Exprs.cnst(Check.Lits.name1("P"), []), Core.Exprs.cnst(Check.Lits.name1("P"), []), Binder.Default)) => true
    notProofByHead(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.natLit(3)) => true
    notProofByHead(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.cnst(Check.Lits.name1("P"), []), Core.Exprs.bvar(0), Binder.Default)) => false

fn probeEnv() -> Env
    ? "Test helper: F : Prop -> Type, a family; T : Type and v : T, a value; P : Prop and p : P, a proof."
    Check.State.envSet(Check.State.envSet(Check.State.envSet(Check.State.envSet(Check.State.envSet(Check.State.envEmpty(), Check.Lits.name1("F"), Const.CAxiom(Head(name = Check.Lits.name1("F"), params = [], ty = Core.Exprs.pi(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Succ(Level.Zero)), Binder.Default)), false)), Check.Lits.name1("T"), Const.CAxiom(Head(name = Check.Lits.name1("T"), params = [], ty = Core.Exprs.sort(Level.Succ(Level.Zero))), false)), Check.Lits.name1("v"), Const.CAxiom(Head(name = Check.Lits.name1("v"), params = [], ty = Core.Exprs.cnst(Check.Lits.name1("T"), [])), false)), Check.Lits.name1("P"), Const.CAxiom(Head(name = Check.Lits.name1("P"), params = [], ty = Core.Exprs.sort(Level.Zero)), false)), Check.Lits.name1("p"), Const.CAxiom(Head(name = Check.Lits.name1("p"), params = [], ty = Core.Exprs.cnst(Check.Lits.name1("P"), [])), false))

verify probeEnv
    Check.State.envSize(probeEnv()) => 5

fn headSays(st: St, c: Option<Const>, ls: List<Level>, k: Int) -> Bool
    ? "notProofByHead once the head constant is found: its type past k pis, at levels ls. The level counts must agree, as inference requires."
    match c
        Option.Some(x) -> match List.len(Check.State.headOf(x).params) == List.len(ls)
            true -> typeSays(st, Check.State.headOf(x).ty, k, Check.State.headOf(x).params, ls)
            false -> false
        Option.None -> false

verify headSays
    headSays(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Option.None, [], 0) => false

fn localSays(st: St, id: Int, k: Int) -> Bool
    ? "notProofByHead for a free variable applied to k arguments, by its type."
    match Check.State.localType(st.lctx, id)
        Result.Ok(ty) -> typeSays(st, ty, k, [], [])
        Result.Err -> false

verify localSays
    localSays(Check.State.fresh(probeEnv(), [], Safety.Safe), 0, 0) => false

fn typeSays(st: St, ty: Expr, k: Int, ps: List<Name>, ls: List<Level>) -> Bool
    ? "A head of type ty applied to k arguments, the parameters ps being ls: past k syntactic pis, a sort means the term is a type, and a pi means a function, a proof exactly when its codomain is one; otherwise its type must be a family whose sort is surely not zero (familySays)."
    match peelPis(ty, k)
        Option.None -> false
        Option.Some(e) -> match e
            Expr.Sort -> true
            Expr.Pi -> typeSays(st, ty, k + 1, ps, ls)
            _ -> familySays(st, ty, k, ps, ls, Core.Apps.fnOf(e), Core.Apps.numArgs(e))

verify typeSays
    typeSays(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), 0, [], []) => true
    typeSays(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("T"), []), 0, [], []) => true
    typeSays(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.cnst(Check.Lits.name1("P"), []), 0, [], []) => false
    typeSays(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.pi(Core.Names.anon(), Core.Exprs.sort(Level.Succ(Level.Zero)), Core.Exprs.bvar(0), Binder.Default), 1, [], []) => true
    typeSays(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.pi(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), 1, [], []) => false

fn familySays(st: St, ty: Expr, k: Int, ps: List<Name>, ls: List<Level>, d: Expr, m: Int) -> Bool
    ? "The family d of the term's type, applied to m arguments: a constant whose type past m pis ends in a sort, a variable bound by one of the k pis of ty, or a free variable, whose type is so; the sort must not be zero at the levels. A type variable is the usual case: HAdd.hAdd ends in its γ, which is bound with Type u (NoProofByTypeVariables)."
    match d
        Expr.Const(_, dn, dls) -> sortSays(ps, ls, dls, Check.State.lookup(st, dn), m)
        Expr.BVar(j) -> sortNotZero(peelAfter(piDomain(ty, k - 1 - j), m), ps, ls)
        Expr.FVar(id) -> localSortSays(st, id, m)
        _ -> false

verify familySays
    familySays(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), 0, [], [], Core.Exprs.natLit(0), 0) => false

fn projSays(st: St, s: Name, i: Int, m: Int) -> Bool
    ? "notProofByHead for x.i of the structure s applied to m arguments, by the type of field i in s's constructor alone, without x's type: x's levels are unknown, so a sort there must be one that is never zero (NoProofByFieldType)."
    match Check.State.lookup(st, s)
        Option.Some(Const.CInduct(iv)) -> match iv.ctors
            [k] -> fieldSays(st, Check.State.lookup(st, k), iv.numParams + i, m)
            _ -> false
        _ -> false

verify projSays
    projSays(Check.State.fresh(probeEnv(), [], Safety.Safe), Check.Lits.name1("T"), 0, 0) => false

fn fieldSays(st: St, c: Option<Const>, n: Int, m: Int) -> Bool
    ? "projSays once the constructor is found: its pi n is the field."
    match c
        Option.Some(Const.CCtor(k)) -> match piDomain(k.head.ty, n)
            Option.Some(d) -> fieldEndSays(st, k.head.ty, n, d, m)
            Option.None -> false
        _ -> false

verify fieldSays
    fieldSays(Check.State.fresh(probeEnv(), [], Safety.Safe), Option.None, 0, 0) => false

fn fieldEndSays(st: St, cty: Expr, n: Int, d: Expr, m: Int) -> Bool
    ? "The field's type d, under the n pis of the constructor type cty before it, past m pis of its own: a sort, a pi read on, or a family whose sort is never zero."
    match peelPis(d, m)
        Option.None -> false
        Option.Some(e) -> match e
            Expr.Sort -> true
            Expr.Pi -> fieldEndSays(st, cty, n, d, m + 1)
            _ -> fieldFamilySays(st, cty, n, d, m, Core.Apps.fnOf(e), Core.Apps.numArgs(e))

verify fieldEndSays
    fieldEndSays(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), 0, Core.Exprs.pi(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Zero), Binder.Default), 0) => true
    fieldEndSays(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.pi(Core.Names.anon(), Core.Exprs.sort(Level.Succ(Level.Zero)), Core.Exprs.bvar(0), Binder.Default), 1, Core.Exprs.bvar(0), 0) => true
    fieldEndSays(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.pi(Core.Names.anon(), Core.Exprs.sort(Level.Param(Core.Names.anon())), Core.Exprs.bvar(0), Binder.Default), 1, Core.Exprs.bvar(0), 0) => false

fn fieldFamilySays(st: St, cty: Expr, n: Int, d: Expr, m: Int, f: Expr, a: Int) -> Bool
    ? "The family f, applied to a arguments, of the field's type: a constant, or a variable bound by one of the m pis of d or by one of the n pis of cty before the field."
    match f
        Expr.Const(_, dn, dls) -> neverZeroFamily(Check.State.lookup(st, dn), dls, a)
        Expr.BVar(j) -> match j < m
            true -> neverZeroSort(peelAfter(piDomain(d, m - 1 - j), a))
            false -> neverZeroSort(peelAfter(piDomain(cty, n - 1 - (j - m)), a))
        _ -> false

verify fieldFamilySays
    fieldFamilySays(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), 0, Core.Exprs.sort(Level.Zero), 0, Core.Exprs.cnst(Check.Lits.name1("T"), []), 0) => true
    fieldFamilySays(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), 0, Core.Exprs.sort(Level.Zero), 0, Core.Exprs.cnst(Check.Lits.name1("P"), []), 0) => false

fn neverZeroFamily(c: Option<Const>, dls: List<Level>, a: Int) -> Bool
    ? "A constant's type past a pis is a sort never zero at its levels as written."
    match c
        Option.Some(x) -> match List.len(Check.State.headOf(x).params) == List.len(dls)
            true -> match peelPis(Check.State.headOf(x).ty, a)
                Option.Some(Expr.Sort(w)) -> Core.Univ.isNotZero(Core.Univ.instantiate(w, Check.State.headOf(x).params, dls))
                _ -> false
            false -> false
        Option.None -> false

verify neverZeroFamily
    neverZeroFamily(Option.None, [], 0) => false

fn neverZeroSort(e: Option<Expr>) -> Bool
    ? "A sort that is never zero, whatever the levels."
    match e
        Option.Some(Expr.Sort(v)) -> Core.Univ.isNotZero(v)
        _ -> false

verify neverZeroSort
    neverZeroSort(Option.Some(Core.Exprs.sort(Level.Succ(Level.Param(Core.Names.anon()))))) => true
    neverZeroSort(Option.Some(Core.Exprs.sort(Level.Param(Core.Names.anon())))) => false

fn localSortSays(st: St, id: Int, m: Int) -> Bool
    ? "A free variable used as a family: its type past m pis is a sort that is not zero."
    match Check.State.localType(st.lctx, id)
        Result.Ok(ty) -> sortNotZero(peelPis(ty, m), [], [])
        Result.Err -> false

verify localSortSays
    localSortSays(Check.State.fresh(probeEnv(), [], Safety.Safe), 0, 0) => false

fn piDomain(ty: Expr, i: Int) -> Option<Expr>
    ? "The domain of the pi i places in, counting from 0."
    match i < 0
        true -> Option.None
        false -> match ty
            Expr.Pi(_, d, b) -> match i == 0
                true -> Option.Some(d)
                false -> piDomain(b, i - 1)
            _ -> Option.None

verify piDomain
    piDomain(Core.Exprs.pi(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), 0) => Option.Some(Core.Exprs.sort(Level.Zero))
    piDomain(Core.Exprs.sort(Level.Zero), 0) => Option.None
    piDomain(Core.Exprs.sort(Level.Zero), -1) => Option.None

fn sortNotZero(e: Option<Expr>, ps: List<Name>, ls: List<Level>) -> Bool
    ? "A sort whose level is not zero once the parameters ps are ls."
    match e
        Option.Some(Expr.Sort(v)) -> Bool.not(Core.Univ.normalizesToZero(Core.Univ.instantiate(v, ps, ls)))
        _ -> false

verify sortNotZero
    sortNotZero(Option.Some(Core.Exprs.sort(Level.Succ(Level.Zero))), [], []) => true
    sortNotZero(Option.Some(Core.Exprs.sort(Level.Zero)), [], []) => false
    sortNotZero(Option.None, [], []) => false

fn sortSays(ps: List<Name>, ls: List<Level>, dls: List<Level>, dc: Option<Const>, m: Int) -> Bool
    ? "D's type past m pis must be a sort, not zero at D's levels as written, then at ls for ps."
    match dc
        Option.Some(c) -> match List.len(Check.State.headOf(c).params) == List.len(dls)
            true -> match peelPis(Check.State.headOf(c).ty, m)
                Option.Some(Expr.Sort(v)) -> Bool.not(Core.Univ.normalizesToZero(Core.Univ.instantiate(Core.Univ.instantiate(v, Check.State.headOf(c).params, dls), ps, ls)))
                _ -> false
            false -> false
        Option.None -> false

verify sortSays
    sortSays([], [], [], Option.None, 0) => false

fn peelPis(e: Expr, k: Int) -> Option<Expr>
    ? "e past k syntactic pis, without normalizing; none if fewer."
    match k <= 0
        true -> Option.Some(e)
        false -> match e
            Expr.Pi(_, _, b) -> peelPis(b, k - 1)
            _ -> Option.None

verify peelPis
    peelPis(Core.Exprs.pi(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), 1) => Option.Some(Core.Exprs.bvar(0))
    peelPis(Core.Exprs.sort(Level.Zero), 1) => Option.None

fn proofTypes(st: St, tType: Expr, s: Expr) -> Result<RI, Fail>
    ? "Compares the two proofs' types."
    ts = inferType(st, s)?
    r = isDefEq(ts.st, tType, ts.e)?
    Result.Ok(RI(i = tri(r.b), st = r.st))

verify proofTypes
    resultInt(proofTypes(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Succ(Level.Zero)), Core.Exprs.sort(Level.Zero))) => 1

fn isNatZero(e: Expr) -> Bool
    ? "Nat.zero or the literal 0."
    Check.Lits.natValue(e) == Option.Some(0)

verify isNatZero
    isNatZero(Core.Exprs.natLit(0)) => true

fn natPred(e: Expr) -> Option<Expr>
    ? "n for a literal n+1 or Nat.succ n."
    match e
        Expr.NatLit(n) -> match n > 0
            true -> Option.Some(Core.Exprs.natLit(n - 1))
            false -> Option.None
        Expr.App(_, f, a) -> match Core.Apps.isConst(f, Check.Lits.natSucc)
            true -> Option.Some(a)
            false -> Option.None
        _ -> Option.None

verify natPred
    natPred(Core.Exprs.natLit(3)) => Option.Some(Core.Exprs.natLit(2))
    natPred(Core.Exprs.natLit(0)) => Option.None

fn defEqOffset(st: St, t: Expr, s: Expr) -> Result<RI, Fail>
    ? "Zero against zero, and successor against successor."
    match Bool.and(isNatZero(t), isNatZero(s))
        true -> Result.Ok(RI(i = 1, st = st))
        false -> offsetPreds(st, natPred(t), natPred(s))

verify defEqOffset
    resultInt(defEqOffset(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.natLit(0), Core.Exprs.cnst(Check.Lits.name2("Nat", "zero"), []))) => 1

fn offsetPreds(st: St, pt: Option<Expr>, ps: Option<Expr>) -> Result<RI, Fail>
    ? "Both successors: compare the predecessors."
    match pt
        Option.Some(a) -> match ps
            Option.Some(b) -> triOf(defEqCore(st, a, b)?)
            Option.None -> Result.Ok(RI(i = 0, st = st))
        Option.None -> Result.Ok(RI(i = 0, st = st))

verify offsetPreds
    resultInt(offsetPreds(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Option.None, Option.None)) => 0

fn triOf(r: RB) -> Result<RI, Fail>
    ? "A boolean result as a known three-way one."
    Result.Ok(RI(i = tri(r.b), st = r.st))

verify triOf
    resultInt(triOf(RB(b = true, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)))) => 1

fn lazyDelta(st: St, t: Expr, s: Expr) -> Result<LD, Fail>
    ? "Unfolds definitions one step at a time, the higher one first, until the sides meet or nothing is left to unfold."
    o = defEqOffset(st, t, s)?
    match decided(o.i)
        true -> Result.Ok(LD(status = o.i, t = t, s = s, st = o.st))
        false -> lazyNat(o.st, t, s)

verify lazyDelta
    resultStatus(lazyDelta(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(2))) => 0

fn lazyNat(st: St, t: Expr, s: Expr) -> Result<LD, Fail>
    ? "Closed terms get Nat arithmetic first."
    match Bool.or(Bool.and(Bool.not(Core.Exprs.hasFVar(t)), Bool.not(Core.Exprs.hasFVar(s))), st.eager)
        true -> lazyNatLeft(reduceNat(st, t)?, t, s)
        false -> lazyStep(st, t, s)

verify lazyNat
    resultStatus(lazyNat(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(2))) => 0

fn lazyNatLeft(r: RO, t: Expr, s: Expr) -> Result<LD, Fail>
    ? "t reduced by arithmetic decides it."
    match r.o
        Option.Some(v) -> ldOf(defEqCore(r.st, v, s)?, t, s)
        Option.None -> lazyNatRight(reduceNat(r.st, s)?, t, s)

verify lazyNatLeft
    resultStatus(lazyNatLeft(RO(o = Option.Some(Core.Exprs.natLit(1)), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.bvar(0), Core.Exprs.natLit(1))) => 1

fn lazyNatRight(r: RO, t: Expr, s: Expr) -> Result<LD, Fail>
    ? "s reduced by arithmetic decides it."
    match r.o
        Option.Some(v) -> ldOf(defEqCore(r.st, t, v)?, t, s)
        Option.None -> lazyStep(r.st, t, s)

verify lazyNatRight
    resultStatus(lazyNatRight(RO(o = Option.Some(Core.Exprs.natLit(1)), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.natLit(2), Core.Exprs.bvar(0))) => 2

fn ldOf(r: RB, t: Expr, s: Expr) -> Result<LD, Fail>
    ? "A boolean answer as a finished lazy delta."
    Result.Ok(LD(status = tri(r.b), t = t, s = s, st = r.st))

verify ldOf
    resultStatus(ldOf(RB(b = false, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.bvar(0), Core.Exprs.bvar(0))) => 2

fn lazyStep(st: St, t: Expr, s: Expr) -> Result<LD, Fail>
    ? "One unfolding step; status 3 means go round again."
    r = deltaStep(st, t, s)?
    match r.status
        3 -> lazyDelta(r.st, r.t, r.s)
        _ -> Result.Ok(r)

verify lazyStep
    resultStatus(lazyStep(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(2))) => 0

fn deltaStep(st: St, t: Expr, s: Expr) -> Result<LD, Fail>
    ? "Unfolds the side that can be unfolded, or the higher one when both can."
    match isDelta(st, t)
        Option.None -> match isDelta(st, s)
            Option.None -> Result.Ok(LD(status = 0, t = t, s = s, st = st))
            Option.Some -> unfoldRight(st, t, s)
        Option.Some(ct) -> match isDelta(st, s)
            Option.None -> unfoldLeft(st, t, s)
            Option.Some(cs) -> unfoldBoth(st, t, s, ct, cs)

verify deltaStep
    resultStatus(deltaStep(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(2))) => 0

fn unfoldLeft(st: St, t: Expr, s: Expr) -> Result<LD, Fail>
    ? "Only t unfolds; a projection application on the other side is reduced instead when it can be."
    pa = tryUnfoldProjApp(st, s)?
    match pa.o
        Option.Some(s2) -> afterStep(pa.st, t, s2)
        Option.None -> unfoldedLeft(unfoldWhnf(pa.st, t)?, s)

verify unfoldLeft
    resultStatus(unfoldLeft(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(1))) => 1

fn unfoldedLeft(u: RE, s: Expr) -> Result<LD, Fail>
    ? "After unfolding t."
    afterStep(u.st, u.e, s)

verify unfoldedLeft
    resultStatus(unfoldedLeft(RE(e = Core.Exprs.fvar(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.fvar(1))) => 1

fn unfoldRight(st: St, t: Expr, s: Expr) -> Result<LD, Fail>
    ? "Only s unfolds; symmetric to unfoldLeft."
    pa = tryUnfoldProjApp(st, t)?
    match pa.o
        Option.Some(t2) -> afterStep(pa.st, t2, s)
        Option.None -> unfoldedRight(unfoldWhnf(pa.st, s)?, t)

verify unfoldRight
    resultStatus(unfoldRight(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(1))) => 1

fn unfoldedRight(u: RE, t: Expr) -> Result<LD, Fail>
    ? "After unfolding s."
    afterStep(u.st, t, u.e)

verify unfoldedRight
    resultStatus(unfoldedRight(RE(e = Core.Exprs.fvar(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.fvar(2))) => 3

decision StepRemembered
    date = "2026-10-24"
    reason =
        "A step of lazy delta, unfolding a term's head and taking the cheap"
        "whnfCore, depends on the term alone, and lazy delta meets the same"
        "step in other pairs of the same declaration: on etale 38 thousand"
        "of 263 thousand steps repeated one already taken. The result is now"
        "remembered for the declaration. Instructions retired, one worker, on"
        "Aver bc71777c: etale 48.4 G to 48.2 G, qb9 92.5 G to 91.9 G, Init"
        "124.0 G to 123.8 G."
    chosen = "StepRemembered"
    rejected = ["StepTakenAgain"]
    impacts = [unfoldWhnf, stepStored]

fn unfoldWhnf(st: St, e: Expr) -> Result<RE, Fail>
    ? "Unfolds the head and takes the cheap whnfCore. The result is a function of e alone, so it is remembered for the declaration: lazy delta meets the same step again in other pairs (StepRemembered)."
    match Check.State.cacheGet(st.stepCache, e)
        Option.Some(r) -> Result.Ok(RE(e = r, st = st))
        Option.None -> stepStored(unfoldStep(st, e)?, e)

fn unfoldStep(st: St, e: Expr) -> Result<RE, Fail>
    ? "One unfolding step and the cheap whnfCore after it. A head at universe levels has the lambdas its arguments meet taken off before the levels are put in, as the machine unfolds (DomainsDropped)."
    match Core.Apps.fnOf(e)
        Expr.Const(_, n, ls) -> match List.len(ls) > 0
            true -> stepAt(st, e, Core.Apps.fnOf(e), ls, Check.State.lookup(st, n))
            false -> unfoldStepWhole(st, e)
        _ -> unfoldStepWhole(st, e)

fn stepAt(st: St, e: Expr, f: Expr, ls: List<Level>, c: Option<Const>) -> Result<RE, Fail>
    ? "The step for a head at levels with a value."
    match c
        Option.Some(k) -> match Check.State.valueOf(k)
            Option.Some(v) -> stepPeeled(st, e, f, Check.State.headOf(k), v, Core.Apps.argsOf(e), ls)
            Option.None -> unfoldStepWhole(st, e)
        Option.None -> unfoldStepWhole(st, e)

verify stepAt
    resultExpr(stepAt(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(1), [], Option.None)) => Core.Exprs.fvar(1)

fn stepPeeled(st: St, e: Expr, f: Expr, h: Head, v: Expr, args: List<Expr>, ls: List<Level>) -> Result<RE, Fail>
    ? "The body under the lambdas the arguments meet, at the levels, run by whnfCore's machine with those arguments as its environment."
    k = lamsUpTo(v, List.len(args), 0)
    match Bool.and(k > 0, List.len(h.params) == List.len(ls))
        false -> unfoldStepWhole(st, e)
        true -> stepRun(peeledBody(st, f, h, v, k, ls), k, closedAll(args, []))

verify stepPeeled
    resultExpr(stepPeeled(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(1), Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), Core.Exprs.natLit(1), [], [])) => Core.Exprs.fvar(1)

fn stepRun(b: RE, k: Int, stack: List<Clo>) -> Result<RE, Fail>
    ? "whnfCore's machine on the body, as unfoldStep runs it after unfolding: no delta, recursors on cheap terms not reduced, projections cheap."
    lcore(b.st, b.e, envOf(stack, k, []), List.drop(stack, k), MS(next = 0, forced = {}), false, false, true)

verify stepRun
    resultExpr(stepRun(RE(e = Core.Exprs.bvar(0), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), 1, [Clo.Clo(-1, Core.Exprs.natLit(4), [])])) => Core.Exprs.natLit(4)

fn unfoldStepWhole(st: St, e: Expr) -> Result<RE, Fail>
    ? "One unfolding of the whole value and the cheap whnfCore after it."
    u = unfoldDefinition(st, e)
    match u.o
        Option.Some(x) -> whnfCoreM(u.st, x, false, true)
        Option.None -> Result.Ok(RE(e = e, st = u.st))

verify unfoldStepWhole
    resultExpr(unfoldStepWhole(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1))) => Core.Exprs.fvar(1)

verify unfoldStep
    resultExpr(unfoldStep(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1))) => Core.Exprs.fvar(1)

fn stepStored(r: RE, e: Expr) -> Result<RE, Fail>
    ? "Remembers a step's result."
    Result.Ok(RE(e = r.e, st = St.update(r.st, stepCache = Check.State.cachePut(r.st.stepCache, e, r.e))))

verify stepStored
    resultExpr(stepStored(RE(e = Core.Exprs.natLit(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.natLit(2))) => Core.Exprs.natLit(1)

verify unfoldWhnf
    resultExpr(unfoldWhnf(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1))) => Core.Exprs.fvar(1)

fn hintOrder(a: Hints, b: Hints) -> Int
    ? "Negative: unfold the left side; positive: the right; zero: both."
    match a
        Hints.Regular(ha) -> match b
            Hints.Regular(hb) -> regularOrder(ha, hb)
            Hints.Opaque -> -1
            Hints.Abbrev -> 1
        Hints.Opaque -> match b
            Hints.Opaque -> 0
            _ -> 1
        Hints.Abbrev -> match b
            Hints.Abbrev -> 0
            Hints.Opaque -> -1
            Hints.Regular -> -1

verify hintOrder
    hintOrder(Hints.Regular(3), Hints.Regular(1)) => -1
    hintOrder(Hints.Opaque, Hints.Abbrev) => 1
    hintOrder(Hints.Abbrev, Hints.Regular(2)) => -1

fn regularOrder(ha: Int, hb: Int) -> Int
    ? "The greater height unfolds first."
    match ha == hb
        true -> 0
        false -> match ha > hb
            true -> -1
            false -> 1

verify regularOrder
    regularOrder(1, 1) => 0

fn isRegular(h: Hints) -> Bool
    ? "A regular definition."
    match h
        Hints.Regular -> true
        _ -> false

verify isRegular
    isRegular(Hints.Opaque) => false

fn unfoldBoth(st: St, t: Expr, s: Expr, ct: Const, cs: Const) -> Result<LD, Fail>
    ? "Both unfold: by hints; the same regular definition first tries equal arguments."
    c = hintOrder(Check.State.hintsOf(ct), Check.State.hintsOf(cs))
    match c < 0
        true -> unfoldedLeft(unfoldWhnf(st, t)?, s)
        false -> match c > 0
            true -> unfoldedRight(unfoldWhnf(st, s)?, t)
            false -> sameHead(st, t, s, ct, cs)

verify unfoldBoth
    resultStatus(unfoldBoth(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(1), Const.CThm(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), Core.Exprs.bvar(0)), Const.CThm(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), Core.Exprs.bvar(0)))) => 1

fn sameHead(st: St, t: Expr, s: Expr, ct: Const, cs: Const) -> Result<LD, Fail>
    ? "f as =?= f bs for a regular f: equal arguments settle it, unless that failed before."
    match Bool.and(Bool.and(Core.Apps.isApp(t), Core.Apps.isApp(s)), Bool.and(Check.State.headOf(ct).name == Check.State.headOf(cs).name, isRegular(Check.State.hintsOf(ct))))
        false -> unfoldBothNow(st, t, s)
        true -> match Check.State.pairGet(st.eqFail, t, s)
            true -> unfoldBothNow(st, t, s)
            false -> tryArgs(st, t, s, ct)

verify sameHead
    resultStatus(sameHead(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(1), Const.CThm(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), Core.Exprs.bvar(0)), Const.CThm(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), Core.Exprs.bvar(0)))) => 1

fn headLevels(e: Expr) -> List<Level>
    ? "Universe levels of the head constant."
    match Core.Apps.fnOf(e)
        Expr.Const(_, _, ls) -> ls
        _ -> []

verify headLevels
    headLevels(Core.Exprs.fvar(0)) => []

fn tryArgs(st: St, t: Expr, s: Expr, c: Const) -> Result<LD, Fail>
    ? "Equal levels and arguments mean equal terms; otherwise remember the failure and unfold both. Arguments that c never uses are not compared."
    match Core.Univ.isEquivList(headLevels(t), headLevels(s))
        false -> unfoldBothNow(St.update(st, eqFail = Check.State.pairPut(st.eqFail, t, s)), t, s)
        true -> argsTried(defEqArgs(st, t, s, unusedArgs(c, Core.Apps.numArgs(t)))?, t, s)

verify tryArgs
    resultStatus(tryArgs(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.natLit(1)), Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.natLit(1)), dropFirst())) => 1
    resultStatus(tryArgs(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.natLit(1)), Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.natLit(2)), dropFirst())) => 1

fn dropFirst() -> Const
    ? "A sample regular definition that ignores its argument: fun x => 0."
    Const.CDefn(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.natLit(0), Binder.Default), Hints.Regular(1), Safety.Safe)

verify dropFirst
    Check.State.hintsOf(dropFirst()) => Hints.Regular(1)

fn isProposition(st: St, h: Head, ls: List<Level>, d: Expr, ctx: List<Expr>) -> Bool
    ? "Whether the type d, under the domains ctx of the constant with head h at levels ls, is surely a proposition: a pi whose codomain is one, or a variable or constant applied to as many arguments as its type has syntactic pis, that type ending in a sort zero at the levels."
    match d
        Expr.Pi(_, a, b) -> isProposition(st, h, ls, b, List.prepend(a, ctx))
        _ -> headIsProp(st, h, ls, Core.Apps.fnOf(d), Core.Apps.numArgs(d), ctx)

verify isProposition
    isProposition(Check.State.fresh(probeEnv(), [], Safety.Safe), Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), [], Core.Exprs.cnst(Check.Lits.name1("P"), []), []) => true
    isProposition(Check.State.fresh(probeEnv(), [], Safety.Safe), Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), [], Core.Exprs.cnst(Check.Lits.name1("T"), []), []) => false
    isProposition(Check.State.fresh(probeEnv(), [], Safety.Safe), Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), [], Core.Exprs.bvar(0), [Core.Exprs.sort(Level.Zero)]) => true
    isProposition(Check.State.fresh(probeEnv(), [], Safety.Safe), Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), [], Core.Exprs.sort(Level.Zero), []) => false

fn headIsProp(st: St, h: Head, ls: List<Level>, f: Expr, m: Int, ctx: List<Expr>) -> Bool
    ? "The head f of the type, applied to m arguments: its own type past m pis must be a sort zero at the levels."
    match f
        Expr.BVar(j) -> sortIsZero(peelAfter(nthDomain(ctx, j), m), h.params, ls)
        Expr.Const(_, n, dls) -> constIsProp(Check.State.lookup(st, n), dls, m, h, ls)
        _ -> false

verify headIsProp
    headIsProp(Check.State.fresh(probeEnv(), [], Safety.Safe), Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), [], Core.Exprs.fvar(0), 0, []) => false

fn constIsProp(c: Option<Const>, dls: List<Level>, m: Int, h: Head, ls: List<Level>) -> Bool
    ? "A constant's type past m pis is a sort zero at its levels as written, then at h's levels."
    match c
        Option.Some(x) -> match List.len(Check.State.headOf(x).params) == List.len(dls)
            true -> match peelPis(Check.State.headOf(x).ty, m)
                Option.Some(Expr.Sort(v)) -> Core.Univ.normalizesToZero(Core.Univ.instantiate(Core.Univ.instantiate(v, Check.State.headOf(x).params, dls), h.params, ls))
                _ -> false
            false -> false
        Option.None -> false

verify constIsProp
    constIsProp(Option.None, [], 0, Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), []) => false

fn peelAfter(d: Option<Expr>, m: Int) -> Option<Expr>
    ? "peelPis of a domain that may be missing."
    match d
        Option.Some(e) -> peelPis(e, m)
        Option.None -> Option.None

verify peelAfter
    peelAfter(Option.None, 0) => Option.None

fn nthDomain(ctx: List<Expr>, j: Int) -> Option<Expr>
    ? "The domain of the binder j places out, the nearest first."
    match ctx
        [] -> Option.None
        [x, ..rest] -> match j <= 0
            true -> Option.Some(x)
            false -> nthDomain(rest, j - 1)

verify nthDomain
    nthDomain([Core.Exprs.bvar(0), Core.Exprs.bvar(1)], 1) => Option.Some(Core.Exprs.bvar(1))
    nthDomain([], 0) => Option.None

fn sortIsZero(e: Option<Expr>, ps: List<Name>, ls: List<Level>) -> Bool
    ? "A sort whose level is zero once the parameters ps are ls."
    match e
        Option.Some(Expr.Sort(v)) -> Core.Univ.normalizesToZero(Core.Univ.instantiate(v, ps, ls))
        _ -> false

verify sortIsZero
    sortIsZero(Option.Some(Core.Exprs.sort(Level.Zero)), [], []) => true
    sortIsZero(Option.Some(Core.Exprs.sort(Level.Succ(Level.Zero))), [], []) => false
    sortIsZero(Option.None, [], []) => false

fn unusedArgs(c: Const, k: Int) -> List<Bool>
    ? "For k arguments of c, last first: whether c's value drops the argument. Only when the arguments cover every leading lambda of the value, so that unfolding both sides leaves the body alone, in which that variable does not occur. No flags means compare everything."
    match Check.State.valueOf(c)
        Option.Some(v) -> unusedFrom(lamBody(v), lamCount(v, 0), k)
        Option.None -> []

verify unusedArgs
    unusedArgs(dropFirst(), 1) => [true]
    unusedArgs(dropFirst(), 2) => [false, true]
    unusedArgs(dropFirst(), 0) => []

fn lamCount(e: Expr, acc: Int) -> Int
    ? "How many lambdas e starts with, plus acc."
    match e
        Expr.Lam(_, _, b) -> lamCount(b, acc + 1)
        _ -> acc

verify lamCount
    lamCount(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), 0) => 1

fn lamBody(e: Expr) -> Expr
    ? "e without its leading lambdas."
    match e
        Expr.Lam(_, _, b) -> lamBody(b)
        _ -> e

verify lamBody
    lamBody(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default)) => Core.Exprs.bvar(0)

fn unusedFrom(body: Expr, n: Int, k: Int) -> List<Bool>
    ? "Flags for k arguments over a body under n lambdas; none when the k arguments do not reach the body."
    match k < n
        true -> []
        false -> unusedLoop(body, n, 0, k, [])

verify unusedFrom
    unusedFrom(Core.Exprs.bvar(0), 2, 1) => []
    unusedFrom(Core.Exprs.bvar(0), 2, 2) => [false, true]

fn unusedLoop(body: Expr, n: Int, i: Int, k: Int, acc: List<Bool>) -> List<Bool>
    ? "Prepends the flag of argument i, first argument first, so the last argument's flag ends up at the front. Argument i is the variable n - 1 - i of the body."
    match i >= k
        true -> acc
        false -> unusedLoop(body, n, i + 1, k, List.prepend(Bool.and(i < n, Bool.not(mentions(body, n - 1 - i))), acc))

verify unusedLoop
    unusedLoop(Core.Exprs.bvar(1), 2, 0, 3, []) => [false, true, false]

fn mentions(body: Expr, j: Int) -> Bool
    ? "Whether variable j may occur in body: not when it is outside the loose range, looked up in a small body, assumed in a large one so that a shared term is never walked as a tree."
    match Core.Exprs.within(body, j)
        true -> false
        false -> match Core.Exprs.treeSize(body) < 63
            true -> Core.Subst.hasLooseBVar(body, j)
            false -> true

verify mentions
    mentions(Core.Exprs.bvar(0), 1) => false
    mentions(Core.Exprs.app(Core.Exprs.bvar(2), Core.Exprs.bvar(0)), 1) => false
    mentions(Core.Exprs.app(Core.Exprs.bvar(2), Core.Exprs.bvar(0)), 2) => true

fn argsTried(r: RB, t: Expr, s: Expr) -> Result<LD, Fail>
    ? "Outcome of the argument comparison."
    match r.b
        true -> Result.Ok(LD(status = 1, t = t, s = s, st = r.st))
        false -> unfoldBothNow(St.update(r.st, eqFail = Check.State.pairPut(r.st.eqFail, t, s)), t, s)

verify argsTried
    resultStatus(argsTried(RB(b = true, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.bvar(0), Core.Exprs.bvar(0))) => 1

fn unfoldBothNow(st: St, t: Expr, s: Expr) -> Result<LD, Fail>
    ? "Unfolds both sides."
    u = unfoldWhnf(st, t)?
    v = unfoldWhnf(u.st, s)?
    afterStep(v.st, u.e, v.e)

verify unfoldBothNow
    resultStatus(unfoldBothNow(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(2))) => 3

fn afterStep(st: St, t: Expr, s: Expr) -> Result<LD, Fail>
    ? "The easy cases after a step; undecided means continue."
    q = quickParts(st, t, s)?
    match decided(q.i)
        true -> Result.Ok(LD(status = q.i, t = t, s = s, st = q.st))
        false -> Result.Ok(LD(status = 3, t = t, s = s, st = q.st))

verify afterStep
    resultStatus(afterStep(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(1))) => 1

fn tryUnfoldProjApp(st: St, e: Expr) -> Result<RO, Fail>
    ? "e headed by a projection, if whnfCore changes it."
    match Core.Apps.fnOf(e)
        Expr.Proj -> changed(whnfCoreM(st, e, false, false)?, e)
        _ -> Result.Ok(RO(o = Option.None, st = st))

verify tryUnfoldProjApp
    resultOpt(tryUnfoldProjApp(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0))) => Option.None

fn changed(w: RE, e: Expr) -> Result<RO, Fail>
    ? "Some only when different."
    match w.e == e
        true -> Result.Ok(RO(o = Option.None, st = w.st))
        false -> Result.Ok(RO(o = Option.Some(w.e), st = w.st))

verify changed
    resultOpt(changed(RE(e = Core.Exprs.fvar(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.fvar(0))) => Option.Some(Core.Exprs.fvar(1))

fn lazyDeltaProj(st: St, t: Expr, s: Expr, sname: Name, idx: Int) -> Result<RB, Fail>
    ? "t.idx =?= s.idx: unfold t and s lazily, and compare the fields once neither unfolds."
    r = deltaStep(st, t, s)?
    match r.status
        3 -> lazyDeltaProj(r.st, r.t, r.s, sname, idx)
        1 -> yes(r.st)
        _ -> projFallback(r.st, r.t, r.s, sname, idx)

verify lazyDeltaProj
    resultBool(lazyDeltaProj(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(2), Core.Names.anon(), 0)) => false

fn projFallback(st: St, t: Expr, s: Expr, sname: Name, idx: Int) -> Result<RB, Fail>
    ? "Fields of constructor applications, else the structures themselves."
    match projCore(st, t, sname, idx)
        Option.Some(pt) -> match projCore(st, s, sname, idx)
            Option.Some(ps) -> defEqCore(st, pt, ps)
            Option.None -> defEqCore(st, t, s)
        Option.None -> defEqCore(st, t, s)

verify projFallback
    resultBool(projFallback(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(1), Core.Exprs.fvar(1), Core.Names.anon(), 0)) => true

fn defEqArgs(st: St, t: Expr, s: Expr, skip: List<Bool>) -> Result<RB, Fail>
    ? "Pairwise equal arguments of two spines of the same length, last first, leaving out those flagged in skip."
    match t
        Expr.App(_, ft, at) -> match s
            Expr.App(_, fs, as) -> match skip
                [true, ..rest] -> defEqArgs(st, ft, fs, rest)
                [false, ..rest] -> argThen(isDefEq(st, at, as)?, ft, fs, rest)
                [] -> argThen(isDefEq(st, at, as)?, ft, fs, [])
            _ -> no(st)
        _ -> match s
            Expr.App -> no(st)
            _ -> yes(st)

verify defEqArgs
    resultBool(defEqArgs(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.natLit(1)), Core.Exprs.app(Core.Exprs.fvar(5), Core.Exprs.natLit(1)), [])) => true
    resultBool(defEqArgs(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.natLit(1)), Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.natLit(2)), [true])) => true
    resultBool(defEqArgs(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.natLit(1)), Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.natLit(2)), [false])) => false

fn argThen(r: RB, ft: Expr, fs: Expr, skip: List<Bool>) -> Result<RB, Fail>
    ? "Continues with the rest of the spine."
    match r.b
        true -> defEqArgs(r.st, ft, fs, skip)
        false -> no(r.st)

verify argThen
    resultBool(argThen(RB(b = false, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.bvar(0), Core.Exprs.bvar(0), [])) => false

fn defEqApp(st: St, t: Expr, s: Expr) -> Result<RB, Fail>
    ? "Congruence: equal heads and equal arguments."
    match Bool.and(Core.Apps.isApp(t), Core.Apps.isApp(s))
        false -> no(st)
        true -> appHeads(isDefEq(st, Core.Apps.fnOf(t), Core.Apps.fnOf(s))?, t, s)

verify defEqApp
    resultBool(defEqApp(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.natLit(1)), Core.Exprs.app(Core.Exprs.fvar(0), Core.Exprs.natLit(2)))) => false

fn appHeads(r: RB, t: Expr, s: Expr) -> Result<RB, Fail>
    ? "Then the arguments, if there are as many, first first, leaving out those in places of proofs (ProofArgsSkipped)."
    match Bool.and(r.b, Core.Apps.numArgs(t) == Core.Apps.numArgs(s))
        true -> argsOfHead(r.st, Core.Apps.fnOf(t), Core.Apps.argsOf(t), Core.Apps.argsOf(s))
        false -> no(r.st)

verify appHeads
    resultBool(appHeads(RB(b = true, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.fvar(0), Core.Exprs.fvar(0))) => true

decision ProofArgsSkipped
    date = "2026-10-24"
    reason =
        "Two applications whose heads were found equal were made equal argument"
        "by argument, and an argument that was a proof was compared like any"
        "other: its type inferred, found a proposition, and the two types"
        "compared, often down a chain of instances. But equal heads have equal"
        "types, so once the arguments before it are equal, an argument in a"
        "place whose domain is a proposition is a proof of the same proposition"
        "on both sides, and proofs of one proposition are equal. The arguments"
        "of a constant are now compared beside the pis of its type; where two"
        "differ, the domain is read as notProofByHead reads a type, and in a"
        "place of a proof they are left out. Instructions retired, one worker:"
        "etale 59.2 G to 53.9 G, qb9 109.4 G to 103.3 G, Init 131.5 G to"
        "132.4 G. Doing the same in the arguments of one definition on both"
        "sides gave nothing (their proofs are mostly the same term)."
    chosen = "ProofArgsSkipped"
    rejected = ["EveryArgumentCompared", "ProofFlagsUpFront"]
    impacts = [argsTyped, isProposition, appHeads]

fn argsOfHead(st: St, f: Expr, as: List<Expr>, bs: List<Expr>) -> Result<RB, Fail>
    ? "The arguments of a constant are compared beside the pis of its type, so that the place of an argument is looked at only when two arguments differ there (ProofArgsSkipped); those of any other head, one by one."
    match f
        Expr.Const(_, n, ls) -> argsOfConst(st, Check.State.lookup(st, n), ls, as, bs)
        _ -> argsAll(st, as, bs)

verify argsOfHead
    resultBool(argsOfHead(Check.State.fresh(probeEnv(), [], Safety.Safe), Core.Exprs.fvar(0), [Core.Exprs.natLit(1)], [Core.Exprs.natLit(2)])) => false

fn argsOfConst(st: St, c: Option<Const>, ls: List<Level>, as: List<Expr>, bs: List<Expr>) -> Result<RB, Fail>
    ? "argsOfHead once the constant is found; the level counts must agree."
    match c
        Option.Some(x) -> match List.len(Check.State.headOf(x).params) == List.len(ls)
            true -> argsTyped(st, as, bs, Check.State.headOf(x), ls, Check.State.headOf(x).ty, [])
            false -> argsAll(st, as, bs)
        Option.None -> argsAll(st, as, bs)

verify argsOfConst
    resultBool(argsOfConst(Check.State.fresh(probeEnv(), [], Safety.Safe), Option.None, [], [], [])) => true

fn argsTyped(st: St, as: List<Expr>, bs: List<Expr>, h: Head, ls: List<Level>, ty: Expr, ctx: List<Expr>) -> Result<RB, Fail>
    ? "Pairwise equality beside the pis of ty, the type of the constant with head h at levels ls; ctx holds the domains passed, the nearest first. Identical arguments are equal. Two others in a place whose domain is surely a proposition are proofs whose domains are equal once the arguments before them are, so they are equal too; the rest are compared. Past the syntactic pis, one by one."
    match ty
        Expr.Pi(_, d, body) -> match as
            [] -> yes(st)
            [a, ..arest] -> match bs
                [b, ..brest] -> match a == b
                    true -> argsTyped(st, arest, brest, h, ls, body, List.prepend(d, ctx))
                    false -> match isProposition(st, h, ls, d, ctx)
                        true -> argsTyped(st, arest, brest, h, ls, body, List.prepend(d, ctx))
                        false -> argsTypedNext(isDefEq(st, a, b)?, arest, brest, h, ls, body, List.prepend(d, ctx))
                [] -> no(st)
        _ -> argsAll(st, as, bs)

verify argsTyped
    resultBool(argsTyped(Check.State.fresh(probeEnv(), [], Safety.Safe), [Core.Exprs.fvar(1)], [Core.Exprs.fvar(2)], Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), [], Core.Exprs.pi(Core.Names.anon(), Core.Exprs.cnst(Check.Lits.name1("P"), []), Core.Exprs.sort(Level.Zero), Binder.Default), [])) => true
    resultBool(argsTyped(Check.State.fresh(probeEnv(), [], Safety.Safe), [Core.Exprs.fvar(1)], [Core.Exprs.fvar(2)], Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), [], Core.Exprs.pi(Core.Names.anon(), Core.Exprs.cnst(Check.Lits.name1("T"), []), Core.Exprs.sort(Level.Zero), Binder.Default), [])) => false

fn argsTypedNext(r: RB, as: List<Expr>, bs: List<Expr>, h: Head, ls: List<Level>, ty: Expr, ctx: List<Expr>) -> Result<RB, Fail>
    ? "Stops at the first unequal pair."
    match r.b
        true -> argsTyped(r.st, as, bs, h, ls, ty, ctx)
        false -> no(r.st)

verify argsTypedNext
    resultBool(argsTypedNext(RB(b = false, st = Check.State.fresh(probeEnv(), [], Safety.Safe)), [], [], Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), [], Core.Exprs.sort(Level.Zero), [])) => false

fn argsAll(st: St, as: List<Expr>, bs: List<Expr>) -> Result<RB, Fail>
    ? "Pairwise equality."
    match as
        [] -> yes(st)
        [a, ..arest] -> match bs
            [b, ..brest] -> argsNext(isDefEq(st, a, b)?, arest, brest)
            [] -> no(st)

verify argsAll
    resultBool(argsAll(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), [Core.Exprs.natLit(1)], [Core.Exprs.natLit(1)])) => true

fn argsNext(r: RB, as: List<Expr>, bs: List<Expr>) -> Result<RB, Fail>
    ? "Stops at the first unequal pair."
    match r.b
        true -> argsAll(r.st, as, bs)
        false -> no(r.st)

verify argsNext
    resultBool(argsNext(RB(b = false, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), [], [])) => false

fn etaExpansion(st: St, t: Expr, s: Expr) -> Result<RB, Fail>
    ? "fun x => f x against f, in either direction."
    a = etaCore(st, t, s)?
    match a.b
        true -> yes(a.st)
        false -> etaCore(a.st, s, t)

verify etaExpansion
    resultBool(etaExpansion(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0), Core.Exprs.fvar(1))) => false

fn etaCore(st: St, t: Expr, s: Expr) -> Result<RB, Fail>
    ? "t a lambda, s not: compare t with s eta expanded along its pi type."
    match t
        Expr.Lam -> match s
            Expr.Lam -> no(st)
            _ -> etaWithType(whnfOf(inferType(st, s)?)?, t, s)
        _ -> no(st)

verify etaCore
    resultBool(etaCore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0), Core.Exprs.fvar(1))) => false

fn etaWithType(w: RE, t: Expr, s: Expr) -> Result<RB, Fail>
    ? "Needs s's type to be a pi."
    match w.e
        Expr.Pi(_, d, _) -> isDefEq(w.st, t, Core.Exprs.lam(Core.Names.anon(), d, Core.Exprs.app(s, Core.Exprs.bvar(0)), Binder.Default))
        _ -> no(w.st)

verify etaWithType
    resultBool(etaWithType(RE(e = Core.Exprs.sort(Level.Zero), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.bvar(0), Core.Exprs.bvar(0))) => false

fn etaStruct(st: St, t: Expr, s: Expr) -> Result<RB, Fail>
    ? "x against mk x.1 ... x.n, in either direction."
    a = etaStructCore(st, t, s)?
    match a.b
        true -> yes(a.st)
        false -> etaStructCore(a.st, s, t)

verify etaStruct
    resultBool(etaStruct(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0), Core.Exprs.fvar(1))) => false

fn etaStructCore(st: St, t: Expr, s: Expr) -> Result<RB, Fail>
    ? "s must be a full constructor application of a non-recursive structure."
    match Core.Apps.fnOf(s)
        Expr.Const(_, n, ls) -> match Check.State.lookup(st, n)
            Option.Some(Const.CCtor(k)) -> match Bool.and(Core.Apps.numArgs(s) == k.numParams + k.numFields, isNonRecStructure(st, k.induct))
                true -> etaStructTypes(st, t, s, k, ls)
                false -> no(st)
            _ -> no(st)
        _ -> no(st)

verify etaStructCore
    resultBool(etaStructCore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0), Core.Exprs.fvar(1))) => false

decision EtaProofFieldsSkipped
    date = "2026-10-29"
    reason =
        "Structure eta compared every field of mk params fields with the"
        "projection of the other side, proof fields included: each such pair"
        "went to proof irrelevance, which inferred the projection's type and"
        "the field's type and compared the two propositions. But the types of"
        "the two sides were found equal first, so the projection of t in the"
        "place of field i proves the field's proposition at t's earlier"
        "projections, the field proves it at the earlier fields, and once"
        "those are equal the propositions are equal by congruence: proofs of"
        "one proposition are equal, as ProofArgsSkipped reads it off a"
        "constant's pis. The fields are now compared beside the constructor's"
        "pis past its parameters, and a place whose domain is a proposition"
        "is left out. A probe counted 683 field comparisons on etale, 1.5%"
        "of the steps with what they called. Instructions retired, one"
        "worker, Arena builds on Aver a714e917, median of three pairs: etale"
        "24.31 G to 24.14 G, taylor 20.30 G to 20.16 G, rep14 3.07 G to"
        "3.01 G, contdiff 17.25 G to 17.21 G, colim 4.36 G to 4.34 G; Init"
        "59.0 G, std 104.0 G, con-leche 97.4 G and reachability 26.7 G as"
        "they were, within noise."
    chosen = "EtaProofFieldsSkipped"
    rejected = ["EveryFieldCompared"]
    impacts = [etaStructTypes, fieldsTyped, projections]

fn etaStructTypes(st: St, t: Expr, s: Expr, k: Ctor, ls: List<Level>) -> Result<RB, Fail>
    ? "Equal types, then each field against the projection of t, proof fields left out (EtaProofFieldsSkipped)."
    it = inferType(st, t)?
    is = inferType(it.st, s)?
    eq = isDefEq(is.st, it.e, is.e)?
    match eq.b
        false -> no(eq.st)
        true -> fieldsTyped(eq.st, projections(k.induct, t, 0, k.numFields), List.drop(Core.Apps.argsOf(s), k.numParams), k, ls, k.head.ty, k.numParams, [])

verify etaStructTypes
    resultBool(etaStructTypes(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Succ(Level.Zero)), Ctor(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), induct = Core.Names.anon(), cidx = 0, numParams = 0, numFields = 0, isUnsafe = false), [])) => false

fn fieldsTyped(st: St, projs: List<Expr>, fields: List<Expr>, k: Ctor, ls: List<Level>, ty: Expr, params: Int, ctx: List<Expr>) -> Result<RB, Fail>
    ? "The projections against the fields beside the pis of the constructor's type at the levels ls: past its params parameters, whose domains go into ctx, the fields are compared as the arguments of a constant are (argsTyped), proof fields left out."
    match params > 0
        false -> argsTyped(st, projs, fields, k.head, ls, ty, ctx)
        true -> match ty
            Expr.Pi(_, d, b) -> fieldsTyped(st, projs, fields, k, ls, b, params - 1, List.prepend(d, ctx))
            _ -> argsAll(st, projs, fields)

verify fieldsTyped
    resultBool(fieldsTyped(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), [], [], Ctor(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), induct = Core.Names.anon(), cidx = 0, numParams = 0, numFields = 0, isUnsafe = false), [], Core.Exprs.sort(Level.Zero), 0, [])) => true
    resultBool(fieldsTyped(Check.State.fresh(probeEnv(), [], Safety.Safe), [Core.Exprs.fvar(1)], [Core.Exprs.fvar(2)], Ctor(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), induct = Core.Names.anon(), cidx = 0, numParams = 1, numFields = 1, isUnsafe = false), [], Core.Exprs.pi(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.pi(Core.Names.anon(), Core.Exprs.cnst(Check.Lits.name1("P"), []), Core.Exprs.sort(Level.Zero), Binder.Default), Binder.Default), 1, [])) => true
    resultBool(fieldsTyped(Check.State.fresh(probeEnv(), [], Safety.Safe), [Core.Exprs.fvar(1)], [Core.Exprs.fvar(2)], Ctor(head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), induct = Core.Names.anon(), cidx = 0, numParams = 1, numFields = 1, isUnsafe = false), [], Core.Exprs.pi(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.pi(Core.Names.anon(), Core.Exprs.cnst(Check.Lits.name1("T"), []), Core.Exprs.sort(Level.Zero), Binder.Default), Binder.Default), 1, [])) => false

fn projections(induct: Name, t: Expr, i: Int, n: Int) -> List<Expr>
    ? "t.i up to t.(n-1)."
    match i >= n
        true -> []
        false -> List.prepend(Core.Exprs.proj(induct, i, t), projections(induct, t, i + 1, n))

verify projections
    projections(Core.Names.anon(), Core.Exprs.fvar(0), 0, 2) => [Core.Exprs.proj(Core.Names.anon(), 0, Core.Exprs.fvar(0)), Core.Exprs.proj(Core.Names.anon(), 1, Core.Exprs.fvar(0))]
    projections(Core.Names.anon(), Core.Exprs.fvar(0), 0, 0) => []

fn stringLitExpansion(st: St, t: Expr, s: Expr) -> Result<RI, Fail>
    ? "A string literal against String.ofList of something: expand the literal."
    a = stringCore(st, t, s)?
    match decided(a.i)
        true -> Result.Ok(a)
        false -> stringCore(a.st, s, t)

verify stringLitExpansion
    resultInt(stringLitExpansion(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.fvar(0), Core.Exprs.fvar(1))) => 0

fn stringCore(st: St, t: Expr, s: Expr) -> Result<RI, Fail>
    ? "One direction of the expansion."
    match t
        Expr.StrLit(x) -> match s
            Expr.App(_, f, _) -> match f == Core.Exprs.cnst(Check.Lits.stringOfList, [])
                true -> stringExpanded(whnf(st, Check.Lits.strToCtor(x))?, s)
                false -> Result.Ok(RI(i = 0, st = st))
            _ -> Result.Ok(RI(i = 0, st = st))
        _ -> Result.Ok(RI(i = 0, st = st))

verify stringCore
    resultInt(stringCore(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.strLit(""), Check.Lits.strToCtor(""))) => 1

fn stringExpanded(w: RE, s: Expr) -> Result<RI, Fail>
    ? "Compares the expansion with s."
    triOf(defEqCore(w.st, w.e, s)?)

verify stringExpanded
    resultInt(stringExpanded(RE(e = Core.Exprs.fvar(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)), Core.Exprs.fvar(1))) => 1

fn unitLike(st: St, t: Expr, s: Expr) -> Result<RB, Fail>
    ? "Values of a structure with one field-less constructor are all equal."
    tt = inferType(st, t)?
    w = whnf(tt.st, tt.e)?
    match Core.Apps.fnOf(w.e)
        Expr.Const(_, n, _) -> match Bool.and(isNonRecStructure(w.st, n), noFields(w.st, firstCtor(w.st, n)))
            true -> unitTypes(w.st, w.e, s)
            false -> no(w.st)
        _ -> no(w.st)

verify unitLike
    resultBool(unitLike(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Zero))) => false

fn noFields(st: St, k: Option<Name>) -> Bool
    ? "The constructor has no fields."
    match k
        Option.Some(c) -> match Check.State.lookup(st, c)
            Option.Some(Const.CCtor(kv)) -> kv.numFields == 0
            _ -> false
        Option.None -> false

verify noFields
    noFields(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Option.None) => false

fn unitTypes(st: St, tType: Expr, s: Expr) -> Result<RB, Fail>
    ? "Equal when s has the same type."
    ts = inferType(st, s)?
    defEqCore(ts.st, tType, ts.e)

verify unitTypes
    resultBool(unitTypes(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Succ(Level.Zero)), Core.Exprs.sort(Level.Zero))) => true

fn resultInt(r: Result<RI, Fail>) -> Int
    ? "Test helper: the three-way answer of a successful result; -1 on an error."
    match r
        Result.Ok(x) -> x.i
        Result.Err -> -1

verify resultInt
    resultInt(Result.Err(Fail.Reject("x"))) => -1

fn resultStatus(r: Result<LD, Fail>) -> Int
    ? "Test helper: the status of a lazy delta result; -1 on an error."
    match r
        Result.Ok(x) -> x.status
        Result.Err -> -1

verify resultStatus
    resultStatus(Result.Err(Fail.Reject("x"))) => -1
