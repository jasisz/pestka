module State
    intent =
        "What the type checker carries while it checks one declaration: the"
        "environment, the local context of free variables with their fresh"
        "counter and the kinds of those open, the universe parameters in"
        "scope, and the caches. Aver has"
        "no mutable state, so every checking function takes a St and returns"
        "the St it leaves behind inside its result."
    exposes [Fail, Const, Env, Placed, ParamGen, Local, Locals, St, RE, RB, RO, envEmpty, envGet, envGetBefore, envHas, envSet, envSize, fresh, headOf, isUnsafe, isPartial, valueOf, hintsOf, lookup, declared, localType, localValue, mkBinding, cacheGet, cachePut, pairGet, pairPut, closedPairGet, closedPairPut, closedFailGet, closedFailPut, names, namesAt, closeVars]
    depends [Core.Hash, Core.Names, Core.Levels, Core.Exprs, Core.Decls, Core.Subst, Core.Cache]
    effects []

type Fail
    Reject(String)
    Decline(String)

type Const
    CAxiom(Head, Bool)
    CDefn(Head, Expr, Hints, Safety)
    CThm(Head, Expr)
    COpaque(Head, Expr, Bool)
    CQuot(Head, QuotKind)
    CInduct(IndType)
    CCtor(Ctor)
    CRec(Rec)

record ParamGen
    params: List<Name>
    cache: Map<Int, Bucket>

record Placed
    name: Name
    c: Const
    at: Int

record Env
    byHash: Map<Int, List<Placed>>
    size: Int

decision MapEnvironment
    date = "2026-10-22"
    reason =
        "The environment only grows, one declaration at a time, and since"
        "each constant carries its place no older version of it is read"
        "again: the declarations are added to one environment handed on, and"
        "the workers only read it. A persistent hash trie copied a path of"
        "16-slot nodes on every add, and every lookup took and dropped a"
        "child at each of its levels; the map finds a bucket at once and is"
        "added to in place."
    chosen = "MapEnvironment"
    rejected = ["PersistentEnvironment"]
    impacts = [Env, envSet, envGet]

decision PlacedConstants
    date = "2026-10-21"
    reason =
        "A version of the trie for every deferred declaration costs a copied"
        "path of 16-slot nodes each, about 4 KB: 3.2 GB on mathlib, kept"
        "until the end. Instead each constant carries its place, the number"
        "of constants before it, and a declaration is checked against the"
        "whole environment, seeing only the constants placed before its own."
    chosen = "PlacedConstants"
    rejected = ["VersionPerDeclaration"]
    impacts = [Env, envSet, envGetBefore, St]

fn envEmpty() -> Env
    ? "The empty environment."
    Env(byHash = {}, size = 0)

verify envEmpty
    envHas(envEmpty(), Core.Names.anon()) => false

fn envGet(env: Env, n: Name) -> Option<Const>
    ? "The constant named n."
    envFind(envBucket(env, Core.Names.hashOf(n)), n)

verify envGet
    envGet(envSet(envEmpty(), Core.Names.anon(), Const.CAxiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), false)), Core.Names.anon()) => Option.Some(Const.CAxiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), false))
    envGet(envEmpty(), Core.Names.anon()) => Option.None

fn envHas(env: Env, n: Name) -> Bool
    ? "Whether a constant is named n."
    envGet(env, n) != Option.None

verify envHas
    envHas(envSet(envEmpty(), Core.Names.anon(), Const.CAxiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), false)), Core.Names.anon()) => true

fn envBucket(env: Env, key: Int) -> List<Placed>
    ? "The constants whose names have this hash, newest first."
    Option.withDefault(Map.get(env.byHash, key), [])

verify envBucket
    envBucket(envEmpty(), 6) => []

fn envFind(bucket: List<Placed>, n: Name) -> Option<Const>
    ? "The newest constant of the bucket named n."
    match bucket
        [] -> Option.None
        [p, ..rest] -> match p.name == n
            true -> Option.Some(p.c)
            false -> envFind(rest, n)

verify envFind
    envFind([], Core.Names.anon()) => Option.None

fn envGetBefore(env: Env, n: Name, upTo: Int) -> Option<Const>
    ? "The constant named n when it was placed before upTo: the environment as it was when it held upTo constants."
    envFindBefore(envBucket(env, Core.Names.hashOf(n)), n, upTo)

verify envGetBefore
    envGetBefore(sampleEnv(3), sampleName(1), 2) => Option.Some(sampleConst(1))
    envGetBefore(sampleEnv(3), sampleName(2), 2) => Option.None

fn envFindBefore(bucket: List<Placed>, n: Name, upTo: Int) -> Option<Const>
    ? "The constant of the bucket named n, if placed before upTo."
    match bucket
        [] -> Option.None
        [p, ..rest] -> match p.name == n
            true -> match p.at < upTo
                true -> Option.Some(p.c)
                false -> Option.None
            false -> envFindBefore(rest, n, upTo)

verify envFindBefore
    envFindBefore([], Core.Names.anon(), 1) => Option.None

fn envSize(env: Env) -> Int
    ? "Number of constants."
    env.size

verify envSize
    envSize(sampleEnv(20)) => 20

fn sampleName(i: Int) -> Name
    ? "The name of the i-th constant of the sample environments."
    Core.Names.num(Core.Names.str(Core.Names.anon(), "c"), i)

verify sampleName
    sampleName(1) == sampleName(2) => false

fn sampleConst(i: Int) -> Const
    ? "The i-th constant of the sample environments, told apart by its type."
    Const.CAxiom(Head(name = sampleName(i), params = [], ty = Core.Exprs.natLit(i)), false)

verify sampleConst
    headOf(sampleConst(2)).name => sampleName(2)

fn sampleEnv(n: Int) -> Env
    ? "An environment of the constants 0 to n - 1, added in order, for the laws."
    match n <= 0
        true -> envEmpty()
        false -> envSet(sampleEnv(n - 1), sampleName(n - 1), sampleConst(n - 1))

verify sampleEnv
    envGet(sampleEnv(3), sampleName(2)) => Option.Some(sampleConst(2))

verify envGetBefore law asTheEnvironmentWas
    given n: Int = [0, 1, 2, 16, 17, 40]
    given upTo: Int = [0, 1, 2, 16, 17, 40]
    given i: Int = [0, 1, 15, 16, 39]
    when upTo <= n
    envGetBefore(sampleEnv(n), sampleName(i), upTo) => envGet(sampleEnv(upTo), sampleName(i))

fn envSet(env: Env, n: Name, c: Const) -> Env
    ? "Adds a constant, placed after all those before it; it shadows any older one of the same name, which the checker never lets in. The size and the bucket are read first, so that the map is then named once and changed in place."
    key = Core.Names.hashOf(n)
    at = env.size
    b = envBucket(env, key)
    Env(byHash = Map.set(env.byHash, key, List.prepend(Placed(name = n, c = c, at = at), b)), size = at + 1)

verify envSet
    envHas(envSet(envSet(envEmpty(), Core.Names.str(Core.Names.anon(), "a"), Const.CAxiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), false)), Core.Names.str(Core.Names.anon(), "b"), Const.CAxiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), false)), Core.Names.str(Core.Names.anon(), "a")) => true

record Local
    name: Name
    ty: Expr
    value: Option<Expr>
    binder: Binder

type Locals
    NoLocals
    OneLocal(Int, Int, Local)
    SomeLocals(Vector<Locals>)

record St
    env: Env
    upTo: Int
    block: Map<Name, Const>
    lctx: Locals
    next: Int
    topLevel: Int
    vars: Map<Int, Bucket>
    params: List<Name>
    checkParams: Bool
    safety: Safety
    eager: Bool
    inferCache: Map<Int, Bucket>
    checkCache: Map<Int, Bucket>
    paramCache: Map<Int, Bucket>
    whnfCache: Map<Int, Bucket>
    coreCache: Map<Int, Bucket>
    eqOk: Map<Int, Bucket>
    eqFail: Map<Int, Bucket>
    eqNo: Map<Int, Bucket>
    unfoldCache: Map<Int, Bucket>
    levelTypes: Map<Int, Bucket>
    closed: Map<Int, Bucket>
    open: Int
    opened: Expr
    keep: Int
    kinds: List<Int>
    gens: List<ParamGen>
    paramsBefore: List<Name>

record RE
    e: Expr
    st: St

record RB
    b: Bool
    st: St

record RO
    o: Option<Expr>
    st: St

fn fresh(env: Env, params: List<Name>, safety: Safety) -> St
    ? "A checker for one declaration: empty context and caches."
    St(env = env, upTo = envSize(env), block = {}, lctx = Locals.NoLocals, next = 0, topLevel = 0, vars = Core.Cache.empty(), params = params, checkParams = true, safety = safety, eager = false, inferCache = Core.Cache.empty(), checkCache = Core.Cache.empty(), paramCache = Core.Cache.empty(), whnfCache = Core.Cache.empty(), coreCache = Core.Cache.empty(), eqOk = Core.Cache.empty(), eqFail = Core.Cache.empty(), eqNo = Core.Cache.empty(), unfoldCache = Core.Cache.empty(), levelTypes = Core.Cache.empty(), closed = Core.Cache.empty(), open = 0, opened = Core.Exprs.sort(Level.Zero), keep = 65536, kinds = [], gens = [], paramsBefore = params)

verify fresh
    fresh(envEmpty(), [], Safety.Safe).next => 0

fn headOf(c: Const) -> Head
    ? "Name, parameters and type of any constant."
    match c
        Const.CAxiom(h, _) -> h
        Const.CDefn(h, _, _, _) -> h
        Const.CThm(h, _) -> h
        Const.COpaque(h, _, _) -> h
        Const.CQuot(h, _) -> h
        Const.CInduct(i) -> i.head
        Const.CCtor(k) -> k.head
        Const.CRec(r) -> r.head

verify headOf
    headOf(Const.CThm(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), Core.Exprs.bvar(0))).name => Core.Names.anon()

fn isUnsafe(c: Const) -> Bool
    ? "Whether the constant is unsafe."
    match c
        Const.CAxiom(_, u) -> u
        Const.CDefn(_, _, _, s) -> s == Safety.Unsafe
        Const.COpaque(_, _, u) -> u
        Const.CInduct(i) -> i.isUnsafe
        Const.CCtor(k) -> k.isUnsafe
        Const.CRec(r) -> r.isUnsafe
        _ -> false

verify isUnsafe
    isUnsafe(Const.CAxiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), true)) => true

fn isPartial(c: Const) -> Bool
    ? "Whether the constant is a partial definition."
    match c
        Const.CDefn(_, _, _, s) -> s == Safety.Partial
        _ -> false

verify isPartial
    isPartial(Const.CThm(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), Core.Exprs.bvar(0))) => false

fn valueOf(c: Const) -> Option<Expr>
    ? "The value delta reduction may unfold: definitions and theorems, never opaque constants."
    match c
        Const.CDefn(_, v, _, _) -> Option.Some(v)
        Const.CThm(_, v) -> Option.Some(v)
        _ -> Option.None

verify valueOf
    valueOf(Const.COpaque(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), Core.Exprs.bvar(0), false)) => Option.None

fn hintsOf(c: Const) -> Hints
    ? "Reducibility hints; everything but a definition counts as opaque."
    match c
        Const.CDefn(_, _, h, _) -> h
        _ -> Hints.Opaque

verify hintsOf
    hintsOf(Const.CThm(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.bvar(0)), Core.Exprs.bvar(0))) => Hints.Opaque

fn lookup(st: St, n: Name) -> Option<Const>
    ? "A constant of the inductive block being added, or of the environment placed before upTo. The block's constants are kept apart until the block is accepted, so the environment is only read while a block is checked and is never copied for it."
    match Map.len(st.block) == 0
        true -> envGetBefore(st.env, n, st.upTo)
        false -> blockFirst(Map.get(st.block, n), st.env, n, st.upTo)

verify lookup
    lookup(fresh(envEmpty(), [], Safety.Safe), Core.Names.anon()) => Option.None

fn blockFirst(b: Option<Const>, env: Env, n: Name, upTo: Int) -> Option<Const>
    ? "The block's constant, else the environment's."
    match b
        Option.Some -> b
        Option.None -> envGetBefore(env, n, upTo)

verify blockFirst
    blockFirst(Option.None, envEmpty(), Core.Names.anon(), 0) => Option.None

fn declared(st: St, n: Name) -> Bool
    ? "Whether the name is taken, in the block being added or in the environment."
    Bool.or(Map.has(st.block, n), envGetBefore(st.env, n, st.upTo) != Option.None)

verify declared
    declared(fresh(envEmpty(), [], Safety.Safe), Core.Names.anon()) => false

fn localType(lctx: Locals, id: Int) -> Result<Expr, Fail>
    ? "The type of a free variable."
    match localGet(lctx, serialOf(id), serialOf(id))
        Option.Some(l) -> Result.Ok(l.ty)
        Option.None -> Result.Err(Fail.Reject("unknown free variable"))

verify localType
    localType(Locals.NoLocals, 3) => Result.Err(Fail.Reject("unknown free variable"))

fn localValue(lctx: Locals, id: Int) -> Option<Expr>
    ? "The value of a let-bound free variable."
    match localGet(lctx, serialOf(id), serialOf(id))
        Option.Some(l) -> l.value
        Option.None -> Option.None

verify localValue
    localValue(Locals.NoLocals, 3) => Option.None

decision CountedVariables
    date = "2026-10-23"
    reason =
        "A free variable is its type and value, and how many variables of the"
        "same type and value are open where it is made: opened by the"
        "checker for a binder and not yet closed. Two binders open at once"
        "with the same type and value get different counts, so they are"
        "different variables, and binders of different types or values are"
        "different anyway; so the variables of a telescope are distinct and"
        "abstracting them out of a body is unambiguous. Two binders that get"
        "the same variable are never open at once, so the variable never"
        "stands for both in one term, and they have the same type and value,"
        "so whatever holds of a term with one holds of it with the other: in"
        "it, in the type found for it, in a pair compared, since each of"
        "those holds only variables open where it was found and those of"
        "their types and values. Typing never reads a binder's name or"
        "binder info, so neither tells variables apart. Before this a"
        "variable had a level, the first above the variables in its scope"
        "and its telescope so far: the same binder opened again got its"
        "variable again, but a type and its instance that were the third"
        "binders of one theorem and the seventh of the next were other"
        "variables there, and the instance diamonds between them were"
        "compared again in every theorem. On qb9 single comparisons cost up"
        "to 225 M instructions, and one worker went from 194.4 G to 184.7 G;"
        "etale 100.1 G to 96.1 G, Init 208.9 G to 204.6 G, navier-stokes-euler"
        "2.22 T to 2.14 T, cslib 2.35 T to 2.27 T. A variable opened"
        "with more than 1023 open around it is fresh, never found again, so"
        "that counting stays short in deep nests; fresh variables are made"
        "otherwise only by the checking of a declaration being added"
        "(inductive types, recursors, the quotient), on states of their own."
        "The serial number has no bound, so numbers never wrap."
    chosen = "CountedVariables"
    rejected = ["LevelledVariables", "FreshNumbers"]
    impacts = [names, namesAt, closeVars]

fn serialOf(id: Int) -> Int
    ? "The serial number of a free variable, which keys the local context."
    Int.div(id, 1024)

verify serialOf
    serialOf(5 * 1024 + 3) => 5

fn numbered(serial: Int) -> Int
    ? "The number of the variable with this serial number: the serial number times 1024 plus one of ten bits, taken in turn, which the terms holding it carry (Core.Exprs.varsOf), so that abstracting it skips every term with none of its bits."
    serial * 1024 + bitOf(Int.mod(serial, 10))

verify numbered
    numbered(0) => 1
    numbered(13) => 13 * 1024 + 8

fn bitOf(k: Int) -> Int
    ? "Two to the power k, for k from 0 to 9."
    match k
        0 -> 1
        1 -> 2
        2 -> 4
        3 -> 8
        4 -> 16
        5 -> 32
        6 -> 64
        7 -> 128
        8 -> 256
        _ -> 512

verify bitOf
    bitOf(0) => 1
    bitOf(9) => 512

fn names(st: St, n: Name, ty: Expr, value: Option<Expr>, bi: Binder) -> RE
    ? "Declares a fresh free variable, one that namesAt never gives, at a level above every level used so far, and returns it."
    level = st.topLevel + 1
    serial = st.next
    RE(e = Core.Exprs.fvar(numbered(serial)), st = St.update(st, lctx = localPut(st.lctx, serial, serial, Local(name = n, ty = ty, value = value, binder = bi)), next = serial + 1, topLevel = level))

verify names
    names(fresh(envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.bvar(0), Option.None, Binder.Default).e => Core.Exprs.fvar(1)
    names(fresh(envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.bvar(0), Option.None, Binder.Default).st.next => 1

fn namesAt(st: St, n: Name, ty: Expr, value: Option<Expr>, bi: Binder) -> RE
    ? "The free variable of a binder opened now, as CountedVariables decides: the one already made for its type and value with as many variables of the same kind open, else a new one; with more than 1023 variables open, a fresh one, so that counting stays short in deep nests. It counts as open until closeVars closes it. The kinds open are read before the state is passed on, so that the maps it holds keep one owner."
    kind = kindOf(ty, value)
    ks = List.prepend(kind, st.kinds)
    count = countKind(st.kinds, kind, 0, 1023)
    r = namesCounted(st, n, ty, value, bi, count)
    RE(e = r.e, st = St.update(r.st, kinds = ks))

verify namesAt
    namesAt(fresh(envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.sort(Level.Zero), Option.None, Binder.Default).e => Core.Exprs.fvar(1)
    namesAt(namesAt(fresh(envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.sort(Level.Zero), Option.None, Binder.Default).st, Core.Names.anon(), Core.Exprs.sort(Level.Zero), Option.None, Binder.Implicit).e => Core.Exprs.fvar(1026)
    namesAt(closeVars(namesAt(fresh(envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.sort(Level.Zero), Option.None, Binder.Default).st, 1), Core.Names.anon(), Core.Exprs.sort(Level.Zero), Option.None, Binder.Implicit).e => Core.Exprs.fvar(1)
    namesAt(namesAt(fresh(envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.sort(Level.Zero), Option.None, Binder.Default).st, Core.Names.anon(), Core.Exprs.natLit(0), Option.None, Binder.Default).e => Core.Exprs.fvar(1026)

fn namesCounted(st: St, n: Name, ty: Expr, value: Option<Expr>, bi: Binder, count: Int) -> RE
    ? "The variable for count variables of its kind open, or a fresh one when there were too many open to count."
    match count < 0
        true -> names(st, n, ty, value, bi)
        false -> namesKeyed(st, n, ty, value, bi, varCode(count, value))

verify namesCounted
    namesCounted(fresh(envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.sort(Level.Zero), Option.None, Binder.Default, 0).e => Core.Exprs.fvar(1)
    namesCounted(fresh(envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.sort(Level.Zero), Option.None, Binder.Default, -1).e => Core.Exprs.fvar(1)

fn namesKeyed(st: St, n: Name, ty: Expr, value: Option<Expr>, bi: Binder, code: Int) -> RE
    ? "The variable kept for these parts, or a new one kept for them. The parts are compared where they are; the term that keeps them is built only for a new variable."
    h = varHash(code, ty, value)
    match varFind(Core.Cache.get(st.vars, h), code, ty, value)
        Option.Some(x) -> RE(e = x, st = st)
        Option.None -> namesNew(st, n, ty, value, bi, code, h)

verify namesKeyed
    namesKeyed(fresh(envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.sort(Level.Zero), Option.None, Binder.Default, 32).e => Core.Exprs.fvar(1)

fn namesNew(st: St, n: Name, ty: Expr, value: Option<Expr>, bi: Binder, code: Int, h: Int) -> RE
    ? "A new variable, kept under its parts."
    serial = st.next
    x = Core.Exprs.fvar(numbered(serial))
    RE(e = x, st = St.update(st, lctx = localPut(st.lctx, serial, serial, Local(name = n, ty = ty, value = value, binder = bi)), vars = Core.Cache.add(st.vars, h, (varKey(code, ty, value), x)), next = serial + 1))

verify namesNew
    namesNew(fresh(envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.sort(Level.Zero), Option.None, Binder.Default, 0, 0).st.next => 1

fn varCode(count: Int, value: Option<Expr>) -> Int
    ? "How many variables of the same kind are open, and whether the variable has a value, as one number."
    count * 2 + hasValue(value)

verify varCode
    varCode(1, Option.None) == varCode(0, Option.None) => false
    varCode(0, Option.None) == varCode(0, Option.Some(Core.Exprs.natLit(1))) => false

fn kindOf(ty: Expr, value: Option<Expr>) -> Int
    ? "A variable's type and value as one hash; variables of one kind open at once are told apart by their count."
    Core.Hash.mix(Core.Hash.mix(hasValue(value), Core.Exprs.hashOf(ty)), optHash(value))

verify kindOf
    kindOf(Core.Exprs.natLit(1), Option.None) == kindOf(Core.Exprs.natLit(1), Option.Some(Core.Exprs.natLit(1))) => false
    kindOf(Core.Exprs.natLit(1), Option.None) == kindOf(Core.Exprs.natLit(2), Option.None) => false

fn countKind(ks: List<Int>, kind: Int, acc: Int, budget: Int) -> Int
    ? "How many of the open variables are of this kind, or -1 when more than budget are open. Two kinds may share a hash, which only counts more."
    match ks
        [] -> acc
        [k, ..rest] -> match budget <= 0
            true -> -1
            false -> match k == kind
                true -> countKind(rest, kind, acc + 1, budget - 1)
                false -> countKind(rest, kind, acc, budget - 1)

verify countKind
    countKind([3, 5, 3], 3, 0, 10) => 2
    countKind([], 3, 0, 10) => 0
    countKind([3, 5, 3], 3, 0, 2) => -1

fn closeVars(st: St, n: Int) -> St
    ? "Closes the n variables opened last. The kinds are read before the state is updated, so that the maps it holds keep one owner."
    ks = List.drop(st.kinds, n)
    St.update(st, kinds = ks)

verify closeVars
    closeVars(namesAt(fresh(envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.sort(Level.Zero), Option.None, Binder.Default).st, 1).kinds => []

fn varHash(code: Int, ty: Expr, value: Option<Expr>) -> Int
    ? "The hash a variable is kept under, from its parts."
    Core.Hash.mix(Core.Hash.mix(code, Core.Exprs.hashOf(ty)), optHash(value))

verify varHash
    varHash(0, Core.Exprs.natLit(1), Option.None) == varHash(1, Core.Exprs.natLit(1), Option.None) => false

fn optHash(o: Option<Expr>) -> Int
    ? "The hash of an optional term, 0 for none."
    match o
        Option.Some(x) -> Core.Exprs.hashOf(x)
        Option.None -> 0

verify optHash
    optHash(Option.None) => 0

fn varFind(bucket: Bucket, code: Int, ty: Expr, value: Option<Expr>) -> Option<Expr>
    ? "The variable kept under these parts in a bucket."
    match bucket
        Bucket.NoEntry -> Option.None
        Bucket.OneEntry((k, x)) -> match valueMatches(k, code, ty, value)
            true -> Option.Some(x)
            false -> Option.None
        Bucket.Entries(es) -> varFindIn(es, code, ty, value)

verify varFind
    varFind(Bucket.NoEntry, 3, Core.Exprs.natLit(1), Option.None) => Option.None

fn varFindIn(bucket: List<Tuple<Expr, Expr>>, code: Int, ty: Expr, value: Option<Expr>) -> Option<Expr>
    ? "The variable kept under these parts in a bucket."
    match bucket
        [] -> Option.None
        [(k, x), ..rest] -> match valueMatches(k, code, ty, value)
            true -> Option.Some(x)
            false -> varFindIn(rest, code, ty, value)

verify varFindIn
    varFindIn([(varKey(3, Core.Exprs.natLit(1), Option.Some(Core.Exprs.fvar(2))), Core.Exprs.fvar(9))], 3, Core.Exprs.natLit(1), Option.Some(Core.Exprs.fvar(2))) => Option.Some(Core.Exprs.fvar(9))
    varFindIn([(varKey(3, Core.Exprs.natLit(1), Option.Some(Core.Exprs.fvar(2))), Core.Exprs.fvar(9))], 3, Core.Exprs.natLit(1), Option.Some(Core.Exprs.fvar(4))) => Option.None

fn valueMatches(k: Expr, code: Int, ty: Expr, value: Option<Expr>) -> Bool
    ? "Whether the term k keeps exactly these parts; the code says whether a value is there, so the term's shape is fixed by it."
    match value
        Option.Some(v) -> match k
            Expr.App(_, k1, v1) -> match v1 == v
                true -> headMatches(k1, code, ty)
                false -> false
            _ -> false
        Option.None -> headMatches(k, code, ty)

verify valueMatches
    valueMatches(Core.Exprs.natLit(0), 0, Core.Exprs.natLit(0), Option.Some(Core.Exprs.natLit(0))) => false

fn headMatches(k: Expr, code: Int, ty: Expr) -> Bool
    ? "valueMatches below the value: the code and the type."
    match k
        Expr.App(_, Expr.NatLit(c), t1) -> match c == code
            true -> t1 == ty
            false -> false
        _ -> false

verify headMatches
    headMatches(Core.Exprs.app(Core.Exprs.natLit(3), Core.Exprs.natLit(1)), 3, Core.Exprs.natLit(1)) => true

fn varKey(code: Int, ty: Expr, value: Option<Expr>) -> Expr
    ? "What a variable is made of, as a term: its code (level, binder info, and whether it has a value), then its type and its value."
    match value
        Option.Some(v) -> Core.Exprs.app(Core.Exprs.app(Core.Exprs.natLit(code), ty), v)
        Option.None -> Core.Exprs.app(Core.Exprs.natLit(code), ty)

verify varKey
    varKey(2, Core.Exprs.natLit(0), Option.None) == varKey(3, Core.Exprs.natLit(0), Option.None) => false

fn hasValue(value: Option<Expr>) -> Int
    ? "1 for a let value, 0 for none."
    match value
        Option.Some -> 1
        Option.None -> 0

verify hasValue
    hasValue(Option.None) => 0

fn localGet(m: Locals, id: Int, rest: Int) -> Option<Local>
    ? "The local of free variable id. The context is a persistent trie on the id's hexadecimal digits, lowest first; rest is the id with the digits above this node taken off. A state holding it can be shared, and declaring a variable copies one short path, where a Map whose owner was shared would be copied whole."
    match m
        Locals.NoLocals -> Option.None
        Locals.OneLocal(k, _, l) -> match k == id
            true -> Option.Some(l)
            false -> Option.None
        Locals.SomeLocals(v) -> localGet(Option.withDefault(Vector.get(v, Bits.and(rest, 15)), Locals.NoLocals), id, Int.div(rest, 16))

verify localGet
    localGet(localPut(localPut(Locals.NoLocals, 1, 1, sampleLocal(0)), 17, 17, sampleLocal(1)), 17, 17) => Option.Some(sampleLocal(1))
    localGet(localPut(localPut(Locals.NoLocals, 1, 1, sampleLocal(0)), 17, 17, sampleLocal(1)), 1, 1) => Option.Some(sampleLocal(0))
    localGet(localPut(Locals.NoLocals, 1, 1, sampleLocal(0)), 33, 33) => Option.None

fn localPut(m: Locals, id: Int, rest: Int, l: Local) -> Locals
    ? "Stores the local of free variable id; a leaf holding another id becomes a node with that leaf one digit further down."
    match m
        Locals.NoLocals -> Locals.OneLocal(id, rest, l)
        Locals.OneLocal(k, krest, old) -> match k == id
            true -> Locals.OneLocal(id, rest, l)
            false -> localPut(Locals.SomeLocals(setLocals(Vector.new(16, Locals.NoLocals), Bits.and(krest, 15), Locals.OneLocal(k, Int.div(krest, 16), old))), id, rest, l)
        Locals.SomeLocals(v) -> Locals.SomeLocals(setLocals(v, Bits.and(rest, 15), localPut(Option.withDefault(Vector.get(v, Bits.and(rest, 15)), Locals.NoLocals), id, Int.div(rest, 16), l)))

verify localPut
    localGet(localPut(localPut(Locals.NoLocals, 0, 0, sampleLocal(0)), 0, 0, sampleLocal(2)), 0, 0) => Option.Some(sampleLocal(2))
    localGet(localPut(localPut(localPut(Locals.NoLocals, 0, 0, sampleLocal(0)), 256, 256, sampleLocal(1)), 16, 16, sampleLocal(2)), 256, 256) => Option.Some(sampleLocal(1))

fn setLocals(v: Vector<Locals>, i: Int, child: Locals) -> Vector<Locals>
    ? "Replaces one child; the index is always in range."
    Option.withDefault(Vector.set(v, i, child), v)

verify setLocals
    Vector.len(setLocals(Vector.new(16, Locals.NoLocals), 3, Locals.NoLocals)) => 16

fn sampleLocal(i: Int) -> Local
    ? "A local for the examples, told apart by its type."
    Local(name = Core.Names.anon(), ty = Core.Exprs.natLit(i), value = Option.None, binder = Binder.Default)

verify sampleLocal
    sampleLocal(3).ty => Core.Exprs.natLit(3)

fn sampleLocals(n: Int) -> Locals
    ? "A context with the variables 0 to n - 1, each told apart by its type, for the laws."
    match n <= 0
        true -> Locals.NoLocals
        false -> localPut(sampleLocals(n - 1), n - 1, n - 1, sampleLocal(n - 1))

verify sampleLocals
    localGet(sampleLocals(3), 2, 2) => Option.Some(sampleLocal(2))

verify localGet law holdsWhatWasPut
    given n: Int = [0, 1, 16, 17, 300]
    given id: Int = [0, 1, 15, 16, 17, 255, 256, 4097]
    when id >= 0
    localGet(localPut(sampleLocals(n), id, id, sampleLocal(-1)), id, id) => Option.Some(sampleLocal(-1))

verify localGet law keepsTheOthers
    given n: Int = [0, 1, 16, 17, 300]
    given id: Int = [0, 1, 16, 255, 256, 4097]
    given other: Int = [0, 1, 15, 16, 17, 256, 299, 4097]
    when Bool.and(Bool.and(id >= 0, other >= 0), id != other)
    localGet(localPut(sampleLocals(n), id, id, sampleLocal(-1)), other, other) => localGet(sampleLocals(n), other, other)

verify localGet law findsEachDeclared
    given n: Int = [0, 1, 16, 17, 300]
    given id: Int = [0, 1, 15, 16, 17, 255, 256, 299, 300]
    when id >= 0
    localGet(sampleLocals(n), id, id) => declaredSpec(n, id)

fn declaredSpec(n: Int, id: Int) -> Option<Local>
    ? "What a context of the variables 0 to n - 1 holds for id."
    match id < n
        true -> Option.Some(sampleLocal(id))
        false -> Option.None

verify declaredSpec
    declaredSpec(3, 5) => Option.None

fn mkBinding(lctx: Locals, ids: List<Int>, body: Expr, isLam: Bool, dropDeadLet: Bool) -> Expr
    ? "Abstracts the free variables ids (outermost first) out of body, binding each with its type, or with let for a let variable."
    wrap(lctx, List.reverse(ids), ids, Core.Subst.abstractFVars(body, ids), isLam, dropDeadLet)

verify mkBinding
    mkBinding(names(fresh(envEmpty(), [], Safety.Safe), Core.Names.anon(), Core.Exprs.sort(Level.Zero), Option.None, Binder.Default).st.lctx, [1], Core.Exprs.fvar(1), false, false) => Core.Exprs.pi(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default)

fn wrap(lctx: Locals, revIds: List<Int>, ids: List<Int>, r: Expr, isLam: Bool, dropDeadLet: Bool) -> Expr
    ? "Adds the binders from the innermost out; the type of variable i is abstracted over the variables before it."
    match revIds
        [] -> r
        [id, ..rest] -> wrap(lctx, rest, ids, wrapOne(lctx, id, List.take(ids, List.len(rest)), r, isLam, dropDeadLet), isLam, dropDeadLet)

verify wrap
    wrap(Locals.NoLocals, [], [], Core.Exprs.bvar(0), true, false) => Core.Exprs.bvar(0)

fn wrapOne(lctx: Locals, id: Int, before: List<Int>, r: Expr, isLam: Bool, dropDeadLet: Bool) -> Expr
    ? "One binder around r."
    match localGet(lctx, serialOf(id), serialOf(id))
        Option.None -> r
        Option.Some(l) -> wrapLocal(l, Core.Subst.abstractFVars(l.ty, before), before, r, isLam, dropDeadLet)

verify wrapOne
    wrapOne(Locals.NoLocals, 0, [], Core.Exprs.bvar(0), true, false) => Core.Exprs.bvar(0)

fn wrapLocal(l: Local, ty: Expr, before: List<Int>, r: Expr, isLam: Bool, dropDeadLet: Bool) -> Expr
    ? "let for a let variable (dropped when dead and asked to), else lambda or pi."
    match l.value
        Option.Some(v) -> match Bool.and(dropDeadLet, Bool.not(Core.Subst.hasLooseBVar(r, 0)))
            true -> Core.Subst.lower(r, 1, 1)
            false -> Core.Exprs.letE(l.name, ty, Core.Subst.abstractFVars(v, before), r)
        Option.None -> match isLam
            true -> Core.Exprs.lam(l.name, ty, r, l.binder)
            false -> Core.Exprs.pi(l.name, ty, r, l.binder)

verify wrapLocal
    wrapLocal(Local(name = Core.Names.anon(), ty = Core.Exprs.sort(Level.Zero), value = Option.Some(Core.Exprs.sort(Level.Zero)), binder = Binder.Default), Core.Exprs.sort(Level.Zero), [], Core.Exprs.sort(Level.Zero), false, true) => Core.Exprs.sort(Level.Zero)

fn cacheGet(cache: Map<Int, Bucket>, key: Expr) -> Option<Expr>
    ? "A cached result for key, found by hash and confirmed by equality."
    Core.Cache.find(cache, Core.Exprs.hashOf(key), key)

verify cacheGet
    cacheGet(Core.Cache.empty(), Core.Exprs.bvar(0)) => Option.None
    cacheGet(cachePut(Core.Cache.empty(), Core.Exprs.bvar(0), Core.Exprs.bvar(1)), Core.Exprs.bvar(0)) => Option.Some(Core.Exprs.bvar(1))

fn cachePut(cache: Map<Int, Bucket>, key: Expr, v: Expr) -> Map<Int, Bucket>
    ? "Stores a result under the key's hash."
    Core.Cache.add(cache, Core.Exprs.hashOf(key), (key, v))

verify cachePut
    Core.Cache.size(cachePut(Core.Cache.empty(), Core.Exprs.bvar(0), Core.Exprs.bvar(1))) => 1

fn pairKey(a: Expr, b: Expr) -> Int
    ? "One key for an unordered pair."
    ha = Core.Exprs.hashOf(a)
    hb = Core.Exprs.hashOf(b)
    Core.Hash.mix(Int.min(ha, hb), Int.max(ha, hb))

verify pairKey
    pairKey(Core.Exprs.bvar(0), Core.Exprs.bvar(1)) == pairKey(Core.Exprs.bvar(1), Core.Exprs.bvar(0)) => true

fn pairGet(cache: Map<Int, Bucket>, a: Expr, b: Expr) -> Bool
    ? "Whether the pair, in either order, is recorded."
    hasPair(Core.Cache.get(cache, pairKey(a, b)), a, b)

verify pairGet
    pairGet(pairPut(Core.Cache.empty(), Core.Exprs.bvar(0), Core.Exprs.bvar(1)), Core.Exprs.bvar(1), Core.Exprs.bvar(0)) => true
    pairGet(Core.Cache.empty(), Core.Exprs.bvar(0), Core.Exprs.bvar(1)) => false

fn hasPair(bucket: Bucket, a: Expr, b: Expr) -> Bool
    ? "Membership in either order."
    match bucket
        Bucket.NoEntry -> false
        Bucket.OneEntry((x, y)) -> Bool.or(Bool.and(alike(x, a), alike(y, b)), Bool.and(alike(x, b), alike(y, a)))
        Bucket.Entries(es) -> hasPairIn(es, a, b)

verify hasPair
    hasPair(Bucket.NoEntry, Core.Exprs.bvar(0), Core.Exprs.bvar(0)) => false

fn hasPairIn(bucket: List<Tuple<Expr, Expr>>, a: Expr, b: Expr) -> Bool
    ? "Membership in either order."
    match bucket
        [] -> false
        [(x, y), ..rest] -> match Bool.or(Bool.and(alike(x, a), alike(y, b)), Bool.and(alike(x, b), alike(y, a)))
            true -> true
            false -> hasPairIn(rest, a, b)

verify hasPairIn
    hasPairIn([], Core.Exprs.bvar(0), Core.Exprs.bvar(0)) => false

fn alike(x: Expr, a: Expr) -> Bool
    ? "The same term up to binder names and annotations, which terms do not keep (BindersUnnamed): the same term."
    x == a

verify alike
    alike(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Core.Exprs.lam(Core.Names.str(Core.Names.anon(), "x"), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default)) => true

fn pairPut(cache: Map<Int, Bucket>, a: Expr, b: Expr) -> Map<Int, Bucket>
    ? "Records the pair."
    Core.Cache.add(cache, pairKey(a, b), (a, b))

verify pairPut
    Core.Cache.size(pairPut(Core.Cache.empty(), Core.Exprs.bvar(0), Core.Exprs.bvar(1))) => 1

fn closedPairKey(a: Expr, b: Expr) -> Int
    ? "The key of a pair in the cache kept across declarations: above every term hash, so that it never meets an entry for a type there."
    pairKey(a, b) + 1099511627776

verify closedPairKey
    closedPairKey(Core.Exprs.bvar(0), Core.Exprs.bvar(1)) > 1099511627775 => true

fn closedPairGet(cache: Map<Int, Bucket>, a: Expr, b: Expr) -> Bool
    ? "Whether the pair, in either order, is recorded in the cache kept across declarations."
    hasPair(Core.Cache.get(cache, closedPairKey(a, b)), a, b)

verify closedPairGet
    closedPairGet(closedPairPut(Core.Cache.empty(), Core.Exprs.natLit(1), Core.Exprs.natLit(2)), Core.Exprs.natLit(2), Core.Exprs.natLit(1)) => true
    closedPairGet(pairPut(Core.Cache.empty(), Core.Exprs.natLit(1), Core.Exprs.natLit(2)), Core.Exprs.natLit(1), Core.Exprs.natLit(2)) => false

fn closedPairPut(cache: Map<Int, Bucket>, a: Expr, b: Expr) -> Map<Int, Bucket>
    ? "Records the pair in the cache kept across declarations."
    Core.Cache.add(cache, closedPairKey(a, b), (a, b))

verify closedPairPut
    Core.Cache.size(closedPairPut(Core.Cache.empty(), Core.Exprs.natLit(1), Core.Exprs.natLit(2))) => 1

fn closedFailKey(a: Expr, b: Expr) -> Int
    ? "The key of a pair known to differ, in the cache kept across declarations: above the keys of equal pairs."
    pairKey(a, b) + 2199023255552

verify closedFailKey
    closedFailKey(Core.Exprs.bvar(0), Core.Exprs.bvar(1)) > 2199023255551 => true

fn closedFailGet(cache: Map<Int, Bucket>, a: Expr, b: Expr) -> Bool
    ? "Whether the pair, in either order, is recorded as different in the cache kept across declarations."
    hasPair(Core.Cache.get(cache, closedFailKey(a, b)), a, b)

verify closedFailGet
    closedFailGet(closedFailPut(Core.Cache.empty(), Core.Exprs.natLit(1), Core.Exprs.natLit(2)), Core.Exprs.natLit(2), Core.Exprs.natLit(1)) => true
    closedFailGet(closedPairPut(Core.Cache.empty(), Core.Exprs.natLit(1), Core.Exprs.natLit(2)), Core.Exprs.natLit(1), Core.Exprs.natLit(2)) => false

fn closedFailPut(cache: Map<Int, Bucket>, a: Expr, b: Expr) -> Map<Int, Bucket>
    ? "Records the pair as different in the cache kept across declarations."
    Core.Cache.add(cache, closedFailKey(a, b), (a, b))

verify closedFailPut
    Core.Cache.size(closedFailPut(Core.Cache.empty(), Core.Exprs.natLit(1), Core.Exprs.natLit(2))) => 1
