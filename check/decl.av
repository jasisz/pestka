module Decl
    intent =
        "Adds declarations to the environment in file order and checks each"
        "as Lean's kernel does when it replays an export: the name is new,"
        "the universe parameters are distinct, the type is a type, and a"
        "value has the declared type. Unsafe and partial declarations are"
        "skipped, as the reference replay skips them. Inductive blocks and"
        "the quotient package are derived and compared with the export as"
        "they are met. The types and values of the other declarations are"
        "checked after the environment is built, each against the"
        "environment at its own place in the file, so that they can be"
        "checked apart; the verdict names the first failure in file order,"
        "as checking strictly in order would."
    exposes [Run, Job, Admitted, Chunk, Checked, Core, Kept, checkAll, checkParallel, admit, due, chunks, checkChunk, combine, jobChecks, jobFor]
    depends [Core.Names, Core.Levels, Core.Exprs, Core.Decls, Core.Cache, Check.State, Check.Tc, Check.IndAdd, Next.Decl]
    effects []

record Run
    env: Env
    closed: Map<Int, List<Tuple<Expr, Expr>>>
    checked: Int
    trusted: Int
    skipped: Int
    jobs: List<Job>
    pos: Int

record Job
    pos: Int
    upTo: Int
    head: Head
    value: Option<Expr>
    isThm: Bool

record Admitted
    run: Run
    failure: Option<Fail>
    at: Int

record Chunk
    env: Env
    jobs: List<Job>
    core: Core

type Core
    Old
    Next
    Both

record Kept
    old: OldFacts
    next: Facts

record OldFacts
    closed: Map<Int, List<Tuple<Expr, Expr>>>
    unfolds: Map<Int, List<Tuple<Expr, Expr>>>
    types: Map<Int, List<Tuple<Expr, Expr>>>
    vars: Map<Int, List<Tuple<Expr, Expr>>>
    lctx: Locals
    next: Int
    topLevel: Int
    inferCache: Map<Int, List<Tuple<Expr, Expr>>>
    checkCache: Map<Int, List<Tuple<Expr, Expr>>>
    whnfCache: Map<Int, List<Tuple<Expr, Expr>>>
    coreCache: Map<Int, List<Tuple<Expr, Expr>>>
    eqOk: Map<Int, List<Tuple<Expr, Expr>>>
    eqFail: Map<Int, List<Tuple<Expr, Expr>>>
    eqNo: Map<Int, List<Tuple<Expr, Expr>>>

record Checked
    failure: Option<Fail>
    at: Int
    count: Int

fn checkAll(decls: List<Decl>) -> Result<Run, Fail>
    ? "Builds the environment, then checks the deferred declarations before the first failure the building met, one after another."
    a = admit(decls)
    finish(a, checkJobs(List.reverse(a.run.jobs), a.run.env, OldFacts.update(oldEmpty(), closed = a.run.closed), a.at))

fn admit(decls: List<Decl>) -> Admitted
    ? "Builds the environment from nothing; the deferred declarations wait in the result."
    admitAll(Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0), decls)

verify admit
    admit([]).at => 0

fn due(a: Admitted) -> List<Job>
    ? "The deferred declarations in file order, those before the building's failure."
    List.reverse(dropLate(a.run.jobs, a.at, []))

verify due
    due(admit([])) => []

fn dropLate(jobs: List<Job>, limit: Int, acc: List<Job>) -> List<Job>
    ? "Keeps the jobs before limit; jobs come newest first and go out oldest first."
    match jobs
        [] -> List.reverse(acc)
        [j, ..rest] -> match j.pos < limit
            true -> dropLate(rest, limit, List.prepend(j, acc))
            false -> dropLate(rest, limit, acc)

verify dropLate
    dropLate([], 0, []) => []

fn chunks(jobs: List<Job>, env: Env, core: Core, size: Int, cur: List<Job>, n: Int, acc: List<Chunk>) -> List<Chunk>
    ? "Consecutive runs of size jobs, in file order, each with the whole environment and the core to check them with; neighbours in a file share the most, which keeps the per-chunk caches useful."
    match jobs
        [] -> match cur
            [] -> List.reverse(acc)
            _ -> List.reverse(List.prepend(Chunk(env = env, jobs = List.reverse(cur), core = core), acc))
        [j, ..rest] -> match n + 1 >= size
            true -> chunks(rest, env, core, size, [], 0, List.prepend(Chunk(env = env, jobs = List.reverse(List.prepend(j, cur)), core = core), acc))
            false -> chunks(rest, env, core, size, List.prepend(j, cur), n + 1, acc)

verify chunks
    chunks([], Check.State.envEmpty(), Core.Old, 4, [], 0, []) => []

fn checkParallel(decls: List<Decl>, workers: Int, core: Core) -> Result<Run, Fail>
    ? "Builds the environment, then checks the deferred declarations on workers at once with the given core: runs of 16 consecutive declarations are dealt to the workers in turn, which evens out their loads, and each worker checks its runs in file order."
    a = admit(decls)
    combine(a, runWorkers(deal(chunks(due(a), a.run.env, core, 16, [], 0, []), workers, 0, emptyGroups(workers, []))))

verify checkParallel
    checkParallel([], 4, Core.Both) => Result.Ok(Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0))

fn emptyGroups(n: Int, acc: List<List<Chunk>>) -> List<List<Chunk>>
    ? "n empty groups."
    none: List<Chunk> = []
    match n <= 0
        true -> acc
        false -> emptyGroups(n - 1, List.prepend(none, acc))

verify emptyGroups
    List.len(emptyGroups(3, [])) => 3

fn deal(cs: List<Chunk>, n: Int, i: Int, groups: List<List<Chunk>>) -> List<List<Chunk>>
    ? "Deals the runs to n groups in turn, run i to group i mod n, keeping each group in file order."
    match cs
        [] -> reverseEach(groups, [])
        [c, ..rest] -> deal(rest, n, i + 1, addAt(groups, Result.withDefault(Int.mod(i, Int.max(n, 1)), 0), c, []))

verify deal
    deal([], 2, 0, emptyGroups(2, [])) => [[], []]

fn addAt(groups: List<List<Chunk>>, k: Int, c: Chunk, before: List<List<Chunk>>) -> List<List<Chunk>>
    ? "Prepends c to group k."
    match groups
        [] -> List.reverse(before)
        [g, ..rest] -> match k == 0
            true -> List.concat(List.reverse(before), List.prepend(List.prepend(c, g), rest))
            false -> addAt(rest, k - 1, c, List.prepend(g, before))

verify addAt
    addAt([[], []], 1, Chunk(env = Check.State.envEmpty(), jobs = [], core = Core.Old), []) => [[], [Chunk(env = Check.State.envEmpty(), jobs = [], core = Core.Old)]]

fn reverseEach(groups: List<List<Chunk>>, acc: List<List<Chunk>>) -> List<List<Chunk>>
    ? "Each group back in file order."
    match groups
        [] -> List.reverse(acc)
        [g, ..rest] -> reverseEach(rest, List.prepend(List.reverse(g), acc))

verify reverseEach
    reverseEach([], []) => []

fn runWorkers(groups: List<List<Chunk>>) -> List<Checked>
    ? "Every group on a worker of its own: the list is halved, and the halves run as an independent product."
    match groups
        [] -> []
        [g] -> [checkGroup(g)]
        _ -> halves(List.take(groups, Int.div(List.len(groups), 2)), List.drop(groups, Int.div(List.len(groups), 2)))

verify runWorkers
    runWorkers([[], []]) => [Checked(failure = Option.None, at = 0, count = 0), Checked(failure = Option.None, at = 0, count = 0)]

fn halves(left: List<List<Chunk>>, right: List<List<Chunk>>) -> List<Checked>
    ? "The two halves at once."
    match (runWorkers(left), runWorkers(right))!
        (l, r) -> List.concat(l, r)

verify halves
    halves([], []) => []

fn checkGroup(g: List<Chunk>) -> Checked
    ? "One worker: its runs in file order with the facts each core keeps across declarations, stopping at the first failure."
    groupLoop(g, keptEmpty(), 0)

verify checkGroup
    checkGroup([]) => Checked(failure = Option.None, at = 0, count = 0)

fn keptEmpty() -> Kept
    ? "No facts in either core."
    Kept(old = oldEmpty(), next = Next.Decl.empty())

verify keptEmpty
    Core.Cache.size(keptEmpty().old.closed) => 0

fn oldEmpty() -> OldFacts
    ? "No facts in the first core."
    OldFacts(closed = Core.Cache.empty(), unfolds = Core.Cache.empty(), types = Core.Cache.empty(), vars = Core.Cache.empty(), lctx = Locals.NoLocals, next = 0, topLevel = 0, inferCache = Core.Cache.empty(), checkCache = Core.Cache.empty(), whnfCache = Core.Cache.empty(), coreCache = Core.Cache.empty(), eqOk = Core.Cache.empty(), eqFail = Core.Cache.empty(), eqNo = Core.Cache.empty())

verify oldEmpty
    Core.Cache.size(oldEmpty().unfolds) => 0

fn groupLoop(g: List<Chunk>, kept: Kept, count: Int) -> Checked
    ? "Run after run."
    match g
        [] -> Checked(failure = Option.None, at = 0, count = count)
        [c, ..rest] -> chunkLoop(c.jobs, c.env, c.core, rest, kept, count)

verify groupLoop
    groupLoop([], keptEmpty(), 2).count => 2

fn checkChunk(c: Chunk) -> Checked
    ? "Checks one run of deferred declarations with facts of its own; the first failure is reported with its place in the file."
    chunkLoop(c.jobs, c.env, c.core, [], keptEmpty(), 0)

verify checkChunk
    checkChunk(Chunk(env = Check.State.envEmpty(), jobs = [], core = Core.Old)) => Checked(failure = Option.None, at = 0, count = 0)

fn chunkLoop(jobs: List<Job>, env: Env, core: Core, more: List<Chunk>, kept: Kept, count: Int) -> Checked
    ? "One job after another, then the next run, until one fails."
    match jobs
        [] -> groupLoop(more, kept, count)
        [j, ..rest] -> chunkNext(jobFor(core, j, env, kept), j, env, core, rest, more, count)

verify chunkLoop
    chunkLoop([], Check.State.envEmpty(), Core.Old, [], keptEmpty(), 3).count => 3

fn chunkNext(r: Result<Kept, Fail>, j: Job, env: Env, core: Core, rest: List<Job>, more: List<Chunk>, count: Int) -> Checked
    ? "Goes on, or stops with the named failure and its position."
    match r
        Result.Ok(kept) -> chunkLoop(rest, env, core, more, kept, count + 1)
        Result.Err(e) -> Checked(failure = Option.Some(failNamed(e, j.head.name)), at = j.pos, count = count)

verify chunkNext
    chunkNext(Result.Err(Fail.Reject("bad")), Job(pos = 4, upTo = 0, head = Head(name = Core.Names.str(Core.Names.anon(), "x"), params = [], ty = Core.Exprs.bvar(0)), value = Option.None, isThm = false), Check.State.envEmpty(), Core.Old, [], [], 0) => Checked(failure = Option.Some(Fail.Reject("x: bad")), at = 4, count = 0)

fn jobFor(core: Core, j: Job, env: Env, kept: Kept) -> Result<Kept, Fail>
    ? "A deferred declaration checked by the first core, the second, or both; with both, any difference in their answers is a failure that says what each answered."
    match core
        Core.Old -> oldKept(jobChecks(j, St.update(checkerFor(env, j), closed = kept.old.closed, unfoldCache = kept.old.unfolds, levelTypes = kept.old.types, vars = kept.old.vars, lctx = kept.old.lctx, next = kept.old.next, topLevel = kept.old.topLevel, inferCache = kept.old.inferCache, checkCache = kept.old.checkCache, whnfCache = kept.old.whnfCache, coreCache = kept.old.coreCache, eqOk = kept.old.eqOk, eqFail = kept.old.eqFail, eqNo = kept.old.eqNo)), kept.next)
        Core.Next -> nextKept(Next.Decl.check(env, j.upTo, j.head, j.value, j.isThm, kept.next), kept.old)
        Core.Both -> agree(jobChecks(j, St.update(checkerFor(env, j), closed = kept.old.closed, unfoldCache = kept.old.unfolds, levelTypes = kept.old.types, vars = kept.old.vars, lctx = kept.old.lctx, next = kept.old.next, topLevel = kept.old.topLevel, inferCache = kept.old.inferCache, checkCache = kept.old.checkCache, whnfCache = kept.old.whnfCache, coreCache = kept.old.coreCache, eqOk = kept.old.eqOk, eqFail = kept.old.eqFail, eqNo = kept.old.eqNo)), Next.Decl.check(env, j.upTo, j.head, j.value, j.isThm, kept.next))

verify jobFor
    jobFor(Core.Both, Job(pos = 0, upTo = 0, head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), value = Option.Some(Core.Exprs.sort(Level.Zero)), isThm = false), Check.State.envEmpty(), keptEmpty()) => Result.Err(Fail.Reject("declaration type mismatch"))
    jobFor(Core.Next, Job(pos = 0, upTo = 0, head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), value = Option.None, isThm = false), Check.State.envEmpty(), keptEmpty()) == Result.Ok(keptEmpty()) => true

fn oldKept(r: Result<OldFacts, Fail>, next: Facts) -> Result<Kept, Fail>
    ? "The first core's facts after a declaration, with the second core's as they were. The two are passed apart, each once, so that the first core's cache reaches the next declaration with one owner."
    match r
        Result.Ok(closed) -> Result.Ok(Kept(old = closed, next = next))
        Result.Err(e) -> Result.Err(e)

verify oldKept
    oldKept(Result.Err(Fail.Reject("x")), Next.Decl.empty()) => Result.Err(Fail.Reject("x"))

fn nextKept(r: Result<Facts, Fail>, old: OldFacts) -> Result<Kept, Fail>
    ? "The second core's facts after a declaration, with the first core's as they were."
    match r
        Result.Ok(f) -> Result.Ok(Kept(old = old, next = f))
        Result.Err(e) -> Result.Err(e)

verify nextKept
    nextKept(Result.Err(Fail.Decline("x")), oldEmpty()) => Result.Err(Fail.Decline("x"))

fn agree(a: Result<OldFacts, Fail>, b: Result<Facts, Fail>) -> Result<Kept, Fail>
    ? "Both cores accepted, or both failed the same way; otherwise a rejection that tells the two answers apart."
    match a
        Result.Ok(closed) -> match b
            Result.Ok(f) -> Result.Ok(Kept(old = closed, next = f))
            Result.Err(e) -> Result.Err(Fail.Reject("the cores disagree: the first accepts, the second says {failText(e)}"))
        Result.Err(e) -> match b
            Result.Ok -> Result.Err(Fail.Reject("the cores disagree: the first says {failText(e)}, the second accepts"))
            Result.Err(f) -> match sameKind(e, f)
                true -> Result.Err(e)
                false -> Result.Err(Fail.Reject("the cores disagree: the first says {failText(e)}, the second says {failText(f)}"))

verify agree
    agree(Result.Ok(oldEmpty()), Result.Err(Fail.Reject("m"))) => Result.Err(Fail.Reject("the cores disagree: the first accepts, the second says rejected: m"))
    agree(Result.Err(Fail.Reject("m")), Result.Err(Fail.Reject("n"))) => Result.Err(Fail.Reject("m"))
    agree(Result.Err(Fail.Reject("m")), Result.Err(Fail.Decline("n"))) => Result.Err(Fail.Reject("the cores disagree: the first says rejected: m, the second says declined: n"))

fn sameKind(a: Fail, b: Fail) -> Bool
    ? "Both rejections or both declines."
    match a
        Fail.Reject -> match b
            Fail.Reject -> true
            Fail.Decline -> false
        Fail.Decline -> match b
            Fail.Decline -> true
            Fail.Reject -> false

verify sameKind
    sameKind(Fail.Reject("a"), Fail.Decline("b")) => false

fn failText(e: Fail) -> String
    ? "A failure as the verdict line words it."
    match e
        Fail.Reject(m) -> "rejected: {m}"
        Fail.Decline(m) -> "declined: {m}"

verify failText
    failText(Fail.Decline("x")) => "declined: x"

fn combine(a: Admitted, results: List<Checked>) -> Result<Run, Fail>
    ? "The first failure in file order across the chunks and the building; otherwise the run with every deferred declaration counted."
    firstOf(results, a.failure, a.at, 0, a)

verify combine
    combine(admit([]), [Checked(failure = Option.Some(Fail.Reject("b")), at = 9, count = 0), Checked(failure = Option.Some(Fail.Reject("a")), at = 2, count = 0)]) => Result.Err(Fail.Reject("a"))

fn firstOf(rs: List<Checked>, best: Option<Fail>, bestAt: Int, count: Int, a: Admitted) -> Result<Run, Fail>
    ? "Keeps the earliest failure seen so far."
    match rs
        [] -> match best
            Option.Some(e) -> Result.Err(e)
            Option.None -> Result.Ok(Run.update(a.run, checked = a.run.checked + count, jobs = []))
        [r, ..rest] -> match r.failure
            Option.None -> firstOf(rest, best, bestAt, count + r.count, a)
            Option.Some(e) -> match Bool.or(best == Option.None, r.at < bestAt)
                true -> firstOf(rest, r.failure, r.at, count + r.count, a)
                false -> firstOf(rest, best, bestAt, count + r.count, a)

verify firstOf
    firstOf([], Option.None, 0, 5, admit([])) == Result.Err(Fail.Reject("x")) => false

fn admitAll(run: Run, decls: List<Decl>) -> Admitted
    ? "One declaration at a time; the first failure stops the building and is kept with its position. A declaration is checked against the environment, which it only reads, and added after: a failure leaves the run as it was without a copy of it kept, so the environment always has one owner and is added to in place."
    match decls
        [] -> Admitted(run = run, failure = Option.None, at = run.pos)
        [d, ..rest] -> match prepared(run.env, d)
            Result.Ok(a) -> admitAll(applied(run, a), rest)
            Result.Err(e) -> Admitted(run = run, failure = Option.Some(failNamed(e, Core.Decls.nameOf(d))), at = run.pos)

verify admitAll
    admitAll(Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0), []).at => 0
    admitAll(Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0), [Decl.Axiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), false), Decl.Axiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), false)]).failure => Option.Some(Fail.Reject("[anonymous]: already declared"))

fn checkJobs(jobs: List<Job>, env: Env, facts: OldFacts, limit: Int) -> Result<OldFacts, Fail>
    ? "The deferred declarations in file order, up to the position where the building failed."
    match jobs
        [] -> Result.Ok(facts)
        [j, ..rest] -> match j.pos < limit
            false -> Result.Ok(facts)
            true -> jobDone(jobChecks(j, St.update(checkerFor(env, j), closed = facts.closed, unfoldCache = facts.unfolds, levelTypes = facts.types, vars = facts.vars, lctx = facts.lctx, next = facts.next, topLevel = facts.topLevel, inferCache = facts.inferCache, checkCache = facts.checkCache, whnfCache = facts.whnfCache, coreCache = facts.coreCache, eqOk = facts.eqOk, eqFail = facts.eqFail, eqNo = facts.eqNo)), j, env, rest, limit)

verify checkJobs
    checkJobs([], Check.State.envEmpty(), oldEmpty(), 0) => Result.Ok(oldEmpty())

fn jobDone(r: Result<OldFacts, Fail>, j: Job, env: Env, rest: List<Job>, limit: Int) -> Result<OldFacts, Fail>
    ? "Goes on, or names the declaration that failed."
    match r
        Result.Ok(facts) -> checkJobs(rest, env, facts, limit)
        Result.Err(e) -> Result.Err(failNamed(e, j.head.name))

verify jobDone
    jobDone(Result.Err(Fail.Reject("bad")), Job(pos = 0, upTo = 0, head = Head(name = Core.Names.str(Core.Names.anon(), "x"), params = [], ty = Core.Exprs.bvar(0)), value = Option.None, isThm = false), Check.State.envEmpty(), [], 1) => Result.Err(Fail.Reject("x: bad"))

fn finish(a: Admitted, b: Result<OldFacts, Fail>) -> Result<Run, Fail>
    ? "A deferred failure comes first in the file; then the building's own; else everything passed."
    match b
        Result.Err(e) -> Result.Err(e)
        Result.Ok(facts) -> match a.failure
            Option.Some(e) -> Result.Err(e)
            Option.None -> Result.Ok(Run.update(a.run, closed = facts.closed, checked = a.run.checked + List.len(a.run.jobs), jobs = []))

verify finish
    finish(Admitted(run = Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0), failure = Option.Some(Fail.Reject("late")), at = 3), Result.Err(Fail.Reject("early"))) => Result.Err(Fail.Reject("early"))

fn checkerFor(env: Env, j: Job) -> St
    ? "A fresh checker for a deferred declaration: its universe parameters, and the constants of env placed before it."
    St.update(Check.State.fresh(env, j.head.params, Safety.Safe), upTo = j.upTo)

verify checkerFor
    checkerFor(Check.State.envEmpty(), Job(pos = 0, upTo = 0, head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), value = Option.None, isThm = false)).upTo => 0

fn jobChecks(j: Job, st0: St) -> Result<OldFacts, Fail>
    ? "A deferred declaration, from st0, its checker carrying the cache of checked closed terms: the type is a type, a theorem's type a proposition, and the value's type equal to the declared one. Returns the cache. The caller puts the cache into the checker itself, where it moves, so that the cache reaches the checker with one owner and is updated in place."
    st = typeIsSort(Check.Tc.check(st0, j.head.ty)?)?
    match j.value
        Option.None -> Result.Ok(carried(st))
        Option.Some(v) -> valueChecks(st, j.head.ty, v, j.isThm)

verify jobChecks
    jobChecks(Job(pos = 0, upTo = 0, head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), value = Option.Some(Core.Exprs.sort(Level.Zero)), isThm = false), Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)) => Result.Err(Fail.Reject("declaration type mismatch"))

fn carried(st: St) -> OldFacts
    ? "What the first core takes from a declaration to the next: the facts about closed terms; the values and constant types instantiated at universe levels, which depend on the levels as written, not on what they mean in a declaration; and, since a free variable is made of its level, type, value and binder info (LevelledVariables), the variables made so far with their context, and what was found by inference, checking, reduction and comparison about terms holding them, which holds wherever the same variables appear. Only the checking of terms with a universe parameter is kept within its declaration: it asks whether the parameter is the declaration's own. Each map is emptied past its limit; the variables and their context together."
    full = Core.Cache.size(st.vars) > 65536
    OldFacts(closed = st.closed, unfolds = bounded(st.unfoldCache, 16384), types = bounded(st.levelTypes, 65536), vars = bounded(st.vars, 65536), lctx = localsKept(st.lctx, full), next = st.next, topLevel = st.topLevel, inferCache = bounded(st.inferCache, 65536), checkCache = bounded(st.checkCache, 65536), whnfCache = bounded(st.whnfCache, 65536), coreCache = bounded(st.coreCache, 65536), eqOk = bounded(st.eqOk, 65536), eqFail = bounded(st.eqFail, 65536), eqNo = bounded(st.eqNo, 65536))

fn localsKept(lctx: Locals, full: Bool) -> Locals
    ? "The context of the variables kept, or none once the variables were let go."
    match full
        true -> Locals.NoLocals
        false -> lctx

verify localsKept
    localsKept(Locals.NoLocals, true) => Locals.NoLocals

verify carried
    Core.Cache.size(carried(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)).unfolds) => 0

fn bounded(m: Map<Int, List<Tuple<Expr, Expr>>>, limit: Int) -> Map<Int, List<Tuple<Expr, Expr>>>
    ? "A map carried across declarations, emptied once it passes limit hashes: kept for the whole run, values instantiated at levels once took mathlib past 14 GB and constant types took it there again on one worker, while most entries are asked for again within a few declarations."
    match Core.Cache.size(m) > limit
        true -> Core.Cache.empty()
        false -> m

verify bounded
    Core.Cache.size(bounded(Core.Cache.empty(), 1)) => 0

verify checkAll
    checkAll([]) => Result.Ok(Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0))

fn failNamed(e: Fail, n: Name) -> Fail
    ? "Puts the declaration's name in front of a failure."
    match e
        Fail.Reject(m) -> Fail.Reject("{Core.Names.render(n)}: {m}")
        Fail.Decline(m) -> Fail.Decline("{Core.Names.render(n)}: {m}")

verify failNamed
    failNamed(Fail.Decline("d"), Core.Names.str(Core.Names.anon(), "y")) => Fail.Decline("y: d")

type Addition
    Skipped
    Deferred(Head, Option<Expr>, Bool, Const)
    Derived(Env)
    Block(Map<Name, Const>)
    Trusted(List<Const>)

fn prepared(env: Env, d: Decl) -> Result<Addition, Fail>
    ? "What a declaration adds, found by checking it against the environment, which it only reads."
    match d
        Decl.Axiom(h, unsafe) -> match unsafe
            true -> Result.Ok(Addition.Skipped)
            false -> deferred(env, h, Option.None, false, Const.CAxiom(h, false))
        Decl.Defn(h, v, hints, safety, _) -> match safety
            Safety.Safe -> deferred(env, h, Option.Some(v), false, Const.CDefn(h, v, hints, safety))
            _ -> Result.Ok(Addition.Skipped)
        Decl.Thm(h, v, _) -> deferred(env, h, Option.Some(v), true, Const.CThm(h, v))
        Decl.Opaq(h, v, unsafe, _) -> match unsafe
            true -> Result.Ok(Addition.Skipped)
            false -> deferred(env, h, Option.Some(v), false, Const.COpaque(h, v, unsafe))
        Decl.Quot(h, kind) -> Result.Ok(Addition.Derived(Check.IndAdd.addQuotDecl(env, h, kind)?))
        Decl.Induct(types, ctors, recs) -> match anyUnsafe(types)
            true -> Result.Ok(Addition.Skipped)
            false -> inductive(env, Check.IndAdd.addInductive(env, types, ctors, recs), types, ctors, recs)

verify prepared
    prepared(Check.State.envEmpty(), Decl.Axiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), true)) => Result.Ok(Addition.Skipped)

fn deferred(env: Env, h: Head, v: Option<Expr>, isThm: Bool, c: Const) -> Result<Addition, Fail>
    ? "A new name and distinct universe parameters now; the type and value are checked later, against the environment before the constant."
    ok = newHead(env, h)?
    Result.Ok(Addition.Deferred(h, v, isThm, c))

verify deferred
    deferred(Check.State.envEmpty(), Head(name = Core.Names.anon(), params = [Core.Names.anon(), Core.Names.anon()], ty = Core.Exprs.sort(Level.Zero)), Option.None, false, Const.CAxiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), false)) => Result.Err(Fail.Reject("duplicate universe level parameter"))

fn newHead(env: Env, h: Head) -> Result<Unit, Fail>
    ? "The name is not taken and the universe parameters are distinct."
    match Check.State.envHas(env, h.name)
        true -> Result.Err(Fail.Reject("already declared"))
        false -> match hasDup(h.params)
            true -> Result.Err(Fail.Reject("duplicate universe level parameter"))
            false -> Result.Ok(Unit)

verify newHead
    newHead(Check.State.envEmpty(), Head(name = Core.Names.anon(), params = [Core.Names.anon(), Core.Names.anon()], ty = Core.Exprs.sort(Level.Zero))) => Result.Err(Fail.Reject("duplicate universe level parameter"))

fn inductive(env: Env, r: Result<Map<Name, Const>, Fail>, types: List<IndType>, ctors: List<Ctor>, recs: List<Rec>) -> Result<Addition, Fail>
    ? "A derived block, or one Pestka cannot derive yet admitted as stated."
    match r
        Result.Ok(cs) -> Result.Ok(Addition.Block(cs))
        Result.Err(Fail.Decline) -> trusted(env, inductConsts(types, ctors, recs))
        Result.Err(e) -> Result.Err(e)

verify inductive
    inductive(Check.State.envEmpty(), Result.Err(Fail.Reject("x")), [], [], []) => Result.Err(Fail.Reject("x"))

fn trusted(env: Env, cs: List<Const>) -> Result<Addition, Fail>
    ? "Constants admitted without checking; their names must still be new."
    match anyDeclared(env, cs)
        true -> Result.Err(Fail.Reject("already declared"))
        false -> Result.Ok(Addition.Trusted(cs))

verify trusted
    trusted(Check.State.envEmpty(), []) => Result.Ok(Addition.Trusted([]))

fn applied(run: Run, a: Addition) -> Run
    ? "Adds what a declaration was found to add; nothing here fails."
    match a
        Addition.Skipped -> Run.update(run, skipped = run.skipped + 1, pos = run.pos + 1)
        Addition.Deferred(h, v, isThm, c) -> deferAdded(run, h, v, isThm, c)
        Addition.Derived(env) -> Run.update(run, env = env, checked = run.checked + 1, pos = run.pos + 1)
        Addition.Block(cs) -> Run.update(run, env = mergeConsts(run.env, Map.entries(cs)), checked = run.checked + 1, pos = run.pos + 1)
        Addition.Trusted(cs) -> Run.update(run, env = addConsts(run.env, cs), trusted = run.trusted + 1, pos = run.pos + 1)

verify applied
    applied(Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0), Addition.Skipped).skipped => 1
    applied(Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0), Addition.Block({})).checked => 1
    applied(Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0), Addition.Trusted([])).trusted => 1

fn deferAdded(run: Run, h: Head, v: Option<Expr>, isThm: Bool, c: Const) -> Run
    ? "The constant joins the environment, and its type and value wait to be checked against the environment before it. Its place is read before the environment is passed on, so that the add has it alone."
    upTo = Check.State.envSize(run.env)
    Run.update(run, env = Check.State.envSet(run.env, h.name, c), jobs = List.prepend(Job(pos = run.pos, upTo = upTo, head = h, value = v, isThm = isThm), run.jobs), pos = run.pos + 1)

verify deferAdded
    deferAdded(Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0), Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), Option.None, false, Const.CAxiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), false)).pos => 1

fn mergeConsts(env: Env, cs: List<Tuple<Name, Const>>) -> Env
    ? "Adds each named constant."
    match cs
        [] -> env
        [(n, c), ..rest] -> mergeConsts(Check.State.envSet(env, n, c), rest)

verify mergeConsts
    Check.State.envHas(mergeConsts(Check.State.envEmpty(), [(Core.Names.anon(), Const.CAxiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), false))]), Core.Names.anon()) => true

fn anyUnsafe(types: List<IndType>) -> Bool
    ? "An unsafe inductive block."
    match types
        [] -> false
        [t, ..rest] -> Bool.or(t.isUnsafe, anyUnsafe(rest))

verify anyUnsafe
    anyUnsafe([]) => false

fn typeIsSort(t: RE) -> Result<St, Fail>
    ? "The declared type's type must be a sort."
    Result.Ok(Check.Tc.ensureSort(t.st, t.e)?.st)

verify typeIsSort
    typeIsSort(RE(e = Core.Exprs.natLit(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe))) => Result.Err(Fail.Reject("type expected"))

fn hasDup(ps: List<Name>) -> Bool
    ? "A name occurring twice."
    match ps
        [] -> false
        [p, ..rest] -> Bool.or(List.contains(rest, p), hasDup(rest))

verify hasDup
    hasDup([Core.Names.anon()]) => false

fn valueChecks(st: St, ty: Expr, v: Expr, isThm: Bool) -> Result<OldFacts, Fail>
    ? "A theorem's type a proposition, and the value's type equal to the declared one; returns the shared cache of checked closed terms."
    st2 = thmProp(st, ty, isThm)?
    vt = Check.Tc.check(st2, v)?
    eq = Check.Tc.isDefEq(vt.st, vt.e, ty)?
    match eq.b
        true -> Result.Ok(carried(eq.st))
        false -> Result.Err(Fail.Reject("declaration type mismatch"))

verify valueChecks
    valueChecks(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Zero), false) => Result.Err(Fail.Reject("declaration type mismatch"))

fn thmProp(st: St, ty: Expr, isThm: Bool) -> Result<St, Fail>
    ? "A theorem must state a proposition."
    match isThm
        false -> Result.Ok(st)
        true -> propOrFail(Check.Tc.isProp(st, ty)?)

verify thmProp
    thmProp(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), true) => Result.Err(Fail.Reject("theorem type is not Prop"))

fn propOrFail(p: RB) -> Result<St, Fail>
    ? "Passes a proposition."
    match p.b
        true -> Result.Ok(p.st)
        false -> Result.Err(Fail.Reject("theorem type is not Prop"))

verify propOrFail
    propOrFail(RB(b = false, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe))) => Result.Err(Fail.Reject("theorem type is not Prop"))

fn anyDeclared(env: Env, cs: List<Const>) -> Bool
    ? "Some name is already in the environment."
    match cs
        [] -> false
        [c, ..rest] -> Bool.or(Check.State.envHas(env, Check.State.headOf(c).name), anyDeclared(env, rest))

verify anyDeclared
    anyDeclared(Check.State.envEmpty(), []) => false

fn addConsts(env: Env, cs: List<Const>) -> Env
    ? "Adds each constant under its name."
    match cs
        [] -> env
        [c, ..rest] -> addConsts(Check.State.envSet(env, Check.State.headOf(c).name, c), rest)

verify addConsts
    Check.State.envHas(addConsts(Check.State.envEmpty(), [Const.CAxiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), false)]), Core.Names.anon()) => true

fn inductConsts(types: List<IndType>, ctors: List<Ctor>, recs: List<Rec>) -> List<Const>
    ? "Every constant an inductive block declares."
    List.concat(typeConsts(types, []), List.concat(ctorConsts(ctors, []), recConsts(recs, [])))

verify inductConsts
    inductConsts([], [], []) => []

fn typeConsts(xs: List<IndType>, acc: List<Const>) -> List<Const>
    ? "The types."
    match xs
        [] -> List.reverse(acc)
        [x, ..rest] -> typeConsts(rest, List.prepend(Const.CInduct(x), acc))

verify typeConsts
    typeConsts([], []) => []

fn ctorConsts(xs: List<Ctor>, acc: List<Const>) -> List<Const>
    ? "The constructors."
    match xs
        [] -> List.reverse(acc)
        [x, ..rest] -> ctorConsts(rest, List.prepend(Const.CCtor(x), acc))

verify ctorConsts
    ctorConsts([], []) => []

fn recConsts(xs: List<Rec>, acc: List<Const>) -> List<Const>
    ? "The recursors."
    match xs
        [] -> List.reverse(acc)
        [x, ..rest] -> recConsts(rest, List.prepend(Const.CRec(x), acc))

verify recConsts
    recConsts([], []) => []
