module Decl
    intent =
        "Adds declarations to the environment in file order and checks each"
        "as Lean's kernel does when it replays an export: the name is new,"
        "the universe parameters are distinct, the type is a type, and a"
        "value has the declared type. Unsafe and partial declarations are"
        "skipped, as the reference replay skips them. Inductive blocks and"
        "the quotient package are derived and compared with the export as"
        "they are met. The types and values of the other declarations are"
        "checked after the environment is built, each against the"
        "environment at its own place in the file, so that they can be"
        "checked apart; the verdict names the first failure in file order,"
        "as checking strictly in order would."
    exposes [Run, Job, Admitted, Chunk, Checked, Checking, checkAll, checkParallel, checkHeld, admit, due, chunks, checkChunk, combine, jobChecks]
    depends [Core.Names, Core.Levels, Core.Exprs, Core.Decls, Core.Cache, Check.Shapes, Check.State, Check.Tc, Check.IndAdd]
    effects []

record Run
    env: Env
    closed: Map<Core.Exprs.Key, Bucket>
    checked: Int
    trusted: Int
    skipped: Int
    jobs: List<Job>
    pos: Int

record Job
    pos: Int
    upTo: Int
    head: Head
    value: Option<Expr>
    isThm: Bool

record Admitted
    run: Run
    failure: Option<Fail>
    at: Int

record Chunk
    env: Env
    jobs: List<Job>
    limits: Limits

record Facts
    closed: Map<Core.Exprs.Key, Bucket>
    unfolds: Map<Core.Exprs.Key, Bucket>
    types: Map<Core.Exprs.Key, Bucket>
    vars: Map<Core.Exprs.Key, Bucket>
    lctx: Locals
    next: Int
    topLevel: Int
    inferCache: Map<Core.Exprs.Key, Bucket>
    checkCache: Map<Core.Exprs.Key, Bucket>
    whnfCache: Map<Core.Exprs.Key, Bucket>
    coreCache: Map<Core.Exprs.Key, Bucket>
    eqOk: Map<Core.Exprs.Key, Bucket>
    eqFail: Map<Core.Exprs.Key, Bucket>
    eqNo: Map<Core.Exprs.Key, Bucket>
    rules: Map<Core.Exprs.Key, Tuple<Expr, Check.Shapes.Hot>>

record Checked
    failure: Option<Fail>
    at: Int
    count: Int
    kept: Facts

record Checking
    run: Result<Run, Fail>
    held: List<Checked>

fn checkAll(decls: List<Decl>) -> Result<Run, Fail>
    ? "Builds the environment, then checks the deferred declarations before the first failure the building met, one after another."
    a = admit(decls)
    finish(a, checkJobs(List.reverse(a.run.jobs), a.run.env, Facts.update(noFacts(), closed = a.run.closed), a.at))

fn admit(decls: List<Decl>) -> Admitted
    ? "Builds the environment from nothing; the deferred declarations wait in the result."
    admitAll(Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0), decls)

verify admit
    admit([]).at => 0

fn due(a: Admitted) -> List<Job>
    ? "The deferred declarations in file order, those before the building's failure."
    List.reverse(dropLate(a.run.jobs, a.at, []))

verify due
    due(admit([])) => []

fn dropLate(jobs: List<Job>, limit: Int, acc: List<Job>) -> List<Job>
    ? "Keeps the jobs before limit; jobs come newest first and go out oldest first."
    match jobs
        [] -> List.reverse(acc)
        [j, ..rest] -> match j.pos < limit
            true -> dropLate(rest, limit, List.prepend(j, acc))
            false -> dropLate(rest, limit, acc)

verify dropLate
    dropLate([], 0, []) => []

fn chunks(jobs: List<Job>, env: Env, limits: Limits, size: Int, cur: List<Job>, n: Int, acc: List<Chunk>) -> List<Chunk>
    ? "Consecutive runs of size jobs, in the order checked, each with the whole environment; neighbours share the most, which keeps the per-chunk caches useful."
    match jobs
        [] -> match cur
            [] -> List.reverse(acc)
            _ -> List.reverse(List.prepend(Chunk(env = env, jobs = List.reverse(cur), limits = limits), acc))
        [j, ..rest] -> match n + 1 >= size
            true -> chunks(rest, env, limits, size, [], 0, List.prepend(Chunk(env = env, jobs = List.reverse(List.prepend(j, cur)), limits = limits), acc))
            false -> chunks(rest, env, limits, size, List.prepend(j, cur), n + 1, acc)

verify chunks
    chunks([], Check.State.envEmpty(), Check.State.limitsOf(65536, Memory.Fast), 4, [], 0, []) => []

decision CheckedByNamespace
    date = "2026-11-06"
    reason =
        "A worker keeps what it found across declarations in maps emptied"
        "past their limits, and on mathlib most entries are asked for again"
        "only after the map they were in was emptied. Declarations about the"
        "same things share one namespace but lie far apart in the file;"
        "checked one namespace after another, they meet the facts they share"
        "before those are let go. The facts carried hold in a later"
        "declaration only when its environment holds every constant they"
        "used (sharedPair): in file order the environment only grows, in"
        "another order a declaration naming a constant placed after it"
        "could find a fact about it instead of the unknown constant. So the"
        "order is changed only when the reader found every declaration naming"
        "constants placed before it alone (NamesPlacedWhereRead), which a"
        "fact about its own terms then uses too, and the earliest failure in"
        "the file is still the one reported."
        "Below the unit of the limits per worker the maps are emptied a few"
        "times at most, and the order stays. Mathlib, one worker,"
        "instructions retired: 1475.9 G and 1476.8 G to 1347.9 G and 1343.5 G,"
        "peak 8.2 GB to 8.6 GB; Init and etale unchanged. A walk of every"
        "type and value before checking, to know the names placed, cost"
        "195 G of that (TermsWalkedBeforeChecking)."
    chosen = "CheckedByNamespace"
    rejected = ["FileOrderAlways", "OrderedBySharedKeys", "TermsWalkedBeforeChecking"]
    impacts = [orderFor, ordered, chunkLoop, chunkNext]

fn orderFor(jobs: List<Job>, workers: Int, placed: Bool, always: Bool) -> List<Job>
    ? "File order while each worker has no more declarations than the unit of its limits, where the maps carried are emptied a few times at most and grouping costs more than it keeps, or when some declaration names a constant not placed before it; otherwise grouped by namespace (CheckedByNamespace). Mathlib's 702040 declarations on one worker pass 262144; Init's 58170, std's 101286 and cedar's 143203 do not, nor any of these on eight workers. always, for tests, groups whatever the count, still only when every name was placed."
    match Bool.or(always, List.len(jobs) > Int.max(workers, 1) * keepFor(workers))
        false -> jobs
        true -> match placed
            true -> ordered(jobs)
            false -> jobs

verify orderFor
    orderFor([], 1, true, false) => []
    List.len(orderFor([Job(pos = 0, upTo = 0, head = Head(name = Core.Names.str(Core.Names.str(Core.Names.anon(), "b"), "x"), params = [], ty = Core.Exprs.sort(Level.Zero)), value = Option.None, isThm = false), Job(pos = 1, upTo = 1, head = Head(name = Core.Names.str(Core.Names.str(Core.Names.anon(), "a"), "x"), params = [], ty = Core.Exprs.sort(Level.Zero)), value = Option.None, isThm = false)], 1, true, true)) => 2
    orderFor([Job(pos = 0, upTo = 0, head = Head(name = Core.Names.str(Core.Names.str(Core.Names.anon(), "b"), "x"), params = [], ty = Core.Exprs.sort(Level.Zero)), value = Option.None, isThm = false), Job(pos = 1, upTo = 1, head = Head(name = Core.Names.str(Core.Names.str(Core.Names.anon(), "a"), "x"), params = [], ty = Core.Exprs.sort(Level.Zero)), value = Option.None, isThm = false)], 1, true, true) == orderFor([Job(pos = 0, upTo = 0, head = Head(name = Core.Names.str(Core.Names.str(Core.Names.anon(), "b"), "x"), params = [], ty = Core.Exprs.sort(Level.Zero)), value = Option.None, isThm = false), Job(pos = 1, upTo = 1, head = Head(name = Core.Names.str(Core.Names.str(Core.Names.anon(), "a"), "x"), params = [], ty = Core.Exprs.sort(Level.Zero)), value = Option.None, isThm = false)], 1, true, false) => false

fn ordered(jobs: List<Job>) -> List<Job>
    ? "The deferred declarations grouped by the first component of their names, groups in the order of that component and file order within each, so that declarations about the same things are checked one after another and the facts one finds are still kept when the next asks for them (CheckedByNamespace)."
    unkeyed(sortKeyed(keyed(jobs, [])), [])

verify ordered
    ordered([]) => []

fn keyed(jobs: List<Job>, acc: List<Tuple<String, Job>>) -> List<Tuple<String, Job>>
    ? "Each job with its group, in the jobs' order."
    match jobs
        [] -> List.reverse(acc)
        [j, ..rest] -> keyed(rest, List.prepend((groupOf(j.head.name), j), acc))

verify keyed
    keyed([], []) => []

fn unkeyed(xs: List<Tuple<String, Job>>, acc: List<Job>) -> List<Job>
    ? "The jobs without their groups, in order."
    match xs
        [] -> List.reverse(acc)
        [(_, j), ..rest] -> unkeyed(rest, List.prepend(j, acc))

verify unkeyed
    unkeyed([], []) => []

fn groupOf(n: Name) -> String
    ? "The first component of a name of two components or more; the empty string for a name of one."
    match n
        Name.Anon -> ""
        Name.Str(pre, _, _) -> rootOf(pre)
        Name.Num(pre, _, _) -> rootOf(pre)

verify groupOf
    groupOf(Core.Names.str(Core.Names.str(Core.Names.str(Core.Names.anon(), "Nat"), "add"), "comm")) => "Nat"
    groupOf(Core.Names.str(Core.Names.anon(), "x")) => ""

fn rootOf(n: Name) -> String
    ? "The first component of a name, empty for the empty name."
    match n
        Name.Anon -> ""
        Name.Str(Name.Anon, s, _) -> s
        Name.Num(Name.Anon, i, _) -> String.fromInt(i)
        Name.Str(pre, _, _) -> rootOf(pre)
        Name.Num(pre, _, _) -> rootOf(pre)

verify rootOf
    rootOf(Core.Names.str(Core.Names.str(Core.Names.anon(), "Nat"), "add")) => "Nat"
    rootOf(Core.Names.anon()) => ""

fn sortKeyed(xs: List<Tuple<String, Job>>) -> List<Tuple<String, Job>>
    ? "A stable merge sort by group."
    mergeAll(singles(xs, []))

verify sortKeyed
    sortKeyed([]) => []

fn singles(xs: List<Tuple<String, Job>>, acc: List<List<Tuple<String, Job>>>) -> List<List<Tuple<String, Job>>>
    ? "Every element a run of its own, in order."
    match xs
        [] -> List.reverse(acc)
        [x, ..rest] -> singles(rest, List.prepend([x], acc))

verify singles
    singles([], []) => []

fn mergeAll(runs: List<List<Tuple<String, Job>>>) -> List<Tuple<String, Job>>
    ? "Merges neighbouring runs until one is left."
    match runs
        [] -> []
        [r] -> r
        _ -> mergeAll(mergePairs(runs, []))

verify mergeAll
    mergeAll([]) => []

fn mergePairs(runs: List<List<Tuple<String, Job>>>, acc: List<List<Tuple<String, Job>>>) -> List<List<Tuple<String, Job>>>
    ? "The first run merged with the second, the third with the fourth, and so on."
    match runs
        [] -> List.reverse(acc)
        [r] -> List.reverse(List.prepend(r, acc))
        [a, b, ..rest] -> mergePairs(rest, List.prepend(merge(a, b, []), acc))

verify mergePairs
    mergePairs([], []) => []

fn merge(a: List<Tuple<String, Job>>, b: List<Tuple<String, Job>>, acc: List<Tuple<String, Job>>) -> List<Tuple<String, Job>>
    ? "Two sorted runs as one, the first's element first on a tie."
    match a
        [] -> List.concat(List.reverse(acc), b)
        [x, ..ra] -> match b
            [] -> List.concat(List.reverse(acc), a)
            [y, ..rb] -> match keyOf(y) < keyOf(x)
                true -> merge(a, rb, List.prepend(y, acc))
                false -> merge(ra, b, List.prepend(x, acc))

verify merge
    merge([], [], []) => []

fn keyOf(x: Tuple<String, Job>) -> String
    ? "The group of a keyed job."
    match x
        (k, _) -> k

verify keyOf
    keyOf(("a", Job(pos = 0, upTo = 0, head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), value = Option.None, isThm = false))) => "a"

fn checkParallel(decls: List<Decl>, workers: Int, memory: Memory) -> Result<Run, Fail>
    ? "Builds the environment, then checks the deferred declarations on workers at once: runs of 16 consecutive declarations are dealt to the workers in turn, which evens out their loads, and each worker checks its runs in file order."
    checkHeld(decls, workers, memory, false, false).run

verify checkParallel
    checkParallel([], 4, Memory.Fast) => Result.Ok(Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0))

decision FactsHeldToExit
    date = "2026-10-24"
    reason =
        "A program compiled to Rust ends the process at the tail of main"
        "without freeing what main still holds. The facts a worker kept"
        "across declarations were freed term by term as its last run"
        "ended, just before the process ended anyway. Each worker's facts"
        "now come back in its result, and main holds them, with the input"
        "and the run, until the verdict ends the process. Instructions"
        "retired, one worker: etale 62.9 G to 60.4 G, qb9 115.1 G to"
        "111.3 G, Init 136.2 G to 134.4 G."
    chosen = "FactsHeldToExit"
    rejected = ["FreedAtTheEnd"]
    impacts = [checkHeld, groupLoop, Checked]

fn checkHeld(decls: List<Decl>, workers: Int, memory: Memory, placed: Bool, always: Bool) -> Checking
    ? "checkParallel, with what each worker found handed back beside the result (FactsHeldToExit); the maps carried are bounded as the memory mode says (LowMemoryMode); always groups by namespace whatever the count, for tests (CheckedByNamespace)."
    a = admit(decls)
    jobs = orderFor(due(a), workers, placed, always)
    cs = runWorkers(deal(chunks(jobs, a.run.env, limitsFor(workers, memory), runSize(List.len(jobs), workers), [], 0, []), workers, 0, emptyGroups(workers, [])))
    Checking(run = combine(a, cs), held = cs)

verify checkHeld
    List.len(checkHeld([], 2, Memory.Fast, false, false).held) => 2

fn runSize(n: Int, workers: Int) -> Int
    ? "How many declarations one run holds: four runs per worker, at least 16, so that a worker checks long stretches of the same namespaces (WorkersByNamespace)."
    w = Int.max(workers, 1) * 4
    Int.max(16, Result.withDefault(Int.div(n + w - 1, w), 16))

verify runSize
    runSize(0, 1) => 16
    runSize(702040, 8) => 21939
    runSize(100, 4) => 16

decision WorkersByNamespace
    date = "2026-11-07"
    reason =
        "Runs of 16 declarations were dealt to the workers in turn, so a"
        "namespace, once grouped (CheckedByNamespace), was spread over every"
        "worker, each with maps of its own, and none of them met the facts"
        "it shared. Four runs per worker keep long stretches of a namespace"
        "on one worker and still let a worker whose stretch is cheap take"
        "more of the rest. One worker checks every run in turn with the"
        "same maps, so its work does not change. Mathlib, instructions"
        "retired and wall: four workers 1573.4 G, 132 s to 1464.2 G and"
        "1458.7 G, 111 s and 102 s; eight workers 1637.6 G, 119 s to"
        "1474.8 G and 1467.6 G, 89 s and 77 s. One run per worker took the"
        "fewest instructions, 1456.1 G on four, but 145 s, the costliest"
        "stretch alone; two and eight runs per worker were between."
    chosen = "FourRunsPerWorker"
    rejected = ["RunsOfSixteen", "OneRunPerWorker", "TwoRunsPerWorker", "EightRunsPerWorker"]
    impacts = [runSize, deal, checkHeld]

fn limitsFor(workers: Int, memory: Memory) -> Limits
    ? "The limits of the maps a worker carries across declarations, from the unit the number of workers sets and the memory mode."
    Check.State.limitsOf(keepFor(workers), memory)

verify limitsFor
    limitsFor(1, Memory.Fast).vars => 196608
    limitsFor(8, Memory.Low).vars => 8192

fn keepFor(workers: Int) -> Int
    ? "How many hashes a map carried across declarations keeps before it is emptied: the unit of the limits carried sets, three of it for the checked types, one and a half for equal pairs and three quarters for the rest (LimitsFromReuseDistances, LimitsAfterOrdering). Every worker keeps maps of its own; the workers share twice what one worker keeps, and no worker keeps more than one alone (CacheBudgetShared). Twice as much on one worker took mathlib from 10467.3 G to 10336.7 G instructions and its peak from 8.28 GB to 8.90 GB; twice that, once terms were smaller, from 5124.6 G to 5010.4 G and from 7.91 GB to 8.89 GB."
    Int.min(262144, Result.withDefault(Int.div(524288, Int.max(workers, 1)), 262144))

verify keepFor
    keepFor(1) => 262144
    keepFor(2) => 262144
    keepFor(4) => 131072
    keepFor(8) => 65536
    keepFor(12) => 43690

decision CacheBudgetShared
    date = "2026-11-07"
    reason =
        "Once a worker checks long stretches of the same namespaces"
        "(WorkersByNamespace), its maps are asked for again much as one"
        "worker's are, but the workers' maps together compete for memory"
        "and the processor's caches. Mathlib, instructions retired, wall"
        "and peak, each worker keeping 65536, 131072 or 262144: four workers"
        "1462.1 G, 118 s, 7.13 GB; 1427.9 G, 95 s, 9.60 GB; 1659.1 G,"
        "145 s, 13.95 GB; eight workers 1476.9 G, 106 s, 9.75 GB;"
        "1594.5 G, 89 s, 12.92 GB; 1823.7 G, 162 s, 22.09 GB, where the"
        "system's paging showed in the instructions. The best of each"
        "keeps 524288 among all the workers, twice what one worker keeps."
        "Against 65536 each: two workers 1455.9 G, 164 s, 5.99 GB to"
        "1393.7 G, 126 s, 10.01 GB; twelve 1637.0 G, 98 s, 10.81 GB to"
        "1494.9 G, 95 s, 9.52 GB; eight with 131072 again 1589.2 G against"
        "1463.6 G."
    chosen = "TwiceOneWorkerShared"
    rejected = ["QuarterPerWorker", "OneWorkerEach"]
    impacts = [keepFor, limitsFor, orderFor]

fn emptyGroups(n: Int, acc: List<List<Chunk>>) -> List<List<Chunk>>
    ? "n empty groups."
    none: List<Chunk> = []
    match n <= 0
        true -> acc
        false -> emptyGroups(n - 1, List.prepend(none, acc))

verify emptyGroups
    List.len(emptyGroups(3, [])) => 3

fn deal(cs: List<Chunk>, n: Int, i: Int, groups: List<List<Chunk>>) -> List<List<Chunk>>
    ? "Deals the runs to n groups in turn, run i to group i mod n, keeping each group in file order."
    match cs
        [] -> reverseEach(groups, [])
        [c, ..rest] -> deal(rest, n, i + 1, addAt(groups, Result.withDefault(Int.mod(i, Int.max(n, 1)), 0), c, []))

verify deal
    deal([], 2, 0, emptyGroups(2, [])) => [[], []]

fn addAt(groups: List<List<Chunk>>, k: Int, c: Chunk, before: List<List<Chunk>>) -> List<List<Chunk>>
    ? "Prepends c to group k."
    match groups
        [] -> List.reverse(before)
        [g, ..rest] -> match k == 0
            true -> List.concat(List.reverse(before), List.prepend(List.prepend(c, g), rest))
            false -> addAt(rest, k - 1, c, List.prepend(g, before))

verify addAt
    addAt([[], []], 1, Chunk(env = Check.State.envEmpty(), jobs = [], limits = Check.State.limitsOf(65536, Memory.Fast)), []) => [[], [Chunk(env = Check.State.envEmpty(), jobs = [], limits = Check.State.limitsOf(65536, Memory.Fast))]]

fn reverseEach(groups: List<List<Chunk>>, acc: List<List<Chunk>>) -> List<List<Chunk>>
    ? "Each group back in file order."
    match groups
        [] -> List.reverse(acc)
        [g, ..rest] -> reverseEach(rest, List.prepend(List.reverse(g), acc))

verify reverseEach
    reverseEach([], []) => []

fn runWorkers(groups: List<List<Chunk>>) -> List<Checked>
    ? "Every group on a worker of its own: the list is halved, and the halves run as an independent product."
    match groups
        [] -> []
        [g] -> [checkGroup(g)]
        _ -> halves(List.take(groups, Int.div(List.len(groups), 2)), List.drop(groups, Int.div(List.len(groups), 2)))

verify runWorkers
    runWorkers([[], []]) => [Checked(failure = Option.None, at = 0, count = 0, kept = noFacts()), Checked(failure = Option.None, at = 0, count = 0, kept = noFacts())]

fn halves(left: List<List<Chunk>>, right: List<List<Chunk>>) -> List<Checked>
    ? "The two halves at once."
    match (runWorkers(left), runWorkers(right))!
        (l, r) -> List.concat(l, r)

verify halves
    halves([], []) => []

fn checkGroup(g: List<Chunk>) -> Checked
    ? "One worker: its runs in file order with the facts kept across declarations, stopping at the first failure."
    groupLoop(g, noFacts(), 0, Option.None, 0)

verify checkGroup
    checkGroup([]) => Checked(failure = Option.None, at = 0, count = 0, kept = noFacts())

fn noFacts() -> Facts
    ? "No facts kept yet."
    Facts(closed = Core.Cache.empty(), unfolds = Core.Cache.empty(), types = Core.Cache.empty(), vars = Core.Cache.empty(), lctx = Locals.NoLocals, next = 0, topLevel = 0, inferCache = Core.Cache.empty(), checkCache = Core.Cache.empty(), whnfCache = Core.Cache.empty(), coreCache = Core.Cache.empty(), eqOk = Core.Cache.empty(), eqFail = Core.Cache.empty(), eqNo = Core.Cache.empty(), rules = {})

verify noFacts
    Core.Cache.size(noFacts().unfolds) => 0

fn groupLoop(g: List<Chunk>, kept: Facts, count: Int, fail: Option<Fail>, at: Int) -> Checked
    ? "Run after run; fail is the failure found so far, at its position in the file."
    match g
        [] -> Checked(failure = fail, at = at, count = count, kept = kept)
        [c, ..rest] -> chunkLoop(c.jobs, c.env, c.limits, rest, kept, count, fail, at)

verify groupLoop
    groupLoop([], noFacts(), 2, Option.None, 0).count => 2

fn checkChunk(c: Chunk) -> Checked
    ? "Checks one run of deferred declarations with facts of its own; the first failure is reported with its place in the file."
    chunkLoop(c.jobs, c.env, c.limits, [], noFacts(), 0, Option.None, 0)

verify checkChunk
    checkChunk(Chunk(env = Check.State.envEmpty(), jobs = [], limits = Check.State.limitsOf(65536, Memory.Fast))) => Checked(failure = Option.None, at = 0, count = 0, kept = noFacts())

fn chunkLoop(jobs: List<Job>, env: Env, limits: Limits, more: List<Chunk>, kept: Facts, count: Int, fail: Option<Fail>, at: Int) -> Checked
    ? "One job after another, then the next run, until one fails. Each job gets the facts kept from the ones before it; they are moved into its checker here, in the loop that owns them, so that every map reaches the checker with one owner and is updated in place."
    match jobs
        [] -> groupLoop(more, kept, count, fail, at)
        [j, ..rest] -> match Bool.and(fail != Option.None, j.pos > at)
            true -> chunkLoop(rest, env, limits, more, kept, count, fail, at)
            false -> chunkNext(jobChecks(j, St.update(checkerFor(env, j), limits = limits, closed = kept.closed, unfoldCache = kept.unfolds, levelTypes = kept.types, vars = kept.vars, lctx = kept.lctx, next = kept.next, topLevel = kept.topLevel, inferCache = kept.inferCache, checkCache = kept.checkCache, whnfCache = kept.whnfCache, coreCache = kept.coreCache, eqOk = kept.eqOk, eqFail = kept.eqFail, eqNo = kept.eqNo, rules = kept.rules)), j, env, limits, rest, more, count, fail, at)

verify chunkLoop
    chunkLoop([], Check.State.envEmpty(), Check.State.limitsOf(65536, Memory.Fast), [], noFacts(), 3, Option.None, 0).count => 3

fn chunkNext(r: Result<Facts, Fail>, j: Job, env: Env, limits: Limits, rest: List<Job>, more: List<Chunk>, count: Int, fail: Option<Fail>, at: Int) -> Checked
    ? "Goes on after a failure too, now with the named failure and its position, checking only declarations placed before it: the runs are not in file order, and the earliest failure is the one reported."
    match r
        Result.Ok(kept) -> chunkLoop(rest, env, limits, more, kept, count + 1, fail, at)
        Result.Err(e) -> chunkLoop(rest, env, limits, more, noFacts(), count, Option.Some(failNamed(e, j.head.name)), j.pos)

verify chunkNext
    chunkNext(Result.Err(Fail.Reject("bad")), Job(pos = 4, upTo = 0, head = Head(name = Core.Names.str(Core.Names.anon(), "x"), params = [], ty = Core.Exprs.bvar(0)), value = Option.None, isThm = false), Check.State.envEmpty(), Check.State.limitsOf(65536, Memory.Fast), [], [], 0, Option.None, 0) => Checked(failure = Option.Some(Fail.Reject("x: bad")), at = 4, count = 0, kept = noFacts())

fn combine(a: Admitted, results: List<Checked>) -> Result<Run, Fail>
    ? "The first failure in file order across the chunks and the building; otherwise the run with every deferred declaration counted."
    firstOf(results, a.failure, a.at, 0, a)

verify combine
    combine(admit([]), [Checked(failure = Option.Some(Fail.Reject("b")), at = 9, count = 0, kept = noFacts()), Checked(failure = Option.Some(Fail.Reject("a")), at = 2, count = 0, kept = noFacts())]) => Result.Err(Fail.Reject("a"))

fn firstOf(rs: List<Checked>, best: Option<Fail>, bestAt: Int, count: Int, a: Admitted) -> Result<Run, Fail>
    ? "Keeps the earliest failure seen so far."
    match rs
        [] -> match best
            Option.Some(e) -> Result.Err(e)
            Option.None -> Result.Ok(Run.update(a.run, checked = a.run.checked + count, jobs = []))
        [r, ..rest] -> match r.failure
            Option.None -> firstOf(rest, best, bestAt, count + r.count, a)
            Option.Some(e) -> match Bool.or(best == Option.None, r.at < bestAt)
                true -> firstOf(rest, r.failure, r.at, count + r.count, a)
                false -> firstOf(rest, best, bestAt, count + r.count, a)

verify firstOf
    firstOf([], Option.None, 0, 5, admit([])) == Result.Err(Fail.Reject("x")) => false

fn admitAll(run: Run, decls: List<Decl>) -> Admitted
    ? "One declaration at a time; the first failure stops the building and is kept with its position. A declaration is checked against the environment, which it only reads, and added after: a failure leaves the run as it was without a copy of it kept, so the environment always has one owner and is added to in place."
    match decls
        [] -> Admitted(run = run, failure = Option.None, at = run.pos)
        [d, ..rest] -> match prepared(run.env, d)
            Result.Ok(a) -> admitAll(applied(run, a), rest)
            Result.Err(e) -> Admitted(run = run, failure = Option.Some(failNamed(e, Core.Decls.nameOf(d))), at = run.pos)

verify admitAll
    admitAll(Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0), []).at => 0
    admitAll(Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0), [Decl.Axiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), false), Decl.Axiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), false)]).failure => Option.Some(Fail.Reject("[anonymous]: already declared"))

fn checkJobs(jobs: List<Job>, env: Env, facts: Facts, limit: Int) -> Result<Facts, Fail>
    ? "The deferred declarations in file order, up to the position where the building failed."
    match jobs
        [] -> Result.Ok(facts)
        [j, ..rest] -> match j.pos < limit
            false -> Result.Ok(facts)
            true -> jobDone(jobChecks(j, St.update(checkerFor(env, j), closed = facts.closed, unfoldCache = facts.unfolds, levelTypes = facts.types, vars = facts.vars, lctx = facts.lctx, next = facts.next, topLevel = facts.topLevel, inferCache = facts.inferCache, checkCache = facts.checkCache, whnfCache = facts.whnfCache, coreCache = facts.coreCache, eqOk = facts.eqOk, eqFail = facts.eqFail, eqNo = facts.eqNo, rules = facts.rules)), j, env, rest, limit)

verify checkJobs
    checkJobs([], Check.State.envEmpty(), noFacts(), 0) => Result.Ok(noFacts())

fn jobDone(r: Result<Facts, Fail>, j: Job, env: Env, rest: List<Job>, limit: Int) -> Result<Facts, Fail>
    ? "Goes on, or names the declaration that failed."
    match r
        Result.Ok(facts) -> checkJobs(rest, env, facts, limit)
        Result.Err(e) -> Result.Err(failNamed(e, j.head.name))

verify jobDone
    jobDone(Result.Err(Fail.Reject("bad")), Job(pos = 0, upTo = 0, head = Head(name = Core.Names.str(Core.Names.anon(), "x"), params = [], ty = Core.Exprs.bvar(0)), value = Option.None, isThm = false), Check.State.envEmpty(), [], 1) => Result.Err(Fail.Reject("x: bad"))

fn finish(a: Admitted, b: Result<Facts, Fail>) -> Result<Run, Fail>
    ? "A deferred failure comes first in the file; then the building's own; else everything passed."
    match b
        Result.Err(e) -> Result.Err(e)
        Result.Ok(facts) -> match a.failure
            Option.Some(e) -> Result.Err(e)
            Option.None -> Result.Ok(Run.update(a.run, closed = facts.closed, checked = a.run.checked + List.len(a.run.jobs), jobs = []))

verify finish
    finish(Admitted(run = Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0), failure = Option.Some(Fail.Reject("late")), at = 3), Result.Err(Fail.Reject("early"))) => Result.Err(Fail.Reject("early"))

fn checkerFor(env: Env, j: Job) -> St
    ? "A fresh checker for a deferred declaration: its universe parameters, and the constants of env placed before it."
    St.update(Check.State.fresh(env, j.head.params, Safety.Safe), upTo = j.upTo)

verify checkerFor
    checkerFor(Check.State.envEmpty(), Job(pos = 0, upTo = 0, head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), value = Option.None, isThm = false)).upTo => 0

fn jobChecks(j: Job, st0: St) -> Result<Facts, Fail>
    ? "A deferred declaration, from st0, its checker carrying the cache of checked closed terms: the type is a type, a theorem's type a proposition, and the value's type equal to the declared one. Returns the cache. The caller puts the cache into the checker itself, where it moves, so that the cache reaches the checker with one owner and is updated in place."
    st = typeIsSort(Check.Tc.check(st0, j.head.ty)?)?
    match j.value
        Option.None -> Result.Ok(carried(st))
        Option.Some(v) -> valueChecks(st, j.head.ty, v, j.isThm)

verify jobChecks
    jobChecks(Job(pos = 0, upTo = 0, head = Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), value = Option.Some(Core.Exprs.sort(Level.Zero)), isThm = false), Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)) => Result.Err(Fail.Reject("declaration type mismatch"))

decision LimitsFromReuseDistances
    date = "2026-11-03"
    reason =
        "Every map carried across declarations was emptied past one limit,"
        "the unfolding cache past a quarter of it. A counting run of mathlib"
        "measured for each cache the distance, in entries put since, between"
        "an entry and every later use of its key: a use within the entry's"
        "life is a hit, a use after the map was emptied computes the result"
        "again, and the instructions of such a computation were sampled."
        "An entry put when the map holds s entries lives limit - s puts, so a"
        "use at distance d is realized with probability 1 - d / limit, and"
        "the model says what a limit buys: the uses it realizes times what"
        "they cost to compute again, less the entries it keeps alive. The"
        "cache of checked types: 112 M hits, 4.8 M outermost uses of keys"
        "already dropped, at distances of 2^17 to 2^22 puts, 19.5 k"
        "instructions each to compute again (94 G in all, 4% of mathlib),"
        "848 instructions to drop an entry and about 470 bytes to keep one."
        "Four times its limit realizes 1.5 M of them, 18 G by the model, for"
        "0.4 GB more at the peak. The unfolding cache: 1.4 M such uses at"
        "2^15 to 2^20, 32 k instructions each (45 G), 5.5 k instructions to"
        "drop an entry; its limit four times larger, the unit itself,"
        "realizes 0.55 M of them, 17 G by the model. Equal pairs: 1.4 M uses"
        "of dropped pairs worth 69 k each, most of them past any limit;"
        "twice the unit realizes 50 k, 3 G by the model, and the pairs share"
        "their terms with the other caches, so they cost almost no memory."
        "Measured under PGO on one worker, mathlib: the two caches four"
        "times larger 1772.6 G to 1728.4 G instructions (-2.5%), peak 6.55 GB"
        "to 7.59 GB; equal pairs twice the unit alone 1762.3 G for 0.15 GB,"
        "all three together 1724.4 G (-2.7%) at 7.58 GB. Every other cache"
        "returns less than 7 G per GB kept: the variables cost 2 KB an entry"
        "and the open caches go with them, the constant types at levels"
        "3.9 KB, whnf 1.8 KB; and eight times the unit for the checked types"
        "would take another 0.9 GB for 13 G more by the model. Two"
        "generations of half the limit, an entry living between half and"
        "the whole of it, would realize most of what twice the limit does at"
        "the memory of the limit itself, for a second lookup on every miss,"
        "40 M on the checked types alone."
    chosen = "LimitsFromReuseDistances"
    rejected = ["OneLimit", "TwoGenerations"]
    impacts = [carried, keepFor]

fn carried(st: St) -> Facts
    ? "What checking takes from a declaration to the next: the facts about closed terms; the values and constant types instantiated at universe levels, which depend on the levels as written, not on what they mean in a declaration; and, since a free variable is made of its type and value and how many of its kind are open around it (CountedVariables), the variables made so far with their context, and what was found by inference, checking, reduction and comparison about terms holding them, which holds wherever the same variables appear. What was found by checking terms with a universe parameter is kept under the declaration's parameters (ParamsInTheKey). Each map is emptied past its limit, a multiple of the unit set by what its entries are used again at and cost to keep (LimitsFromReuseDistances), the closed terms only in the low-memory mode (LowMemoryMode); when the variables are, their context and every map that may hold a variable go with them, so no kept result names a variable that is gone."
    full = Core.Cache.size(st.vars) > st.limits.vars
    Facts(closed = bounded(st.closed, st.limits.closed), unfolds = bounded(st.unfoldCache, st.limits.unfold), types = bounded(st.levelTypes, st.limits.types), vars = bounded(st.vars, st.limits.vars), lctx = localsKept(st.lctx, full), next = st.next, topLevel = st.topLevel, inferCache = openKept(st.inferCache, full, st.limits.infer), checkCache = openKept(st.checkCache, full, st.limits.check), whnfCache = openKept(st.whnfCache, full, st.limits.whnf), coreCache = openKept(st.coreCache, full, st.limits.core), eqOk = openKept(st.eqOk, full, st.limits.eqOk), eqFail = openKept(st.eqFail, full, st.limits.eqFail), eqNo = openKept(st.eqNo, full, st.limits.eqNo), rules = st.rules)

fn openKept(m: Map<Core.Exprs.Key, Bucket>, full: Bool, limit: Int) -> Map<Core.Exprs.Key, Bucket>
    ? "A map that may hold free variables: emptied with the variables, else past its own limit."
    match full
        true -> Core.Cache.empty()
        false -> bounded(m, limit)

verify openKept
    Core.Cache.size(openKept(Check.State.cachePut(Core.Cache.empty(), Core.Exprs.natLit(1), Core.Exprs.natLit(1)), true, 65536)) => 0

fn localsKept(lctx: Locals, full: Bool) -> Locals
    ? "The context of the variables kept, or none once the variables were let go."
    match full
        true -> Locals.NoLocals
        false -> lctx

verify localsKept
    localsKept(Locals.NoLocals, true) => Locals.NoLocals

verify carried
    Core.Cache.size(carried(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe)).unfolds) => 0

fn bounded(m: Map<Core.Exprs.Key, Bucket>, limit: Int) -> Map<Core.Exprs.Key, Bucket>
    ? "A map carried across declarations, emptied once it passes limit hashes: kept for the whole run, values instantiated at levels once took mathlib past 14 GB and constant types took it there again on one worker, while most entries are asked for again within a few declarations (LimitsFromReuseDistances)."
    match Core.Cache.size(m) > limit
        true -> Core.Cache.empty()
        false -> m

verify bounded
    Core.Cache.size(bounded(Core.Cache.empty(), 1)) => 0

verify checkAll
    checkAll([]) => Result.Ok(Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0))

fn failNamed(e: Fail, n: Name) -> Fail
    ? "Puts the declaration's name in front of a failure."
    match e
        Fail.Reject(m) -> Fail.Reject("{Core.Names.render(n)}: {m}")
        Fail.Decline(m) -> Fail.Decline("{Core.Names.render(n)}: {m}")

verify failNamed
    failNamed(Fail.Decline("d"), Core.Names.str(Core.Names.anon(), "y")) => Fail.Decline("y: d")

type Addition
    Skipped
    Deferred(Head, Option<Expr>, Bool, Const)
    Derived(Env)
    Block(Map<Name, Const>)
    Trusted(List<Const>)

fn prepared(env: Env, d: Decl) -> Result<Addition, Fail>
    ? "What a declaration adds, found by checking it against the environment, which it only reads."
    match d
        Decl.Axiom(h, unsafe) -> match unsafe
            true -> Result.Ok(Addition.Skipped)
            false -> deferred(env, h, Option.None, false, Const.CAxiom(h, false))
        Decl.Defn(h, v, hints, safety, _) -> match safety
            Safety.Safe -> deferred(env, h, Option.Some(v), false, Const.CDefn(h, v, hints, safety, Check.Tc.reachesRecursor(env, v)))
            _ -> Result.Ok(Addition.Skipped)
        Decl.Thm(h, v, _) -> deferred(env, h, Option.Some(v), true, Const.CThm(h, v))
        Decl.Opaq(h, v, unsafe, _) -> match unsafe
            true -> Result.Ok(Addition.Skipped)
            false -> deferred(env, h, Option.Some(v), false, Const.COpaque(h, v, unsafe))
        Decl.Quot(h, kind) -> Result.Ok(Addition.Derived(Check.IndAdd.addQuotDecl(env, h, kind)?))
        Decl.Induct(types, ctors, recs) -> match anyUnsafe(types)
            true -> Result.Ok(Addition.Skipped)
            false -> inductive(env, Check.IndAdd.addInductive(env, types, ctors, recs), types, ctors, recs)

verify prepared
    prepared(Check.State.envEmpty(), Decl.Axiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), true)) => Result.Ok(Addition.Skipped)

fn deferred(env: Env, h: Head, v: Option<Expr>, isThm: Bool, c: Const) -> Result<Addition, Fail>
    ? "A new name and distinct universe parameters now; the type and value are checked later, against the environment before the constant."
    ok = newHead(env, h)?
    Result.Ok(Addition.Deferred(h, v, isThm, c))

verify deferred
    deferred(Check.State.envEmpty(), Head(name = Core.Names.anon(), params = [Core.Names.anon(), Core.Names.anon()], ty = Core.Exprs.sort(Level.Zero)), Option.None, false, Const.CAxiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), false)) => Result.Err(Fail.Reject("duplicate universe level parameter"))

fn newHead(env: Env, h: Head) -> Result<Unit, Fail>
    ? "The name is not taken and the universe parameters are distinct."
    match Check.State.envHas(env, h.name)
        true -> Result.Err(Fail.Reject("already declared"))
        false -> match hasDup(h.params)
            true -> Result.Err(Fail.Reject("duplicate universe level parameter"))
            false -> Result.Ok(Unit)

verify newHead
    newHead(Check.State.envEmpty(), Head(name = Core.Names.anon(), params = [Core.Names.anon(), Core.Names.anon()], ty = Core.Exprs.sort(Level.Zero))) => Result.Err(Fail.Reject("duplicate universe level parameter"))

fn inductive(env: Env, r: Result<Map<Name, Const>, Fail>, types: List<IndType>, ctors: List<Ctor>, recs: List<Rec>) -> Result<Addition, Fail>
    ? "A derived block, or one Pestka cannot derive yet admitted as stated."
    match r
        Result.Ok(cs) -> Result.Ok(Addition.Block(cs))
        Result.Err(Fail.Decline) -> trusted(env, inductConsts(env, types, ctors, recs))
        Result.Err(e) -> Result.Err(e)

verify inductive
    inductive(Check.State.envEmpty(), Result.Err(Fail.Reject("x")), [], [], []) => Result.Err(Fail.Reject("x"))

fn trusted(env: Env, cs: List<Const>) -> Result<Addition, Fail>
    ? "Constants admitted without checking; their names must still be new."
    match anyDeclared(env, cs)
        true -> Result.Err(Fail.Reject("already declared"))
        false -> Result.Ok(Addition.Trusted(cs))

verify trusted
    trusted(Check.State.envEmpty(), []) => Result.Ok(Addition.Trusted([]))

fn applied(run: Run, a: Addition) -> Run
    ? "Adds what a declaration was found to add; nothing here fails."
    match a
        Addition.Skipped -> Run.update(run, skipped = run.skipped + 1, pos = run.pos + 1)
        Addition.Deferred(h, v, isThm, c) -> deferAdded(run, h, v, isThm, c)
        Addition.Derived(env) -> Run.update(run, env = env, checked = run.checked + 1, pos = run.pos + 1)
        Addition.Block(cs) -> Run.update(run, env = mergeConsts(run.env, Map.entries(cs)), checked = run.checked + 1, pos = run.pos + 1)
        Addition.Trusted(cs) -> Run.update(run, env = addConsts(run.env, cs), trusted = run.trusted + 1, pos = run.pos + 1)

verify applied
    applied(Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0), Addition.Skipped).skipped => 1
    applied(Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0), Addition.Block({})).checked => 1
    applied(Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0), Addition.Trusted([])).trusted => 1

fn deferAdded(run: Run, h: Head, v: Option<Expr>, isThm: Bool, c: Const) -> Run
    ? "The constant joins the environment, and its type and value wait to be checked against the environment before it. Its place is read before the environment is passed on, so that the add has it alone."
    upTo = Check.State.envSize(run.env)
    Run.update(run, env = Check.State.envSet(run.env, h.name, c), jobs = List.prepend(Job(pos = run.pos, upTo = upTo, head = h, value = v, isThm = isThm), run.jobs), pos = run.pos + 1)

verify deferAdded
    deferAdded(Run(env = Check.State.envEmpty(), closed = Core.Cache.empty(), checked = 0, trusted = 0, skipped = 0, jobs = [], pos = 0), Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), Option.None, false, Const.CAxiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), false)).pos => 1

fn mergeConsts(env: Env, cs: List<Tuple<Name, Const>>) -> Env
    ? "Adds each named constant."
    match cs
        [] -> env
        [(n, c), ..rest] -> mergeConsts(Check.State.envSet(env, n, c), rest)

verify mergeConsts
    Check.State.envHas(mergeConsts(Check.State.envEmpty(), [(Core.Names.anon(), Const.CAxiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), false))]), Core.Names.anon()) => true

fn anyUnsafe(types: List<IndType>) -> Bool
    ? "An unsafe inductive block."
    match types
        [] -> false
        [t, ..rest] -> Bool.or(t.isUnsafe, anyUnsafe(rest))

verify anyUnsafe
    anyUnsafe([]) => false

fn typeIsSort(t: RE) -> Result<St, Fail>
    ? "The declared type's type must be a sort."
    Result.Ok(Check.Tc.ensureSort(t.st, t.e)?.st)

verify typeIsSort
    typeIsSort(RE(e = Core.Exprs.natLit(1), st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe))) => Result.Err(Fail.Reject("type expected"))

fn hasDup(ps: List<Name>) -> Bool
    ? "A name occurring twice."
    match ps
        [] -> false
        [p, ..rest] -> Bool.or(List.contains(rest, p), hasDup(rest))

verify hasDup
    hasDup([Core.Names.anon()]) => false

fn valueChecks(st: St, ty: Expr, v: Expr, isThm: Bool) -> Result<Facts, Fail>
    ? "A theorem's type a proposition, and the value's type equal to the declared one; returns the shared cache of checked closed terms."
    st2 = thmProp(st, ty, isThm)?
    eq = Check.Tc.valueFits(st2, v, ty)?
    match eq.b
        true -> Result.Ok(carried(eq.st))
        false -> Result.Err(Fail.Reject("declaration type mismatch"))

verify valueChecks
    valueChecks(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), Core.Exprs.sort(Level.Zero), false) => Result.Err(Fail.Reject("declaration type mismatch"))

fn thmProp(st: St, ty: Expr, isThm: Bool) -> Result<St, Fail>
    ? "A theorem must state a proposition."
    match isThm
        false -> Result.Ok(st)
        true -> propOrFail(Check.Tc.isProp(st, ty)?)

verify thmProp
    thmProp(Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe), Core.Exprs.sort(Level.Zero), true) => Result.Err(Fail.Reject("theorem type is not Prop"))

fn propOrFail(p: RB) -> Result<St, Fail>
    ? "Passes a proposition."
    match p.b
        true -> Result.Ok(p.st)
        false -> Result.Err(Fail.Reject("theorem type is not Prop"))

verify propOrFail
    propOrFail(RB(b = false, st = Check.State.fresh(Check.State.envEmpty(), [], Safety.Safe))) => Result.Err(Fail.Reject("theorem type is not Prop"))

fn anyDeclared(env: Env, cs: List<Const>) -> Bool
    ? "Some name is already in the environment."
    match cs
        [] -> false
        [c, ..rest] -> Bool.or(Check.State.envHas(env, Check.State.headOf(c).name), anyDeclared(env, rest))

verify anyDeclared
    anyDeclared(Check.State.envEmpty(), []) => false

fn addConsts(env: Env, cs: List<Const>) -> Env
    ? "Adds each constant under its name."
    match cs
        [] -> env
        [c, ..rest] -> addConsts(Check.State.envSet(env, Check.State.headOf(c).name, c), rest)

verify addConsts
    Check.State.envHas(addConsts(Check.State.envEmpty(), [Const.CAxiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), false)]), Core.Names.anon()) => true

fn inductConsts(env: Env, types: List<IndType>, ctors: List<Ctor>, recs: List<Rec>) -> List<Const>
    ? "Every constant an inductive block declares."
    List.concat(typeConsts(types, []), List.concat(ctorConsts(ctors, []), recConsts(env, types, recs, [])))

verify inductConsts
    inductConsts(Check.State.envEmpty(), [], [], []) => []

fn typeConsts(xs: List<IndType>, acc: List<Const>) -> List<Const>
    ? "The types."
    match xs
        [] -> List.reverse(acc)
        [x, ..rest] -> typeConsts(rest, List.prepend(Const.CInduct(x), acc))

verify typeConsts
    typeConsts([], []) => []

fn ctorConsts(xs: List<Ctor>, acc: List<Const>) -> List<Const>
    ? "The constructors."
    match xs
        [] -> List.reverse(acc)
        [x, ..rest] -> ctorConsts(rest, List.prepend(Const.CCtor(x), acc))

verify ctorConsts
    ctorConsts([], []) => []

fn recConsts(env: Env, types: List<IndType>, xs: List<Rec>, acc: List<Const>) -> List<Const>
    ? "The recursors, with the facts reduction asks of them found as for a derived block."
    match xs
        [] -> List.reverse(acc)
        [x, ..rest] -> recConsts(env, types, rest, List.prepend(Const.CRec(Check.Tc.recFacts(x, typeNamed(env, types, Check.Tc.majorInduct(x)))), acc))

verify recConsts
    recConsts(Check.State.envEmpty(), [], [], []) => []

fn typeNamed(env: Env, types: List<IndType>, n: Name) -> Option<Const>
    ? "The block's own type named n, or else the environment's constant."
    match types
        [] -> Check.State.envGet(env, n)
        [t, ..rest] -> match t.head.name == n
            true -> Option.Some(Const.CInduct(t))
            false -> typeNamed(env, rest, n)

verify typeNamed
    typeNamed(Check.State.envEmpty(), [], Core.Names.anon()) => Option.None
