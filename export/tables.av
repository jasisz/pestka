module Tables
    intent =
        "What has been read of an export so far: the three numbered tables"
        "of names, levels and expressions, and the declarations in file"
        "order. Indices are arbitrary numbers, as in the reference parser:"
        "they need not be consecutive or ordered, and a later line with the"
        "same index replaces the earlier one. A reference to an index not"
        "yet defined is an error, which is what keeps every term a finite"
        "DAG. The next fields count the lines read (plus the implicit name"
        "and level 0)."
    exposes [Tables, Parsed, empty, name, level, expr, names, levels, addName, addLevel, addExpr, addDecl, finish]
    depends [Core.Names, Core.Levels, Core.Exprs, Core.Decls, Core.Lazy]
    effects []

record Tables
    names: Map<Int, Name>
    levels: Map<Int, Level>
    exprs: Map<Int, Expr>
    cur: Vector<Expr>
    chunks: Vector<Vector<Expr>>
    dense: Int
    nextName: Int
    nextLevel: Int
    nextExpr: Int
    decls: List<Decl>
    constants: Int
    known: Map<Name, Int>
    pending: List<Name>
    allPlaced: Bool
    declCount: Int
    outNames: List<Name>
    outLevels: List<Level>
    outExprs: List<Expr>
    nOutNames: Int
    nOutLevels: Int
    nOutExprs: Int
    lastName: Int
    lastLevel: Int
    lastExpr: Int
    proofBase: Int
    proofLength: Int
    proofAt: Int

record Parsed
    constants: Int
    names: Int
    levels: Int
    exprs: Int
    decls: List<Decl>
    allPlaced: Bool

fn finish(t: Tables) -> Parsed
    ? "What checking needs: the declarations in file order and the counts; the index tables are left behind to be freed."
    Parsed(constants = t.constants, names = t.nextName, levels = t.nextLevel, exprs = t.nextExpr, decls = List.reverse(t.decls), allPlaced = t.allPlaced)

verify finish
    finish(empty()).names => 1

fn empty() -> Tables
    ? "Name 0 is the anonymous name and level 0 is zero; neither has a line."
    Tables(names = {0 => Core.Names.anon()}, levels = {0 => Level.Zero}, exprs = {}, cur = freshChunk(), chunks = Vector.fromList([]), dense = 0, nextName = 1, nextLevel = 1, nextExpr = 0, decls = [], constants = 0, known = {}, pending = [], allPlaced = true, declCount = 0, outNames = [], outLevels = [], outExprs = [], nOutNames = 0, nOutLevels = 0, nOutExprs = 0, lastName = -1, lastLevel = -1, lastExpr = -1, proofBase = 0, proofLength = 0, proofAt = 0)

verify empty
    empty().nextName => 1
    empty().nextExpr => 0

fn name(t: Tables, i: Int) -> Result<Name, String>
    ? "A defined name by index."
    match Map.get(t.names, i)
        Option.Some(n) -> Result.Ok(n)
        Option.None -> Result.Err("unknown name index {i}")

verify name
    name(empty(), 0) => Result.Ok(Core.Names.anon())
    name(empty(), 5) => Result.Err("unknown name index 5")

fn level(t: Tables, i: Int) -> Result<Level, String>
    ? "A defined level by index."
    match Map.get(t.levels, i)
        Option.Some(l) -> Result.Ok(l)
        Option.None -> Result.Err("unknown level index {i}")

verify level
    level(empty(), 0) => Result.Ok(Level.Zero)
    level(empty(), 1) => Result.Err("unknown level index 1")

fn expr(t: Tables, i: Int) -> Result<Expr, String>
    ? "A defined expression by index: one defined out of order or again, then one of the dense run from 0."
    match Map.get(t.exprs, i)
        Option.Some(e) -> Result.Ok(e)
        Option.None -> match Bool.and(i >= 0, i < t.dense)
            true -> Result.Ok(denseAt(t, i))
            false -> Result.Err("unknown expression index {i}")

decision PlacesMatchedWhereRead
    date = "2026-10-24"
    reason =
        "A place of a chunk was read with Vector.get, which hands back a"
        "copy, and the option was given to slot, which the Rust backend"
        "lends it and so copied the expression once more: a count up and"
        "one down on the expression for every index an expression line"
        "names. The option is now matched where it is read. Instructions"
        "retired, one worker, reading only: Init 20.73 G to 20.64 G (median"
        "of three runs each); checked in full, etale 56.50 G to 56.44 G, qb9"
        "102.90 G to 102.75 G, Init 123.04 G to 122.86 G (medians)."
    chosen = "PlacesMatchedWhereRead"
    rejected = ["PlacesThroughSlot"]
    impacts = [denseAt, inChunk]

fn denseAt(t: Tables, i: Int) -> Expr
    ? "Expression i of the dense run, from the chunk it sits in; callers keep i below dense, so the place is always filled. The place is matched here rather than in a function of its own (PlacesMatchedWhereRead)."
    match i >= Vector.len(t.chunks) * 65536
        true -> match Vector.get(t.cur, Int.mod(i, 65536))
            Option.Some(e) -> e
            Option.None -> Core.Exprs.bvar(0)
        false -> inChunk(Vector.get(t.chunks, Int.div(i, 65536)), Int.mod(i, 65536))

fn inChunk(c: Option<Vector<Expr>>, j: Int) -> Expr
    ? "Place j of a frozen chunk, matched where it is read (PlacesMatchedWhereRead). A match rather than a default: a default chunk would be built on every read."
    match c
        Option.Some(v) -> match Vector.get(v, j)
            Option.Some(e) -> e
            Option.None -> Core.Exprs.bvar(0)
        Option.None -> Core.Exprs.bvar(0)

verify inChunk
    inChunk(Option.None, 3) => Core.Exprs.bvar(0)
    inChunk(Option.Some(Vector.fromList([Core.Exprs.natLit(1)])), 0) => Core.Exprs.natLit(1)
    inChunk(Option.Some(Vector.fromList([Core.Exprs.natLit(1)])), 1) => Core.Exprs.bvar(0)

verify denseAt
    denseAt(sequential(empty(), 0, 3), 2) => Core.Exprs.natLit(2)

verify expr law sameAsSpec
    given n: Int = [0, 3, 65537]
    given i: Int = [0, 2, 65535, 65536, 65537]
    expr(sequential(empty(), 0, n), i) => exprSpec(n, i)

verify expr law firstLineKept
    given i: Int = [0, 4, 5, 6, 9]
    expr(sequential(Result.withDefault(addExpr(empty(), 5, Core.Exprs.natLit(100)), empty()), 0, 10), i) => keptSpec(i)

fn sequential(t: Tables, k: Int, n: Int) -> Tables
    ? "t with expressions k to n - 1 defined in order, expression j being the literal j: what lean4export writes."
    match k >= n
        true -> t
        false -> sequential(Result.withDefault(addExpr(t, k, Core.Exprs.natLit(k)), t), k + 1, n)

verify sequential
    sequential(empty(), 0, 2).dense => 2

fn exprSpec(n: Int, i: Int) -> Result<Expr, String>
    ? "What expr gives after expressions 0 to n - 1 were defined in order."
    match Bool.and(i >= 0, i < n)
        true -> Result.Ok(Core.Exprs.natLit(i))
        false -> Result.Err("unknown expression index {i}")

verify exprSpec
    exprSpec(1, 1) => Result.Err("unknown expression index 1")

fn keptSpec(i: Int) -> Result<Expr, String>
    ? "Expression 5 defined first as 100, then 0 to 9 in order: the second line for 5 is refused, so the first one stands, and the rest still read back."
    match i == 5
        true -> Result.Ok(Core.Exprs.natLit(100))
        false -> Result.Ok(Core.Exprs.natLit(i))

verify keptSpec
    keptSpec(5) => Result.Ok(Core.Exprs.natLit(100))

fn freshChunk() -> Vector<Expr>
    ? "An empty chunk of the dense run: 65536 places."
    Vector.new(65536, Core.Exprs.bvar(0))

verify expr
    expr(empty(), 0) => Result.Err("unknown expression index 0")

fn names(t: Tables, ids: List<Int>) -> Result<List<Name>, String>
    ? "Several names by index, in order, each prepended to the rest, as a constant's levels are (LevelsAsCells): a declaration's universe parameters are walked at every instantiation of it."
    match ids
        [] -> Result.Ok([])
        [i, ..rest] -> Result.Ok(List.prepend(name(t, i)?, names(t, rest)?))

verify names
    names(empty(), [0, 0]) => Result.Ok([Core.Names.anon(), Core.Names.anon()])
    names(empty(), [3]) => Result.Err("unknown name index 3")

fn levels(t: Tables, ids: List<Int>) -> Result<List<Level>, String>
    ? "Several levels by index, in order, each prepended to the rest (LevelsAsCells)."
    match ids
        [] -> Result.Ok([])
        [i, ..rest] -> Result.Ok(List.prepend(level(t, i)?, levels(t, rest)?))

verify levels
    levels(empty(), [0]) => Result.Ok([Level.Zero])
    levels(empty(), [2]) => Result.Err("unknown level index 2")

fn addName(t: Tables, i: Int, n: Name) -> Result<Tables, String>
    ? "Defines name i. An index already bound, the anonymous name 0 included, is malformed input, as the reference kernel holds it; it is refused rather than overwritten."
    match Map.has(t.names, i)
        true -> Result.Err("name index {i} is already bound")
        false -> Result.Ok(Tables.update(t, names = Map.set(t.names, i, n), nextName = t.nextName + 1))

verify addName
    Result.withDefault(addName(empty(), 1, Core.Names.anon()), empty()).nextName => 2
    Map.has(Result.withDefault(addName(empty(), 7, Core.Names.anon()), empty()).names, 7) => true
    addName(empty(), 0, Core.Names.anon()) => Result.Err("name index 0 is already bound")

fn addLevel(t: Tables, i: Int, l: Level) -> Result<Tables, String>
    ? "Defines level i. An index already bound, level 0 included, is refused as addName refuses one."
    match Map.has(t.levels, i)
        true -> Result.Err("level index {i} is already bound")
        false -> Result.Ok(Tables.update(t, levels = Map.set(t.levels, i, l), nextLevel = t.nextLevel + 1))

verify addLevel
    Result.withDefault(addLevel(empty(), 1, Level.Zero), empty()).nextLevel => 2
    addLevel(empty(), 0, Level.Zero) => Result.Err("level index 0 is already bound")

fn addExpr(t: Tables, i: Int, e: Expr) -> Result<Tables, String>
    ? "Defines expression i. lean4export numbers expressions 0, 1, 2 and on, so they go into chunks of a dense run, 16 bytes each; an index out of that order goes into the map, which expr reads first. On mathlib the map alone held 105 million entries, about 4.4 GB, twice that while it grew. An index already bound is refused, as by addName."
    match Bool.or(Bool.and(i >= 0, i < t.dense), Map.has(t.exprs, i))
        true -> Result.Err("expression index {i} is already bound")
        false -> Result.Ok(noted(exprPlaced(t, i, e), e))

fn exprPlaced(t: Tables, i: Int, e: Expr) -> Tables
    ? "t with the unbound expression i: at the end of the dense run when it comes next there, else in the map."
    match i == t.dense
        true -> denseAdd(t, e)
        false -> Tables.update(t, exprs = Map.set(t.exprs, i, e), nextExpr = t.nextExpr + 1)

verify exprPlaced
    exprPlaced(empty(), 0, Core.Exprs.bvar(0)).dense => 1
    Map.has(exprPlaced(empty(), 3, Core.Exprs.bvar(0)).exprs, 3) => true

fn denseAdd(t: Tables, e: Expr) -> Tables
    ? "Puts e at the end of the dense run; a full chunk joins the others and a fresh one starts."
    j = Int.mod(t.dense, 65536)
    match j == 65535
        true -> Tables.update(t, chunks = withChunk(t.chunks, placed(t.cur, j, e)), cur = freshChunk(), dense = t.dense + 1, nextExpr = t.nextExpr + 1)
        false -> Tables.update(t, cur = placed(t.cur, j, e), dense = t.dense + 1, nextExpr = t.nextExpr + 1)

verify denseAdd
    denseAdd(empty(), Core.Exprs.natLit(7)).dense => 1
    Vector.len(denseAdd(Tables.update(empty(), dense = 65535), Core.Exprs.natLit(7)).chunks) => 1

fn placed(v: Vector<Expr>, j: Int, e: Expr) -> Vector<Expr>
    ? "v with e at j; j is always in range."
    Option.withDefault(Vector.set(v, j, e), v)

verify placed
    Vector.get(placed(freshChunk(), 3, Core.Exprs.natLit(1)), 3) => Option.Some(Core.Exprs.natLit(1))

fn withChunk(chunks: Vector<Vector<Expr>>, c: Vector<Expr>) -> Vector<Vector<Expr>>
    ? "The chunks with c after them: a few thousand at most, rebuilt once per 65536 expressions."
    Vector.fromList(List.concat(List.fromVector(chunks), [c]))

verify addExpr
    Result.withDefault(addExpr(empty(), 0, Core.Exprs.bvar(0)), empty()).nextExpr => 1
    Map.has(Result.withDefault(addExpr(empty(), 5, Core.Exprs.bvar(0)), empty()).exprs, 5) => true
    addExpr(Result.withDefault(addExpr(empty(), 0, Core.Exprs.bvar(0)), empty()), 0, Core.Exprs.bvar(1)) => Result.Err("expression index 0 is already bound")
    addExpr(Result.withDefault(addExpr(empty(), 5, Core.Exprs.bvar(0)), empty()), 5, Core.Exprs.bvar(1)) => Result.Err("expression index 5 is already bound")

fn addDecl(t: Tables, d: Decl) -> Result<Tables, String>
    ? "Appends a declaration, newest first, and counts its constants; the constants named since the last declaration must be placed before it or, for an inductive block, be its own (NamesPlacedWhereRead). Every name it declares must be new (UniqueDeclaredNames), and is kept with its declaration's code."
    places = placedBy(d)
    ok = pendingPlaced(t.pending, t.known, ownForBlock(d, places))
    known = declared(t.known, declNames(d), codeOf(t.declCount, skipped(d)))?
    Result.Ok(Tables.update(t, decls = List.prepend(d, t.decls), constants = t.constants + Core.Decls.constantCount(d), known = known, pending = [], allPlaced = Bool.and(t.allPlaced, ok), declCount = t.declCount + 1))

verify addDecl
    Result.withDefault(addDecl(empty(), Decl.Induct([], [], [])), empty()).constants => 0
    Result.withDefault(addDecl(noted(empty(), Core.Exprs.cnst(Core.Names.str(Core.Names.anon(), "x"), [])), Decl.Axiom(Head(name = Core.Names.str(Core.Names.anon(), "x"), params = [], ty = Core.Exprs.sort(Level.Zero)), false)), empty()).allPlaced => false
    Result.withDefault(addDecl(Result.withDefault(addDecl(empty(), Decl.Axiom(Head(name = Core.Names.str(Core.Names.anon(), "x"), params = [], ty = Core.Exprs.sort(Level.Zero)), false)), empty()), Decl.Axiom(Head(name = Core.Names.str(Core.Names.anon(), "y"), params = [], ty = Core.Exprs.sort(Level.Zero)), false)), empty()).allPlaced => true
    List.len(Result.withDefault(addDecl(empty(), Decl.Induct([], [], [])), empty()).decls) => 1
    Result.withDefault(addDecl(noted(empty(), Core.Exprs.cnst(Core.Names.str(Core.Names.anon(), "x"), [])), Decl.Induct([IndType(head = Head(name = Core.Names.str(Core.Names.anon(), "x"), params = [], ty = Core.Exprs.sort(Level.Zero)), numParams = 0, numIndices = 0, all = [], ctors = [], numNested = 0, isRec = false, isUnsafe = true, isReflexive = false)], [], [])), empty()).allPlaced => false
    Result.withDefault(addDecl(noted(empty(), Core.Exprs.cnst(Core.Names.str(Core.Names.anon(), "x"), [])), Decl.Induct([IndType(head = Head(name = Core.Names.str(Core.Names.anon(), "x"), params = [], ty = Core.Exprs.sort(Level.Zero)), numParams = 0, numIndices = 0, all = [], ctors = [], numNested = 0, isRec = false, isUnsafe = false, isReflexive = false)], [], [])), empty()).allPlaced => true
    addDecl(Result.withDefault(addDecl(empty(), Decl.Axiom(Head(name = Core.Names.str(Core.Names.anon(), "x"), params = [], ty = Core.Exprs.sort(Level.Zero)), true)), empty()), Decl.Axiom(Head(name = Core.Names.str(Core.Names.anon(), "x"), params = [], ty = Core.Exprs.sort(Level.Zero)), false)) => Result.Err("x is declared twice")

decision UniqueDeclaredNames
    date = "2026-11-12"
    reason =
        "Every name a declaration declares, its own or, for an inductive"
        "block, every type, constructor and recursor, must not have been"
        "declared before, by any declaration, skipped or not, nor earlier in"
        "the same block (Susz 1, OWNER-8). Pestka skips unsafe and partial"
        "declarations, so it once admitted a safe declaration of a name an"
        "unsafe one had declared, which Lean refuses; checked out of file"
        "order, a theorem naming the first could then meet facts about the"
        "second. The rule is the reader's, for both formats: a name"
        "declared twice is an error of the record or line, before anything"
        "is checked. A declaration may not be named by the anonymous name"
        "either (spec OPEN 3). Each name is kept with its code: twice the index of"
        "the declaration, plus one when Pestka skips it, so that a name"
        "declared once has one index (DeclaredBefore in Core.Lazy) and the"
        "names a skipped declaration declares are never placed"
        "(NamesPlacedWhereRead)."
    chosen = "UniqueDeclaredNames"
    rejected = ["DuplicatesAtAdmission", "NoReorderOnDuplicates"]
    impacts = [addDecl, declared, codeOf, isPlaced]

fn codeOf(decl: Int, skip: Bool) -> Int
    ? "The code of a name declared by declaration decl, skipped or not (UniqueDeclaredNames)."
    match skip
        true -> 2 * decl + 1
        false -> 2 * decl

verify codeOf
    codeOf(3, true) => 7
    codeOf(3, false) => 6

fn isPlaced(known: Map<Name, Int>, n: Name) -> Bool
    ? "Whether n is declared by a declaration Pestka does not skip (UniqueDeclaredNames)."
    match Map.get(known, n)
        Option.Some(c) -> Int.mod(c, 2) == 0
        Option.None -> false

verify isPlaced
    isPlaced({Core.Names.anon() => 6}, Core.Names.anon()) => true
    isPlaced({Core.Names.anon() => 7}, Core.Names.anon()) => false

fn declared(known: Map<Name, Int>, ns: List<Name>, code: Int) -> Result<Map<Name, Int>, String>
    ? "Every name declared with code; one declared before, or twice here, is an error (UniqueDeclaredNames)."
    match ns
        [] -> Result.Ok(known)
        [n, ..rest] -> match n == Core.Names.anon()
            true -> Result.Err("a declaration is named by the anonymous name")
            false -> match Map.has(known, n)
                true -> Result.Err("{Core.Names.render(n)} is declared twice")
                false -> declared(Map.set(known, n, code), rest, code)

verify declared
    declared({}, [Core.Names.str(Core.Names.anon(), "a"), Core.Names.str(Core.Names.anon(), "a")], 0) => Result.Err("a is declared twice")
    declared({}, [Core.Names.anon()], 0) => Result.Err("a declaration is named by the anonymous name")

decision NamesPlacedWhereRead
    date = "2026-11-06"
    reason =
        "Checking may take declarations out of file order"
        "(CheckedByNamespace) only when every declaration names constants"
        "placed before it alone. A walk of every type and value to find out"
        "cost mathlib about 195 G instructions. Here each expression line"
        "is looked at once as it is read: a constant or a projection names"
        "its constant. The constants a literal stands for are left to"
        "checking, which keeps file order up to the last of them"
        "(LiteralPrefix in Check.Decl). A"
        "name not yet placed waits, and the next declaration line must"
        "place it as part of its own inductive block; else allPlaced turns"
        "false and checking keeps file order. This suffices: an expression"
        "is built from lines before it, so a declaration only holds"
        "expressions whose lines came before its own, and each of those"
        "named only constants placed before the declaration that followed"
        "the line, which is no later than this one. A name of a declaration"
        "Pestka skips is never placed, as it is never in the environment,"
        "and an unsafe block's names are not its own to name either: else a"
        "line naming such a name passes, a safe declaration of the same name"
        "comes later, and checked out of order the earlier declaration uses"
        "it. Every name placed is in the environment once the declaration is"
        "added: the stated types, constructors and recursors of a block must"
        "equal derived ones, a quotient adds its whole package, and a name"
        "declared twice stops the building there."
    chosen = "NamesPlacedWhereRead"
    rejected = ["TermsWalkedBeforeChecking"]
    impacts = [addExpr, addDecl, noted, placedBy, ownForBlock]

fn noted(t: Tables, e: Expr) -> Tables
    ? "The constants e names, kept to be matched with the next declaration when not placed yet: a constant's own, a projection's structure (NamesPlacedWhereRead)."
    match e
        Expr.Const(_, n, _) -> waiting(t, n)
        Expr.Proj(_, n, _, _) -> waiting(t, n)
        _ -> t

verify noted
    noted(empty(), Core.Exprs.natLit(1)).pending => []
    noted(empty(), Core.Exprs.cnst(Core.Names.anon(), [])).pending => [Core.Names.anon()]

fn waiting(t: Tables, n: Name) -> Tables
    ? "n waits for the next declaration unless already placed."
    match isPlaced(t.known, n)
        true -> t
        false -> Tables.update(t, pending = List.prepend(n, t.pending))

verify waiting
    List.len(waiting(empty(), Core.Names.anon()).pending) => 1

fn pendingPlaced(ps: List<Name>, known: Map<Name, Int>, own: List<Name>) -> Bool
    ? "Every waiting name is placed, or one of the block's own."
    match ps
        [] -> true
        [p, ..rest] -> match Bool.or(isPlaced(known, p), List.contains(own, p))
            true -> pendingPlaced(rest, known, own)
            false -> false

verify pendingPlaced
    pendingPlaced([Core.Names.anon()], {}, []) => false
    pendingPlaced([Core.Names.anon()], {}, [Core.Names.anon()]) => true
    pendingPlaced([Core.Names.anon()], {Core.Names.anon() => 0}, []) => true
    pendingPlaced([Core.Names.anon()], {Core.Names.anon() => 1}, []) => false

fn declNames(d: Decl) -> List<Name>
    ? "The names a declaration declares."
    match d
        Decl.Axiom(h, _) -> [h.name]
        Decl.Defn(h, _, _, _, _) -> [h.name]
        Decl.Thm(h, _, _) -> [h.name]
        Decl.Opaq(h, _, _, _) -> [h.name]
        Decl.Quot(h, _) -> [h.name]
        Decl.Induct(types, ctors, recs) -> List.concat(typeNames(types, []), List.concat(ctorNames(ctors, []), recNames(recs, [])))

verify declNames
    declNames(Decl.Induct([], [], [])) => []

fn typeNames(xs: List<IndType>, acc: List<Name>) -> List<Name>
    ? "The names of a block's types."
    match xs
        [] -> acc
        [x, ..rest] -> typeNames(rest, List.prepend(x.head.name, acc))

verify typeNames
    typeNames([], []) => []

fn ctorNames(xs: List<Ctor>, acc: List<Name>) -> List<Name>
    ? "The names of a block's constructors."
    match xs
        [] -> acc
        [x, ..rest] -> ctorNames(rest, List.prepend(x.head.name, acc))

verify ctorNames
    ctorNames([], []) => []

fn recNames(xs: List<Rec>, acc: List<Name>) -> List<Name>
    ? "The names of a block's recursors."
    match xs
        [] -> acc
        [x, ..rest] -> recNames(rest, List.prepend(x.head.name, acc))

verify recNames
    recNames([], []) => []

fn ownForBlock(d: Decl, places: List<Name>) -> List<Name>
    ? "The names a declaration's own expressions may name besides those placed before it: those an inductive block places itself, nothing for any other."
    match d
        Decl.Induct(_, _, _) -> places
        _ -> []

verify ownForBlock
    ownForBlock(Decl.Axiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), false), [Core.Names.anon()]) => []

fn placedBy(d: Decl) -> List<Name>
    ? "The names d places in the environment: its own, or none when Pestka skips it as unsafe or partial, so that a skipped block's own names are neither placed nor its own to name (NamesPlacedWhereRead)."
    match skipped(d)
        true -> []
        false -> declNames(d)

verify placedBy
    placedBy(Decl.Axiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), true)) => []
    placedBy(Decl.Axiom(Head(name = Core.Names.anon(), params = [], ty = Core.Exprs.sort(Level.Zero)), false)) => [Core.Names.anon()]

fn skipped(d: Decl) -> Bool
    ? "A declaration checking skips, as Check.Decl.prepared does: unsafe or partial."
    match d
        Decl.Axiom(_, unsafe) -> unsafe
        Decl.Defn(_, _, _, safety, _) -> safety != Safety.Safe
        Decl.Opaq(_, _, unsafe, _) -> unsafe
        Decl.Induct(types, _, _) -> anyUnsafe(types)
        _ -> false

verify skipped
    skipped(Decl.Induct([], [], [])) => false

fn anyUnsafe(types: List<IndType>) -> Bool
    ? "A type of the block is unsafe."
    match types
        [] -> false
        [t, ..rest] -> Bool.or(t.isUnsafe, anyUnsafe(rest))

verify anyUnsafe
    anyUnsafe([]) => false
