    blockRef([], ixAt(1), 1, num(0), ixAt(1), cnew(1, 0), ids0(1)) => [1]
    blockRef([], ixAt(1), 1, num(0), ixAt(1), cnew(1, -4), ids0(1)) => [2]

verify blockRefs
    blockRefs(Bytes.fromList([]), at(0), 0, ixAt(0), num(0), ixAt(0), cnew(0, 0), ids0(0), [3]).out => [3]

verify blockExpr
    blockExpr(Bytes.fromList([7, 3]), at(0), ixAt(0), num(0), ixAt(0), cnew(1, 0), ids0(1), Vector.fromList([]), Vector.fromList([]), codes0(), 0, []).out => [3, 7]

verify constBlock
    constBlock(Bytes.fromList([9, 0, 0]), at(0), Vector.fromList([5]), Vector.fromList([]), Codes(names = Vector.fromList([0]), nat = 0, str = []), 1, []).out => [0, 5, 9]

verify levelsOut
    levelsOut(Bytes.fromList([]), at(0), 0, Vector.fromList([]), [2]).out => [2]

verify projBlock
    projBlock(Bytes.fromList([16, 0, 2, 1]), at(0), ixAt(1), num(0), ixAt(1), cnew(1, 0), ids0(1), Vector.fromList([3]), Codes(names = Vector.fromList([Core.Lazy.never()]), nat = 0, str = []), 0, []).out => [1, 2, 3, 16]

verify declWritten
    Result.withDefault(declWritten(Bytes.fromList([]), at(0), fresh(), cnew(0, 0), Vector.fromList([]), Vector.fromList([]), codes0(), cols0(), DeclP(kind = 4, pieces = [], names = [], skip = false, value = -1, end = at(0))), fresh()).di => 1

verify lazyWritten
    lazyWritten(Bytes.fromList([]), at(0), fresh(), cnew(0, 0), Vector.fromList([]), Vector.fromList([]), codes0(), cols0(), DeclP(kind = 2, pieces = [], names = [], skip = false, value = 0, end = at(0)), Option.None) => Result.Err("declaration 0: its block is missing")

verify lazyOut
    Result.withDefault(lazyOut(Bytes.fromList([]), at(0), fresh(), cnew(0, 0), Vector.fromList([]), Vector.fromList([]), codes0(), cols0(), DeclP(kind = 2, pieces = [Piece.Val(0)], names = [], skip = false, value = 0, end = at(0)), Acc(out = [3, 7], k = ixAt(1), mark = 0, fine = true), 1), fresh()).proofs => Bytes.fromList([1, 7, 3])
    Result.withDefault(lazyOut(Bytes.fromList([]), at(0), fresh(), cnew(0, 0), Vector.fromList([]), Vector.fromList([]), codes0(), cols0(), DeclP(kind = 2, pieces = [Piece.Val(0)], names = [], skip = false, value = 0, end = at(0)), Acc(out = [3, 7], k = ixAt(1), mark = 0, fine = true), 1), fresh()).main => [1, 3, 6, 18]

verify declPieces
    declPieces(Bytes.fromList([5, 6]), [Piece.Raw(at(0), at(2))], ixAt(0), ixAt(0), ids0(0), -1, 0, false, []) => [6, 5]

verify ctorRest
    ctorRest(Bytes.fromList([0, 0, 0, 0, 0]), cur0(0)).p => at(5)




verify wantedLevel
    Vector.get(wantedLevel(Bytes.fromList([]), Vector.fromList([-2]), At(value = 0, at = at(0)), 1), 0) => Option.Some(-1)

verify mainCopied
    mainCopied(Bytes.fromList([7, 5]), at(0), at(2), 0, ixAt(0), ixAt(0), ids0(0), []).out => [5, 7]

verify mainRefAt
    mainRefAt(Bytes.fromList([]), At(value = 1, at = at(0)), 1, ixAt(3), ixAt(5), IdsW(done = cset32(cnew32(3), 2, 1), cur = Vector.fromList([]), base = ixAt(65536)), []).out => [4]

verify blockRefAt
    blockRefAt(Bytes.fromList([]), At(value = 1, at = at(0)), 1, ixAt(1), num(0), ixAt(1), cnew(1, 0), ids0(1), []).out => [1]

verify blockNamed
    blockNamed(Bytes.fromList([]), At(value = 0, at = at(0)), 0, ixAt(0), num(0), ixAt(0), cnew(0, 0), ids0(0), Vector.fromList([6]), []).out => [6]

verify levelOut
    levelOut(Bytes.fromList([]), At(value = 0, at = at(0)), 1, Vector.fromList([4]), []).out => [4]

verify image
    image(Bytes.fromList([])) => Result.Err("not a Susz file of version 0")

verify withV0
    Result.withDefault(withV0(Bytes.fromList([]), Bytes.fromList([])), Laid(hd = Bytes.fromList([]), mains = [], proofs = [], message = "")).message == "" => false

verify laid
    List.len(Result.withDefault(laid(Bytes.fromList([]), 1, 1, 0, 0, fresh()), Laid(hd = Bytes.fromList([]), mains = [], proofs = [], message = "")).proofs) => 1

verify laidAfter
    laidMessage2(laidAfter(Bytes.fromList([83, 85, 83, 90, 0, 0, 0, 0, 0]), 9, 9, 1, 1, 0, 0, A(eoff = cnew(0, 0), c1 = cnew32(0), c2 = cnew32(0), owner = cnew(0, -1), names = Vector.fromList([Core.Names.anon()]), known = {}, exprs = 0, decls = 0))) == "" => false

fn laidMessage2(r: Result<Laid, String>) -> String
    ? "What a laid file says of itself, or why there is none, for examples."
    match r
        Result.Ok(l) -> l.message
        Result.Err(e) -> e

verify laidMessage2
    laidMessage2(Result.Err("x")) => "x"

verify imageOf
    imageOf(Laid(hd = Bytes.fromList([1]), mains = [], proofs = [], message = "")) == Result.Err("") => false

fn colsK(kind: Vector<Vector<Num>>) -> Cols
    ? "Columns of kind words only, for examples."
    Cols(kind = kind, c1 = cnew32(0), c2 = cnew32(0))

verify colsK
    Vector.len(colsK(cnew(1, 0)).kind) => 1

fn cols0() -> Cols
    ? "No columns, for examples."
    colsK(cnew(0, 0))

verify cols0
    Vector.len(cols0().kind) => 0

fn cols2(k: Int, c1: Int, c2: Int) -> Cols
    ? "Three expressions, the last of kind word k with parts c1 and c2, for examples."
    Cols(kind = cset(cnew(3, 0), 2, k), c1 = cset32(cnew32(3), 2, c1), c2 = cset32(cnew32(3), 2, c2))

verify cols2
    cget32(cols2(1, 0, 1).c2, 2) => 1

verify handedK
    cget(handedK(Bytes.fromList([]), cols2(1, 0, 1), ixAt(2), cnew(3, -1), num(5), num(1)), 1) => 5
    cget(handedK(Bytes.fromList([17, 1]), cols2(1, 0, 1), ixAt(1), cnew(3, -1), num(5), num(0)), 0) => 5



verify colsWritten
    colsWritten(Bytes.fromList([]), at(0), 0, at(0), fresh(), cnew(0, 0), Vector.fromList([]), Vector.fromList([]), codes0(), cols0()) => Result.Ok(fresh())
    Result.withDefault(colsWritten(Bytes.fromList([]), at(0), 1, at(0), W.update(fresh(), ei = ixAt(2), mainNext = ixAt(2), ids = ids0(3)), cnew(3, -2), Vector.fromList([]), Vector.fromList([]), codes0(), cols2(1, 0, 1)), fresh()).main => [2, 2, 10]

verify colWritten
    Result.withDefault(colWritten(Bytes.fromList([]), at(0), 1, at(0), W.update(fresh(), ei = ixAt(2), mainNext = ixAt(2), ids = ids0(3)), cnew(3, -3), Vector.fromList([]), Vector.fromList([]), codes0(), cols2(1, 0, 1)), fresh()).fE => 1

verify colMainDone
    Result.withDefault(colMainDone(Bytes.fromList([]), at(0), 1, at(0), fresh(), cnew(1, -2), Vector.fromList([]), Vector.fromList([]), codes0(), cols0(), num(-2)), fresh()).mainNext.value => 1

verify colBlock
    Option.withDefault(Vector.get(colBlock(W.update(fresh(), ei = ixAt(2), open = Vector.fromList([acc0()]), ids = ids0(3)), cset(cnew(3, 0), 1, -4), Vector.fromList([]), num(0), num(1), ixAt(0), ixAt(1)).open, 0), acc0()).out => [1, 0, 10]

verify colBlockOut
    colBlockOut([], num(1), ixAt(0), ixAt(1), num(0), ixAt(1), cset(cnew(2, 0), 1, -4), ids0(2), Vector.fromList([])) => [2, 1, 10]
    colBlockOut([], num(98), ixAt(0), ixAt(1), num(0), ixAt(1), cnew(2, 0), ids0(2), Vector.fromList([5, 5, 5, 5, 5, 5, 7])) => [1, 1, 7, 0, 11]

fn ids0(n: Int) -> IdsW
    ? "Numbers for n expressions, none set, for examples."
    IdsW(done = cnew32(n), cur = Vector.new(65536, nat32(0)), base = Ix(value = 0))

verify ids0
    Vector.len(ids0(1).done) => 1
