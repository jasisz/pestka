    cget(scanned(Bytes.fromList([7, 0, 18, 0, 0, 0, 1, 0]), at(0), at(8), 0, 0, 1, cnew(1, 0), cnew(1, -1), Vector.fromList([Core.Names.anon()]), {}).owner, 0) => -2

