    ctorRest(Bytes.fromList([0, 0, 0, 0, 0]), cur0(0)).p => at(5)

verify numberedConst
    Vector.get(numberedConst(Bytes.fromList([0]), 0, 1, cnew(1, 0), cnew(1, 0), Vector.fromList([]), Vector.fromList([-2]), Vector.fromList([]), 0, At(value = 0, at = at(0))).nameF, 0) => Option.Some(-1)

verify numberedNamed
    Vector.get(numberedNamed(Bytes.fromList([0, 1]), 1, 1, cnew(2, 0), cnew(2, -2), Vector.fromList([]), Vector.fromList([-2]), Vector.fromList([]), 0, At(value = 0, at = at(0)), 0).nameF, 0) => Option.Some(-1)
    cget(numberedNamed(Bytes.fromList([0, 1]), 1, 1, cnew(2, 0), cnew(2, -2), Vector.fromList([]), Vector.fromList([-2]), Vector.fromList([]), 0, At(value = 0, at = at(0)), 0).owner, 0) => -3

verify outwardNamed
    cget(outwardNamed(Bytes.fromList([1]), At(value = 0, at = at(0)), 1, cnew(1, -2), 0), 0) => -3
    cget(outwardNamed(Bytes.fromList([1]), At(value = 1, at = at(0)), 1, cnew(1, -2), 2), 0) => -3

verify wantedLevel
    Vector.get(wantedLevel(Bytes.fromList([]), Vector.fromList([-2]), At(value = 0, at = at(0)), 1), 0) => Option.Some(-1)

verify mainCopied
    mainCopied(Bytes.fromList([7, 5]), at(0), at(2), 0, 0, 0, cnew(0, 0), []) => [5, 7]

verify mainRefAt
    mainRefAt(Bytes.fromList([]), At(value = 1, at = at(0)), 1, 3, 5, cset(cnew(3, 0), 2, 1), []) => [4]

verify blockRefAt
    blockRefAt(Bytes.fromList([]), At(value = 1, at = at(0)), 1, 1, 0, 1, cnew(1, 0), cnew(1, 0), []) => [1]

verify blockNamed
    blockNamed(Bytes.fromList([]), At(value = 0, at = at(0)), 0, 0, 0, 0, cnew(0, 0), cnew(0, 0), Vector.fromList([6]), []) => [6]

verify levelOut
    levelOut(Bytes.fromList([]), At(value = 0, at = at(0)), 1, Vector.fromList([4]), []) => [4]

verify image
    image(Bytes.fromList([])) => Result.Err("not a Susz file of version 0")

verify withV0
    Result.withDefault(withV0(Bytes.fromList([]), Bytes.fromList([])), Laid(hd = Bytes.fromList([]), mains = [], proofs = [], message = "")).message == "" => false

verify laid
    List.len(Result.withDefault(laid(Bytes.fromList([]), 1, 1, 0, 0, fresh()), Laid(hd = Bytes.fromList([]), mains = [], proofs = [], message = "")).proofs) => 1

verify laidAfter
    laidMessage2(laidAfter(Bytes.fromList([83, 85, 83, 90, 0, 0, 0, 0, 0]), 9, 9, 1, 1, 0, 0, A(eoff = cnew(0, 0), owner = cnew(0, -1), names = Vector.fromList([Core.Names.anon()]), known = {}, exprs = 0, decls = 0))) == "" => false

fn laidMessage2(r: Result<Laid, String>) -> String
    ? "What a laid file says of itself, or why there is none, for examples."
    match r
        Result.Ok(l) -> l.message
        Result.Err(e) -> e

verify laidMessage2
    laidMessage2(Result.Err("x")) => "x"

verify imageOf
    imageOf(Laid(hd = Bytes.fromList([1]), mains = [], proofs = [], message = "")) == Result.Err("") => false
