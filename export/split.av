    cget(owned(handedK(Bytes.fromList([17, 1]), cols2(1, 0, 1), ixAt(1), own(cnew(3, -1)), num(5), num(0))), 0) => 5



verify colsWritten
    colsWritten(Bytes.fromList([]), at(0), num(0), at(0), fresh(), cnew(0, 0), Vector.fromList([]), Vector.fromList([]), cols0()) => Result.Ok(fresh())
    Result.withDefault(colsWritten(Bytes.fromList([]), at(0), num(1), at(0), W.update(fresh(), ei = ixAt(2), mainNext = ixAt(2), ids = ids0(3)), cnew(3, -2), Vector.fromList([]), Vector.fromList([]), cols2(1, 0, 1)), fresh()).main => [2, 2, 10]

verify colWritten
    Result.withDefault(colWritten(Bytes.fromList([]), at(0), num(1), at(0), W.update(fresh(), ei = ixAt(2), mainNext = ixAt(2), ids = ids0(3)), cnew(3, -3), Vector.fromList([]), Vector.fromList([]), cols2(1, 0, 1)), fresh()).fE => 1

verify colMainDone
    Result.withDefault(colMainDone(Bytes.fromList([]), at(0), num(1), at(0), fresh(), cnew(1, -2), Vector.fromList([]), Vector.fromList([]), cols0(), num(-2)), fresh()).mainNext.value => 1

verify colBlock
    colBlock(W.update(fresh(), ei = ixAt(2), open = Vector.fromList([acc0()]), ids = ids0(3)), cset(cnew(3, 0), 1, -4), Vector.fromList([]), num(0), num(1), ixAt(0), ixAt(1)).hold.out => [1, 0, 10]

verify colBlockOut
    colBlockOut([], num(1), ixAt(0), ixAt(1), num(0), ixAt(1), cset(cnew(2, 0), 1, -4), ids0(2), Vector.fromList([])) => [2, 1, 10]
    colBlockOut([], num(98), ixAt(0), ixAt(1), num(0), ixAt(1), cnew(2, 0), ids0(2), Vector.fromList([5, 5, 5, 5, 5, 5, 7])) => [1, 1, 7, 0, 11]

fn ids0(n: Int) -> IdsW
    ? "Numbers for n expressions, none set, for examples."
    IdsW(done = cnew32(n), cur = Vector.new(65536, nat32(0)), base = Ix(value = 0))

verify ids0
    Vector.len(ids0(1).done) => 1
