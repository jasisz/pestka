module Split
    intent =
        "Rewrites a Susz file of version 0 as version 2 (docs/susz.md): every"
        "expression that only one theorem's proof reaches moves into that"
        "theorem's block in the proof section, the rest stays in the main"
        "block, renumbered densely, and the main block lists the frontier the"
        "blocks name. pestka pack writes version 0 first and then this, so the"
        "export is parsed by the code that parses it for version 0. Four"
        "passes over the main block of version 0: one reads names, finds"
        "where every expression starts, seeds each expression with the"
        "declarations naming it and keeps where each name is first placed;"
        "one goes back from the last expression to the first, handing each"
        "expression's owner to its parts; one numbers expressions in the main"
        "block and in their blocks and finds the frontier; the last writes."
        "The writer is deterministic: the same file gives the same bytes."
    exposes [split, image, imageOf, laidMessage2, written2, laidAfter, Laid, A, Cols, DeclP, declOf, seeded, placedUnlessSkipped, nameStrAt, nameNumAt, at, cset, cget, noChunk, nat32, noChunk32, cget32, cnew32, num]
    exposes opaque [Ix, U32, Num]
    depends [Bytes, Core.Names, Core.Lazy, Export.Susz]
    effects [Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.appendBytes]

decision OwnersByOneWalkBack
    date = "2026-11-11"
    reason =
        "An expression belongs to a theorem's block when that theorem's"
        "value is the only way any declaration reaches it. Every expression"
        "names only earlier ones, so going from the last expression to the"
        "first, each one's owner is final when it is met: a theorem's value"
        "is seeded with the theorem, every other expression a declaration"
        "names with the main block, and each expression hands its owner to"
        "its parts, a part met with two owners going to the main block."
        "An expression no declaration reaches stays in the main block, as"
        "lean4export may write such lines. A block holds its expressions in"
        "export order, so each is written once the pass reaches it, and a"
        "block is complete before its theorem's declaration record, which"
        "names its value, the last of them."
    chosen = "OwnersByOneWalkBack"
    rejected = ["ReachabilityPerTheorem"]
    impacts = [walkBack, walkBackAt]

decision ReadAsTheReaderReads
    date = "2026-11-11"
    reason =
        "The file split reads is Susz of version 0, the encoding"
        "Export.Susz reads. Its positions are that module's Pos and its"
        "varints are read by that module's decoder (OneDecoder), so the"
        "packer and the reader read one encoding the same way. A field"
        "that runs past the bytes gives none, and a record at none is an"
        "error of the file, not a record."
    chosen = "ReadAsTheReaderReads"
    rejected = ["DecoderOfItsOwn"]
    impacts = [rv, at, past, off, tagAt, scanned, written]

fn rv(b: Bytes, p: Pos) -> At
    ? "The varint at p and where the next field starts, none when it runs past the end (ReadAsTheReaderReads)."
    Export.Susz.vAt(b, p)

verify rv
    rv(Bytes.fromList([172, 2]), at(0)) => At(value = 300, at = at(2))
    off(rv(Bytes.fromList([172]), at(0)).at) => -1

fn at(n: Int) -> Pos
    ? "The position n, none when it is not one."
    Export.Susz.posAt(n)

verify at
    off(at(4)) => 4

fn past(p: Pos, k: Int) -> Pos
    ? "k bytes past p."
    Export.Susz.ahead(p, k)

verify past
    off(past(at(4), 3)) => 7

fn next1(p: Pos) -> Pos
    ? "One byte past p: past a tag."
    Export.Susz.ahead1(p)

verify next1
    off(next1(at(4))) => 5

fn next2(p: Pos) -> Pos
    ? "Two bytes past p."
    Export.Susz.ahead2(p)

verify next2
    off(next2(at(4))) => 6

fn off(p: Pos) -> Int
    ? "Where p is, -1 for none."
    Export.Susz.place(p)

verify off
    off(at(-3)) => -1

fn tagAt(b: Bytes, p: Pos) -> Int
    ? "The octet at p, 0 at none or past the end."
    Export.Susz.octetAt(b, p)

verify tagAt
    tagAt(Bytes.fromList([7]), at(0)) => 7
    tagAt(Bytes.fromList([7]), at(1)) => 0

fn octet(b: Bytes, i: Int) -> Int
    ? "The octet at i of the trailer, 0 past the end."
    Option.withDefault(Bytes.get(b, i), 0)

verify octet
    octet(Bytes.fromList([7]), 0) => 7
    octet(Bytes.fromList([7]), 1) => 0

fn u32At(b: Bytes, i: Int) -> Int
    ? "A little-endian u32 at i."
    ((octet(b, i + 3) * 256 + octet(b, i + 2)) * 256 + octet(b, i + 1)) * 256 + octet(b, i)

verify u32At
    u32At(Bytes.fromList([1, 2, 0, 0]), 0) => 513

fn u64At(b: Bytes, i: Int) -> Int
    ? "A little-endian u64 at i."
    u32At(b, i + 4) * 4294967296 + u32At(b, i)

verify u64At
    u64At(Bytes.fromList([1, 0, 0, 0, 1, 0, 0, 0]), 0) => 4294967297

fn uv(acc: List<Int>, n: Int) -> List<Int>
    ? "n as a varint onto the reversed output."
    match n < 128
        true -> List.prepend(n, acc)
        false -> match n < 4611686018427387904
            true -> uv(List.prepend(Bits.and(n, 127) + 128, acc), Bits.shiftRight(n, 7))
            false -> uv(List.prepend(Int.mod(n, 128) + 128, acc), Int.div(n, 128))

verify uv
    uv([], 300) => [2, 172]

fn uwn(acc: List<Int>, n: Num) -> List<Int>
    ? "n as a varint onto the reversed output, n and each step of it a machine word: uv for the ids and distances the writer works out (IdsInRange)."
    match n.value < 128
        true -> List.prepend(n.value, acc)
        false -> uwn(List.prepend(Bits.and(n.value, 127) + 128, acc), numStep(Bits.shiftRight(n.value, 7)))

verify uwn
    uwn([], num(300)) => [2, 172]

fn uvLen(n: Int) -> Int
    ? "How many bytes n takes as a varint."
    match n < 128
        true -> 1
        false -> 1 + uvLen(Int.div(n, 128))

verify uvLen
    uvLen(300) => 2

fn u32(acc: List<Int>, n: Int) -> List<Int>
    ? "n as four bytes, little-endian, onto the reversed output."
    List.prepend(Int.mod(Int.div(n, 16777216), 256), List.prepend(Int.mod(Int.div(n, 65536), 256), List.prepend(Int.mod(Int.div(n, 256), 256), List.prepend(Int.mod(n, 256), acc))))

verify u32
    u32([], 513) => [0, 0, 2, 1]

fn u64(acc: List<Int>, n: Int) -> List<Int>
    ? "n as eight bytes, little-endian, onto the reversed output."
    u32(u32(acc, Int.mod(n, 4294967296)), Int.div(n, 4294967296))

verify u64
    List.len(u64([], 1)) => 8

fn copied(acc: List<Int>, b: Bytes, s: Pos, t: Pos) -> List<Int>
    ? "Bytes s to t - 1 of b onto the reversed output."
    match off(s) >= off(t)
        true -> acc
        false -> copied(List.prepend(tagAt(b, s), acc), b, next1(s), t)

verify copied
    copied([], Bytes.fromList([1, 2, 3]), at(1), at(3)) => [3, 2]

fn geti(v: Vector<Int>, i: Int) -> Int
    ? "Element i, -1 past the end."
    Option.withDefault(Vector.get(v, i), -1)

verify geti
    geti(Vector.fromList([4]), 0) => 4

fn seti(v: Vector<Int>, i: Int, x: Int) -> Vector<Int>
    ? "v with x at i; i is in range."
    Option.withDefault(Vector.set(v, i, x), v)

verify seti
    geti(seti(Vector.fromList([4]), 0, 5), 0) => 5

decision ChunkedNumbers
    date = "2026-11-11"
    reason =
        "Vector.new makes at most 2^24 places, and mathlib has 105 M"
        "expressions, each needing where it starts, its owner and its new"
        "number. Each of these is a vector of chunks of 65536 numbers. A"
        "number is set in place by taking its chunk out of the outer vector"
        "first, so that the chunk has one owner while it is set, and putting"
        "it back after. What stands in its place meanwhile is noChunk, one"
        "vector made once for the module, so taking a chunk out allocates"
        "nothing."
    chosen = "ChunkedNumbers"
    rejected = ["OneVector", "MapsOfNumbers"]
    impacts = [cnew, cget, cset, Ix, ixAt]

decision IdsInRange
    date = "2026-11-11"
    reason =
        "An expression or declaration id is below 2^40, or none (-1), as a"
        "file's counts are u32. It is an Ix, made only by ixAt, so compiled"
        "Aver holds it as a machine word and finds its chunk and its place"
        "in the chunk by division and remainder on that word."
    chosen = "IdsInRange"
    rejected = ["IdsAsInts"]
    impacts = [Ix, ixOf, ixAt, cget, cset]

record Ix
    value: Int

fn ixOf(n: Int) -> Result<Ix, String>
    ? "An id: -1 for none, otherwise below 2^40 (IdsInRange)."
    match Bool.and(n >= -1, n <= 1099511627776)
        true -> Result.Ok(Ix(value = n))
        false -> Result.Err("id out of range")

verify ixOf
    ixOf(-2) => Result.Err("id out of range")

fn ixAt(n: Int) -> Ix
    ? "The id n, none when it is out of range (IdsInRange)."
    match ixOf(n)
        Result.Ok(x) -> x
        Result.Err(_) -> Ix(value = -1)

verify ixAt
    ixAt(5).value => 5
    ixAt(-9).value => -1

fn ixWord(n: Int) -> Result<Ix, String>
    ? "An id reckoned on a machine word: the bound of ixOf, a constructor of its own so that its argument stays a word (IdsInRange)."
    match Bool.and(n >= -1, n <= 1099511627776)
        true -> Result.Ok(Ix(value = n))
        false -> Result.Err("id out of range")

verify ixWord
    ixWord(-2) => Result.Err("id out of range")

fn ixStep(n: Int) -> Ix
    ? "The id n reckoned on a word, none when it is out of range (IdsInRange)."
    match ixWord(n)
        Result.Ok(x) -> x
        Result.Err(_) -> Ix(value = -1)

verify ixStep
    ixStep(5).value => 5
    ixStep(-9).value => -1

fn cnew(n: Int, x: Int) -> Vector<Vector<Num>>
    ? "n numbers x, in chunks of 65536 (ChunkedNumbers)."
    Vector.fromList(chunksOf(Int.div(n + 65535, 65536), x, []))

verify cnew
    cget(cnew(70000, 3), 69999) => 3

fn chunksOf(k: Int, x: Int, acc: List<Vector<Num>>) -> List<Vector<Num>>
    ? "k chunks, each of its own."
    match k <= 0
        true -> acc
        false -> chunksOf(k - 1, x, List.prepend(Vector.new(65536, num(x)), acc))

verify chunksOf
    List.len(chunksOf(2, 0, [])) => 2

fn cget(v: Vector<Vector<Num>>, i: Int) -> Int
    ? "Number i, -1 when there is none (ChunkedNumbers, IdsInRange)."
    nget(v, ixAt(i)).value

fn nget(v: Vector<Vector<Num>>, x: Ix) -> Num
    ? "Number x, -1 when there is none (ChunkedNumbers, IdsInRange)."
    match x.value < 0
        true -> Num(value = -1)
        false -> match Vector.get(v, Int.div(x.value, 65536))
            Option.Some(c) -> Option.withDefault(Vector.get(c, Int.mod(x.value, 65536)), Num(value = -1))
            Option.None -> Num(value = -1)

verify nget
    nget(cnew(1, 5), ixAt(0)).value => 5
    nget(cnew(1, 5), ixAt(-1)).value => -1

verify cget
    cget(cnew(1, 5), 0) => 5
    cget(cnew(1, 5), -1) => -1

fn cset(v: Vector<Vector<Num>>, i: Int, x: Int) -> Vector<Vector<Num>>
    ? "v with x as number i: its chunk taken out, set and put back (ChunkedNumbers, IdsInRange)."
    nset(v, ixAt(i), num(x))

fn nset(v: Vector<Vector<Num>>, k: Ix, x: Num) -> Vector<Vector<Num>>
    ? "v with x as number k: its chunk taken out, set and put back (ChunkedNumbers, IdsInRange)."
    ci = Int.div(Int.max(k.value, 0), 65536)
    match Bool.and(k.value >= 0, ci < Vector.len(v))
        false -> v
        true -> match Vector.get(v, ci)
            Option.None -> v
            Option.Some(c) -> cput(Option.withDefault(Vector.set(v, ci, noChunk), v), ci, chunkSet(c, Int.mod(k.value, 65536), x))

verify cset
    cget(cset(cset(cnew(70000, 0), 65537, 9), 2, 4), 65537) => 9

verify nset
    nget(nset(cnew(70000, 0), ixAt(65537), num(9)), ixAt(65537)).value => 9

fn chunkSet(c: Vector<Num>, j: Int, x: Num) -> Vector<Num>
    ? "c with x at j."
    Option.withDefault(Vector.set(c, j, x), c)

verify chunkSet
    Vector.get(chunkSet(Vector.fromList([num(0)]), 0, num(2)), 0) => Option.Some(num(2))

fn cput(v: Vector<Vector<Num>>, ci: Int, c: Vector<Num>) -> Vector<Vector<Num>>
    ? "c back as chunk ci."
    Option.withDefault(Vector.set(v, ci, c), v)

verify cput
    Vector.len(cput(Vector.fromList([noChunk]), 0, Vector.fromList([num(1)]))) => 1

noChunk: Vector<Num> = Vector.fromList([num(0)])

decision NumbersAsWords
    date = "2026-11-12"
    reason =
        "The chunks of owners and kind words held Ints: every read made an"
        "Int of the element and every write dropped the one it replaced,"
        "the checks of a number of any size each time. Their numbers are"
        "below 2^62 either way (an owner is a declaration or a small"
        "negative code, a kind word a byte offset times 16 plus a name"
        "times 16), so the chunks hold a Num, made only by num, which"
        "compiled Aver holds as a machine word."
    chosen = "NumbersAsWords"
    rejected = ["ChunksOfInts"]
    impacts = [Num, num, cnew, cget, cset, chunkSet]

record Num
    value: Int

fn numOf(n: Int) -> Result<Num, String>
    ? "A number of a chunk: -2^62 to 2^62 - 1 (NumbersAsWords)."
    match Bool.and(n >= -4611686018427387904, n <= 4611686018427387903)
        true -> Result.Ok(Num(value = n))
        false -> Result.Err("number out of range")

verify numOf
    numOf(4611686018427387904) => Result.Err("number out of range")

fn num(n: Int) -> Num
    ? "n as a number of a chunk, 0 when it is out of range."
    match numOf(n)
        Result.Ok(x) -> x
        Result.Err(_) -> Num(value = 0)

verify num
    num(-7).value => -7
    num(4611686018427387904).value => 0

fn numWord(n: Int) -> Result<Num, String>
    ? "A number of a chunk reckoned on a machine word: the bound of numOf, a constructor of its own so that its argument stays a word (NumbersAsWords)."
    match Bool.and(n >= -4611686018427387904, n <= 4611686018427387903)
        true -> Result.Ok(Num(value = n))
        false -> Result.Err("number out of range")

verify numWord
    numWord(4611686018427387904) => Result.Err("number out of range")

fn numStep(n: Int) -> Num
    ? "n reckoned on a word as a number of a chunk, 0 when it is out of range."
    match numWord(n)
        Result.Ok(x) -> x
        Result.Err(_) -> Num(value = 0)

verify numStep
    numStep(-7).value => -7

decision ExprColumns
    date = "2026-11-12"
    reason =
        "On mathlib 98.4% of the expressions are applications, lambdas and"
        "pis (98.8% on Init). The packer encoded each as a record of version"
        "0, and the passes after decoded it three times (owners, numbers,"
        "writing) before writing it again. They are kept as numbers"
        "instead: a kind word per expression (where its record starts,"
        "times 16, for a record; else 1 for an application, 2 to 5 for a"
        "lambda and 6 to 9 for a pi by binder, plus 16 times its name) and"
        "its two parts by absolute id, as u32 (U32). The records between"
        "them carry a run record (tag 20, a count) where such expressions"
        "stood, so the last pass writes them in their place. The bytes"
        "written are those of version 0 rewritten."
    chosen = "ExprColumns"
    rejected = ["VersionZeroRecords"]
    impacts = [Cols, U32, walkBack, written, colsWritten]

record U32
    value: Int

fn u32Of(n: Int) -> Result<U32, String>
    ? "An id or a number of the columns: 0 to 2^32 - 1 (ExprColumns)."
    match Bool.and(n >= 0, n <= 4294967295)
        true -> Result.Ok(U32(value = n))
        false -> Result.Err("number out of range")

verify u32Of
    u32Of(-1) => Result.Err("number out of range")

fn nat32(n: Int) -> U32
    ? "n as a u32, 0 when it is out of range."
    match u32Of(n)
        Result.Ok(x) -> x
        Result.Err(_) -> U32(value = 0)

verify nat32
    nat32(7).value => 7
    nat32(-7).value => 0

fn u32Word(n: Int) -> Result<U32, String>
    ? "A u32 reckoned on a machine word: the bound of u32Of, a constructor of its own so that its argument stays a word (ExprColumns)."
    match Bool.and(n >= 0, n <= 4294967295)
        true -> Result.Ok(U32(value = n))
        false -> Result.Err("number out of range")

verify u32Word
    u32Word(-1) => Result.Err("number out of range")

fn u32Step(n: Int) -> U32
    ? "n reckoned on a word as a u32, 0 when it is out of range."
    match u32Word(n)
        Result.Ok(x) -> x
        Result.Err(_) -> U32(value = 0)

verify u32Step
    u32Step(7).value => 7

noChunk32: Vector<U32> = Vector.fromList([nat32(0)])

fn cnew32(n: Int) -> Vector<Vector<U32>>
    ? "n numbers 0, in chunks of 65536 (ChunkedNumbers)."
    Vector.fromList(chunks32(Int.div(n + 65535, 65536), []))

verify cnew32
    cget32(cnew32(70000), 69999) => 0

fn chunks32(k: Int, acc: List<Vector<U32>>) -> List<Vector<U32>>
    ? "k chunks, each of its own."
    match k <= 0
        true -> acc
        false -> chunks32(k - 1, List.prepend(Vector.new(65536, nat32(0)), acc))

verify chunks32
    List.len(chunks32(2, [])) => 2

fn cget32(v: Vector<Vector<U32>>, i: Int) -> Int
    ? "Number i, -1 when there is none (ChunkedNumbers, IdsInRange)."
    uget(v, ixAt(i))

fn uget(v: Vector<Vector<U32>>, x: Ix) -> Int
    ? "Number x, -1 when there is none (ChunkedNumbers, IdsInRange)."
    match x.value < 0
        true -> -1
        false -> match Vector.get(v, Int.div(x.value, 65536))
            Option.Some(c) -> match Vector.get(c, Int.mod(x.value, 65536))
                Option.Some(u) -> u.value
                Option.None -> -1
            Option.None -> -1

verify cget32
    cget32(cnew32(1), -1) => -1

verify uget
    uget(cnew32(1), ixAt(0)) => 0

fn part(v: Vector<Vector<U32>>, x: Ix) -> Ix
    ? "The part of expression x a column holds, an id (ExprColumns, IdsInRange)."
    ixStep(uget(v, x))

verify part
    part(cnew32(1), ixAt(0)).value => 0

fn cset32(v: Vector<Vector<U32>>, i: Int, x: Int) -> Vector<Vector<U32>>
    ? "v with x as number i: its chunk taken out, set and put back (ChunkedNumbers, IdsInRange)."
    k = ixAt(i)
    ci = Int.div(Int.max(k.value, 0), 65536)
    match Bool.and(k.value >= 0, ci < Vector.len(v))
        false -> v
        true -> match Vector.get(v, ci)
            Option.None -> v
            Option.Some(c) -> cput32(Option.withDefault(Vector.set(v, ci, noChunk32), v), ci, chunkSet32(c, Int.mod(k.value, 65536), x))

verify cset32
    cget32(cset32(cset32(cnew32(70000), 65537, 9), 2, 4), 65537) => 9

fn chunkSet32(c: Vector<U32>, j: Int, x: Int) -> Vector<U32>
    ? "c with x at j."
    Option.withDefault(Vector.set(c, j, nat32(x)), c)

verify chunkSet32
    Vector.len(chunkSet32(Vector.fromList([nat32(0)]), 0, 2)) => 1

fn cput32(v: Vector<Vector<U32>>, ci: Int, c: Vector<U32>) -> Vector<Vector<U32>>
    ? "c back as chunk ci."
    Option.withDefault(Vector.set(v, ci, c), v)

verify cput32
    Vector.len(cput32(Vector.fromList([noChunk32]), 0, Vector.fromList([nat32(1)]))) => 1

record Cols
    kind: Vector<Vector<Num>>
    c1: Vector<Vector<U32>>
    c2: Vector<Vector<U32>>

fn recordAt(k: Num) -> Pos
    ? "Where the record of a kind word that names one starts (ExprColumns)."
    at(Bits.shiftRight(k.value, 4))

verify recordAt
    off(recordAt(num(48))) => 3

fn skipList(b: Bytes, p: Pos) -> Pos
    ? "Past a list of varints at p."
    n = rv(b, p)
    skipN(b, n.at, n.value)

verify skipList
    skipList(Bytes.fromList([2, 1, 130, 1]), at(0)) => at(4)

fn skipN(b: Bytes, p: Pos, n: Int) -> Pos
    ? "Past n varints at p."
    match n <= 0
        true -> p
        false -> skipN(b, rv(b, p).at, n - 1)

verify skipN
    skipN(Bytes.fromList([1, 2]), at(0), 2) => at(2)

fn skipText(b: Bytes, p: Pos) -> Pos
    ? "Past a string at p."
    n = rv(b, p)
    match off(n.at) < 0
        true -> n.at
        false -> past(n.at, n.value)

verify skipText
    skipText(Bytes.fromList([2, 97, 98]), at(0)) => at(3)
    skipText(Bytes.fromList([128]), at(0)) => at(-1)

fn skipRecord(b: Bytes, p: Pos) -> Pos
    ? "Past the record at p, which is not a declaration."
    match tagAt(b, p)
        1 -> skipText(b, rv(b, next1(p)).at)
        9 -> skipList(b, rv(b, next1(p)).at)
        11 -> skipN(b, next2(p), 3)
        12 -> skipN(b, next2(p), 3)
        14 -> skipText(b, next1(p))
        15 -> skipText(b, next1(p))
        13 -> skipN(b, next1(p), 4)
        16 -> skipN(b, next1(p), 3)
        2 -> skipN(b, next1(p), 2)
        4 -> skipN(b, next1(p), 2)
        5 -> skipN(b, next1(p), 2)
        10 -> skipN(b, next1(p), 2)
        _ -> skipN(b, next1(p), 1)

verify skipRecord
    skipRecord(Bytes.fromList([1, 0, 1, 97]), at(0)) => at(4)
    skipRecord(Bytes.fromList([10, 1, 2]), at(0)) => at(3)

type Piece
    Raw(Pos, Pos)
    Ref(Int)
    Val(Int)

record Cur
    p: Pos
    raw: Pos
    pieces: List<Piece>
    names: List<Int>
    skip: Bool
    value: Int
    next: Int

record DeclP
    kind: Int
    pieces: List<Piece>
    names: List<Int>
    skip: Bool
    value: Int
    end: Pos

fn declOf(b: Bytes, p: Pos, next: Int) -> DeclP
    ? "The declaration record whose kind is at p, cut into raw bytes and expression references (as absolute ids, next being the next expression's), with the names it places, whether Pestka skips it and a theorem's value."
    k = tagAt(b, p)
    c = declBody(b, k, Cur(p = next1(p), raw = next1(p), pieces = [], names = [], skip = false, value = -1, next = next))
    f = flushed(c)
    DeclP(kind = k, pieces = List.reverse(f.pieces), names = f.names, skip = f.skip, value = f.value, end = f.p)

verify declOf
    declOf(Bytes.fromList([2, 1, 0, 1, 1, 0]), at(0), 5).value => 4
    declOf(Bytes.fromList([2, 1, 0, 1, 1, 0]), at(0), 5).pieces => [Piece.Raw(at(1), at(3)), Piece.Ref(4), Piece.Val(4), Piece.Raw(at(5), at(6))]

fn flushed(c: Cur) -> Cur
    ? "The raw bytes read since the last reference, as a piece."
    match off(c.p) > off(c.raw)
        true -> Cur.update(c, pieces = List.prepend(Piece.Raw(c.raw, c.p), c.pieces), raw = c.p)
        false -> c

fn cExpr(b: Bytes, c: Cur) -> Cur
    ? "An expression reference."
    f = flushed(c)
    d = rv(b, f.p)
    Cur.update(f, p = d.at, raw = d.at, pieces = List.prepend(Piece.Ref(f.next - d.value), f.pieces))

fn cSkip(b: Bytes, c: Cur, n: Int) -> Cur
    ? "Past n varints."
    Cur.update(c, p = skipN(b, c.p, n))

fn cList(b: Bytes, c: Cur) -> Cur
    ? "Past a list."
    Cur.update(c, p = skipList(b, c.p))

fn cHead(b: Bytes, c: Cur) -> Cur
    ? "A head: the name it places, its parameters, its type."
    n = rv(b, c.p)
    cExpr(b, Cur.update(c, p = skipList(b, n.at), names = List.prepend(n.value, c.names)))

fn cUnsafe(b: Bytes, c: Cur) -> Cur
    ? "A bool byte saying unsafe, which makes Pestka skip the declaration."
    Cur.update(c, p = next1(c.p), skip = Bool.or(c.skip, tagAt(b, c.p) == 1))

fn declBody(b: Bytes, k: Int, c: Cur) -> Cur
    ? "The fields of each kind, as docs/susz.md lists them."
    match k
        0 -> cUnsafe(b, cHead(b, c))
        1 -> defBody(b, cExpr(b, cHead(b, c)))
        2 -> thmBody(b, cHead(b, c))
        3 -> cList(b, cUnsafe(b, cExpr(b, cHead(b, c))))
        4 -> pastByte(cHead(b, c))
        _ -> indBody(b, c)

fn pastByte(c: Cur) -> Cur
    ? "Past one byte."
    Cur.update(c, p = next1(c.p))

fn defBody(b: Bytes, c: Cur) -> Cur
    ? "Hints, safety, group: anything but safe is skipped."
    match tagAt(b, c.p) == 2
        true -> defSafety(b, c, rv(b, next1(c.p)).at)
        false -> defSafety(b, c, next1(c.p))

fn defSafety(b: Bytes, c: Cur, q: Pos) -> Cur
    ? "The safety byte at q, then the group."
    cList(b, Cur.update(c, p = next1(q), skip = tagAt(b, q) != 0))

fn thmBody(b: Bytes, c: Cur) -> Cur
    ? "The value, kept as the theorem's (a piece of its own), and the group."
    v = cExpr(b, c)
    cList(b, asValue(v, v.pieces))

fn asValue(c: Cur, ps: List<Piece>) -> Cur
    ? "The newest reference made the theorem's value."
    match ps
        [Piece.Ref(e), ..rest] -> Cur.update(c, pieces = List.prepend(Piece.Val(e), rest), value = e)
        _ -> c

verify asValue
    asValue(cur0(0), [Piece.Ref(3)]).pieces => [Piece.Val(3)]

fn indBody(b: Bytes, c: Cur) -> Cur
    ? "Types, constructors, recursors, each counted."
    nt = rv(b, c.p)
    ts = indTypes(b, Cur.update(c, p = nt.at), nt.value)
    nc = rv(b, ts.p)
    cs = indCtors(b, Cur.update(ts, p = nc.at), nc.value)
    nr = rv(b, cs.p)
    indRecs(b, Cur.update(cs, p = nr.at), nr.value)

fn indTypes(b: Bytes, c: Cur, n: Int) -> Cur
    ? "A type: head, unsafe, numParams, numIndices, all, ctors, numNested, isRec, isReflexive."
    match n <= 0
        true -> c
        false -> indTypes(b, indTypeRest(b, cUnsafe(b, cHead(b, c))), n - 1)

fn indTypeRest(b: Bytes, c: Cur) -> Cur
    ? "The type's fields after unsafe."
    q = skipN(b, skipList(b, skipList(b, skipN(b, c.p, 2))), 1)
    Cur.update(c, p = next2(q))

fn indCtors(b: Bytes, c: Cur, n: Int) -> Cur
    ? "A constructor: head, unsafe, induct, cidx, numParams, numFields."
    match n <= 0
        true -> c
        false -> indCtors(b, ctorRest(b, cHead(b, c)), n - 1)

fn ctorRest(b: Bytes, c: Cur) -> Cur
    ? "The constructor's fields after its head."
    Cur.update(c, p = skipN(b, next1(c.p), 4))

fn indRecs(b: Bytes, c: Cur, n: Int) -> Cur
    ? "A recursor: head, unsafe, all, four numbers, rules, k."
    match n <= 0
        true -> c
        false -> indRecs(b, recRest(b, cHead(b, c)), n - 1)

fn recRest(b: Bytes, c: Cur) -> Cur
    ? "The recursor's fields after its head."
    q = skipN(b, skipList(b, next1(c.p)), 4)
    nr = rv(b, q)
    r = rules(b, Cur.update(c, p = nr.at), nr.value)
    Cur.update(r, p = next1(r.p))

fn rules(b: Bytes, c: Cur, n: Int) -> Cur
    ? "Each rule: constructor, nfields, right-hand side."
    match n <= 0
        true -> c
        false -> rules(b, cExpr(b, cSkip(b, c, 2)), n - 1)

record A
    eoff: Vector<Vector<Num>>
    c1: Vector<Vector<U32>>
    c2: Vector<Vector<U32>>
    owner: Vector<Vector<Num>>
    names: Vector<Name>
    known: Map<Name, Int>
    exprs: Int
    decls: Int

fn scanned(b: Bytes, p: Pos, end: Pos, ei: Int, di: Int, nameId: Int, eoff: Vector<Vector<Num>>, owner: Vector<Vector<Num>>, names: Vector<Name>, known: Map<Name, Int>) -> A
    ? "The first pass: names built, where each expression starts, owners seeded by the declarations, and where each name is first placed (OwnersByOneWalkBack, PlaceCodes). A record at none stops it; the last pass, reading the same records, reports it (ReadAsTheReaderReads)."
    match Bool.or(off(p) >= off(end), off(p) < 0)
        true -> A(eoff = eoff, c1 = Vector.fromList([]), c2 = Vector.fromList([]), owner = owner, names = names, known = known, exprs = ei, decls = di)
        false -> match tagAt(b, p)
            1 -> scanned(b, skipRecord(b, p), end, ei, di, nameId + 1, eoff, owner, Option.withDefault(Vector.set(names, nameId, nameStrAt(b, p, names)), names), known)
            2 -> scanned(b, skipRecord(b, p), end, ei, di, nameId + 1, eoff, owner, Option.withDefault(Vector.set(names, nameId, nameNumAt(b, p, names)), names), known)
            18 -> declScanned(b, end, ei, di, nameId, eoff, owner, names, known, declOf(b, next1(p), ei))
            t -> match Bool.and(t >= 7, t <= 17)
                true -> scanned(b, skipRecord(b, p), end, ei + 1, di, nameId, cset(eoff, ei, off(p) * 16), owner, names, known)
                false -> scanned(b, skipRecord(b, p), end, ei, di, nameId, eoff, owner, names, known)

fn nameStrAt(b: Bytes, p: Pos, names: Vector<Name>) -> Name
    ? "A name record 1: its prefix and its text."
    pre = rv(b, next1(p))
    n = rv(b, pre.at)
    Core.Names.str(Option.withDefault(Vector.get(names, pre.value), Core.Names.anon()), Result.withDefault(String.fromUtf8(Bytes.take(Bytes.drop(b, Int.max(off(n.at), 0)), n.value)), ""))

fn nameNumAt(b: Bytes, p: Pos, names: Vector<Name>) -> Name
    ? "A name record 2: its prefix and its number."
    pre = rv(b, next1(p))
    k = rv(b, pre.at)
    Core.Names.num(Option.withDefault(Vector.get(names, pre.value), Core.Names.anon()), k.value)

fn declScanned(b: Bytes, end: Pos, ei: Int, di: Int, nameId: Int, eoff: Vector<Vector<Num>>, owner: Vector<Vector<Num>>, names: Vector<Name>, known: Map<Name, Int>, d: DeclP) -> A
    ? "A declaration: its references seed their owners, a theorem's value with the theorem, and the names it places keep its code unless Pestka skips it."
    scanned(b, d.end, end, ei, di + 1, nameId, eoff, seeded(owner, d.pieces, d.value, di), names, placedUnlessSkipped(known, names, d, di))

fn placedUnlessSkipped(known: Map<Name, Int>, names: Vector<Name>, d: DeclP, di: Int) -> Map<Name, Int>
    ? "The names d places, with its code, unless Pestka skips it."
    match d.skip
        true -> known
        false -> placedAll(known, names, d.names, Core.Lazy.codeOf(di, d.kind == 5))

fn placedAll(known: Map<Name, Int>, names: Vector<Name>, ns: List<Int>, code: Int) -> Map<Name, Int>
    ? "Each name placed with code, unless placed before."
    match ns
        [] -> known
        [n, ..rest] -> placedAll(placedOne(known, Option.withDefault(Vector.get(names, n), Core.Names.anon()), code), names, rest, code)

fn placedOne(known: Map<Name, Int>, nm: Name, code: Int) -> Map<Name, Int>
    ? "nm placed with code, unless placed before."
    match Map.has(known, nm)
        true -> known
        false -> Map.set(known, nm, code)

verify placedOne
    Map.get(placedOne(placedOne({}, Core.Names.anon(), 2), Core.Names.anon(), 4), Core.Names.anon()) => Option.Some(2)

fn seeded(owner: Vector<Vector<Num>>, ps: List<Piece>, value: Int, di: Int) -> Vector<Vector<Num>>
    ? "Each reference of a declaration marked: a theorem's value with its value code (valueCode), every other with the main block."
    match ps
        [] -> owner
        [Piece.Val(e), ..rest] -> seeded(marked(owner, e, valueCode(di)), rest, value, di)
        [Piece.Ref(e), ..rest] -> seeded(marked(owner, e, -2), rest, value, di)
        [_, ..rest] -> seeded(owner, rest, value, di)

fn valueCode(di: Int) -> Int
    ? "Theorem di's value as seeded, -5 - di, told apart from di as a block's expression hands it on (FrontierInWalkBack)."
    -5 - di

verify valueCode
    valueCode(0) => -5

fn marked(owner: Vector<Vector<Num>>, e: Int, o: Int) -> Vector<Vector<Num>>
    ? "Expression e seeded from owner o, a value code or the main block (-2); -1 is none yet, and two owners make the main block (OwnersByOneWalkBack)."
    x = cget(owner, e)
    match x == -1
        true -> cset(owner, e, o)
        false -> match x == o
            true -> owner
            false -> cset(owner, e, -2)

verify marked
    cget(marked(cnew(1, -1), 0, 3), 0) => 3
    cget(marked(cnew(1, 3), 0, 3), 0) => 3
    cget(marked(cnew(1, 3), 0, 4), 0) => -2

decision FrontierInWalkBack
    date = "2026-11-12"
    reason =
        "A pass after the walk back went over every expression again, to"
        "number it in the main block or its block, to put on the frontier"
        "each expression of the main block an expression of a block names,"
        "and the names and levels a block's expressions name. The walk"
        "back knows all but the numbers: an expression of the main block"
        "that a block's expression names is reached from two owners, one of"
        "them a block, so it is put on the frontier (-3) as it goes to the"
        "main block; a theorem's value is seeded with a code of its own,"
        "-5 - di, so that a value reached from the main block alone stays"
        "off it; and an expression met with a block as its owner puts its"
        "names and levels on the frontier then. The numbers are given as"
        "the last pass writes (NumberedAsWritten)."
    chosen = "FrontierInWalkBack"
    rejected = ["PassOfNumbers"]
    impacts = [valueCode, handOn, walkBack, walkBackAt, walkBlock, walkRecord]

fn handOn(owner: Vector<Vector<Num>>, c: Ix, o: Num) -> Vector<Vector<Num>>
    ? "Expression c reached from an expression of owner o, a block or the main block (-2), in the walk back: two owners make the main block, and the frontier (-3) once a block is one of them; a theorem's value reached from the main block is of the main block, off the frontier (FrontierInWalkBack)."
    x = nget(owner, c)
    match x.value == -1
        true -> nset(owner, c, o)
        false -> match x.value == o.value
            true -> owner
            false -> handOnOther(owner, c, o, x)

verify handOn
    cget(handOn(cnew(1, -1), ixAt(0), num(3)), 0) => 3
    cget(handOn(cnew(1, -2), ixAt(0), num(3)), 0) => -3
    cget(handOn(cnew(1, 3), ixAt(0), num(-2)), 0) => -3
    cget(handOn(cnew(1, -5), ixAt(0), num(-2)), 0) => -2
    cget(handOn(cnew(1, -5), ixAt(0), num(1)), 0) => -3

fn handOnOther(owner: Vector<Vector<Num>>, c: Ix, o: Num, x: Num) -> Vector<Vector<Num>>
    ? "c, of owner x, reached from o as well."
    match x.value <= -5
        true -> match o.value == -2
            true -> nset(owner, c, Num(value = -2))
            false -> match o.value == -5 - x.value
                true -> nset(owner, c, o)
                false -> nset(owner, c, Num(value = -3))
        false -> match x.value == -3
            true -> owner
            false -> nset(owner, c, Num(value = -3))

verify handOnOther
    cget(handOnOther(cnew(1, -5), ixAt(0), num(0), num(-5)), 0) => 0
    cget(handOnOther(cnew(1, -3), ixAt(0), num(0), num(-3)), 0) => -3

record F
    owner: Vector<Vector<Num>>
    nameF: Vector<Int>
    levelF: Vector<Int>

fn walkBack(b: Bytes, e: Ix, cs: Cols, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>) -> F
    ? "The second pass, from the last expression to the first: each hands its owner, final once it is met, to its parts, and one of a block puts its names and levels on the frontier; one no declaration reached goes to the main block (OwnersByOneWalkBack, FrontierInWalkBack)."
    match e.value < 0
        true -> F(owner = owner, nameF = nameF, levelF = levelF)
        false -> walkBackAt(b, e, cs, owner, nameF, levelF, nget(owner, e))

fn walkBackAt(b: Bytes, e: Ix, cs: Cols, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, o: Num) -> F
    ? "Expression e, of owner o: a block's, the main block's (on the frontier or not), a theorem's value or none yet."
    match o.value >= 0
        true -> walkBlock(b, e, cs, owner, nameF, levelF, o, nget(cs.kind, e))
        false -> match o.value == -1
            true -> walkBackAt(b, e, cs, nset(owner, e, Num(value = -2)), nameF, levelF, Num(value = -2))
            false -> match o.value >= -3
                true -> walkBack(b, ixStep(e.value - 1), cs, handedK(b, cs, e, owner, Num(value = -2), nget(cs.kind, e)), nameF, levelF)
                false -> walkBackAt(b, e, cs, nset(owner, e, numStep(-5 - o.value)), nameF, levelF, numStep(-5 - o.value))

fn walkBlock(b: Bytes, e: Ix, cs: Cols, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, o: Num, k: Num) -> F
    ? "Expression e of block o, of kind word k: its owner handed to its parts, its names and levels on the frontier; an application or a binder read from the columns (ExprColumns)."
    match Bits.and(k.value, 15)
        0 -> walkRecord(b, e, cs, owner, nameF, levelF, o, recordAt(k))
        1 -> walkBack(b, ixStep(e.value - 1), cs, handOn(handOn(owner, part(cs.c1, e), o), part(cs.c2, e), o), nameF, levelF)
        _ -> walkBack(b, ixStep(e.value - 1), cs, handOn(handOn(owner, part(cs.c1, e), o), part(cs.c2, e), o), wanted(nameF, Bits.shiftRight(k.value, 4)), levelF)

fn walkRecord(b: Bytes, e: Ix, cs: Cols, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, o: Num, p: Pos) -> F
    ? "Expression e of block o read from its record at p."
    match tagAt(b, p)
        8 -> walkBack(b, ixStep(e.value - 1), cs, owner, nameF, sortWanted(b, levelF, p))
        9 -> walkConst(b, e, cs, owner, nameF, levelF, rv(b, next1(p)))
        11 -> walkNamed(b, e, cs, owner, nameF, levelF, o, rv(b, next2(p)), 2)
        12 -> walkNamed(b, e, cs, owner, nameF, levelF, o, rv(b, next2(p)), 2)
        13 -> walkNamed(b, e, cs, owner, nameF, levelF, o, rv(b, next1(p)), 3)
        16 -> walkNamed(b, e, cs, owner, nameF, levelF, o, rv(b, next1(p)), 0)
        _ -> walkBack(b, ixStep(e.value - 1), cs, handed(b, p, e, owner, o), nameF, levelF)

verify walkRecord
    walkRecord(Bytes.fromList([9, 3, 1, 0]), ixAt(0), cols0(), cnew(1, 0), Vector.fromList([-2, -2, -2, -2]), Vector.fromList([-2]), num(0), at(0)).nameF => Vector.fromList([-2, -2, -2, -1])
    walkRecord(Bytes.fromList([9, 3, 1, 0]), ixAt(0), cols0(), cnew(1, 0), Vector.fromList([-2, -2, -2, -2]), Vector.fromList([-2]), num(0), at(0)).levelF => Vector.fromList([-1])

verify walkBlock
    walkBlock(Bytes.fromList([]), ixAt(2), cols2(34, 0, 1), cnew(3, -1), Vector.fromList([-2, -2, -2]), Vector.fromList([]), num(0), num(34)).nameF => Vector.fromList([-2, -2, -1])

fn walkConst(b: Bytes, e: Ix, cs: Cols, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, nm: At) -> F
    ? "A constant of a block: its name and its levels on the frontier."
    walkBack(b, ixStep(e.value - 1), cs, owner, wanted(nameF, nm.value), wantedList(b, levelF, rv(b, nm.at)))

fn walkNamed(b: Bytes, e: Ix, cs: Cols, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, o: Num, nm: At, parts: Int) -> F
    ? "A binder (2 parts), a let (3) or a projection (0, its field then its structure) of a block: its name on the frontier, its owner handed to its parts."
    walkBack(b, ixStep(e.value - 1), cs, namedParts(b, rv(b, nm.at), e, owner, o, parts), wanted(nameF, nm.value), levelF)

verify walkConst
    walkConst(Bytes.fromList([0]), ixAt(0), cols0(), cnew(1, 0), Vector.fromList([-2]), Vector.fromList([-2]), At(value = 0, at = at(0))).nameF => Vector.fromList([-1])

verify walkNamed
    cget(walkNamed(Bytes.fromList([0, 1]), ixAt(1), cols0(), cnew(2, -2), Vector.fromList([-2]), Vector.fromList([]), num(0), At(value = 0, at = at(0)), 0).owner, 0) => -3

fn namedParts(b: Bytes, x: At, e: Ix, owner: Vector<Vector<Num>>, o: Num, parts: Int) -> Vector<Vector<Num>>
    ? "The parts after a name: x is the first field after it."
    match parts
        2 -> two(b, x, e, owner, o)
        3 -> letParts(b, x, e, owner, o)
        _ -> one(rv(b, x.at), e, owner, o)

verify namedParts
    cget(namedParts(Bytes.fromList([1]), At(value = 1, at = at(0)), ixAt(1), cnew(1, -2), num(0), 0), 0) => -3
    cget(namedParts(Bytes.fromList([1]), At(value = 1, at = at(0)), ixAt(1), cnew(2, -1), num(4), 2), 0) => 4

fn handedK(b: Bytes, cs: Cols, e: Ix, owner: Vector<Vector<Num>>, o: Num, k: Num) -> Vector<Vector<Num>>
    ? "o handed to the parts of expression e of kind word k: read from its record, or from the columns (ExprColumns)."
    match Bits.and(k.value, 15) == 0
        true -> handed(b, recordAt(k), e, owner, o)
        false -> handOn(handOn(owner, part(cs.c1, e), o), part(cs.c2, e), o)

fn handed(b: Bytes, p: Pos, e: Ix, owner: Vector<Vector<Num>>, o: Num) -> Vector<Vector<Num>>
    ? "o handed to the parts of the expression record at p."
    match tagAt(b, p)
        10 -> two(b, rv(b, next1(p)), e, owner, o)
        11 -> two(b, rv(b, rv(b, next2(p)).at), e, owner, o)
        12 -> two(b, rv(b, rv(b, next2(p)).at), e, owner, o)
        13 -> letParts(b, rv(b, rv(b, next1(p)).at), e, owner, o)
        16 -> one(rv(b, rv(b, rv(b, next1(p)).at).at), e, owner, o)
        17 -> one(rv(b, next1(p)), e, owner, o)
        _ -> owner

fn one(x: At, e: Ix, owner: Vector<Vector<Num>>, o: Num) -> Vector<Vector<Num>>
    ? "One part."
    handOn(owner, back(e, x.value), o)

fn back(e: Ix, d: Int) -> Ix
    ? "The id d back from e, none when it is not one: d is read from the file, any size (IdsInRange)."
    ixAt(e.value - d)

verify back
    back(ixAt(5), 2).value => 3
    back(ixAt(5), 9).value => -1

fn two(b: Bytes, x: At, e: Ix, owner: Vector<Vector<Num>>, o: Num) -> Vector<Vector<Num>>
    ? "Two parts."
    y = rv(b, x.at)
    handOn(handOn(owner, back(e, x.value), o), back(e, y.value), o)

fn letParts(b: Bytes, x: At, e: Ix, owner: Vector<Vector<Num>>, o: Num) -> Vector<Vector<Num>>
    ? "A let's type, value and body."
    y = rv(b, x.at)
    z = rv(b, y.at)
    handOn(handOn(handOn(owner, back(e, x.value), o), back(e, y.value), o), back(e, z.value), o)

decision NumberedAsWritten
    date = "2026-11-12"
    reason =
        "Each expression's number in the main block or in its block is how"
        "many of that block's expressions come before it, which the last"
        "pass counts anyway as it writes them in order: the main block's"
        "next number, and each open block's count. So the number is set as"
        "the expression is written, in a current chunk filled in order, and"
        "an expression named later, always an earlier one, is read from"
        "there or from its chunk put in place; a theorem's block is"
        "complete before its declaration, so its count is the open block's."
    chosen = "NumberedAsWritten"
    rejected = ["PassOfNumbers"]
    impacts = [IdsW, idSet, idOf, mainExprOut, blockWritten, colBlock, declWritten]

record IdsW
    done: Vector<Vector<U32>>
    cur: Vector<U32>
    base: Ix

fn idsW(n: Int) -> Result<IdsW, String>
    ? "Room for n new numbers: the chunks to come, and the current one, from expression 0, filled in order."
    Result.Ok(IdsW(done = Vector.new(Int.div(n + 65535, 65536), noChunk32)?, cur = Vector.new(65536, nat32(0)), base = Ix(value = 0)))

verify idsW
    Result.withDefault(idsW(1), IdsW(done = Vector.fromList([]), cur = Vector.fromList([]), base = Ix(value = 0))).done == Vector.fromList([noChunk32]) => true

fn idSet(w: IdsW, e: Ix, v: Ix) -> IdsW
    ? "v as the number of e, the next one in order, set in the current chunk in place; a full chunk is put in its place (ChunkedNumbers, NumberedAsWritten)."
    j = Bits.and(e.value, 65535)
    w1 = IdsW.update(w, cur = Option.withDefault(Vector.set(w.cur, j, u32Step(v.value)), w.cur))
    match j == 65535
        true -> idsFlipped(w1, Int.div(e.value, 65536))
        false -> w1

verify idSet
    idOf(idSet(idSet(Result.withDefault(idsW(2), IdsW(done = Vector.fromList([]), cur = Vector.fromList([]), base = Ix(value = 0))), ixAt(0), ixAt(5)), ixAt(1), ixAt(7)), ixAt(1)) => 7

fn idsFlipped(w: IdsW, ci: Int) -> IdsW
    ? "The current chunk put in place as chunk ci, and a new one begun, each field on its own."
    w1 = IdsW.update(w, done = cput32(w.done, ci, w.cur))
    w2 = IdsW.update(w1, cur = Vector.new(65536, nat32(0)))
    IdsW.update(w2, base = ixStep((ci + 1) * 65536))

verify idsFlipped
    Vector.len(idsFlipped(IdsW(done = Vector.fromList([noChunk32]), cur = Vector.fromList([nat32(3)]), base = Ix(value = 0)), 0).cur) => 65536

fn idOf(w: IdsW, c: Ix) -> Int
    ? "The number of expression c, set before: in the current chunk, or in its chunk put in place (NumberedAsWritten)."
    match c.value >= w.base.value
        true -> match Vector.get(w.cur, c.value - w.base.value)
            Option.Some(u) -> u.value
            Option.None -> -1
        false -> uget(w.done, c)

verify idOf
    idOf(ids0(1), ixAt(0)) => 0
    idOf(ids0(1), ixAt(-1)) => -1

fn wanted(v: Vector<Int>, i: Int) -> Vector<Int>
    ? "Item i on the frontier."
    seti(v, i, -1)

fn wantedList(b: Bytes, v: Vector<Int>, n: At) -> Vector<Int>
    ? "Each of n levels on the frontier."
    match n.value <= 0
        true -> v
        false -> wantedLevels(b, v, n.at, n.value)

fn wantedLevels(b: Bytes, v: Vector<Int>, p: Pos, n: Int) -> Vector<Int>
    ? "n more levels."
    match n <= 0
        true -> v
        false -> wantedLevel(b, v, rv(b, p), n)

fn wantedLevel(b: Bytes, v: Vector<Int>, x: At, n: Int) -> Vector<Int>
    ? "One level read; the rest follow."
    wantedLevels(b, seti(v, x.value, -1), x.at, n - 1)

fn sortWanted(b: Bytes, levelF: Vector<Int>, p: Pos) -> Vector<Int>
    ? "A sort's level on the frontier."
    seti(levelF, rv(b, next1(p)).value, -1)

verify sortWanted
    geti(sortWanted(Bytes.fromList([8, 0]), Vector.fromList([-2]), at(0)), 0) => -1

record Acc
    out: List<Int>
    k: Ix
    mark: Int
    fine: Bool

record W
    main: List<Int>
    mainChunks: List<Bytes>
    mainBytes: Int
    proofs: Bytes
    proofChunks: List<Bytes>
    proofBytes: Int
    fN: Int
    fL: Int
    fE: Int
    nameId: Int
    levelId: Int
    ei: Ix
    di: Int
    mainNext: Ix
    lazy: Int
    open: Vector<Acc>
    ids: IdsW

fn zeroes(w: W, name: Bool, level: Bool) -> W
    ? "The anonymous name and the level zero have no records: when a block names them, their frontier entries open the main block, 1 back from names 1 and levels 1."
    match name
        true -> zeroLevel(W.update(w, main = List.prepend(1, List.prepend(0, List.prepend(19, w.main))), fN = 1), level)
        false -> zeroLevel(w, level)

verify zeroes
    zeroes(fresh(), true, true).main => [1, 1, 19, 1, 0, 19]
    zeroes(fresh(), false, false) => fresh()

fn zeroLevel(w: W, level: Bool) -> W
    ? "The level zero's frontier entry, when a block names it."
    match level
        true -> W.update(w, main = List.prepend(1, List.prepend(1, List.prepend(19, w.main))), fL = 1)
        false -> w

verify zeroLevel
    zeroLevel(fresh(), true).fL => 1

fn zeroed(v: Vector<Int>) -> Vector<Int>
    ? "Item 0 is frontier entry 0 when a block names it."
    match geti(v, 0) == -1
        true -> seti(v, 0, 0)
        false -> v

verify zeroed
    Vector.get(zeroed(Vector.fromList([-1])), 0) => Option.Some(0)
    Vector.get(zeroed(Vector.fromList([-2])), 0) => Option.Some(-2)

fn fresh() -> W
    ? "Nothing written yet; names and levels start at 1, after the implicit 0."
    W(main = [], mainChunks = [], mainBytes = 0, proofs = Bytes.fromList([]), proofChunks = [], proofBytes = 0, fN = 0, fL = 0, fE = 0, nameId = 1, levelId = 1, ei = Ix(value = 0), di = 0, mainNext = Ix(value = 0), lazy = 0, open = Vector.fromList([]), ids = ids0(0))

verify fresh
    fresh().nameId => 1

fn codes0() -> Codes
    ? "No place codes, for examples."
    Codes(names = Vector.fromList([]), nat = 0, str = [])

verify codes0
    codes0().nat => 0

fn cur0(next: Int) -> Cur
    ? "A cursor at 0, for examples."
    Cur(p = at(0), raw = at(0), pieces = [], names = [], skip = false, value = -1, next = next)

verify cur0
    cur0(3).next => 3

record Codes
    names: Vector<Int>
    nat: Int
    str: List<Int>

fn split(path: String) -> Result<String, String>
    ? "Reads the Susz file of version 0 at path and writes it again as version 2."
    ! [Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.appendBytes]
    size = Disk.size(path)?
    l = laidFrom(Disk.readBytesAt(path, 0, size)?)?
    _ = appendAll(path, List.concat(l.mains, l.proofs), l.hd)?
    Result.Ok(l.message)

fn image(b: Bytes) -> Result<Image, String>
    ? "The Susz bytes of version 0 in b as an image of version 2 in memory, its two runs joined (BytesFromFileOrMemory in Export.Susz): the header and the main block, then the proof section and the trailer. What the split builds is freed before the runs are joined."
    imageOf(laidFrom(b)?)

fn imageOf(l: Laid) -> Result<Image, String>
    ? "A file laid out as version 2, as an image in memory: the header and the main block, then the proof section and the trailer."
    Result.Ok(Image(front = joinAll(List.prepend(l.hd, l.mains)), back = joinAll(l.proofs)))

fn written2(path: String, l: Laid) -> Result<String, String>
    ? "A file laid out as version 2, written to path; the counts it holds."
    ! [Disk.writeBytes, Disk.appendBytes]
    _ = appendAll(path, List.concat(l.mains, l.proofs), l.hd)?
    Result.Ok(l.message)

fn joinAll(bs: List<Bytes>) -> Bytes
    ? "The bytes one after another, joined two by two in rounds, so that each byte is copied once a round, as many rounds as halvings of the count."
    match bs
        [] -> Bytes.fromList([])
        [b] -> b
        _ -> joinAll(pairs(bs, []))

verify joinAll
    joinAll([Bytes.fromList([1]), Bytes.fromList([2, 3]), Bytes.fromList([4])]) => Bytes.fromList([1, 2, 3, 4])
    joinAll([]) => Bytes.fromList([])

fn pairs(bs: List<Bytes>, acc: List<Bytes>) -> List<Bytes>
    ? "Each two neighbours joined; one left over kept."
    match bs
        [] -> List.reverse(acc)
        [a] -> List.reverse(List.prepend(a, acc))
        [a, b, ..rest] -> pairs(rest, List.prepend(Bytes.concat(a, b), acc))

verify pairs
    pairs([Bytes.fromList([1]), Bytes.fromList([2]), Bytes.fromList([3])], []) => [Bytes.fromList([1, 2]), Bytes.fromList([3])]

record Laid
    hd: Bytes
    mains: List<Bytes>
    proofs: List<Bytes>
    message: String

fn laidFrom(b: Bytes) -> Result<Laid, String>
    ? "The bytes of version 0 laid out as version 2."
    size = Bytes.len(b)
    tl = u32At(b, size - 8)
    match Bool.and(tl == 60, size >= 68)
        false -> Result.Err("not a Susz file of version 0")
        true -> withV0(b, Bytes.drop(b, size - 60))

verify laidFrom
    laidFrom(Bytes.fromList([])) => Result.Err("not a Susz file of version 0")

fn withV0(b: Bytes, tr: Bytes) -> Result<Laid, String>
    ? "The counts and the one block of version 0; the passes' tables are freed when it returns."
    names = u32At(tr, 0)
    exprs = u32At(tr, 8)
    decls = u32At(tr, 12)
    base = u64At(tr, 20)
    len = u64At(tr, 28)
    nv = Vector.new(names, Core.Names.anon())?
    a = scanned(b, at(base), at(base + len), 0, 0, 1, cnew(exprs, 0), cnew(exprs, -1), nv, {})
    laidAfter(b, base, base + len, names, u32At(tr, 4), decls, exprs, a)

fn laidAfter(b: Bytes, base: Int, end: Int, names: Int, levels: Int, decls: Int, exprs: Int, a: A) -> Result<Laid, String>
    ? "The passes after the first, from what the first found in b, the records of version 0 from base to end, of these counts (OneStepPack in Export.Pack): owners and the frontier handed back, then the writing, which numbers (FrontierInWalkBack, NumberedAsWritten)."
    cs = Cols(kind = a.eoff, c1 = a.c1, c2 = a.c2)
    f = walkBack(b, ixAt(a.exprs - 1), cs, a.owner, Vector.new(names, -2)?, Vector.new(levels, -2)?)
    codes = Codes(names = Vector.fromList(codesOf(a.known, List.fromVector(a.names), [])), nat = codeIn(a.known, Core.Names.str(Core.Names.anon(), "Nat")), str = codesOf(a.known, litNames, []))
    w = written(b, at(base), at(end), zeroes(W.update(fresh(), open = Vector.new(decls, acc0())?, ids = idsW(a.exprs)?), geti(f.nameF, 0) == -1, geti(f.levelF, 0) == -1), f.owner, zeroed(f.nameF), zeroed(f.levelF), codes, cs)?
    laid(Bytes.take(Bytes.drop(b, 8), base - 8), names, levels, decls, exprs, w)

litNames: List<Name> = [Core.Names.str(Core.Names.anon(), "Nat"), Core.Names.str(Core.Names.anon(), "String"), Core.Names.str(Core.Names.str(Core.Names.anon(), "String"), "ofList"), Core.Names.str(Core.Names.anon(), "List"), Core.Names.str(Core.Names.anon(), "Char"), Core.Names.str(Core.Names.str(Core.Names.anon(), "Char"), "ofNat")]

fn codesOf(known: Map<Name, Int>, ns: List<Name>, acc: List<Int>) -> List<Int>
    ? "The place code of each name, in order (PlaceCodes)."
    match ns
        [] -> List.reverse(acc)
        [n, ..rest] -> codesOf(known, rest, List.prepend(codeIn(known, n), acc))

fn codeIn(known: Map<Name, Int>, n: Name) -> Int
    ? "n's place code, or never."
    Option.withDefault(Map.get(known, n), Core.Lazy.never())

fn laid(meta: Bytes, names: Int, levels: Int, decls: Int, exprs: Int, w: W) -> Result<Laid, String>
    ? "The file's parts: header, main block, proof section, trailer."
    hd = Bytes.concat(Bytes.fromList([83, 85, 83, 90, 2, 0, 0, 0]), meta)
    ws = flushProofs(flushMain(w)?)?
    moff = Bytes.len(hd)
    t = u64(u64(u64(u64(u32(u32(u32(u32([], names), levels), ws.mainNext.value), decls), moff), ws.mainBytes), moff + ws.mainBytes), ws.proofBytes)
    tr = Bytes.fromList(List.reverse(List.prepend(83, List.prepend(85, List.prepend(83, List.prepend(90, u32(t, 56)))))))?
    Result.Ok(Laid(hd = hd, mains = List.reverse(ws.mainChunks), proofs = List.concat(List.reverse(ws.proofChunks), [tr]), message = "names {names - 1}, levels {levels - 1}, expressions {exprs} ({ws.mainNext.value} in the main block, {exprs - ws.mainNext.value} in {ws.lazy} proof blocks), declarations {decls}, frontier {ws.fN} names, {ws.fL} levels, {ws.fE} expressions, {moff + ws.mainBytes + ws.proofBytes + 56} bytes"))

fn appendAll(path: String, cs: List<Bytes>, hd: Bytes) -> Result<Unit, String>
    ? "The header written, then each chunk appended."
    ! [Disk.writeBytes, Disk.appendBytes]
    match Disk.writeBytes(path, hd)
        Result.Err(e) -> Result.Err("cannot write {path}: {e}")
        Result.Ok(_) -> appended(path, cs)

fn appended(path: String, cs: List<Bytes>) -> Result<Unit, String>
    ? "Each chunk appended."
    ! [Disk.appendBytes]
    match cs
        [] -> Result.Ok(Unit)
        [c, ..rest] -> match Disk.appendBytes(path, c)
            Result.Err(e) -> Result.Err("cannot write {path}: {e}")
            Result.Ok(_) -> appended(path, rest)

fn flushMain(w: W) -> Result<W, String>
    ? "The main block's bytes so far, as a chunk."
    match List.len(w.main) == 0
        true -> Result.Ok(w)
        false -> mainChunked(w, Bytes.fromList(List.reverse(w.main))?)

fn mainChunked(w: W, c: Bytes) -> Result<W, String>
    ? "c, the main block's bytes so far, kept as a chunk."
    Result.Ok(W.update(w, main = [], mainChunks = List.prepend(c, w.mainChunks), mainBytes = w.mainBytes + Bytes.len(c)))

verify mainChunked
    Result.withDefault(mainChunked(fresh(), Bytes.fromList([1, 2])), fresh()).mainBytes => 2

fn flushProofs(w: W) -> Result<W, String>
    ? "The proof section's bytes so far, as a chunk."
    match Bytes.len(w.proofs) == 0
        true -> Result.Ok(w)
        false -> proofsChunked(w, w.proofs)

fn proofsChunked(w: W, c: Bytes) -> Result<W, String>
    ? "c, the proof section's bytes so far, kept as a chunk."
    Result.Ok(W.update(w, proofs = Bytes.fromList([]), proofChunks = List.prepend(c, w.proofChunks), proofBytes = w.proofBytes + Bytes.len(c)))

verify proofsChunked
    Result.withDefault(proofsChunked(fresh(), Bytes.fromList([1, 2])), fresh()).proofBytes => 2

fn chunkLimit() -> Int
    ? "Bytes of the main block, or of the proof section, gathered as a list before they become a chunk; List.len is a field of the list, so it is asked after every record, a run of expressions of the columns being one: where a chunk ends changes no byte written."
    1048576

verify chunkLimit
    chunkLimit() > 0 => true

fn flushedIf(w: W) -> Result<W, String>
    ? "Chunks made once the lists are long."
    match List.len(w.main) >= chunkLimit()
        true -> proofsFlushedIf(flushMain(w)?)
        false -> proofsFlushedIf(w)

fn proofsFlushedIf(w: W) -> Result<W, String>
    ? "The proof section's chunk made once its list is long."
    match Bytes.len(w.proofs) >= chunkLimit()
        true -> flushProofs(w)
        false -> Result.Ok(w)

fn mainOut(w: W, out: List<Int>) -> W
    ? "The main block's list now out, one record longer."
    W.update(w, main = out)

fn blockLength(open: Vector<Acc>, di: Int) -> Int
    ? "How many expressions the block of declaration di holds so far."
    match Vector.get(open, di)
        Option.Some(a) -> a.k.value
        Option.None -> 0

verify blockLength
    blockLength(Vector.fromList([acc0()]), 0) => 0

fn mainExprOut(w: W, out: List<Int>) -> W
    ? "The main block's list now out, one expression longer, and that expression numbered the next of the main block (NumberedAsWritten)."
    w1 = W.update(w, main = out)
    W.update(w1, ids = idSet(w1.ids, w1.ei, w1.mainNext))

verify mainExprOut
    idOf(mainExprOut(W.update(fresh(), ids = ids0(1), mainNext = ixAt(3)), []).ids, ixAt(0)) => 3


fn written(b: Bytes, p: Pos, end: Pos, w: W, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, codes: Codes, cs: Cols) -> Result<W, String>
    ? "The last pass: each record of version 0 written into the main block or its block; a record at none ran past the block (ReadAsTheReaderReads)."
    match off(p) < 0
        true -> Result.Err("record {w.ei.value + w.di + w.nameId + w.levelId - 1}: the block ends inside it")
        false -> match off(p) >= off(end)
            true -> Result.Ok(w)
            false -> writtenAt(b, p, end, flushedIf(w)?, owner, nameF, levelF, codes, cs, tagAt(b, p))

fn writtenAt(b: Bytes, p: Pos, end: Pos, w: W, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, codes: Codes, cs: Cols, tag: Int) -> Result<W, String>
    ? "One record by its tag. An expression record is read once, by the function that writes it, which says where it ends (WrittenAsRead)."
    match tag
        20 -> colsRun(b, rv(b, next1(p)), end, w, owner, nameF, levelF, codes, cs)
        18 -> declWritten(b, end, w, owner, nameF, levelF, codes, cs, declOf(b, next1(p), w.ei.value))
        _ -> match tag <= 2
            true -> nameWritten(b, skipRecord(b, p), end, W.update(w, main = copied(w.main, b, p, skipRecord(b, p))), owner, nameF, levelF, codes, cs, geti(nameF, w.nameId))
            false -> match tag <= 6
                true -> levelWritten(b, skipRecord(b, p), end, W.update(w, main = copied(w.main, b, p, skipRecord(b, p))), owner, nameF, levelF, codes, cs, geti(levelF, w.levelId))
                false -> exprWritten(b, p, end, w, owner, nameF, levelF, codes, cs, nget(owner, w.ei))

fn nameWritten(b: Bytes, q: Pos, end: Pos, w: W, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, codes: Codes, cs: Cols, f: Int) -> Result<W, String>
    ? "A name, then its frontier entry when a block names it."
    match f == -1
        true -> written(b, q, end, W.update(w, main = List.prepend(1, List.prepend(0, List.prepend(19, w.main))), fN = w.fN + 1, nameId = w.nameId + 1), owner, seti(nameF, w.nameId, w.fN), levelF, codes, cs)
        false -> written(b, q, end, W.update(w, nameId = w.nameId + 1), owner, nameF, levelF, codes, cs)

fn levelWritten(b: Bytes, q: Pos, end: Pos, w: W, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, codes: Codes, cs: Cols, f: Int) -> Result<W, String>
    ? "A level, then its frontier entry when a block names it."
    match f == -1
        true -> written(b, q, end, W.update(w, main = List.prepend(1, List.prepend(1, List.prepend(19, w.main))), fL = w.fL + 1, levelId = w.levelId + 1), owner, nameF, seti(levelF, w.levelId, w.fL), codes, cs)
        false -> written(b, q, end, W.update(w, levelId = w.levelId + 1), owner, nameF, levelF, codes, cs)

fn exprWritten(b: Bytes, p: Pos, end: Pos, w: W, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, codes: Codes, cs: Cols, o: Num) -> Result<W, String>
    ? "An expression: into the main block, with its frontier entry when a block names it (-3), or into its owner's block."
    match o.value >= 0
        true -> blockDone(b, end, blockWritten(b, p, w, owner, nameF, levelF, codes, cs, o), owner, nameF, levelF, codes, cs)
        false -> mainDone(b, end, w, mainExpr(b, p, w.ei, w.mainNext, w.ids, w.main), owner, nameF, levelF, codes, cs, o)

fn blockDone(b: Bytes, end: Pos, bw: BW, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, codes: Codes, cs: Cols) -> Result<W, String>
    ? "On after an expression of a block, from where its record ended."
    written(b, bw.at, end, W.update(bw.w, ei = ixStep(bw.w.ei.value + 1)), owner, nameF, levelF, codes, cs)

fn mainDone(b: Bytes, end: Pos, w: W, r: RA, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, codes: Codes, cs: Cols, o: Num) -> Result<W, String>
    ? "On after a main expression, from where its record ended."
    mainExprWritten(b, r.at, end, mainExprOut(w, r.out), owner, nameF, levelF, codes, cs, o)

decision WrittenAsRead
    date = "2026-11-11"
    reason =
        "The last pass found where each record ends by reading it past"
        "(skipRecord), and then read it again to write it. An expression is"
        "now read once: the functions that write its fields give back where"
        "they stopped, which is where the next record starts."
    chosen = "WrittenAsRead"
    rejected = ["SkippedThenWritten"]
    impacts = [writtenAt, exprWritten, mainExpr, blockExpr]

record RA
    out: List<Int>
    at: Pos

record BW
    w: W
    at: Pos

fn mainExprWritten(b: Bytes, q: Pos, end: Pos, w: W, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, codes: Codes, cs: Cols, o: Num) -> Result<W, String>
    ? "After a main expression: its frontier entry, the frontier index kept in its owner as -(index + 4)."
    match o.value == -3
        true -> written(b, q, end, W.update(w, main = List.prepend(1, List.prepend(2, List.prepend(19, w.main))), fE = w.fE + 1, ei = ixStep(w.ei.value + 1), mainNext = ixStep(w.mainNext.value + 1)), nset(owner, w.ei, num(0 - w.fE - 4)), nameF, levelF, codes, cs)
        false -> written(b, q, end, W.update(w, ei = ixStep(w.ei.value + 1), mainNext = ixStep(w.mainNext.value + 1)), owner, nameF, levelF, codes, cs)

fn mainRef(acc: List<Int>, e: Ix, d: Int, next: Ix, ids: IdsW) -> List<Int>
    ? "A reference d back from expression e, as how far back its main number is from next."
    uwn(acc, numStep(next.value - idOf(ids, back(e, d))))

fn mainExpr(b: Bytes, p: Pos, e: Ix, next: Ix, ids: IdsW, acc: List<Int>) -> RA
    ? "The expression record at p in the main block: only references change."
    match tagAt(b, p)
        10 -> mainRefs(b, next1(p), 2, e, next, ids, List.prepend(10, acc))
        11 -> mainCopied(b, p, rv(b, next2(p)).at, 2, e, next, ids, acc)
        12 -> mainCopied(b, p, rv(b, next2(p)).at, 2, e, next, ids, acc)
        13 -> mainCopied(b, p, rv(b, next1(p)).at, 3, e, next, ids, acc)
        16 -> mainCopied(b, p, skipN(b, next1(p), 2), 1, e, next, ids, acc)
        17 -> mainRefs(b, next1(p), 1, e, next, ids, List.prepend(17, acc))
        _ -> copiedTo(acc, b, p, skipRecord(b, p))

fn copiedTo(acc: List<Int>, b: Bytes, p: Pos, q: Pos) -> RA
    ? "Bytes p to q copied, and q."
    RA(out = copied(acc, b, p, q), at = q)

verify copiedTo
    copiedTo([], Bytes.fromList([7, 1]), at(0), at(2)) => RA(out = [1, 7], at = at(2))

fn mainCopied(b: Bytes, p: Pos, q: Pos, n: Int, e: Ix, next: Ix, ids: IdsW, acc: List<Int>) -> RA
    ? "The record's bytes from p to q copied, then its n references at q."
    mainRefs(b, q, n, e, next, ids, copied(acc, b, p, q))

fn mainRefs(b: Bytes, p: Pos, n: Int, e: Ix, next: Ix, ids: IdsW, acc: List<Int>) -> RA
    ? "n references at p, and where they end."
    match n <= 0
        true -> RA(out = acc, at = p)
        false -> mainRefAt(b, rv(b, p), n, e, next, ids, acc)

fn mainRefAt(b: Bytes, x: At, n: Int, e: Ix, next: Ix, ids: IdsW, acc: List<Int>) -> RA
    ? "One reference read; the rest follow."
    mainRefs(b, x.at, n - 1, e, next, ids, mainRef(acc, e, x.value, next, ids))

fn blockWritten(b: Bytes, p: Pos, w: W, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, codes: Codes, cs: Cols, o: Num) -> BW
    ? "An expression of o's block, after a mark when it stood before a later declaration than the block's last record."
    a1 = markedAt(Option.withDefault(Vector.get(w.open, o.value), acc0()), w.di)
    r = blockExpr(b, p, w.ei, o, a1.k, owner, w.ids, nameF, levelF, codes, a1.mark, a1.out)
    w1 = W.update(w, open = Option.withDefault(Vector.set(w.open, o.value, Acc(out = r.out, k = ixStep(a1.k.value + 1), mark = a1.mark, fine = Bool.and(a1.fine, r.fine))), w.open))
    BW(w = W.update(w1, ids = idSet(w1.ids, w1.ei, a1.k)), at = r.at)

fn colsRun(b: Bytes, n: At, end: Pos, w: W, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, codes: Codes, cs: Cols) -> Result<W, String>
    ? "A run record: the next n.value expressions are in the columns (ExprColumns); the records go on after it."
    colsWritten(b, n.at, n.value, end, w, owner, nameF, levelF, codes, cs)

fn colsWritten(b: Bytes, q: Pos, left: Int, end: Pos, w: W, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, codes: Codes, cs: Cols) -> Result<W, String>
    ? "left more expressions of the columns written, each into the main block or its block, then the records from q."
    match left <= 0
        true -> written(b, q, end, w, owner, nameF, levelF, codes, cs)
        false -> colWritten(b, q, left, end, w, owner, nameF, levelF, codes, cs)

fn colWritten(b: Bytes, q: Pos, left: Int, end: Pos, w: W, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, codes: Codes, cs: Cols) -> Result<W, String>
    ? "One expression of the columns, by its owner."
    o = nget(owner, w.ei)
    k = nget(cs.kind, w.ei)
    c1 = part(cs.c1, w.ei)
    c2 = part(cs.c2, w.ei)
    match o.value >= 0
        true -> colsWritten(b, q, left - 1, end, colBlock(w, owner, nameF, o, k, c1, c2), owner, nameF, levelF, codes, cs)
        false -> colMainDone(b, q, left, end, mainExprOut(w, colMain(w.main, k, c1, c2, w.mainNext, w.ids)), owner, nameF, levelF, codes, cs, o)

fn colMainDone(b: Bytes, q: Pos, left: Int, end: Pos, w: W, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, codes: Codes, cs: Cols, o: Num) -> Result<W, String>
    ? "After a main expression of the columns: its frontier entry, as mainExprWritten."
    match o.value == -3
        true -> colFrontier(b, q, left, end, nset(owner, w.ei, num(0 - w.fE - 4)), w, nameF, levelF, codes, cs)
        false -> colsWritten(b, q, left - 1, end, W.update(w, ei = ixStep(w.ei.value + 1), mainNext = ixStep(w.mainNext.value + 1)), owner, nameF, levelF, codes, cs)

fn colFrontier(b: Bytes, q: Pos, left: Int, end: Pos, owner: Vector<Vector<Num>>, w: W, nameF: Vector<Int>, levelF: Vector<Int>, codes: Codes, cs: Cols) -> Result<W, String>
    ? "The frontier entry of a main expression of the columns, its owner already set to its index."
    colsWritten(b, q, left - 1, end, W.update(w, main = List.prepend(1, List.prepend(2, List.prepend(19, w.main))), fE = w.fE + 1, ei = ixStep(w.ei.value + 1), mainNext = ixStep(w.mainNext.value + 1)), owner, nameF, levelF, codes, cs)

verify colFrontier
    Result.withDefault(colFrontier(Bytes.fromList([]), at(0), 1, at(0), cnew(1, -2), fresh(), Vector.fromList([]), Vector.fromList([]), codes0(), cols0()), fresh()).fE => 1

fn colHead(acc: List<Int>, k: Num) -> List<Int>
    ? "The tag of kind word k, and a binder's annotation byte."
    code = Bits.and(k.value, 15)
    match code == 1
        true -> List.prepend(10, acc)
        false -> match code <= 5
            true -> List.prepend(code - 2, List.prepend(11, acc))
            false -> List.prepend(code - 6, List.prepend(12, acc))

verify colHead
    colHead([], num(1)) => [10]
    colHead([], num(3)) => [1, 11]
    colHead([], num(9)) => [3, 12]

fn colMain(acc: List<Int>, k: Num, c1: Ix, c2: Ix, next: Ix, ids: IdsW) -> List<Int>
    ? "An expression of the columns in the main block: its name as it is, its parts by how far back their main numbers are from next."
    h = match Bits.and(k.value, 15) == 1
        true -> colHead(acc, k)
        false -> uwn(colHead(acc, k), numStep(Bits.shiftRight(k.value, 4)))
    uwn(uwn(h, numStep(next.value - idOf(ids, c1))), numStep(next.value - idOf(ids, c2)))

verify colMain
    colMain([], num(1), ixAt(0), ixAt(0), ixAt(1), ids0(1)) => [1, 1, 10]
    colMain([], num(34), ixAt(0), ixAt(0), ixAt(1), ids0(1)) => [1, 1, 2, 0, 11]

fn colBlock(w: W, owner: Vector<Vector<Num>>, nameF: Vector<Int>, o: Num, k: Num, c1: Ix, c2: Ix) -> W
    ? "An expression of the columns into o's block, after a mark when it stood before a later declaration than the block's last record, as blockWritten; numbered the block's next (NumberedAsWritten)."
    a1 = markedAt(Option.withDefault(Vector.get(w.open, o.value), acc0()), w.di)
    out = colBlockOut(a1.out, k, c1, c2, o, a1.k, owner, w.ids, nameF)
    w1 = W.update(w, open = Option.withDefault(Vector.set(w.open, o.value, Acc(out = out, k = ixStep(a1.k.value + 1), mark = a1.mark, fine = a1.fine)), w.open))
    w2 = W.update(w1, ids = idSet(w1.ids, w1.ei, a1.k))
    W.update(w2, ei = ixStep(w2.ei.value + 1))

fn colBlockOut(acc: List<Int>, k: Num, c1: Ix, c2: Ix, o: Num, n: Ix, owner: Vector<Vector<Num>>, ids: IdsW, nameF: Vector<Int>) -> List<Int>
    ? "An expression of the columns in its block: the name by its frontier number, the parts by the block's own numbers and the frontier's."
    h = match Bits.and(k.value, 15) == 1
        true -> colHead(acc, k)
        false -> uv(colHead(acc, k), geti(nameF, Bits.shiftRight(k.value, 4)))
    blockRefC(blockRefC(h, c1, o, n, owner, ids), c2, o, n, owner, ids)

fn blockRefC(acc: List<Int>, c: Ix, o: Num, k: Ix, owner: Vector<Vector<Num>>, ids: IdsW) -> List<Int>
    ? "A reference to expression c from number k of o's block: back among the block's own, else past them into the frontier."
    oc = nget(owner, c)
    match oc.value == o.value
        true -> uwn(acc, numStep(k.value - idOf(ids, c)))
        false -> uwn(acc, numStep(k.value + 1 + (0 - oc.value - 4)))

verify blockRefC
    blockRefC([], ixAt(0), num(0), ixAt(1), cnew(1, 0), ids0(1)) => [1]
    blockRefC([], ixAt(0), num(0), ixAt(1), cnew(1, -4), ids0(1)) => [2]

fn acc0() -> Acc
    ? "A block not yet begun."
    Acc(out = [], k = Ix(value = 0), mark = 0, fine = true)

verify acc0
    acc0().k.value => 0

fn markedAt(a: Acc, di: Int) -> Acc
    ? "A mark record first when the block's last mark is not di."
    match a.mark == di
        true -> a
        false -> Acc.update(a, out = uv(List.prepend(19, a.out), di), mark = di)

verify markedAt
    markedAt(Acc(out = [], k = Ix(value = 0), mark = 0, fine = true), 3).out => [3, 19]

record BE
    out: List<Int>
    fine: Bool
    at: Pos

fn blockRef(acc: List<Int>, e: Ix, d: Int, o: Num, k: Ix, owner: Vector<Vector<Num>>, ids: IdsW) -> List<Int>
    ? "A reference d back from expression e, number k of o's block: as blockRefC."
    blockRefC(acc, back(e, d), o, k, owner, ids)

fn blockRefs(b: Bytes, p: Pos, n: Int, e: Ix, o: Num, k: Ix, owner: Vector<Vector<Num>>, ids: IdsW, acc: List<Int>) -> RA
    ? "n references at p, and where they end."
    match n <= 0
        true -> RA(out = acc, at = p)
        false -> blockRefAt(b, rv(b, p), n, e, o, k, owner, ids, acc)

fn blockRefAt(b: Bytes, x: At, n: Int, e: Ix, o: Num, k: Ix, owner: Vector<Vector<Num>>, ids: IdsW, acc: List<Int>) -> RA
    ? "One reference read; the rest follow."
    blockRefs(b, x.at, n - 1, e, o, k, owner, ids, blockRef(acc, e, x.value, o, k, owner, ids))

fn blockExpr(b: Bytes, p: Pos, e: Ix, o: Num, k: Ix, owner: Vector<Vector<Num>>, ids: IdsW, nameF: Vector<Int>, levelF: Vector<Int>, codes: Codes, mark: Int, acc: List<Int>) -> BE
    ? "The expression record at p in its block: references, names and levels by the block's own numbers and the frontier's; a constant, projection or literal says whether its names are placed before mark (PlaceCodes)."
    match tagAt(b, p)
        10 -> fineRA(blockRefs(b, next1(p), 2, e, o, k, owner, ids, List.prepend(10, acc)), true)
        11 -> fineRA(blockNamed(b, rv(b, next2(p)), 2, e, o, k, owner, ids, nameF, List.prepend(tagAt(b, next1(p)), List.prepend(11, acc))), true)
        12 -> fineRA(blockNamed(b, rv(b, next2(p)), 2, e, o, k, owner, ids, nameF, List.prepend(tagAt(b, next1(p)), List.prepend(12, acc))), true)
        7 -> fineRA(copiedTo(acc, b, p, skipRecord(b, p)), true)
        8 -> sortBlock(b, rv(b, next1(p)), levelF, acc)
        9 -> constBlock(b, p, nameF, levelF, codes, mark, acc)
        13 -> fineRA(blockNamed(b, rv(b, next1(p)), 3, e, o, k, owner, ids, nameF, List.prepend(13, acc)), true)
        14 -> fineRA(copiedTo(acc, b, p, skipRecord(b, p)), Core.Lazy.placedFor(codes.nat, mark))
        15 -> fineRA(copiedTo(acc, b, p, skipRecord(b, p)), allPlaced(codes.str, mark))
        16 -> projBlock(b, p, e, o, k, owner, ids, nameF, codes, mark, acc)
        _ -> fineRA(blockRefs(b, next1(p), 1, e, o, k, owner, ids, List.prepend(17, acc)), true)

fn fineRA(r: RA, fine: Bool) -> BE
    ? "A block's record written, with whether its names are placed."
    BE(out = r.out, fine = fine, at = r.at)

verify fineRA
    fineRA(RA(out = [1], at = at(2)), true) => BE(out = [1], fine = true, at = at(2))

fn sortBlock(b: Bytes, l: At, levelF: Vector<Int>, acc: List<Int>) -> BE
    ? "A sort: its level by its frontier number."
    BE(out = uv(List.prepend(8, acc), geti(levelF, l.value)), fine = true, at = l.at)

verify sortBlock
    sortBlock(Bytes.fromList([]), At(value = 0, at = at(2)), Vector.fromList([5]), []) => BE(out = [5, 8], fine = true, at = at(2))

fn blockNamed(b: Bytes, nm: At, n: Int, e: Ix, o: Num, k: Ix, owner: Vector<Vector<Num>>, ids: IdsW, nameF: Vector<Int>, acc: List<Int>) -> RA
    ? "A binder's or a let's name by its frontier number, then its n references."
    blockRefs(b, nm.at, n, e, o, k, owner, ids, uv(acc, geti(nameF, nm.value)))

fn allPlaced(cs: List<Int>, mark: Int) -> Bool
    ? "Every code placed before mark."
    match cs
        [] -> true
        [c, ..rest] -> Bool.and(Core.Lazy.placedFor(c, mark), allPlaced(rest, mark))

verify allPlaced
    allPlaced([0], 1) => true

fn constBlock(b: Bytes, p: Pos, nameF: Vector<Int>, levelF: Vector<Int>, codes: Codes, mark: Int, acc: List<Int>) -> BE
    ? "A constant: its frontier name and levels."
    n = rv(b, next1(p))
    k = rv(b, n.at)
    fineRA(levelsOut(b, k.at, k.value, levelF, uv(uv(List.prepend(9, acc), geti(nameF, n.value)), k.value)), Core.Lazy.placedFor(geti(codes.names, n.value), mark))

fn levelsOut(b: Bytes, p: Pos, n: Int, levelF: Vector<Int>, acc: List<Int>) -> RA
    ? "n levels by their frontier numbers, and where they end."
    match n <= 0
        true -> RA(out = acc, at = p)
        false -> levelOut(b, rv(b, p), n, levelF, acc)

fn levelOut(b: Bytes, x: At, n: Int, levelF: Vector<Int>, acc: List<Int>) -> RA
    ? "One level read; the rest follow."
    levelsOut(b, x.at, n - 1, levelF, uv(acc, geti(levelF, x.value)))

fn projBlock(b: Bytes, p: Pos, e: Ix, o: Num, k: Ix, owner: Vector<Vector<Num>>, ids: IdsW, nameF: Vector<Int>, codes: Codes, mark: Int, acc: List<Int>) -> BE
    ? "A projection: its frontier name, its field, its structure."
    n = rv(b, next1(p))
    i = rv(b, n.at)
    fineRA(blockRefs(b, i.at, 1, e, o, k, owner, ids, uv(uv(List.prepend(16, acc), geti(nameF, n.value)), i.value)), Core.Lazy.placedFor(geti(codes.names, n.value), mark))

fn declWritten(b: Bytes, end: Pos, w: W, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, codes: Codes, cs: Cols, d: DeclP) -> Result<W, String>
    ? "A declaration, its references by main numbers; a theorem whose value has a block becomes kind 6, its block taken into the proof section."
    match blockLength(w.open, w.di) > 0
        true -> lazyWritten(b, end, w, owner, nameF, levelF, codes, cs, d, Vector.get(w.open, w.di))
        false -> written(b, d.end, end, W.update(mainOut(w, declPieces(b, d.pieces, w.ei, w.mainNext, w.ids, -1, 0, false, List.prepend(d.kind, List.prepend(18, w.main)))), di = w.di + 1), owner, nameF, levelF, codes, cs)

fn lazyWritten(b: Bytes, end: Pos, w: W, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, codes: Codes, cs: Cols, d: DeclP, a: Option<Acc>) -> Result<W, String>
    ? "Kind 6: head, the block's length, whether its names are placed, group; the block, its count first, goes to the proof section."
    match a
        Option.None -> Result.Err("declaration {w.di}: its block is missing")
        Option.Some(x) -> lazyOut(b, end, w, owner, nameF, levelF, codes, cs, d, x, x.k.value)

fn lazyOut(b: Bytes, end: Pos, w: W, owner: Vector<Vector<Num>>, nameF: Vector<Int>, levelF: Vector<Int>, codes: Codes, cs: Cols, d: DeclP, x: Acc, n: Int) -> Result<W, String>
    ? "The theorem and its block written."
    blen = uvLen(n) + List.len(x.out)
    m = declPieces(b, d.pieces, w.ei, w.mainNext, w.ids, d.value, blen, x.fine, List.prepend(6, List.prepend(18, w.main)))
    blk = Bytes.fromList(List.reverse(x.out))?
    cnt = Bytes.fromList(List.reverse(uv([], n)))?
    w1 = W.update(w, proofs = Bytes.concat(Bytes.concat(w.proofs, cnt), blk))
    w2 = W.update(w1, main = m, open = Option.withDefault(Vector.set(w1.open, w1.di, acc0()), w1.open), di = w1.di + 1, lazy = w1.lazy + 1)
    written(b, d.end, end, w2, owner, nameF, levelF, codes, cs)

decision BlocksAsBytes
    date = "2026-11-12"
    reason =
        "A finished block was put onto the proof section's list of octets"
        "with List.concat, every octet of it read and pushed once more. It is"
        "now made bytes at once (its octets reversed where they lie) and"
        "appended, with its count, to the bytes of the proof section's"
        "current chunk, which has one owner and grows in place."
    chosen = "BlocksAsBytes"
    rejected = ["BlocksConcatenated"]
    impacts = [lazyOut, W, flushProofs]

fn declPieces(b: Bytes, ps: List<Piece>, e: Ix, next: Ix, ids: IdsW, value: Int, blen: Int, fine: Bool, acc: List<Int>) -> List<Int>
    ? "A declaration's pieces: raw bytes copied, references by main numbers; the value of a theorem with a block (value, else -1) is its block's length and the placed byte."
    match ps
        [] -> acc
        [Piece.Raw(s, t), ..rest] -> declPieces(b, rest, e, next, ids, value, blen, fine, copied(acc, b, s, t))
        [Piece.Ref(x), ..rest] -> declPieces(b, rest, e, next, ids, value, blen, fine, uwn(acc, numStep(next.value - idOf(ids, ixAt(x)))))
        [Piece.Val(x), ..rest] -> match value >= 0
            true -> declPieces(b, rest, e, next, ids, value, blen, fine, List.prepend(placedByte(fine), uv(acc, blen)))
            false -> declPieces(b, rest, e, next, ids, value, blen, fine, uwn(acc, numStep(next.value - idOf(ids, ixAt(x)))))

fn placedByte(fine: Bool) -> Int
    ? "1 when every name is placed."
    match fine
        true -> 1
        false -> 0

verify placedByte
    placedByte(true) => 1

