module Reader
    intent =
        "Reads a whole lean4export file: the header line first, then every"
        "other line in order. A line is a declaration when its object has a"
        "single key, and an item of the name, level or expression table"
        "when it carries an in, il or ie index."
    exposes [header, supported, readAll, readParallel, readLine]
    depends [Json.Line, Json.Escapes, Json.Access, Core.Exprs, Export.Tables, Export.Items, Export.Declarations]
    effects []

fn header(line: String) -> Result<String, String>
    ? "The format version the header line declares."
    match Json.Line.parse(line)?
        J.JObj(fs) -> Json.Access.text(Json.Access.obj(Json.Access.obj(fs, "meta")?, "format")?, "version")
        _ -> Result.Err("the header is not an object")

verify header
    header("{{\"meta\":{{\"format\":{{\"version\":\"3.1.0\"}}}}}}") => Result.Ok("3.1.0")
    header("[]") => Result.Err("the header is not an object")
    header("{{\"in\":1}}") => Result.Err("missing key 'meta'")

fn supported(version: String) -> Bool
    ? "Format versions this reader understands: 3.1.x."
    String.startsWith(version, "3.1.")

verify supported
    supported("3.1.0") => true
    supported("3.2.0") => false
    supported("2.0.0") => false

fn readAll(t: Tables, lines: List<String>, n: Int) -> Result<Tables, String>
    ? "Reads every remaining line; n is the line number of the first one."
    match lines
        [] -> Result.Ok(t)
        [l, ..rest] -> continueAfter(applyLine(t, parseLine(l)), rest, n)

verify readAll
    readAll(Export.Tables.empty(), ["", ""], 2) => Result.Ok(Export.Tables.empty())
    readAll(Export.Tables.empty(), ["{{\"app\":{{\"arg\":3,\"fn\":3}},\"ie\":1}}"], 2) => Result.Err("line 2: unknown expression index 3")

fn continueAfter(r: Result<Tables, String>, rest: List<String>, n: Int) -> Result<Tables, String>
    ? "Stops at the first bad line, naming it; otherwise reads on."
    match r
        Result.Err(e) -> Result.Err("line {n}: {e}")
        Result.Ok(t) -> readAll(t, rest, n + 1)

verify continueAfter
    continueAfter(Result.Err("x"), [], 4) => Result.Err("line 4: x")

fn readLine(t: Tables, line: String) -> Result<Tables, String>
    ? "Reads one line into the tables."
    applyLine(t, parseLine(line))

verify readLine
    readLine(Export.Tables.empty(), "{{\"app\":{{\"arg\":3,\"fn\":4}},\"ie\":12}}") => Result.Err("unknown expression index 4")

type Line
    App(Int, Int, Int)
    Bind(BinderIds)
    NameStr(Int, Int, String)
    NameNum(Int, Int, Int)
    LevelSucc(Int, Int)
    LevelParam(Int, Int)
    LevelPair(Int, Int, Int, Bool)
    BVar(Int, Int)
    Sort(Int, Int)
    Const(Int, Int, List<Int>)
    Obj(List<Tuple<String, J>>)
    Blank
    Bad(String)

fn parseLine(line: String) -> Line
    ? "One line parsed without the tables: an application, binder, name, level, constant, bound variable or sort line in its canonical form by position, any other line through the JSON parser."
    match line == ""
        true -> Line.Blank
        false -> match appLine(line)
            Option.Some(ids) -> Line.App(ids.ie, ids.fnIdx, ids.argIdx)
            Option.None -> match binderLine(line)
                Option.Some(b) -> Line.Bind(b)
                Option.None -> otherLine(line)

verify parseLine
    parseLine("") => Line.Blank
    parseLine("{{\"app\":{{\"arg\":3,\"fn\":4}},\"ie\":12}}") => Line.App(12, 4, 3)
    parseLine("1") => Line.Bad("the line is not an object")

fn jsonParsed(r: Result<J, String>) -> Line
    ? "A parsed object, or why the line is not one."
    match r
        Result.Err(e) -> Line.Bad(e)
        Result.Ok(J.JObj(fs)) -> Line.Obj(fs)
        Result.Ok(_) -> Line.Bad("the line is not an object")

verify jsonParsed
    jsonParsed(Result.Err("x")) => Line.Bad("x")
    jsonParsed(Result.Ok(J.JObj([]))) => Line.Obj([])

fn applyLine(t: Tables, l: Line) -> Result<Tables, String>
    ? "Adds a parsed line to the tables, or rejects it."
    match l
        Line.App(ie, f, a) -> Export.Items.appAt(t, ie, f, a)
        Line.Bind(b) -> Export.Items.binderAt(t, b.ie, b.nameIdx, b.typeIdx, b.bodyIdx, b.bi, b.isLam)
        Line.NameStr(i, pre, text) -> Export.Items.nameStrAt(t, i, pre, text)
        Line.NameNum(i, pre, k) -> Export.Items.nameNumAt(t, i, pre, k)
        Line.LevelSucc(i, a) -> Export.Items.succAdded(t, i, a)
        Line.LevelParam(i, n) -> Export.Items.paramAdded(t, i, n)
        Line.LevelPair(i, a, b, isMax) -> Export.Items.levelsRead(t, i, a, b, isMax)
        Line.BVar(ie, k) -> Export.Tables.addExpr(t, ie, Core.Exprs.bvar(k))
        Line.Sort(ie, lv) -> Export.Items.sortAt(t, ie, lv)
        Line.Const(ie, n, us) -> Export.Items.constAt(t, ie, n, us)
        Line.Obj(fs) -> dispatch(t, fs)
        Line.Blank -> Result.Ok(t)
        Line.Bad(e) -> Result.Err(e)

verify applyLine
    applyLine(Export.Tables.empty(), Line.Blank) => Result.Ok(Export.Tables.empty())
    applyLine(Export.Tables.empty(), Line.Bad("x")) => Result.Err("x")

fn readParallel(t: Tables, lines: List<String>, n: Int, workers: Int) -> Result<Tables, String>
    ? "Reads every remaining line with the parsing shared out among workers, in rounds: each worker parses a run of the round's lines, the runs are parsed at once, and the parsed lines go into the tables in file order, so the first bad line is still the one reported. Rounds keep few parsed lines waiting for the tables at a time."
    match workers <= 1
        true -> readAll(t, lines, n)
        false -> readRounds(t, lines, n, workers)

verify readParallel
    readParallel(Export.Tables.empty(), ["", "{{\"app\":{{\"arg\":3,\"fn\":3}},\"ie\":1}}", ""], 2, 2) => Result.Err("line 3: unknown expression index 3")
    readParallel(Export.Tables.empty(), ["", ""], 2, 3) => Result.Ok(Export.Tables.empty())

fn runLines() -> Int
    ? "Lines one worker parses in a round."
    20000

verify runLines
    runLines() > 0 => true

fn readRounds(t: Tables, lines: List<String>, n: Int, workers: Int) -> Result<Tables, String>
    ? "Parses the first round, then goes on round by round."
    match lines
        [] -> Result.Ok(t)
        _ -> overlapped(t, parseRuns(starts(lines, workers, [])), List.drop(lines, workers * runLines()), n, workers)

verify readRounds
    readRounds(Export.Tables.empty(), [], 2, 2) => Result.Ok(Export.Tables.empty())

fn overlapped(t: Tables, parsed: List<List<Line>>, rest: List<String>, n: Int, workers: Int) -> Result<Tables, String>
    ? "Puts a parsed round into the tables while the next round is parsed."
    match rest
        [] -> lastRound(applyRuns(t, parsed, n)?)
        _ -> match (applyRuns(t, parsed, n), parseRuns(starts(rest, workers, [])))!
            (applied, next) -> roundDone(applied?, next, List.drop(rest, workers * runLines()), workers)

verify overlapped
    overlapped(Export.Tables.empty(), [[Line.Blank]], [], 2, 2) => Result.Ok(Export.Tables.empty())

fn lastRound(at: At) -> Result<Tables, String>
    ? "The tables after the last round."
    Result.Ok(at.t)

verify lastRound
    lastRound(At(t = Export.Tables.empty(), n = 3)) => Result.Ok(Export.Tables.empty())

fn roundDone(at: At, next: List<List<Line>>, rest: List<String>, workers: Int) -> Result<Tables, String>
    ? "Goes on with the next round."
    overlapped(at.t, next, rest, at.n, workers)

verify roundDone
    roundDone(At(t = Export.Tables.empty(), n = 3), [], [], 2) => Result.Ok(Export.Tables.empty())

fn starts(lines: List<String>, k: Int, acc: List<List<String>>) -> List<List<String>>
    ? "Where each of k runs begins, in order: the lines from there on, which share their cells with lines."
    match k <= 0
        true -> List.reverse(acc)
        false -> match lines
            [] -> List.reverse(acc)
            _ -> starts(List.drop(lines, runLines()), k - 1, List.prepend(lines, acc))

verify starts
    starts(["a"], 3, []) => [["a"]]
    starts([], 3, []) => []

fn parseRuns(runs: List<List<String>>) -> List<List<Line>>
    ? "Each run parsed on a worker of its own: the list is halved, and the halves run as an independent product."
    match runs
        [] -> []
        [r] -> [parseAll(r, runLines(), [])]
        _ -> parseHalves(List.take(runs, Int.div(List.len(runs), 2)), List.drop(runs, Int.div(List.len(runs), 2)))

verify parseRuns
    parseRuns([[""], ["", ""]]) => [[Line.Blank], [Line.Blank, Line.Blank]]

fn parseHalves(left: List<List<String>>, right: List<List<String>>) -> List<List<Line>>
    ? "The two halves at once."
    match (parseRuns(left), parseRuns(right))!
        (l, r) -> List.concat(l, r)

verify parseHalves
    parseHalves([[""]], [[""]]) => [[Line.Blank], [Line.Blank]]

fn parseAll(lines: List<String>, count: Int, acc: List<Line>) -> List<Line>
    ? "The first count lines parsed, in order."
    match count <= 0
        true -> List.reverse(acc)
        false -> match lines
            [] -> List.reverse(acc)
            [l, ..rest] -> parseAll(rest, count - 1, List.prepend(parseLine(l), acc))

verify parseAll
    parseAll(["", ""], 5, []) => [Line.Blank, Line.Blank]
    parseAll(["", ""], 1, []) => [Line.Blank]

record At
    t: Tables
    n: Int

fn applyRuns(t: Tables, runs: List<List<Line>>, n: Int) -> Result<At, String>
    ? "The parsed runs into the tables, in order."
    match runs
        [] -> Result.Ok(At(t = t, n = n))
        [r, ..rest] -> applyNext(applyAll(t, r, n)?, rest)

verify applyRuns
    applyRuns(Export.Tables.empty(), [[Line.Blank], [Line.Bad("x")]], 5) => Result.Err("line 6: x")

fn applyNext(at: At, rest: List<List<Line>>) -> Result<At, String>
    ? "Goes on with the next run."
    applyRuns(at.t, rest, at.n)

verify applyNext
    applyNext(At(t = Export.Tables.empty(), n = 3), []) => Result.Ok(At(t = Export.Tables.empty(), n = 3))

fn applyAll(t: Tables, ls: List<Line>, n: Int) -> Result<At, String>
    ? "One run's lines into the tables; n is the line number of the first."
    match ls
        [] -> Result.Ok(At(t = t, n = n))
        [l, ..rest] -> applyAfter(applyLine(t, l), rest, n)

verify applyAll
    applyAll(Export.Tables.empty(), [Line.Blank], 2) => Result.Ok(At(t = Export.Tables.empty(), n = 3))

fn applyAfter(r: Result<Tables, String>, rest: List<Line>, n: Int) -> Result<At, String>
    ? "Stops at the first bad line, naming it; otherwise goes on."
    match r
        Result.Err(e) -> Result.Err("line {n}: {e}")
        Result.Ok(t) -> applyAll(t, rest, n + 1)

verify applyAfter
    applyAfter(Result.Err("x"), [], 7) => Result.Err("line 7: x")

record AppIds
    ie: Int
    fnIdx: Int
    argIdx: Int

fn appLine(line: String) -> Option<AppIds>
    ? "Four lines in five of an export are applications, written exactly as {{\"app\":{{\"arg\":A,\"fn\":F}},\"ie\":I}} with plain decimal indices. Such a line is read by position, digit by digit, instead of by a JSON parse, and accepted only in that form exactly: each number canonical, each separator where the form puts it, nothing after the last brace. Anything else, however close, gives None and goes to the parser."
    match String.startsWith(line, "{{\"app\":{{\"arg\":")
        false -> Option.None
        true -> appFn(line, canonAt(line, 14))

verify appLine
    appLine("{{\"app\":{{\"arg\":3,\"fn\":4}},\"ie\":12}}") => Option.Some(AppIds(ie = 12, fnIdx = 4, argIdx = 3))
    appLine("{{\"app\":{{\"arg\":0,\"fn\":40}},\"ie\":105}}") => Option.Some(AppIds(ie = 105, fnIdx = 40, argIdx = 0))
    appLine("{{\"app\":{{\"arg\":3,\"fn\":04}},\"ie\":12}}") => Option.None
    appLine("{{\"app\":{{\"arg\":3,\"fn\":4}}}},\"ie\":12}}") => Option.None
    appLine("{{\"app\":{{\"arg\":3, \"fn\":4}},\"ie\":12}}") => Option.None
    appLine("{{\"app\":{{\"arg\":3,\"fn\":4}},\"ie\":12}} ") => Option.None
    appLine("{{\"app\":{{\"arg\":3,\"fn\":4}},\"ie\":12") => Option.None
    appLine("{{\"app\":{{\"arg\":,\"fn\":4}},\"ie\":12}}") => Option.None
    appLine("{{\"ie\":1,\"bvar\":0}}") => Option.None

fn appFn(line: String, a: NumAt) -> Option<AppIds>
    ? "The function's index, after the argument's."
    match textAt(line, a.end, ",\"fn\":")
        false -> Option.None
        true -> appIe(line, a, canonAt(line, a.end + 6))

verify appFn
    appFn("x1,\"fn\":2}},\"ie\":3}}", NumAt(value = 1, end = 2)) => Option.Some(AppIds(ie = 3, fnIdx = 2, argIdx = 1))
    appFn("x1;\"fn\":2}},\"ie\":3}}", NumAt(value = 1, end = 2)) => Option.None

fn appIe(line: String, a: NumAt, f: NumAt) -> Option<AppIds>
    ? "The line's own index, after the function's."
    match textAt(line, f.end, "}},\"ie\":")
        false -> Option.None
        true -> appEnd(line, a, f, canonAt(line, f.end + 7))

verify appIe
    appIe("x}},\"ie\":3}}", NumAt(value = 1, end = 0), NumAt(value = 2, end = 1)) => Option.Some(AppIds(ie = 3, fnIdx = 2, argIdx = 1))
    appIe("x}},\"ie\":3}}", NumAt(value = 1, end = 0), NumAt(value = 2, end = -1)) => Option.None

fn appEnd(line: String, a: NumAt, f: NumAt, i: NumAt) -> Option<AppIds>
    ? "The closing brace, and nothing after it."
    match lastAt(line, i.end, "}}")
        true -> Option.Some(AppIds(ie = i.value, fnIdx = f.value, argIdx = a.value))
        false -> Option.None

verify appEnd
    appEnd("x3}}", NumAt(value = 1, end = 0), NumAt(value = 2, end = 0), NumAt(value = 3, end = 2)) => Option.Some(AppIds(ie = 3, fnIdx = 2, argIdx = 1))
    appEnd("x3}}}}", NumAt(value = 1, end = 0), NumAt(value = 2, end = 0), NumAt(value = 3, end = 2)) => Option.None

record NumAt
    value: Int
    end: Int

fn digitAt(s: String, i: Int) -> Int
    ? "The decimal digit at position i, or -1 for anything else or past the end."
    match String.charAt(s, i)
        Option.Some("0") -> 0
        Option.Some("1") -> 1
        Option.Some("2") -> 2
        Option.Some("3") -> 3
        Option.Some("4") -> 4
        Option.Some("5") -> 5
        Option.Some("6") -> 6
        Option.Some("7") -> 7
        Option.Some("8") -> 8
        Option.Some("9") -> 9
        Option.Some -> -1
        Option.None -> -1

verify digitAt
    digitAt("a7", 1) => 7
    digitAt("a7", 0) => -1
    digitAt("a7", 2) => -1

decision DigitsInTheLoop
    date = "2026-10-24"
    reason =
        "Most of what a line read by position costs is its digits, a step of"
        "numberAt each. The step called digitAt, which the Rust backend"
        "keeps a function of its own, and compared the digit it gave with"
        "zero. numberAt now matches the character itself, so each step is"
        "one indexed read of the character's code point and the arm for"
        "its digit. Instructions retired, one worker, reading only: Init"
        "25.87 G to 24.28 G; checked in full, etale 58.10 G to 57.53 G, qb9"
        "107.03 G to 105.66 G, Init 128.14 G to 126.45 G."
    chosen = "DigitsInTheLoop"
    rejected = ["DigitCalled"]
    impacts = [numberAt]

fn numberAt(s: String, i: Int, acc: Int) -> NumAt
    ? "The digits from position i on as a number, and where they stop. The digit of each step is matched here rather than read with digitAt (DigitsInTheLoop)."
    match String.charAt(s, i)
        Option.Some("0") -> numberAt(s, i + 1, acc * 10)
        Option.Some("1") -> numberAt(s, i + 1, acc * 10 + 1)
        Option.Some("2") -> numberAt(s, i + 1, acc * 10 + 2)
        Option.Some("3") -> numberAt(s, i + 1, acc * 10 + 3)
        Option.Some("4") -> numberAt(s, i + 1, acc * 10 + 4)
        Option.Some("5") -> numberAt(s, i + 1, acc * 10 + 5)
        Option.Some("6") -> numberAt(s, i + 1, acc * 10 + 6)
        Option.Some("7") -> numberAt(s, i + 1, acc * 10 + 7)
        Option.Some("8") -> numberAt(s, i + 1, acc * 10 + 8)
        Option.Some("9") -> numberAt(s, i + 1, acc * 10 + 9)
        Option.Some -> NumAt(value = acc, end = i)
        Option.None -> NumAt(value = acc, end = i)

verify numberAt
    numberAt("x12,", 1, 0) => NumAt(value = 12, end = 3)
    numberAt("x,", 1, 0) => NumAt(value = 0, end = 1)

fn canonAt(s: String, i: Int) -> NumAt
    ? "The number at i in its canonical decimal form: digits with no leading zero, or 0 alone. Its end is -1 when there is none."
    d = digitAt(s, i)
    match d < 0
        true -> NumAt(value = 0, end = -1)
        false -> match d == 0
            true -> zeroAt(s, i)
            false -> numberAt(s, i + 1, d)

verify canonAt
    canonAt("x12,", 1) => NumAt(value = 12, end = 3)
    canonAt("x0,", 1) => NumAt(value = 0, end = 2)
    canonAt("x012,", 1).end => -1
    canonAt("x,", 1).end => -1
    canonAt("x", -1).end => -1

fn zeroAt(s: String, i: Int) -> NumAt
    ? "A zero is a number only when no digit follows it."
    match digitAt(s, i + 1) < 0
        true -> NumAt(value = 0, end = i + 1)
        false -> NumAt(value = 0, end = -1)

verify zeroAt
    zeroAt("0}}", 0) => NumAt(value = 0, end = 1)
    zeroAt("07", 0).end => -1

decision LengthsUncounted
    date = "2026-10-24"
    reason =
        "textAt took the length of the text it looks for with String.len,"
        "which counts characters, and lastAt counted every character of the"
        "line to see that the text ends it: a count for every separator of"
        "a line read by position, and one of the whole line at its end."
        "Every text the reader looks for is ASCII, so its"
        "byte length, read in one step, is its length; and the text ends"
        "the line when no character stands after it, which one indexed read"
        "tells. Instructions retired, one worker, reading only: Init 27.15 G"
        "to 25.87 G; checked in full, etale 58.5 G to 58.1 G, qb9 107.3 G"
        "to 107.0 G, Init 129.3 G to 128.1 G."
    chosen = "LengthsUncounted"
    rejected = ["LengthsCounted"]
    impacts = [textAt, lastAt, endAt]

fn textAt(s: String, i: Int, t: String) -> Bool
    ? "Whether t stands in s at position i; never at a negative position, where a number that was not found leaves it. Every t the reader looks for is ASCII, so its length in characters is its length in bytes, which is read without counting."
    match i < 0
        true -> false
        false -> String.slice(s, i, i + String.byteLength(t)) == t

verify textAt
    textAt("ab,cd", 2, ",c") => true
    textAt("ab,cd", 3, ",c") => false
    textAt("ab,cd", 4, "de") => false
    textAt("ab,cd", -1, "ab") => false
    textAt("αb,cd", 2, ",c") => true

fn lastAt(s: String, i: Int, t: String) -> Bool
    ? "Whether s ends with t standing at position i: t stands there and no character follows it, which needs no count of the characters of s."
    match textAt(s, i, t)
        false -> false
        true -> endAt(s, i + String.byteLength(t))

verify lastAt
    lastAt("ab}}", 2, "}}") => true
    lastAt("ab}} ", 2, "}}") => false
    lastAt("αb}}", 2, "}}") => true

fn endAt(s: String, i: Int) -> Bool
    ? "Whether no character of s stands at position i, for an i the caller keeps at or below the length of s: then i is the length."
    match String.charAt(s, i)
        Option.None -> true
        Option.Some -> false

verify endAt
    endAt("ab", 2) => true
    endAt("ab", 1) => false

record BinderIds
    ie: Int
    nameIdx: Int
    typeIdx: Int
    bodyIdx: Int
    bi: Binder
    isLam: Bool

record BinderAt
    bi: Binder
    body: Int
    name: Int
    typ: Int
    end: Int

record AnnAt
    bi: Binder
    end: Int

fn binderLine(line: String) -> Option<BinderIds>
    ? "Lambdas and pi types, the next most common lines, in their canonical forms: the lambda's index comes first, the pi's last. Read by position as application lines are, and accepted only in those forms exactly."
    match String.startsWith(line, "{{\"ie\":")
        true -> lamAfterIe(line, canonAt(line, 6))
        false -> match String.startsWith(line, "{{\"forallE\":")
            true -> piAfter(line, binderAt(line, 11))
            false -> Option.None

verify binderLine
    binderLine("{{\"ie\":7,\"lam\":{{\"binderInfo\":\"default\",\"body\":3,\"name\":2,\"type\":1}}}}") => Option.Some(BinderIds(ie = 7, nameIdx = 2, typeIdx = 1, bodyIdx = 3, bi = Binder.Default, isLam = true))
    binderLine("{{\"forallE\":{{\"binderInfo\":\"instImplicit\",\"body\":3,\"name\":2,\"type\":1}},\"ie\":7}}") => Option.Some(BinderIds(ie = 7, nameIdx = 2, typeIdx = 1, bodyIdx = 3, bi = Binder.InstImplicit, isLam = false))
    binderLine("{{\"forallE\":{{\"binderInfo\":\"strictImplicit\",\"body\":30,\"name\":0,\"type\":12}},\"ie\":70}}") => Option.Some(BinderIds(ie = 70, nameIdx = 0, typeIdx = 12, bodyIdx = 30, bi = Binder.StrictImplicit, isLam = false))
    binderLine("{{\"ie\":7,\"lam\":{{\"binderInfo\":\"implicit\",\"body\":3,\"name\":2,\"type\":1}}}}") => Option.Some(BinderIds(ie = 7, nameIdx = 2, typeIdx = 1, bodyIdx = 3, bi = Binder.Implicit, isLam = true))
    binderLine("{{\"forallE\":{{\"binderInfo\":\"other\",\"body\":3,\"name\":2,\"type\":1}},\"ie\":7}}") => Option.None
    binderLine("{{\"ie\":7,\"lam\":{{\"binderInfo\":\"default\",\"body\":03,\"name\":2,\"type\":1}}}}") => Option.None
    binderLine("{{\"ie\":7,\"lam\":{{\"binderInfo\":\"default\",\"body\":3,\"name\":2,\"type\":1}}}}}}") => Option.None
    binderLine("{{\"forallE\":{{\"binderInfo\":\"default\",\"body\":3,\"name\":2,\"type\":1}},\"ie\":7}} ") => Option.None
    binderLine("{{\"ie\":7,\"bvar\":0}}") => Option.None

fn lamAfterIe(line: String, i: NumAt) -> Option<BinderIds>
    ? "A lambda's binder after its index."
    match textAt(line, i.end, ",\"lam\":")
        false -> Option.None
        true -> lamEnd(line, i, binderAt(line, i.end + 7))

verify lamAfterIe
    lamAfterIe("x", NumAt(value = 0, end = -1)) => Option.None

fn lamEnd(line: String, i: NumAt, b: Option<BinderAt>) -> Option<BinderIds>
    ? "The lambda line's closing brace, and nothing after it."
    match b
        Option.None -> Option.None
        Option.Some(x) -> match lastAt(line, x.end, "}}")
            true -> Option.Some(BinderIds(ie = i.value, nameIdx = x.name, typeIdx = x.typ, bodyIdx = x.body, bi = x.bi, isLam = true))
            false -> Option.None

verify lamEnd
    lamEnd("x", NumAt(value = 0, end = 0), Option.None) => Option.None

fn piAfter(line: String, b: Option<BinderAt>) -> Option<BinderIds>
    ? "A pi's index after its binder."
    match b
        Option.None -> Option.None
        Option.Some(x) -> match textAt(line, x.end, ",\"ie\":")
            false -> Option.None
            true -> piEnd(line, x, canonAt(line, x.end + 6))

verify piAfter
    piAfter("x", Option.None) => Option.None

fn piEnd(line: String, x: BinderAt, i: NumAt) -> Option<BinderIds>
    ? "The pi line's closing brace, and nothing after it."
    match lastAt(line, i.end, "}}")
        true -> Option.Some(BinderIds(ie = i.value, nameIdx = x.name, typeIdx = x.typ, bodyIdx = x.body, bi = x.bi, isLam = false))
        false -> Option.None

verify piEnd
    piEnd("x7}}", BinderAt(bi = Binder.Default, body = 3, name = 2, typ = 1, end = 0), NumAt(value = 7, end = 2)) => Option.Some(BinderIds(ie = 7, nameIdx = 2, typeIdx = 1, bodyIdx = 3, bi = Binder.Default, isLam = false))

fn binderAt(line: String, p: Int) -> Option<BinderAt>
    ? "The object {{\"binderInfo\":\"B\",\"body\":D,\"name\":N,\"type\":T}} at p, in this form exactly; its end is just after its closing brace."
    match textAt(line, p, "{{\"binderInfo\":\"")
        false -> Option.None
        true -> binderBody(line, annotationAt(line, p + 15))

verify binderAt
    binderAt("{{\"binderInfo\":\"default\",\"body\":3,\"name\":2,\"type\":1}}", 0) => Option.Some(BinderAt(bi = Binder.Default, body = 3, name = 2, typ = 1, end = 51))
    binderAt("{{\"binderInfo\":\"default\",\"body\":3,\"type\":1}}", 0) => Option.None

fn annotationAt(line: String, i: Int) -> Option<AnnAt>
    ? "One of the four binder annotations at i, with its closing quote."
    match textAt(line, i, "default\"")
        true -> Option.Some(AnnAt(bi = Binder.Default, end = i + 8))
        false -> match textAt(line, i, "implicit\"")
            true -> Option.Some(AnnAt(bi = Binder.Implicit, end = i + 9))
            false -> match textAt(line, i, "instImplicit\"")
                true -> Option.Some(AnnAt(bi = Binder.InstImplicit, end = i + 13))
                false -> match textAt(line, i, "strictImplicit\"")
                    true -> Option.Some(AnnAt(bi = Binder.StrictImplicit, end = i + 15))
                    false -> Option.None

verify annotationAt
    annotationAt("\"implicit\",", 1) => Option.Some(AnnAt(bi = Binder.Implicit, end = 10))
    annotationAt("\"implicitly\",", 1) => Option.None

fn binderBody(line: String, a: Option<AnnAt>) -> Option<BinderAt>
    ? "The body's index after the annotation."
    match a
        Option.None -> Option.None
        Option.Some(x) -> match textAt(line, x.end, ",\"body\":")
            false -> Option.None
            true -> binderName(line, x.bi, canonAt(line, x.end + 8))

verify binderBody
    binderBody("x", Option.None) => Option.None

fn binderName(line: String, bi: Binder, d: NumAt) -> Option<BinderAt>
    ? "The name's index after the body's."
    match textAt(line, d.end, ",\"name\":")
        false -> Option.None
        true -> binderType(line, bi, d, canonAt(line, d.end + 8))

verify binderName
    binderName("x", Binder.Default, NumAt(value = 0, end = -1)) => Option.None

fn binderType(line: String, bi: Binder, d: NumAt, n: NumAt) -> Option<BinderAt>
    ? "The type's index after the name's."
    match textAt(line, n.end, ",\"type\":")
        false -> Option.None
        true -> binderClose(line, bi, d, n, canonAt(line, n.end + 8))

verify binderType
    binderType("x", Binder.Default, NumAt(value = 0, end = 0), NumAt(value = 0, end = -1)) => Option.None

fn binderClose(line: String, bi: Binder, d: NumAt, n: NumAt, t: NumAt) -> Option<BinderAt>
    ? "The binder object's closing brace."
    match textAt(line, t.end, "}}")
        false -> Option.None
        true -> Option.Some(BinderAt(bi = bi, body = d.value, name = n.value, typ = t.value, end = t.end + 1))

verify binderClose
    binderClose("x1}}", Binder.Default, NumAt(value = 3, end = 0), NumAt(value = 2, end = 0), NumAt(value = 1, end = 2)) => Option.Some(BinderAt(bi = Binder.Default, body = 3, name = 2, typ = 1, end = 3))

fn otherLine(line: String) -> Line
    ? "A line that is neither an application nor a binder: by position when it is in one of the other common canonical forms, else through the JSON parser."
    match quickLine(line)
        Option.Some(l) -> l
        Option.None -> jsonParsed(Json.Line.parse(line))

verify otherLine
    otherLine("{{\"bvar\":0,\"ie\":2}}") => Line.BVar(2, 0)
    otherLine("{{\"bvar\" : 0,\"ie\":2}}") => Line.Obj([("bvar", J.JInt(0)), ("ie", J.JInt(2))])

fn quickLine(line: String) -> Option<Line>
    ? "Names, levels, constants, bound variables and sorts, each only in the exact form lean4export writes: keys in its order, numbers canonical, nothing after the last brace."
    match String.startsWith(line, "{{\"in\":")
        true -> nameAfter(line, canonAt(line, 6))
        false -> match String.startsWith(line, "{{\"il\":")
            true -> levelAfter(line, canonAt(line, 6))
            false -> match String.startsWith(line, "{{\"const\":{{\"name\":")
                true -> constAfter(line, canonAt(line, 17))
                false -> match String.startsWith(line, "{{\"bvar\":")
                    true -> bvarAfter(line, canonAt(line, 8))
                    false -> match String.startsWith(line, "{{\"ie\":")
                        true -> sortAfter(line, canonAt(line, 6))
                        false -> Option.None

verify quickLine
    quickLine("{{\"in\":1,\"str\":{{\"pre\":0,\"str\":\"Add\"}}}}") => Option.Some(Line.NameStr(1, 0, "Add"))
    quickLine("{{\"in\":3,\"str\":{{\"pre\":0,\"str\":\"α\"}}}}") => Option.Some(Line.NameStr(3, 0, "α"))
    quickLine("{{\"in\":4,\"str\":{{\"pre\":1,\"str\":\"a\\\"b\"}}}}") => Option.Some(Line.NameStr(4, 1, "a\"b"))
    quickLine("{{\"in\":10,\"num\":{{\"i\":0,\"pre\":9}}}}") => Option.Some(Line.NameNum(10, 9, 0))
    quickLine("{{\"il\":1,\"param\":2}}") => Option.Some(Line.LevelParam(1, 2))
    quickLine("{{\"il\":2,\"succ\":1}}") => Option.Some(Line.LevelSucc(2, 1))
    quickLine("{{\"il\":9,\"max\":[2,6]}}") => Option.Some(Line.LevelPair(9, 2, 6, true))
    quickLine("{{\"il\":9,\"imax\":[2,6]}}") => Option.Some(Line.LevelPair(9, 2, 6, false))
    quickLine("{{\"const\":{{\"name\":1,\"us\":[1]}},\"ie\":7}}") => Option.Some(Line.Const(7, 1, [1]))
    quickLine("{{\"const\":{{\"name\":5,\"us\":[]}},\"ie\":8}}") => Option.Some(Line.Const(8, 5, []))
    quickLine("{{\"const\":{{\"name\":5,\"us\":[1,20,3]}},\"ie\":8}}") => Option.Some(Line.Const(8, 5, [1, 20, 3]))
    quickLine("{{\"bvar\":3,\"ie\":14}}") => Option.Some(Line.BVar(14, 3))
    quickLine("{{\"ie\":0,\"sort\":2}}") => Option.Some(Line.Sort(0, 2))
    quickLine("{{\"ie\":0,\"sort\":02}}") => Option.None
    quickLine("{{\"il\":9,\"max\":[2,6,7]}}") => Option.None
    quickLine("{{\"const\":{{\"name\":5,\"us\":[1,]}},\"ie\":8}}") => Option.None
    quickLine("{{\"in\":1,\"str\":{{\"pre\":0,\"str\":\"Add\"}}}} ") => Option.None
    quickLine("{{\"ie\":0,\"natVal\":\"5\"}}") => Option.None

fn nameAfter(line: String, i: NumAt) -> Option<Line>
    ? "Name.str or Name.num after the index."
    match textAt(line, i.end, ",\"str\":{{\"pre\":")
        true -> nameStrAfter(line, i, canonAt(line, i.end + 14))
        false -> match textAt(line, i.end, ",\"num\":{{\"i\":")
            true -> nameNumAfter(line, i, canonAt(line, i.end + 12))
            false -> Option.None

verify nameAfter
    nameAfter("x", NumAt(value = 0, end = -1)) => Option.None

fn nameStrAfter(line: String, i: NumAt, pre: NumAt) -> Option<Line>
    ? "The string component, read as the JSON parser reads strings."
    match textAt(line, pre.end, ",\"str\":\"")
        false -> Option.None
        true -> nameStrEnd(line, i, pre, Json.Escapes.text(line, pre.end + 8))

verify nameStrAfter
    nameStrAfter("x", NumAt(value = 0, end = 0), NumAt(value = 0, end = -1)) => Option.None

fn nameStrEnd(line: String, i: NumAt, pre: NumAt, r: Scan) -> Option<Line>
    ? "The two closing braces after the string, and nothing after them."
    match r
        Scan.Done(text, at) -> match lastAt(line, at, "}}}}")
            true -> Option.Some(Line.NameStr(i.value, pre.value, text))
            false -> Option.None
        Scan.Bad -> Option.None

verify nameStrEnd
    nameStrEnd("ab}}}}", NumAt(value = 1, end = 0), NumAt(value = 0, end = 0), Scan.Done("a", 2)) => Option.Some(Line.NameStr(1, 0, "a"))
    nameStrEnd("ab}}", NumAt(value = 1, end = 0), NumAt(value = 0, end = 0), Scan.Done("a", 2)) => Option.None

fn nameNumAfter(line: String, i: NumAt, k: NumAt) -> Option<Line>
    ? "The prefix after the numeric component."
    match textAt(line, k.end, ",\"pre\":")
        false -> Option.None
        true -> nameNumEnd(line, i, k, canonAt(line, k.end + 7))

verify nameNumAfter
    nameNumAfter("x", NumAt(value = 0, end = 0), NumAt(value = 0, end = -1)) => Option.None

fn nameNumEnd(line: String, i: NumAt, k: NumAt, pre: NumAt) -> Option<Line>
    ? "The two closing braces."
    match lastAt(line, pre.end, "}}}}")
        true -> Option.Some(Line.NameNum(i.value, pre.value, k.value))
        false -> Option.None

verify nameNumEnd
    nameNumEnd("x9}}}}", NumAt(value = 1, end = 0), NumAt(value = 0, end = 0), NumAt(value = 9, end = 2)) => Option.Some(Line.NameNum(1, 9, 0))

fn levelAfter(line: String, i: NumAt) -> Option<Line>
    ? "succ, param, max or imax after the index, in the order lean4export sorts its keys."
    match textAt(line, i.end, ",\"succ\":")
        true -> levelOne(line, i, canonAt(line, i.end + 8), true)
        false -> match textAt(line, i.end, ",\"param\":")
            true -> levelOne(line, i, canonAt(line, i.end + 9), false)
            false -> match textAt(line, i.end, ",\"max\":[")
                true -> levelTwo(line, i, canonAt(line, i.end + 8), true)
                false -> match textAt(line, i.end, ",\"imax\":[")
                    true -> levelTwo(line, i, canonAt(line, i.end + 9), false)
                    false -> Option.None

verify levelAfter
    levelAfter("x", NumAt(value = 0, end = -1)) => Option.None

fn levelOne(line: String, i: NumAt, a: NumAt, isSucc: Bool) -> Option<Line>
    ? "A successor or a parameter, then the closing brace."
    match lastAt(line, a.end, "}}")
        false -> Option.None
        true -> match isSucc
            true -> Option.Some(Line.LevelSucc(i.value, a.value))
            false -> Option.Some(Line.LevelParam(i.value, a.value))

verify levelOne
    levelOne("x1}}", NumAt(value = 2, end = 0), NumAt(value = 1, end = 2), true) => Option.Some(Line.LevelSucc(2, 1))

fn levelTwo(line: String, i: NumAt, a: NumAt, isMax: Bool) -> Option<Line>
    ? "The second level of a max or imax."
    match textAt(line, a.end, ",")
        false -> Option.None
        true -> levelTwoEnd(line, i, a, canonAt(line, a.end + 1), isMax)

verify levelTwo
    levelTwo("x", NumAt(value = 0, end = 0), NumAt(value = 0, end = -1), true) => Option.None

fn levelTwoEnd(line: String, i: NumAt, a: NumAt, b: NumAt, isMax: Bool) -> Option<Line>
    ? "The closing bracket and brace."
    match lastAt(line, b.end, "]}}")
        true -> Option.Some(Line.LevelPair(i.value, a.value, b.value, isMax))
        false -> Option.None

verify levelTwoEnd
    levelTwoEnd("x6]}}", NumAt(value = 9, end = 0), NumAt(value = 2, end = 0), NumAt(value = 6, end = 2), true) => Option.Some(Line.LevelPair(9, 2, 6, true))

record UsAt
    us: List<Int>
    end: Int

fn constAfter(line: String, n: NumAt) -> Option<Line>
    ? "The universe levels after the name."
    match textAt(line, n.end, ",\"us\":[")
        false -> Option.None
        true -> constIe(line, n, usFirst(line, n.end + 7))

verify constAfter
    constAfter("x", NumAt(value = 0, end = -1)) => Option.None

fn usFirst(s: String, j: Int) -> UsAt
    ? "A list of level indices up to its closing bracket, possibly empty; its end is -1 when it is not in the canonical form."
    match textAt(s, j, "]")
        true -> UsAt(us = [], end = j + 1)
        false -> usMore(s, canonAt(s, j), [])

verify usFirst
    usFirst("[]", 1) => UsAt(us = [], end = 2)
    usFirst("[3,4]", 1) => UsAt(us = [3, 4], end = 5)
    usFirst("[3,]", 1).end => -1

fn usMore(s: String, u: NumAt, acc: List<Int>) -> UsAt
    ? "One more index, then a comma and the next or the closing bracket."
    match u.end < 0
        true -> UsAt(us = [], end = -1)
        false -> match textAt(s, u.end, ",")
            true -> usMore(s, canonAt(s, u.end + 1), List.prepend(u.value, acc))
            false -> match textAt(s, u.end, "]")
                true -> UsAt(us = List.reverse(List.prepend(u.value, acc)), end = u.end + 1)
                false -> UsAt(us = [], end = -1)

verify usMore
    usMore("7]", NumAt(value = 7, end = 1), []) => UsAt(us = [7], end = 2)
    usMore("7x", NumAt(value = 7, end = 1), []).end => -1

fn constIe(line: String, n: NumAt, us: UsAt) -> Option<Line>
    ? "The line's index after the constant."
    match us.end < 0
        true -> Option.None
        false -> match textAt(line, us.end, "}},\"ie\":")
            false -> Option.None
            true -> constEnd(line, n, us, canonAt(line, us.end + 7))

verify constIe
    constIe("x", NumAt(value = 0, end = 0), UsAt(us = [], end = -1)) => Option.None

fn constEnd(line: String, n: NumAt, us: UsAt, i: NumAt) -> Option<Line>
    ? "The closing brace."
    match lastAt(line, i.end, "}}")
        true -> Option.Some(Line.Const(i.value, n.value, us.us))
        false -> Option.None

verify constEnd
    constEnd("x7}}", NumAt(value = 1, end = 0), UsAt(us = [1], end = 0), NumAt(value = 7, end = 2)) => Option.Some(Line.Const(7, 1, [1]))

fn bvarAfter(line: String, b: NumAt) -> Option<Line>
    ? "The line's index after the bound variable's."
    match textAt(line, b.end, ",\"ie\":")
        false -> Option.None
        true -> bvarEnd(line, b, canonAt(line, b.end + 6))

verify bvarAfter
    bvarAfter("x", NumAt(value = 0, end = -1)) => Option.None

fn bvarEnd(line: String, b: NumAt, i: NumAt) -> Option<Line>
    ? "The closing brace."
    match lastAt(line, i.end, "}}")
        true -> Option.Some(Line.BVar(i.value, b.value))
        false -> Option.None

verify bvarEnd
    bvarEnd("x2}}", NumAt(value = 0, end = 0), NumAt(value = 2, end = 2)) => Option.Some(Line.BVar(2, 0))

fn sortAfter(line: String, i: NumAt) -> Option<Line>
    ? "The sort's level after the line's index."
    match textAt(line, i.end, ",\"sort\":")
        false -> Option.None
        true -> sortEnd(line, i, canonAt(line, i.end + 8))

verify sortAfter
    sortAfter("x", NumAt(value = 0, end = -1)) => Option.None

fn sortEnd(line: String, i: NumAt, l: NumAt) -> Option<Line>
    ? "The closing brace."
    match lastAt(line, l.end, "}}")
        true -> Option.Some(Line.Sort(i.value, l.value))
        false -> Option.None

verify sortEnd
    sortEnd("x2}}", NumAt(value = 0, end = 0), NumAt(value = 2, end = 2)) => Option.Some(Line.Sort(0, 2))

fn jsonLine(t: Tables, line: String) -> Result<Tables, String>
    ? "Reads one line through the JSON parser."
    applyLine(t, jsonParsed(Json.Line.parse(line)))

verify readLine
    readLine(Export.Tables.empty(), "{{\"app\":{{\"arg\":3,\"fn\":4}},\"ie\":12}}") => Result.Err("unknown expression index 4")

verify jsonLine
    Result.withDefault(jsonLine(Export.Tables.empty(), "{{\"in\":1,\"str\":{{\"pre\":0,\"str\":\"Nat\"}}}}"), Export.Tables.empty()).nextName => 2
    jsonLine(Export.Tables.empty(), "1") => Result.Err("the line is not an object")

fn dispatch(t: Tables, fs: List<Tuple<String, J>>) -> Result<Tables, String>
    ? "A single key is a declaration; otherwise the index key says which table."
    match fs
        [(k, J.JObj(o))] -> Export.Declarations.declLine(t, k, o)
        [(k, _)] -> Result.Err("declaration '{k}' is not an object")
        _ -> indexed(t, fs)

verify dispatch
    dispatch(Export.Tables.empty(), [("axiom", J.JNull)]) => Result.Err("declaration 'axiom' is not an object")
    dispatch(Export.Tables.empty(), [("a", J.JNull), ("b", J.JNull)]) => Result.Err("unrecognised line")

fn indexed(t: Tables, fs: List<Tuple<String, J>>) -> Result<Tables, String>
    ? "Expressions are by far the most common line, so they are tried first."
    match Json.Access.has(fs, "ie")
        true -> Export.Items.exprLine(t, fs)
        false -> match Json.Access.has(fs, "in")
            true -> Export.Items.nameLine(t, fs)
            false -> match Json.Access.has(fs, "il")
                true -> Export.Items.levelLine(t, fs)
                false -> Result.Err("unrecognised line")

verify indexed
    Result.withDefault(indexed(Export.Tables.empty(), [("il", J.JInt(1)), ("succ", J.JInt(0))]), Export.Tables.empty()).nextLevel => 2
    indexed(Export.Tables.empty(), [("x", J.JNull), ("y", J.JNull)]) => Result.Err("unrecognised line")
