module Lines
    intent =
        "Reads the lines of a lean4export file from its bytes, for the"
        "packer: the lines most of an export is made of, in the exact form"
        "lean4export writes them, are read by position from the bytes of a"
        "chunk, as Export.Reader reads them from text, and give the same"
        "Line; any other line gives none and is read as text by"
        "Export.Reader.parseLine."
    exposes [lineAt, lineOf, numOf, nameAt, LineAt, offAt, offValue, fwd, newlineFrom]
    exposes opaque [Off, Small, Lit]
    depends [Bytes, Core.Decls, Core.Exprs, Export.Reader]
    effects []

decision LinesFromBytes
    date = "2026-11-11"
    reason =
        "The packer read a chunk as text, split it into a list of lines and"
        "read each line by position as text: on mathlib 215 G of the 727 G"
        "a pack took, with the digits read one String.charAt at a time the"
        "hottest code of it. The common lines are now read from the chunk's"
        "bytes where they lie, each byte one Bytes.get at a position held as"
        "a machine word, the digits summed in one, and only a line in any"
        "other form is cut out and decoded as text for the reader's parser."
        "A line read from bytes gives the Line the reader's parser gives, so"
        "the records packed are the same."
    chosen = "LinesFromBytes"
    rejected = ["LinesAsText"]
    impacts = [lineAt, digits, canon]

record Off
    value: Int

fn offOf(n: Int) -> Result<Off, Bool>
    ? "A place in a chunk: -1 for none, otherwise below 2^62."
    match Bool.and(n >= -1, n <= 4611686018427387903)
        true -> Result.Ok(Off(value = n))
        false -> Result.Err(false)

verify offOf
    offOf(-2) => Result.Err(false)
    offOf(3) => offAt(3)

fn offAt(n: Int) -> Off
    ? "The place n, none when it is not one."
    match offOf(n)
        Result.Ok(o) -> o
        Result.Err(_) -> Off(value = -1)

verify offAt
    offAt(4).value => 4
    offAt(-4).value => -1

fn offValue(p: Off) -> Int
    ? "Where p is, -1 for none."
    p.value

verify offValue
    offValue(offAt(5)) => 5

fn fwd(p: Off, k: Int) -> Off
    ? "k bytes past p, for k from 0 to 1024; none stays none, and so does a place past the range. Reckoned on the machine word p holds (WordSteps)."
    match Bool.and(p.value >= 0, Bool.and(k >= 0, k <= 1024))
        true -> placeAt(p.value + k)
        false -> Off(value = -1)

fn placeOf(n: Int) -> Result<Off, Bool>
    ? "A place reckoned on a machine word: the bound of offOf, a constructor of its own so that its argument stays a word (WordSteps)."
    match Bool.and(n >= -1, n <= 4611686018427387903)
        true -> Result.Ok(Off(value = n))
        false -> Result.Err(false)

verify placeOf
    placeOf(-2) => Result.Err(false)

fn placeAt(n: Int) -> Off
    ? "The place n, none when it is not one."
    match placeOf(n)
        Result.Ok(o) -> o
        Result.Err(_) -> Off(value = -1)

verify placeAt
    placeAt(4).value => 4

verify fwd
    fwd(offAt(2), 3) => offAt(5)
    fwd(offAt(-1), 3) => offAt(-1)
    fwd(offAt(2), 2000) => offAt(-1)

decision WordSteps
    date = "2026-11-12"
    reason =
        "A step past a place went through offAt, whose parameter is a"
        "general Int: the machine word the place holds was made an Int,"
        "compared as one and narrowed back, at every digit of every number"
        "read. A step and a digit pushed onto a sum are now operations of"
        "their own types (fwd, after, pushDigit), checked on the word."
    chosen = "WordSteps"
    rejected = ["StepsThroughInt"]
    impacts = [fwd, after, pushDigit, digits, canon]

fn after(p: Off) -> Off
    ? "One byte past p (WordSteps)."
    fwd(p, 1)

verify after
    after(offAt(4)) => offAt(5)

record Small
    value: Int

fn smallOf(n: Int) -> Result<Small, Bool>
    ? "A number of at most 17 digits, which a step of reading one more digit keeps a machine word."
    match Bool.and(n >= 0, n <= 99999999999999999)
        true -> Result.Ok(Small(value = n))
        false -> Result.Err(false)

verify smallOf
    smallOf(-1) => Result.Err(false)
    smallOf(12) => smallAt(12)

fn pushDigit(acc: Small, x: Int) -> Small
    ? "acc with the digit of byte x after it, acc of at most 16 digits and x a digit's byte; 0 otherwise (WordSteps)."
    match Bool.and(acc.value < 10000000000000000, Bool.and(x >= 48, x <= 57))
        true -> smallAt(acc.value * 10 + x - 48)
        false -> smallAt(0)

verify pushDigit
    pushDigit(smallAt(12), 51).value => 123
    pushDigit(smallAt(12), 1).value => 0

fn smallAt(n: Int) -> Small
    ? "n, or 0 when it is out of range."
    match smallOf(n)
        Result.Ok(s) -> s
        Result.Err(_) -> Small(value = 0)

verify smallAt
    smallAt(7).value => 7

record Num
    value: Small
    end: Off

record LineAt
    line: Line
    next: Off
    kind: Small
    n1: Small
    n2: Small
    n3: Small
    n4: Small
    bi: Binder
    lam: Bool

decision AppsUnboxed
    date = "2026-11-12"
    reason =
        "Nine lines in ten are applications, lambdas and pis, and each was"
        "read into a Line on the heap only for the packer to take its"
        "numbers out and drop it. A line read gives them in the LineAt"
        "itself, by its kind: 1 an application, its index, function and"
        "argument; 2 a lambda or a pi, its index, name, type and body, its"
        "annotation and which of the two; 0 any other line, in its Line."
        "The packer takes the numbers as they are, from a chunk read line"
        "by line and from the lines parsed ahead in rounds alike."
    chosen = "AppsUnboxed"
    rejected = ["AppsAsLines", "AppsApart"]
    impacts = [lineAt, lineOf]

fn lineOf(l: Line, next: Off) -> LineAt
    ? "A line read as the Line l, the next starting at next."
    LineAt(line = l, next = next, kind = smallAt(0), n1 = smallAt(0), n2 = smallAt(0), n3 = smallAt(0), n4 = smallAt(0), bi = Binder.Default, lam = false)

verify lineOf
    numOf(lineOf(Line.Blank, offAt(3)).kind) => 0

fn numOf(s: Small) -> Int
    ? "The number s holds."
    s.value

verify numOf
    numOf(smallAt(7)) => 7

fn none() -> Num
    ? "No number."
    Num(value = smallAt(0), end = offAt(-1))

verify none
    none().end => offAt(-1)

fn digits(b: Bytes, p: Off, acc: Small) -> Num
    ? "The digits from p on summed onto acc, and where they stop; none past 17 digits, which the text path reads. One function calling itself, so a loop, the sum a machine word."
    match Bytes.get(b, p.value)
        Option.Some(x) -> match Bool.and(x >= 48, x <= 57)
            true -> match acc.value < 10000000000000000
                true -> digits(b, after(p), pushDigit(acc, x))
                false -> none()
            false -> Num(value = acc, end = p)
        Option.None -> Num(value = acc, end = p)

verify digits
    digits(Bytes.fromList([49, 50, 44]), offAt(0), smallAt(0)) => Num(value = smallAt(12), end = offAt(2))
    digits(Bytes.fromList([49]), offAt(0), smallAt(10000000000000000)) => none()

fn canon(b: Bytes, p: Off) -> Num
    ? "The number at p in its canonical form, as Export.Reader.canonAt reads it: digits with no leading zero, or 0 alone; none otherwise."
    match Bytes.get(b, p.value)
        Option.Some(48) -> zeroEnd(b, p)
        Option.Some(x) -> match Bool.and(x >= 49, x <= 57)
            true -> digits(b, after(p), pushDigit(smallAt(0), x))
            false -> none()
        Option.None -> none()

verify canon
    canon(Bytes.fromList([49, 50, 44]), offAt(0)) => Num(value = smallAt(12), end = offAt(2))
    canon(Bytes.fromList([48, 50]), offAt(0)) => none()
    canon(Bytes.fromList([48, 44]), offAt(0)) => Num(value = smallAt(0), end = offAt(1))
    canon(Bytes.fromList([44]), offAt(0)) => none()
    canon(Bytes.fromList([49]), offAt(-1)) => none()

fn zeroEnd(b: Bytes, p: Off) -> Num
    ? "A zero is a number only when no digit follows it."
    match Bytes.get(b, p.value + 1)
        Option.Some(x) -> match Bool.and(x >= 48, x <= 57)
            true -> none()
            false -> Num(value = smallAt(0), end = after(p))
        Option.None -> Num(value = smallAt(0), end = after(p))

verify zeroEnd
    zeroEnd(Bytes.fromList([48]), offAt(0)) => Num(value = smallAt(0), end = offAt(1))

fn closedNl(b: Bytes, p: Off) -> Bool
    ? "A closing brace at p and the line's newline after it."
    match Bytes.get(b, p.value)
        Option.Some(125) -> byteIs(b, p.value + 1, 10)
        _ -> false

fn byteIs(b: Bytes, i: Int, c: Int) -> Bool
    ? "Whether the byte at i is c, read where it lies."
    match Bytes.get(b, i)
        Option.Some(x) -> x == c
        Option.None -> false

verify byteIs
    byteIs(Bytes.fromList([7]), 0, 7) => true
    byteIs(Bytes.fromList([7]), 1, 7) => false

verify closedNl
    closedNl(Bytes.fromList([125, 10]), offAt(0)) => true
    closedNl(Bytes.fromList([125]), offAt(0)) => false

fn newlineFrom(b: Bytes, p: Off) -> Off
    ? "The first newline at p or after it, none when the bytes end first."
    match Bytes.get(b, p.value)
        Option.Some(10) -> p
        Option.Some(_) -> newlineFrom(b, after(p))
        Option.None -> offAt(-1)

verify newlineFrom
    newlineFrom(Bytes.fromList([1, 10]), offAt(0)) => offAt(1)
    newlineFrom(Bytes.fromList([1]), offAt(0)) => offAt(-1)

fn lineAt(b: Bytes, p: Off) -> Option<LineAt>
    ? "The line at p when it is an application, a lambda, a pi, a constant, a let, a theorem or a definition in the exact form lean4export writes and ends with a newline; none for any other, which the caller reads by nameAt or as text (LinesFromBytes). It only reads the bytes, so the caller lends them (NamesApart)."
    match Bytes.get(b, p.value + 2)
        Option.Some(97) -> match litApp(b, p)
            true -> appArg(b, canon(b, fwd(p, 14)))
            false -> Option.None
        Option.Some(105) -> match Bytes.get(b, p.value + 3)
            Option.Some(101) -> match litIe(b, p)
                true -> ieAfter(b, canon(b, fwd(p, 6)))
                false -> Option.None
            _ -> Option.None
        Option.Some(116) -> thmAt(b, p)
        Option.Some(100) -> defAt(b, p)
        Option.Some(102) -> match litPi(b, p)
            true -> piAfter(b, binderAt(b, fwd(p, 26)))
            false -> Option.None
        Option.Some(99) -> match litConst(b, p)
            true -> constAfter(b, canon(b, fwd(p, 17)))
            false -> Option.None
        _ -> Option.None

verify lineAt
    lineAt(Bytes.fromList([123, 34, 97, 112, 112, 34, 58, 123, 34, 97, 114, 103, 34, 58, 51, 44, 34, 102, 110, 34, 58, 52, 125, 44, 34, 105, 101, 34, 58, 49, 50, 125, 10]), offAt(0)) => Option.Some(LineAt(line = Line.Blank, next = offAt(33), kind = smallAt(1), n1 = smallAt(12), n2 = smallAt(4), n3 = smallAt(3), n4 = smallAt(0), bi = Binder.Default, lam = false))
    lineAt(Bytes.fromList([123, 34, 97, 112, 112, 34, 58, 123, 34, 97, 114, 103, 34, 58, 51, 44, 34, 102, 110, 34, 58, 52, 125, 44, 34, 105, 101, 34, 58, 49, 50, 125]), offAt(0)) => Option.None
    lineAt(Bytes.fromList([]), offAt(0)) => Option.None
    lineAt(Bytes.fromList([123, 34, 105, 101, 34, 58, 55, 44, 34, 108, 97, 109, 34, 58, 123, 34, 98, 105, 110, 100, 101, 114, 73, 110, 102, 111, 34, 58, 34, 100, 101, 102, 97, 117, 108, 116, 34, 44, 34, 98, 111, 100, 121, 34, 58, 49, 44, 34, 110, 97, 109, 101, 34, 58, 50, 44, 34, 116, 121, 112, 101, 34, 58, 51, 125, 125, 10]), offAt(0)) => Option.Some(LineAt(line = Line.Blank, next = offAt(67), kind = smallAt(2), n1 = smallAt(7), n2 = smallAt(2), n3 = smallAt(3), n4 = smallAt(1), bi = Binder.Default, lam = true))
    lineAt(Bytes.fromList([123, 34, 102, 111, 114, 97, 108, 108, 69, 34, 58, 123, 34, 98, 105, 110, 100, 101, 114, 73, 110, 102, 111, 34, 58, 34, 105, 109, 112, 108, 105, 99, 105, 116, 34, 44, 34, 98, 111, 100, 121, 34, 58, 53, 44, 34, 110, 97, 109, 101, 34, 58, 51, 44, 34, 116, 121, 112, 101, 34, 58, 48, 125, 44, 34, 105, 101, 34, 58, 54, 125, 10]), offAt(0)) => Option.Some(LineAt(line = Line.Blank, next = offAt(72), kind = smallAt(2), n1 = smallAt(6), n2 = smallAt(3), n3 = smallAt(0), n4 = smallAt(5), bi = Binder.Implicit, lam = false))

decision NamesApart
    date = "2026-11-12"
    reason =
        "A Name.str line is the one common line whose reading cuts its text"
        "out of the chunk, which takes the chunk's bytes as a value of its"
        "own: read in lineAt, every line of a chunk paid for a copy of the"
        "chunk's handle, two atomic counts. Names are read by nameAt, which"
        "the caller tries only after lineAt gave none, so lineAt borrows the"
        "bytes."
    chosen = "NamesApart"
    rejected = ["NamesInLineAt"]
    impacts = [lineAt, nameAt]

fn nameAt(b: Bytes, p: Off) -> Option<LineAt>
    ? "The line at p when it is a Name.str or a Name.num in the exact form lean4export writes and ends with a newline; none for any other (NamesApart)."
    match Bool.and(byteIs(b, p.value + 2, 105), byteIs(b, p.value + 3, 110))
        true -> match litIn(b, p)
            true -> nameAfter(b, canon(b, fwd(p, 6)))
            false -> Option.None
        false -> Option.None

verify nameAt
    nameAt(Bytes.fromList([123, 34, 105, 110, 34, 58, 57, 44, 34, 110, 117, 109, 34, 58, 123, 34, 105, 34, 58, 48, 44, 34, 112, 114, 101, 34, 58, 56, 125, 125, 10]), offAt(0)) => Option.Some(lineOf(Line.NameNum(9, 8, 0), offAt(31)))
    nameAt(Bytes.fromList([123, 34, 105, 110, 34, 58, 49, 44, 34, 115, 116, 114, 34, 58, 123, 34, 112, 114, 101, 34, 58, 48, 44, 34, 115, 116, 114, 34, 58, 34, 117, 34, 125, 125, 10]), offAt(0)) => Option.Some(lineOf(Line.NameStr(1, 0, "u"), offAt(35)))
    nameAt(Bytes.fromList([123, 34, 97, 112, 112]), offAt(0)) => Option.None

fn appArg(b: Bytes, a: Num) -> Option<LineAt>
    ? "The function's index after the argument's."
    match litFn(b, a.end)
        true -> appFn(b, a, canon(b, fwd(a.end, 6)))
        false -> Option.None

verify appArg
    appArg(Bytes.fromList([]), none()) => Option.None

fn appFn(b: Bytes, a: Num, f: Num) -> Option<LineAt>
    ? "The line's own index after the function's."
    match litIeClose(b, f.end)
        true -> appEnd(b, a, f, canon(b, fwd(f.end, 7)))
        false -> Option.None

verify appFn
    appFn(Bytes.fromList([]), none(), none()) => Option.None

fn appEnd(b: Bytes, a: Num, f: Num, i: Num) -> Option<LineAt>
    ? "The application, once its brace and newline end it."
    match closedNl(b, i.end)
        true -> Option.Some(LineAt(line = Line.Blank, next = fwd(i.end, 2), kind = smallAt(1), n1 = i.value, n2 = f.value, n3 = a.value, n4 = smallAt(0), bi = Binder.Default, lam = false))
        false -> Option.None

verify appEnd
    appEnd(Bytes.fromList([]), none(), none(), none()) => Option.None

record BAt
    bi: Binder
    body: Small
    name: Small
    ty: Small
    end: Off

fn binderAt(b: Bytes, p: Off) -> Option<BAt>
    ? "The binder object from p, just after the quote that opens its annotation, as Export.Reader.binderAt reads it; its end is just after its closing brace."
    match Bytes.get(b, p.value)
        Option.Some(100) -> annotated(b, litDefault(b, p), Binder.Default, canon(b, fwd(p, 16)))
        Option.Some(115) -> annotated(b, litStrict(b, p), Binder.StrictImplicit, canon(b, fwd(p, 23)))
        Option.Some(105) -> match Bytes.get(b, p.value + 1)
            Option.Some(109) -> annotated(b, litImplicit(b, p), Binder.Implicit, canon(b, fwd(p, 17)))
            _ -> annotated(b, litInst(b, p), Binder.InstImplicit, canon(b, fwd(p, 21)))
        _ -> Option.None

verify binderAt
    binderAt(Bytes.fromList([]), offAt(0)) => Option.None

fn annotated(b: Bytes, found: Bool, bi: Binder, d: Num) -> Option<BAt>
    ? "The body's index after the annotation, when the annotation's text was found."
    match found
        false -> Option.None
        true -> match litName(b, d.end)
            false -> Option.None
            true -> binderName(b, bi, d, canon(b, fwd(d.end, 8)))

verify annotated
    annotated(Bytes.fromList([]), false, Binder.Default, none()) => Option.None

fn binderName(b: Bytes, bi: Binder, d: Num, n: Num) -> Option<BAt>
    ? "The type's index after the name's."
    match litType(b, n.end)
        false -> Option.None
        true -> binderType(b, bi, d, n, canon(b, fwd(n.end, 8)))

verify binderName
    binderName(Bytes.fromList([]), Binder.Default, none(), none()) => Option.None

fn binderType(b: Bytes, bi: Binder, d: Num, n: Num, t: Num) -> Option<BAt>
    ? "The binder object's closing brace."
    match byteIs(b, t.end.value, 125)
        true -> Option.Some(BAt(bi = bi, body = d.value, name = n.value, ty = t.value, end = fwd(t.end, 1)))
        false -> Option.None

verify binderType
    binderType(Bytes.fromList([]), Binder.Default, none(), none(), none()) => Option.None

fn ieAfter(b: Bytes, i: Num) -> Option<LineAt>
    ? "A lambda or a let after the line's index, told apart by the key's second letter."
    match Bytes.get(b, i.end.value + 3)
        Option.Some(97) -> lamAfterIe(b, i)
        Option.Some(101) -> letAfter(b, i)
        _ -> Option.None

verify ieAfter
    ieAfter(Bytes.fromList([]), none()) => Option.None

fn lamAfterIe(b: Bytes, i: Num) -> Option<LineAt>
    ? "A lambda's binder after its index."
    match litLam(b, i.end)
        true -> lamEnd(b, i, binderAt(b, fwd(i.end, 22)))
        false -> Option.None

verify lamAfterIe
    lamAfterIe(Bytes.fromList([]), none()) => Option.None

fn lamEnd(b: Bytes, i: Num, x: Option<BAt>) -> Option<LineAt>
    ? "The lambda line's closing brace and newline."
    match x
        Option.None -> Option.None
        Option.Some(y) -> match closedNl(b, y.end)
            true -> Option.Some(LineAt(line = Line.Blank, next = fwd(y.end, 2), kind = smallAt(2), n1 = i.value, n2 = y.name, n3 = y.ty, n4 = y.body, bi = y.bi, lam = true))
            false -> Option.None

verify lamEnd
    lamEnd(Bytes.fromList([]), none(), Option.None) => Option.None

fn piAfter(b: Bytes, x: Option<BAt>) -> Option<LineAt>
    ? "A pi's index after its binder."
    match x
        Option.None -> Option.None
        Option.Some(y) -> match litIeComma(b, y.end)
            true -> piEnd(b, y, canon(b, fwd(y.end, 6)))
            false -> Option.None

verify piAfter
    piAfter(Bytes.fromList([]), Option.None) => Option.None

fn piEnd(b: Bytes, y: BAt, i: Num) -> Option<LineAt>
    ? "The pi line's closing brace and newline."
    match closedNl(b, i.end)
        true -> Option.Some(LineAt(line = Line.Blank, next = fwd(i.end, 2), kind = smallAt(2), n1 = i.value, n2 = y.name, n3 = y.ty, n4 = y.body, bi = y.bi, lam = false))
        false -> Option.None

verify piEnd
    piEnd(Bytes.fromList([]), BAt(bi = Binder.Default, body = smallAt(0), name = smallAt(0), ty = smallAt(0), end = offAt(0)), none()) => Option.None

fn nameAfter(b: Bytes, i: Num) -> Option<LineAt>
    ? "Name.str or Name.num after the index."
    match litStr(b, i.end)
        true -> nameStrAfter(b, i, canon(b, fwd(i.end, 14)))
        false -> match litNum(b, i.end)
            true -> nameNumAfter(b, i, canon(b, fwd(i.end, 12)))
            false -> Option.None

verify nameAfter
    nameAfter(Bytes.fromList([]), none()) => Option.None

fn nameStrAfter(b: Bytes, i: Num, pre: Num) -> Option<LineAt>
    ? "The string component: bytes up to the closing quote, with no backslash, which the text path decodes."
    match litStrText(b, pre.end)
        false -> Option.None
        true -> nameText(b, i, pre, fwd(pre.end, 8), quoteFrom(b, fwd(pre.end, 8)))

verify nameStrAfter
    nameStrAfter(Bytes.fromList([]), none(), none()) => Option.None

fn quoteFrom(b: Bytes, p: Off) -> Off
    ? "The closing quote of a string from p, none when a backslash comes first or the bytes end."
    match Bytes.get(b, p.value)
        Option.Some(34) -> p
        Option.Some(92) -> offAt(-1)
        Option.Some(_) -> quoteFrom(b, after(p))
        Option.None -> offAt(-1)

verify quoteFrom
    quoteFrom(Bytes.fromList([97, 34]), offAt(0)) => offAt(1)
    quoteFrom(Bytes.fromList([92, 34]), offAt(0)) => offAt(-1)

fn nameText(b: Bytes, i: Num, pre: Num, s: Off, q: Off) -> Option<LineAt>
    ? "The two closing braces and the newline after the quote, then the text decoded."
    match Bool.and(q.value >= 0, Bool.and(byteIs(b, q.value + 1, 125), closedNl(b, fwd(q, 2))))
        false -> Option.None
        true -> match String.fromUtf8(Bytes.take(Bytes.drop(b, s.value), q.value - s.value))
            Result.Ok(t) -> Option.Some(lineOf(Line.NameStr(i.value.value, pre.value.value, t), fwd(q, 4)))
            Result.Err(_) -> Option.None

verify nameText
    nameText(Bytes.fromList([]), none(), none(), offAt(0), offAt(-1)) => Option.None

fn nameNumAfter(b: Bytes, i: Num, k: Num) -> Option<LineAt>
    ? "The prefix after the numeric component, then two braces and the newline."
    match litPre(b, k.end)
        false -> Option.None
        true -> nameNumEnd(b, i, k, canon(b, fwd(k.end, 7)))

verify nameNumAfter
    nameNumAfter(Bytes.fromList([]), none(), none()) => Option.None

fn nameNumEnd(b: Bytes, i: Num, k: Num, pre: Num) -> Option<LineAt>
    ? "The two closing braces and the newline."
    match Bool.and(byteIs(b, pre.end.value, 125), closedNl(b, fwd(pre.end, 1)))
        true -> Option.Some(lineOf(Line.NameNum(i.value.value, pre.value.value, k.value.value), fwd(pre.end, 3)))
        false -> Option.None

verify nameNumEnd
    nameNumEnd(Bytes.fromList([]), none(), none(), none()) => Option.None

record UsAt
    us: List<Int>
    end: Off

fn constAfter(b: Bytes, n: Num) -> Option<LineAt>
    ? "The universe levels after the name."
    match litUs(b, n.end)
        true -> constIe(b, n, usFirst(b, fwd(n.end, 7)))
        false -> Option.None

verify constAfter
    constAfter(Bytes.fromList([]), none()) => Option.None

fn usFirst(b: Bytes, p: Off) -> UsAt
    ? "A list of level indices up to its closing bracket, possibly empty; its end is none when it is not in the canonical form."
    match byteIs(b, p.value, 93)
        true -> UsAt(us = [], end = fwd(p, 1))
        false -> usMore(b, canon(b, p), [])

verify usFirst
    usFirst(Bytes.fromList([93]), offAt(0)) => UsAt(us = [], end = offAt(1))
    usFirst(Bytes.fromList([51, 44, 52, 93]), offAt(0)) => UsAt(us = [3, 4], end = offAt(4))
    usFirst(Bytes.fromList([51, 44, 93]), offAt(0)).end => offAt(-1)

fn usMore(b: Bytes, u: Num, acc: List<Int>) -> UsAt
    ? "One more index, then a comma and the next or the closing bracket."
    match u.end.value < 0
        true -> UsAt(us = [], end = offAt(-1))
        false -> match Bytes.get(b, u.end.value)
            Option.Some(44) -> usMore(b, canon(b, fwd(u.end, 1)), List.prepend(u.value.value, acc))
            Option.Some(93) -> UsAt(us = List.reverse(List.prepend(u.value.value, acc)), end = fwd(u.end, 1))
            _ -> UsAt(us = [], end = offAt(-1))

verify usMore
    usMore(Bytes.fromList([93]), Num(value = smallAt(7), end = offAt(0)), []) => UsAt(us = [7], end = offAt(1))

fn constIe(b: Bytes, n: Num, us: UsAt) -> Option<LineAt>
    ? "The line's index after the constant, then the brace and the newline."
    match litIeClose(b, us.end)
        false -> Option.None
        true -> constEnd(b, n, us, canon(b, fwd(us.end, 7)))

verify constIe
    constIe(Bytes.fromList([]), none(), UsAt(us = [], end = offAt(-1))) => Option.None

fn constEnd(b: Bytes, n: Num, us: UsAt, i: Num) -> Option<LineAt>
    ? "The closing brace and the newline."
    match closedNl(b, i.end)
        true -> Option.Some(lineOf(Line.Const(i.value.value, n.value.value, us.us), fwd(i.end, 2)))
        false -> Option.None

verify constEnd
    constEnd(Bytes.fromList([]), none(), UsAt(us = [], end = offAt(0)), none()) => Option.None

decision DeclsFromBytes
    date = "2026-11-12"
    reason =
        "Theorem, definition and let lines, about one line in a hundred,"
        "were cut out, decoded as text and read by Export.Reader, at some"
        "5000 instructions a line: a twentieth of reading init. They are now"
        "read from the bytes as the other common lines are, in the exact"
        "form Export.Reader reads by position, to the same Line."
    chosen = "DeclsFromBytes"
    rejected = ["DeclsAsText"]
    impacts = [thmAt, defAt, letAfter]

record TV
    ty: Small
    value: Small
    next: Off

fn tvAt(b: Bytes, p: Off) -> Option<TV>
    ? "A declaration's type and value from p and the two braces and the newline that end its line: ,\"type\":T,\"value\":V}}}}."
    match litType(b, p)
        true -> tvType(b, canon(b, fwd(p, 8)))
        false -> Option.None

verify tvAt
    tvAt(Bytes.fromList([44, 34, 116, 121, 112, 101, 34, 58, 51, 44, 34, 118, 97, 108, 117, 101, 34, 58, 52, 125, 125, 10]), offAt(0)) => Option.Some(TV(ty = smallAt(3), value = smallAt(4), next = offAt(22)))
    tvAt(Bytes.fromList([44, 34, 116, 121, 112, 101, 34, 58, 51, 44, 34, 118, 97, 108, 117, 101, 34, 58, 52, 125, 125]), offAt(0)) => Option.None

fn tvType(b: Bytes, t: Num) -> Option<TV>
    ? "The value after the type."
    match litValue(b, t.end)
        true -> tvEnd(b, t, canon(b, fwd(t.end, 9)))
        false -> Option.None

verify tvType
    tvType(Bytes.fromList([]), none()) => Option.None

fn tvEnd(b: Bytes, t: Num, v: Num) -> Option<TV>
    ? "The two closing braces and the newline."
    match Bool.and(byteIs(b, v.end.value, 125), closedNl(b, fwd(v.end, 1)))
        true -> Option.Some(TV(ty = t.value, value = v.value, next = fwd(v.end, 3)))
        false -> Option.None

verify tvEnd
    tvEnd(Bytes.fromList([]), none(), none()) => Option.None

record HB
    params: List<Int>
    name: Small
    end: Off

fn headAt(b: Bytes, p: Off) -> Option<HB>
    ? "A declaration's universe parameters and name from p: ,\"levelParams\":[..],\"name\":N."
    match litParams(b, p)
        true -> headParams(b, usFirst(b, fwd(p, 16)))
        false -> Option.None

verify headAt
    headAt(Bytes.fromList([44, 34, 108, 101, 118, 101, 108, 80, 97, 114, 97, 109, 115, 34, 58, 91, 49, 93, 44, 34, 110, 97, 109, 101, 34, 58, 52, 44]), offAt(0)) => Option.Some(HB(params = [1], name = smallAt(4), end = offAt(27)))
    headAt(Bytes.fromList([44, 34, 108, 101, 118, 101, 108, 80, 97, 114, 97, 109, 115, 34, 58, 91, 49, 93, 44, 34, 110, 97, 109, 101, 34, 58, 48, 52]), offAt(0)) => Option.None

fn headParams(b: Bytes, ps: UsAt) -> Option<HB>
    ? "The name after the universe parameters."
    match litName(b, ps.end)
        true -> headName(ps, canon(b, fwd(ps.end, 8)))
        false -> Option.None

verify headParams
    headParams(Bytes.fromList([]), UsAt(us = [], end = offAt(-1))) => Option.None

fn headName(ps: UsAt, n: Num) -> Option<HB>
    ? "The head, when the name is a number."
    match n.end.value < 0
        true -> Option.None
        false -> Option.Some(HB(params = ps.us, name = n.value, end = n.end))

verify headName
    headName(UsAt(us = [], end = offAt(0)), none()) => Option.None

fn thmAt(b: Bytes, p: Off) -> Option<LineAt>
    ? "A theorem line at p: {{\"thm\":{{\"all\":[..],\"levelParams\":[..],\"name\":N,\"type\":T,\"value\":V}}}} and its newline (DeclsFromBytes)."
    match litThm(b, p)
        true -> thmAll(b, usFirst(b, fwd(p, 15)))
        false -> Option.None

verify thmAt
    thmAt(Bytes.fromList([123, 34, 116, 104, 109, 34, 58, 123, 34, 97, 108, 108, 34, 58, 91, 53, 93, 44, 34, 108, 101, 118, 101, 108, 80, 97, 114, 97, 109, 115, 34, 58, 91, 93, 44, 34, 110, 97, 109, 101, 34, 58, 53, 44, 34, 116, 121, 112, 101, 34, 58, 54, 44, 34, 118, 97, 108, 117, 101, 34, 58, 55, 125, 125, 10]), offAt(0)) => Option.Some(lineOf(Line.Thm(Export.Reader.DeclIds(name = 5, params = [], ty = 6, value = 7, all = [5])), offAt(65)))
    thmAt(Bytes.fromList([123, 34, 116, 104, 109, 34, 58, 123, 34, 97, 108, 108, 34, 58, 91, 53, 93, 44, 34, 108, 101, 118, 101, 108, 80, 97, 114, 97, 109, 115, 34, 58, 91, 93, 44, 34, 110, 97, 109, 101, 34, 58, 53, 44, 34, 116, 121, 112, 101, 34, 58, 54, 44, 34, 118, 97, 108, 117, 101, 34, 58, 55, 125, 125]), offAt(0)) => Option.None

fn thmAll(b: Bytes, all: UsAt) -> Option<LineAt>
    ? "The theorem's head after the names of its mutual group."
    match all.end.value < 0
        true -> Option.None
        false -> thmHead(b, all, headAt(b, all.end))

verify thmAll
    thmAll(Bytes.fromList([]), UsAt(us = [], end = offAt(-1))) => Option.None

fn thmHead(b: Bytes, all: UsAt, h: Option<HB>) -> Option<LineAt>
    ? "The theorem's type and value after its head."
    match h
        Option.None -> Option.None
        Option.Some(x) -> thmEnd(all, x, tvAt(b, x.end))

verify thmHead
    thmHead(Bytes.fromList([]), UsAt(us = [], end = offAt(0)), Option.None) => Option.None

fn thmEnd(all: UsAt, h: HB, tv: Option<TV>) -> Option<LineAt>
    ? "The theorem, once its type and value end the line."
    match tv
        Option.None -> Option.None
        Option.Some(y) -> Option.Some(lineOf(Line.Thm(Export.Reader.DeclIds(name = h.name.value, params = h.params, ty = y.ty.value, value = y.value.value, all = all.us)), y.next))

verify thmEnd
    thmEnd(UsAt(us = [], end = offAt(0)), HB(params = [], name = smallAt(0), end = offAt(0)), Option.None) => Option.None

record HintsB
    hints: Hints
    end: Off

fn defAt(b: Bytes, p: Off) -> Option<LineAt>
    ? "A definition line at p: {{\"def\":{{\"all\":[..],\"hints\":H,\"levelParams\":[..],\"name\":N,\"safety\":S,\"type\":T,\"value\":V}}}} and its newline (DeclsFromBytes)."
    match litDef(b, p)
        true -> defAll(b, usFirst(b, fwd(p, 15)))
        false -> Option.None

verify defAt
    defAt(Bytes.fromList([123, 34, 100, 101, 102, 34, 58, 123, 34, 97, 108, 108, 34, 58, 91, 50, 50, 93, 44, 34, 104, 105, 110, 116, 115, 34, 58, 123, 34, 114, 101, 103, 117, 108, 97, 114, 34, 58, 49, 125, 44, 34, 108, 101, 118, 101, 108, 80, 97, 114, 97, 109, 115, 34, 58, 91, 50, 93, 44, 34, 110, 97, 109, 101, 34, 58, 50, 50, 44, 34, 115, 97, 102, 101, 116, 121, 34, 58, 34, 115, 97, 102, 101, 34, 44, 34, 116, 121, 112, 101, 34, 58, 54, 55, 44, 34, 118, 97, 108, 117, 101, 34, 58, 55, 52, 125, 125, 10]), offAt(0)) => Option.Some(lineOf(Line.Defn(Export.Reader.DeclIds(name = 22, params = [2], ty = 67, value = 74, all = [22]), Hints.Regular(1), Safety.Safe), offAt(108)))
    defAt(Bytes.fromList([123, 34, 100, 101, 102, 34, 58, 123, 34, 97, 108, 108, 34, 58, 91, 50, 50, 93, 44, 34, 104, 105, 110, 116, 115, 34, 58, 34, 97, 98, 98, 114, 101, 118, 34, 44, 34, 108, 101, 118, 101, 108, 80, 97, 114, 97, 109, 115, 34, 58, 91, 93, 44, 34, 110, 97, 109, 101, 34, 58, 50, 50, 44, 34, 115, 97, 102, 101, 116, 121, 34, 58, 34, 112, 97, 114, 116, 105, 97, 108, 34, 44, 34, 116, 121, 112, 101, 34, 58, 54, 55, 44, 34, 118, 97, 108, 117, 101, 34, 58, 55, 52, 125, 125, 10]), offAt(0)) => Option.Some(lineOf(Line.Defn(Export.Reader.DeclIds(name = 22, params = [], ty = 67, value = 74, all = [22]), Hints.Abbrev, Safety.Partial), offAt(105)))

fn defAll(b: Bytes, all: UsAt) -> Option<LineAt>
    ? "The definition's hints after the names of its mutual group."
    match litHints(b, all.end)
        true -> defHints(b, all, hintsAt(b, fwd(all.end, 9)))
        false -> Option.None

verify defAll
    defAll(Bytes.fromList([]), UsAt(us = [], end = offAt(-1))) => Option.None

fn hintsAt(b: Bytes, p: Off) -> Option<HintsB>
    ? "The hints at p: \"abbrev\", \"opaque\" or {{\"regular\":H}}."
    match Bytes.get(b, p.value)
        Option.Some(123) -> match litRegular(b, p)
            true -> regularEnd(b, canon(b, fwd(p, 11)))
            false -> Option.None
        Option.Some(34) -> match litAbbrev(b, p)
            true -> Option.Some(HintsB(hints = Hints.Abbrev, end = fwd(p, 8)))
            false -> match litOpaque(b, p)
                true -> Option.Some(HintsB(hints = Hints.Opaque, end = fwd(p, 8)))
                false -> Option.None
        _ -> Option.None

verify hintsAt
    hintsAt(Bytes.fromList([34, 111, 112, 97, 113, 117, 101, 34]), offAt(0)) => Option.Some(HintsB(hints = Hints.Opaque, end = offAt(8)))
    hintsAt(Bytes.fromList([34, 111, 116, 104, 101, 114, 34, 44]), offAt(0)) => Option.None
    hintsAt(Bytes.fromList([123, 34, 114, 101, 103, 117, 108, 97, 114, 34, 58, 49, 50, 125]), offAt(0)) => Option.Some(HintsB(hints = Hints.Regular(12), end = offAt(14)))

fn regularEnd(b: Bytes, h: Num) -> Option<HintsB>
    ? "The height's closing brace."
    match byteIs(b, h.end.value, 125)
        true -> Option.Some(HintsB(hints = Hints.Regular(h.value.value), end = fwd(h.end, 1)))
        false -> Option.None

verify regularEnd
    regularEnd(Bytes.fromList([]), none()) => Option.None

fn defHints(b: Bytes, all: UsAt, h: Option<HintsB>) -> Option<LineAt>
    ? "The definition's head after its hints."
    match h
        Option.None -> Option.None
        Option.Some(x) -> defHead(b, all, x.hints, headAt(b, x.end))

verify defHints
    defHints(Bytes.fromList([]), UsAt(us = [], end = offAt(0)), Option.None) => Option.None

fn defHead(b: Bytes, all: UsAt, hints: Hints, hd: Option<HB>) -> Option<LineAt>
    ? "The definition's safety after its head: the first letter of the value picks the text to look for."
    match hd
        Option.None -> Option.None
        Option.Some(y) -> match Bytes.get(b, y.end.value + 11)
            Option.Some(115) -> defSafe(b, all, hints, y, litSafe(b, y.end), Safety.Safe, fwd(y.end, 16))
            Option.Some(117) -> defSafe(b, all, hints, y, litUnsafe(b, y.end), Safety.Unsafe, fwd(y.end, 18))
            Option.Some(112) -> defSafe(b, all, hints, y, litPartial(b, y.end), Safety.Partial, fwd(y.end, 19))
            _ -> Option.None

verify defHead
    defHead(Bytes.fromList([]), UsAt(us = [], end = offAt(0)), Hints.Abbrev, Option.None) => Option.None

fn defSafe(b: Bytes, all: UsAt, hints: Hints, hd: HB, found: Bool, sa: Safety, p: Off) -> Option<LineAt>
    ? "The type and value after the safety, when its text was found."
    match found
        false -> Option.None
        true -> defEnd(all, hints, hd, sa, tvAt(b, p))

verify defSafe
    defSafe(Bytes.fromList([]), UsAt(us = [], end = offAt(0)), Hints.Abbrev, HB(params = [], name = smallAt(0), end = offAt(0)), false, Safety.Safe, offAt(0)) => Option.None

fn defEnd(all: UsAt, hints: Hints, hd: HB, sa: Safety, tv: Option<TV>) -> Option<LineAt>
    ? "The definition, once its type and value end the line."
    match tv
        Option.None -> Option.None
        Option.Some(y) -> Option.Some(lineOf(Line.Defn(Export.Reader.DeclIds(name = hd.name.value, params = hd.params, ty = y.ty.value, value = y.value.value, all = all.us), hints, sa), y.next))

verify defEnd
    defEnd(UsAt(us = [], end = offAt(0)), Hints.Abbrev, HB(params = [], name = smallAt(0), end = offAt(0)), Safety.Safe, Option.None) => Option.None

fn letAfter(b: Bytes, i: Num) -> Option<LineAt>
    ? "A let after the line's index: ,\"letE\":{{\"body\":B,\"name\":N,\"nondep\":F,\"type\":T,\"value\":V}}}} and its newline (DeclsFromBytes)."
    match litLet(b, i.end)
        true -> letBody(b, i, canon(b, fwd(i.end, 16)))
        false -> Option.None

verify letAfter
    letAfter(Bytes.fromList([]), none()) => Option.None

fn letBody(b: Bytes, i: Num, bd: Num) -> Option<LineAt>
    ? "The let's name after its body."
    match litName(b, bd.end)
        true -> letName(b, i, bd, canon(b, fwd(bd.end, 8)))
        false -> Option.None

verify letBody
    letBody(Bytes.fromList([]), none(), none()) => Option.None

fn letName(b: Bytes, i: Num, bd: Num, n: Num) -> Option<LineAt>
    ? "The let's nondep flag, which is not kept, and the type's key after it; the flag's first letter picks the text to look for."
    match Bytes.get(b, n.end.value + 10)
        Option.Some(102) -> letType(b, i, bd, n, litFalse(b, n.end), fwd(n.end, 23))
        Option.Some(116) -> letType(b, i, bd, n, litTrue(b, n.end), fwd(n.end, 22))
        _ -> Option.None

verify letName
    letName(Bytes.fromList([]), none(), none(), none()) => Option.None

fn letType(b: Bytes, i: Num, bd: Num, n: Num, found: Bool, p: Off) -> Option<LineAt>
    ? "The let's type and value at p, when the flag and the type's key were found."
    match found
        false -> Option.None
        true -> letValue(b, i, bd, n, canon(b, p))

verify letType
    letType(Bytes.fromList([]), none(), none(), none(), false, offAt(0)) => Option.None

fn letValue(b: Bytes, i: Num, bd: Num, n: Num, t: Num) -> Option<LineAt>
    ? "The let's value after its type."
    match litValue(b, t.end)
        true -> letEnd(b, i, bd, n, t, canon(b, fwd(t.end, 9)))
        false -> Option.None

verify letValue
    letValue(Bytes.fromList([]), none(), none(), none(), none()) => Option.None

fn letEnd(b: Bytes, i: Num, bd: Num, n: Num, t: Num, v: Num) -> Option<LineAt>
    ? "The two closing braces and the newline."
    match Bool.and(byteIs(b, v.end.value, 125), closedNl(b, fwd(v.end, 1)))
        true -> Option.Some(lineOf(Line.LetE(i.value.value, n.value.value, t.value.value, v.value.value, bd.value.value), fwd(v.end, 3)))
        false -> Option.None

verify letEnd
    letEnd(Bytes.fromList([]), none(), none(), none(), none(), none()) => Option.None

fn litThm(b: Bytes, p: Off) -> Bool
    ? "Whether the 15 bytes of {{\"thm\":{{\"all\":[ stand at p, compared by litRun (LiteralWords)."
    Bool.and(Bool.and(litRun(b, p, smallAt(0), Lit(value = 16363401948439163)), litRun(b, p, smallAt(7), Lit(value = 16363397719335547))), litRun(b, p, smallAt(14), Lit(value = 91)))

