fn byteOf(b: Bytes, i: Int) -> Int
    ? "The byte at i, read where it lies; -1, which no byte is, when there is none."
    match Bytes.get(b, i)
        Option.Some(x) -> x
        Option.None -> -1

verify byteOf
    byteOf(Bytes.fromList([7, 8]), 1) => 8
    byteOf(Bytes.fromList([7]), -1) => -1
    byteOf(Bytes.fromList([7]), 1) => -1

decision LiteralWords
    date = "2026-11-12"
    reason =
        "The fixed text of a line was compared one byte at a time, each"
        "comparison a read of its own written out in a chain: the generated"
        "code took the chunk's place and length afresh for every byte, and"
        "past a few bytes called the read instead of inlining it, about 20"
        "instructions a byte of the 30 fixed bytes of an application line."
        "Up to 7 bytes of the text are now one word, lowest byte first, and"
        "litRun compares the bytes with it in one loop, which reads the"
        "chunk's place once. The bytes compared and the answer are the same."
    chosen = "LiteralWords"
    rejected = ["ByteChains", "OrOfDifferences"]
    impacts = [litRun]

record Lit
    value: Int

fn litOf(n: Int) -> Result<Lit, Bool>
    ? "Up to 7 bytes of fixed text in one word, the first the lowest (LiteralWords)."
    match Bool.and(n >= 0, n <= 72057594037927935)
        true -> Result.Ok(Lit(value = n))
        false -> Result.Err(false)

verify litOf
    litOf(-1) => Result.Err(false)

fn litRest(w: Lit) -> Lit
    ? "The text after w's first byte."
    match litOf(Bits.shiftRight(w.value, 8))
        Result.Ok(v) -> v
        Result.Err(_) -> Lit(value = 0)

verify litRest
    litRest(Lit(value = 513)).value => 2

fn litRun(b: Bytes, p: Off, k: Small, w: Lit) -> Bool
    ? "Whether the bytes from k past p are those of w, its lowest byte first, up to its highest byte that is not 0 (LiteralWords). The first byte read is at p itself, so a p that is none gives false."
    match w.value == 0
        true -> true
        false -> match byteOf(b, p.value + k.value) == Bits.and(w.value, 255)
            true -> litRun(b, p, smallAt(k.value + 1), litRest(w))
            false -> false

verify litRun
    litRun(Bytes.fromList([1, 2, 3]), offAt(0), smallAt(0), Lit(value = 513)) => true
    litRun(Bytes.fromList([1, 2, 3]), offAt(1), smallAt(0), Lit(value = 770)) => true
    litRun(Bytes.fromList([1, 2, 3]), offAt(1), smallAt(0), Lit(value = 513)) => false
    litRun(Bytes.fromList([1, 2]), offAt(1), smallAt(0), Lit(value = 770)) => false
    litRun(Bytes.fromList([1]), offAt(-1), smallAt(0), Lit(value = 1)) => false
    litRun(Bytes.fromList([1, 2, 3]), offAt(0), smallAt(1), Lit(value = 770)) => true

