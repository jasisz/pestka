module Pack
    intent =
        "Writes an export in Susz, Pestka's binary export format"
        "(docs/susz.md): the lines of a lean4export file, read with the"
        "reader's own line parser, become records with implicit ids. Version"
        "0 puts every record in one block, in the order of the file; version"
        "2, the default, is version 0 rewritten by Export.Split with each"
        "theorem's own proof in a block of its own. The packer copies"
        "structure only; the reader trusts none of it and computes every hash"
        "and range itself."
    exposes [pack, image]
    depends [Bytes, Json.Line, Json.Access, Core.Names, Core.Lazy, Core.Exprs, Core.Decls, Export.Reader, Export.Split, Export.Susz]
    effects [Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.appendBytes]

record P
    path: String
    out: List<Int>
    written: Int
    start: Int
    names: Int
    levels: Int
    exprs: Int
    decls: Int
    nr: Ren
    lr: Ren
    er: Ren

decision IdsRenumbered
    date = "2026-11-10"
    reason =
        "Susz gives ids implicitly, in record order, while an ndjson file may"
        "number its lines as it likes and skip numbers."
        "lean4export writes them in order from the first, and a file that"
        "does is copied as it is, at no cost; from the first line that"
        "breaks the order, the ids that table defines are mapped to the"
        "ones Susz gives. An id defined twice is refused, as the reader's"
        "tables refuse it."
    chosen = "IdsRenumbered"
    rejected = ["OrderedIdsOnly", "AlwaysMapped"]
    impacts = [Ren, define, lookup]

record Ren
    below: Int
    m: Map<Int, Int>

fn define(r: Ren, src: Int, dense: Int) -> Ren
    ? "The table's id src becomes Susz id dense: while every id has been its own, nothing is kept (IdsRenumbered)."
    match Bool.and(Map.len(r.m) == 0, src == dense)
        true -> Ren(below = dense + 1, m = r.m)
        false -> Ren(below = r.below, m = Map.set(r.m, src, dense))

verify define
    define(Ren(below = 1, m = {}), 1, 1) => Ren(below = 2, m = {})
    define(Ren(below = 1, m = {}), 5, 1) => Ren(below = 1, m = {5 => 1})

fn lookup(r: Ren, i: Int) -> Int
    ? "The Susz id of the table's id i, or -1 when i is not defined (IdsRenumbered)."
    match Map.get(r.m, i)
        Option.Some(x) -> x
        Option.None -> match Bool.and(i >= 0, i < r.below)
            true -> i
            false -> -1

verify lookup
    lookup(Ren(below = 2, m = {}), 1) => 1
    lookup(Ren(below = 2, m = {7 => 2}), 7) => 2
    lookup(Ren(below = 2, m = {}), 2) => -1

fn nm(q: P, i: Int) -> Result<Int, String>
    ? "A name's Susz id."
    match lookup(q.nr, i) < 0
        true -> Result.Err("unknown name index {i}")
        false -> Result.Ok(lookup(q.nr, i))

verify nm
    nm(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), 1) => Result.Err("unknown name index 1")

fn lv(q: P, i: Int) -> Result<Int, String>
    ? "A level's Susz id."
    match lookup(q.lr, i) < 0
        true -> Result.Err("unknown level index {i}")
        false -> Result.Ok(lookup(q.lr, i))

verify lv
    lv(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), 0) => Result.Ok(0)

fn nms(q: P, xs: List<Int>, acc: List<Int>) -> Result<List<Int>, String>
    ? "Names' Susz ids, in order."
    match xs
        [] -> Result.Ok(List.reverse(acc))
        [x, ..rest] -> nms(q, rest, List.prepend(nm(q, x)?, acc))

verify nms
    nms(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), [0], []) => Result.Ok([0])

fn lvs(q: P, xs: List<Int>, acc: List<Int>) -> Result<List<Int>, String>
    ? "Levels' Susz ids, in order."
    match xs
        [] -> Result.Ok(List.reverse(acc))
        [x, ..rest] -> lvs(q, rest, List.prepend(lv(q, x)?, acc))

verify lvs
    lvs(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), [3], []) => Result.Err("unknown level index 3")

fn pack(src: String, dst: String, version: Int) -> Result<String, String>
    ? "Packs src into dst in Susz of version 0 or 2; the counts written, or why not. Version 2 is packed in one step (OneStepPack)."
    ! [Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.appendBytes]
    match Disk.writeBytes(dst, Bytes.fromList([]))
        Result.Err(e) -> Result.Err("cannot write {dst}: {e}")
        Result.Ok(_) -> match version == 2
            true -> Export.Split.written2(dst, onePacked(src)?)
            false -> versioned(trailedTo(chunked(src, dst, 0, "", Option.None, 1)), dst, version)

decision OneStepPack
    date = "2026-11-11"
    reason =
        "Version 2 was packed in two steps: the lines became version 0, and"
        "Export.Split read version 0 again, a first pass over every record"
        "finding where each expression starts, building the names, seeding"
        "owners from the declarations and keeping where each name is first"
        "placed. The packer knows all of that as it writes each record, so"
        "it notes it then: where the expression starts, the name it built,"
        "and a declaration's references, names and skip read from the bytes"
        "it just wrote, with the decoder the split uses (declOf), so both"
        "agree. Version 0 is still kept in memory as the records to rewrite,"
        "and the split's later passes run on it unchanged, so the bytes"
        "written are those of the two steps."
    chosen = "OneStepPack"
    rejected = ["VersionZeroReadAgain"]
    impacts = [onePacked, X, noted, oneLines]

record X
    eoff: Vector<Vector<Int>>
    owner: Vector<Vector<Int>>
    cap: Int
    names: Vector<Name>
    known: Map<Name, Int>

fn x0(slots: Int) -> Result<X, String>
    ? "Nothing noted yet: room for slots chunks of 65536 expressions, none made, and for 4096 names."
    Result.Ok(X(eoff = Vector.new(Int.max(slots, 1), Export.Split.noChunk)?, owner = Vector.new(Int.max(slots, 1), Export.Split.noChunk)?, cap = 0, names = Vector.new(4096, Core.Names.anon()), known = {}))

verify x0
    capOf(x0(2)) => Result.Ok(0)

fn x00() -> X
    ? "Nothing noted, for examples."
    X(eoff = Vector.fromList([Export.Split.noChunk]), owner = Vector.fromList([Export.Split.noChunk]), cap = 0, names = Vector.fromList([Core.Names.anon()]), known = {})

verify x00
    x00().cap => 0

fn slotsFor(size: Int) -> Int
    ? "Chunks enough for every expression a file of size bytes may hold: an expression line takes at least 16 bytes."
    Int.div(Int.div(size, 16), 65536) + 2

verify slotsFor
    slotsFor(0) => 2

fn onePacked(src: String) -> Result<Laid, String>
    ? "The ndjson export at src packed into version 2 in one step (OneStepPack)."
    ! [Disk.readBytesAt, Disk.size]
    size = Disk.size(src)?
    o = oneChunked(src, 0, "", Option.None, x0(slotsFor(size))?, 1)?
    oneLaid(o)

record One
    q: P
    x: X

fn oneLaid(o: One) -> Result<Laid, String>
    ? "The split's later passes on the records packed, with what was noted while packing them."
    b = Bytes.fromList(List.reverse(o.q.out))?
    a = A(eoff = o.x.eoff, owner = o.x.owner, names = Vector.fromList(List.take(List.fromVector(o.x.names), o.q.names)), known = o.x.known, exprs = o.q.exprs, decls = o.q.decls)
    Export.Split.laidAfter(b, o.q.start, Bytes.len(b), o.q.names, o.q.levels, o.q.decls, o.q.exprs, a)

fn oneChunked(src: String, offset: Int, carry: String, p: Option<P>, x: X, line: Int) -> Result<One, String>
    ? "Reads the chunk at offset, as chunked does, noting what the split needs (OneStepPack)."
    ! [Disk.readBytesAt]
    match Disk.readBytesAt(src, offset, chunkBytes())
        Result.Err(e) -> Result.Err("cannot read {src}: {e}")
        Result.Ok(b) -> match Bytes.len(b) == 0
            true -> oneFinished(oneLines(p, x, [carry], line))
            false -> oneDecoded(src, offset, carry, p, x, line, b, 0)

fn oneDecoded(src: String, offset: Int, carry: String, p: Option<P>, x: X, line: Int, b: Bytes, cut: Int) -> Result<One, String>
    ? "The chunk as text, as decoded does."
    ! [Disk.readBytesAt]
    match String.fromUtf8(Bytes.take(b, Bytes.len(b) - cut))
        Result.Err(e) -> match cut >= 3
            true -> Result.Err("cannot read {src}: {e}")
            false -> oneDecoded(src, offset, carry, p, x, line, b, cut + 1)
        Result.Ok(t) -> oneSplit(src, offset + Bytes.len(b) - cut, joined(carry, String.split(t, "\n")), p, x, line)

fn oneSplit(src: String, next: Int, parts: List<String>, p: Option<P>, x: X, line: Int) -> Result<One, String>
    ? "The complete lines of a chunk; the last part waits for the next chunk."
    ! [Disk.readBytesAt]
    match oneLines(p, x, List.take(parts, List.len(parts) - 1), line)
        OneLined.Bad(e) -> Result.Err(e)
        OneLined.Done(q, y, at) -> oneChunked(src, next, lastOf(parts), q, y, at)

type OneLined
    Done(Option<P>, X, Int)
    Bad(String)

fn oneLines(p: Option<P>, x: X, ls: List<String>, line: Int) -> OneLined
    ? "Packs lines in order, as lines does, noting each record (OneStepPack)."
    match ls
        [] -> OneLined.Done(p, x, line)
        [l, ..rest] -> match p
            Option.None -> oneHeader(l, x, rest, line)
            Option.Some(q) -> match l == ""
                true -> oneLines(p, x, rest, line + 1)
                false -> oneLine(q, x, Export.Reader.parseLine(l), rest, line)

fn oneLine(q: P, x: X, l: Line, rest: List<String>, line: Int) -> OneLined
    ? "One parsed line packed and noted."
    e0 = q.exprs
    n0 = q.names
    d0 = q.decls
    before = List.len(q.out)
    match lineOf(q, l)
        Result.Ok(r) -> oneNoted(noted(x, r, e0, n0, d0, before), r, rest, line)
        Result.Err(e) -> OneLined.Bad("line {line}: {e}")

fn oneNoted(r: Result<X, String>, q: P, rest: List<String>, line: Int) -> OneLined
    ? "On to the next line, once the record is noted."
    match r
        Result.Ok(x) -> oneLines(Option.Some(q), x, rest, line + 1)
        Result.Err(e) -> OneLined.Bad("line {line}: {e}")

fn oneHeader(l: String, x: X, rest: List<String>, line: Int) -> OneLined
    ? "The header line, as afterHeader reads it."
    match Export.Reader.header(l)
        Result.Err(e) -> OneLined.Bad("line 1: {e}")
        Result.Ok(v) -> match Export.Reader.supported(v)
            false -> OneLined.Bad("format version {v} is not supported")
            true -> oneLines(Option.Some(started("", metaText(l))), x, rest, line + 1)

fn oneFinished(l: OneLined) -> Result<One, String>
    ? "The packer and its notes after the last record."
    match l
        OneLined.Bad(e) -> Result.Err(e)
        OneLined.Done(Option.None, _, _) -> Result.Err("empty file")
        OneLined.Done(Option.Some(q), x, _) -> Result.Ok(One(q = q, x = x))

fn noted(x: X, q: P, e0: Int, n0: Int, d0: Int, before: Int) -> Result<X, String>
    ? "What the record just packed at before tells the split: an expression where it starts, a name its value, a declaration its references, its names and whether it is skipped (OneStepPack)."
    match q.exprs > e0
        true -> Result.Ok(exprNoted(roomFor(x, e0), e0, before))
        false -> match q.names > n0
            true -> nameNoted(x, n0, newBytes(q.out, List.len(q.out) - before))
            false -> match q.decls > d0
                true -> Result.Ok(declNoted(x, d0, Export.Split.declOf(newBytes(q.out, List.len(q.out) - before), Export.Split.at(1), e0)))
                false -> Result.Ok(x)

fn newBytes(out: List<Int>, n: Int) -> Bytes
    ? "The last n bytes packed, the record just written."
    Result.withDefault(Bytes.fromList(List.reverse(List.take(out, n))), Bytes.fromList([]))

verify newBytes
    newBytes([3, 2, 1], 2) => Bytes.fromList([2, 3])

fn roomFor(x: X, e: Int) -> X
    ? "Expression e's chunk made when it is the first of its chunk."
    match e < x.cap
        true -> x
        false -> X.update(x, eoff = chunkMade(x.eoff, Int.div(x.cap, 65536), 0), owner = chunkMade(x.owner, Int.div(x.cap, 65536), -1), cap = x.cap + 65536)

fn chunkMade(v: Vector<Vector<Int>>, ci: Int, init: Int) -> Vector<Vector<Int>>
    ? "Chunk ci made, all init."
    Option.withDefault(Vector.set(v, ci, Vector.new(65536, init)), v)

fn exprNoted(x: X, e: Int, before: Int) -> X
    ? "Where expression e starts."
    X.update(x, eoff = Export.Split.cset(x.eoff, e, before))

fn nameNoted(x: X, n: Int, b: Bytes) -> Result<X, String>
    ? "Name n, built from its record b."
    match Bytes.get(b, 0)
        Option.Some(1) -> nameSet(x, n, Export.Split.nameStrAt(b, Export.Split.at(0), x.names))
        _ -> nameSet(x, n, Export.Split.nameNumAt(b, Export.Split.at(0), x.names))

fn nameSet(x: X, n: Int, v: Name) -> Result<X, String>
    ? "v as name n, the vector doubled when it is full."
    match n < Vector.len(x.names)
        true -> Result.Ok(X.update(x, names = Option.withDefault(Vector.set(x.names, n, v), x.names)))
        false -> nameGrown(x, n, v, Vector.new(2 * Vector.len(x.names), Core.Names.anon())?)

fn nameGrown(x: X, n: Int, v: Name, w: Vector<Name>) -> Result<X, String>
    ? "The names copied into w, twice as long, then v set."
    nameSet(X.update(x, names = doubled(x.names, w, 0)), n, v)

fn doubled(v: Vector<Name>, w: Vector<Name>, i: Int) -> Vector<Name>
    ? "w with v's names copied to its first places."
    match Vector.get(v, i)
        Option.None -> w
        Option.Some(n) -> doubled(v, Option.withDefault(Vector.set(w, i, n), w), i + 1)

fn declNoted(x: X, di: Int, d: DeclP) -> X
    ? "A declaration's references seed their owners, and the names it places keep its code unless it is skipped."
    knownNoted(X.update(x, owner = Export.Split.seeded(x.owner, d.pieces, d.value, di)), di, d)

fn knownNoted(x: X, di: Int, d: DeclP) -> X
    ? "The names d places with its code, unless it is skipped: the names are read first and the map written after, each field of x on its own, so that neither is copied."
    ns = placedNames(x.names, d.names, d.skip, [])
    X.update(x, known = placedList(x.known, ns, Core.Lazy.codeOf(di, d.kind == 5)))

verify knownNoted
    Map.len(knownNoted(x00(), 0, Export.Split.declOf(Bytes.fromList([18, 0, 0, 0, 1, 0]), Export.Split.at(1), 1)).known) => 1

fn placedNames(names: Vector<Name>, ns: List<Int>, skip: Bool, acc: List<Name>) -> List<Name>
    ? "The names of ids ns, none when the declaration is skipped."
    match skip
        true -> []
        false -> match ns
            [] -> acc
            [n, ..rest] -> placedNames(names, rest, skip, List.prepend(Option.withDefault(Vector.get(names, n), Core.Names.anon()), acc))

verify placedNames
    placedNames(Vector.fromList([Core.Names.anon()]), [0], true, []) => []
    List.len(placedNames(Vector.fromList([Core.Names.anon()]), [0], false, [])) => 1

fn placedList(known: Map<Name, Int>, ns: List<Name>, code: Int) -> Map<Name, Int>
    ? "Each name placed with code, unless placed before."
    match ns
        [] -> known
        [n, ..rest] -> match Map.has(known, n)
            true -> placedList(known, rest, code)
            false -> placedList(Map.set(known, n, code), rest, code)

verify placedList
    Map.get(placedList({}, [Core.Names.anon()], 4), Core.Names.anon()) => Option.Some(4)

decision PackedInMemory
    date = "2026-11-11"
    reason =
        "pestka FILE.ndjson packs the export into Susz of version 2 in"
        "memory and reads that, with no file between: the lines are packed"
        "as for a file, but a packer with no path keeps its output instead"
        "of appending it, version 0 is the bytes it kept and the trailer,"
        "and Export.Split.image lays them out as version 2. Each stage"
        "returns only bytes, so what it built is freed before the next one"
        "runs and before checking."
    chosen = "PackedInMemory"
    rejected = ["TemporaryFile"]
    impacts = [image, written, onePacked]

fn image(src: String) -> Result<Image, String>
    ? "The ndjson export at src packed into Susz of version 2 in memory (PackedInMemory), in one step (OneStepPack)."
    ! [Disk.readBytesAt, Disk.size]
    Export.Split.imageOf(onePacked(src)?)

fn trailedTo(r: Result<P, String>) -> Result<String, String>
    ? "The last bytes and the trailer appended to the file."
    ! [Disk.appendBytes]
    trailed(written(r?)?)

fn versioned(r: Result<String, String>, dst: String, version: Int) -> Result<String, String>
    ? "Version 0 as written, or rewritten as version 2."
    ! [Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.appendBytes]
    match r
        Result.Err(e) -> Result.Err(e)
        Result.Ok(m) -> match version == 2
            true -> Export.Split.split(dst)
            false -> Result.Ok(m)

fn chunkBytes() -> Int
    ? "How much of the ndjson file one chunk reads."
    16777216

verify chunkBytes
    chunkBytes() > 0 => true

fn chunked(src: String, dst: String, offset: Int, carry: String, p: Option<P>, line: Int) -> Result<P, String>
    ? "Reads the chunk at offset; carry is the unfinished last line of the chunk before; p is the packer once the header line is read."
    ! [Disk.readBytesAt, Disk.writeBytes, Disk.appendBytes]
    match Disk.readBytesAt(src, offset, chunkBytes())
        Result.Err(e) -> Result.Err("cannot read {src}: {e}")
        Result.Ok(b) -> match Bytes.len(b) == 0
            true -> finished(lines(dst, p, [carry], line))
            false -> decoded(src, dst, offset, carry, p, line, b, 0)

fn decoded(src: String, dst: String, offset: Int, carry: String, p: Option<P>, line: Int, b: Bytes, cut: Int) -> Result<P, String>
    ? "The chunk as text, leaving out the bytes of a character its end cuts in two."
    ! [Disk.readBytesAt, Disk.writeBytes, Disk.appendBytes]
    match String.fromUtf8(Bytes.take(b, Bytes.len(b) - cut))
        Result.Err(e) -> match cut >= 3
            true -> Result.Err("cannot read {src}: {e}")
            false -> decoded(src, dst, offset, carry, p, line, b, cut + 1)
        Result.Ok(t) -> split(src, dst, offset + Bytes.len(b) - cut, joined(carry, String.split(t, "\n")), p, line)

fn joined(carry: String, parts: List<String>) -> List<String>
    ? "The parts with the carry put in front of the first."
    match parts
        [] -> [carry]
        [first, ..rest] -> List.prepend(carry + first, rest)

verify joined
    joined("ab", ["c", "d"]) => ["abc", "d"]

fn split(src: String, dst: String, next: Int, parts: List<String>, p: Option<P>, line: Int) -> Result<P, String>
    ? "Packs the complete lines of a chunk and writes what they gave; the last part waits for the next chunk."
    ! [Disk.readBytesAt, Disk.writeBytes, Disk.appendBytes]
    match lines(dst, p, List.take(parts, List.len(parts) - 1), line)
        Lined.Bad(e) -> Result.Err(e)
        Lined.Done(q, at) -> chunked(src, dst, next, lastOf(parts), flushed(q)?, at)

fn lastOf(parts: List<String>) -> String
    ? "The last part."
    match List.drop(parts, List.len(parts) - 1)
        [x, .._] -> x
        [] -> ""

verify lastOf
    lastOf(["a", "b"]) => "b"

type Lined
    Done(Option<P>, Int)
    Bad(String)

fn lines(dst: String, p: Option<P>, ls: List<String>, line: Int) -> Lined
    ? "Packs lines in order; line 1 is the header; empty lines are skipped, as the reader skips them."
    match ls
        [] -> Lined.Done(p, line)
        [l, ..rest] -> match p
            Option.None -> afterHeader(dst, l, rest, line)
            Option.Some(q) -> match l == ""
                true -> lines(dst, p, rest, line + 1)
                false -> match lineOf(q, Export.Reader.parseLine(l))
                    Result.Ok(r) -> lines(dst, Option.Some(r), rest, line + 1)
                    Result.Err(e) -> Lined.Bad("line {line}: {e}")

verify lines
    lines("", Option.None, [], 3) => Lined.Done(Option.None, 3)

fn afterHeader(dst: String, l: String, rest: List<String>, line: Int) -> Lined
    ? "The header line: its version is checked as the reader checks it, and its meta object is written after the signature."
    match Export.Reader.header(l)
        Result.Err(e) -> Lined.Bad("line 1: {e}")
        Result.Ok(v) -> match Export.Reader.supported(v)
            false -> Lined.Bad("format version {v} is not supported")
            true -> lines(dst, Option.Some(started(dst, metaText(l))), rest, line + 1)

verify afterHeader
    afterHeader("", "[]", [], 1) => Lined.Bad("line 1: the header is not an object")

fn metaText(l: String) -> String
    ? "The meta object of the header line: the text between the meta key and the last brace."
    String.slice(l, 8, String.len(l) - 1)

verify metaText
    metaText("{{\"meta\":{{\"a\":1}}}}") => "{{\"a\":1}}"

fn started(dst: String, meta: String) -> P
    ? "The signature SUSZ, the version 0, three bytes kept zero, then the meta text."
    out = text(List.reverse([83, 85, 83, 90, 0, 0, 0, 0]), meta)
    P(path = dst, out = out, written = 0, start = List.len(out), names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {}))

verify started
    started("x", "ab").start => 11

fn octetsOnto(xs: List<Int>, acc: List<Int>) -> List<Int>
    ? "xs put onto the reversed output."
    match xs
        [] -> acc
        [x, ..rest] -> octetsOnto(rest, List.prepend(x, acc))

verify octetsOnto
    octetsOnto([1, 2], [0]) => [2, 1, 0]

fn uv(acc: List<Int>, n: Int) -> List<Int>
    ? "n as a varint, little-endian base 128, onto the reversed output."
    match n < 128
        true -> List.prepend(n, acc)
        false -> uv(List.prepend(Int.mod(n, 128) + 128, acc), Int.div(n, 128))

verify uv
    uv([], 5) => [5]
    uv([], 300) => [2, 172]

fn u32(acc: List<Int>, n: Int) -> List<Int>
    ? "n as four bytes, little-endian."
    octetsOnto([Int.mod(n, 256), Int.mod(Int.div(n, 256), 256), Int.mod(Int.div(n, 65536), 256), Int.mod(Int.div(n, 16777216), 256)], acc)

verify u32
    u32([], 513) => [0, 0, 2, 1]

fn u64(acc: List<Int>, n: Int) -> List<Int>
    ? "n as eight bytes, little-endian."
    u32(u32(acc, Int.mod(n, 4294967296)), Int.div(n, 4294967296))

verify u64
    List.len(u64([], 1)) => 8

fn text(acc: List<Int>, s: String) -> List<Int>
    ? "A string: its length in bytes, then its UTF-8 bytes."
    b = String.toUtf8(s)
    octetsOnto(Bytes.octets(b), uv(acc, Bytes.len(b)))

verify text
    text([], "hi") => [105, 104, 2]

fn ids(acc: List<Int>, xs: List<Int>) -> List<Int>
    ? "A list of ids: its length, then each."
    idsOnto(uv(acc, List.len(xs)), xs)

fn idsOnto(acc: List<Int>, xs: List<Int>) -> List<Int>
    ? "Each id."
    match xs
        [] -> acc
        [x, ..rest] -> idsOnto(uv(acc, x), rest)

verify idsOnto
    idsOnto([], [1, 2]) => [2, 1]

verify ids
    ids([], [1, 2]) => [2, 1, 2]

fn flushed(p: Option<P>) -> Result<Option<P>, String>
    ? "Appends what the lines packed so far gave to the file."
    ! [Disk.appendBytes]
    match p
        Option.None -> Result.Ok(p)
        Option.Some(q) -> Result.Ok(Option.Some(written(q)?))

fn written(q: P) -> Result<P, String>
    ? "The bytes of q's output appended to the file; a packer with no path keeps them (PackedInMemory)."
    ! [Disk.appendBytes]
    match q.path == ""
        true -> Result.Ok(q)
        false -> appended(q, Bytes.fromList(List.reverse(q.out))?)

fn appended(q: P, bs: Bytes) -> Result<P, String>
    ? "bs appended to the file."
    ! [Disk.appendBytes]
    match Disk.appendBytes(q.path, bs)
        Result.Err(e) -> Result.Err("cannot write: {e}")
        Result.Ok(_) -> Result.Ok(P(path = q.path, out = [], written = q.written + Bytes.len(bs), start = q.start, names = q.names, levels = q.levels, exprs = q.exprs, decls = q.decls, nr = q.nr, lr = q.lr, er = q.er))

fn finished(l: Lined) -> Result<P, String>
    ? "The packer after the last record."
    match l
        Lined.Bad(e) -> Result.Err(e)
        Lined.Done(Option.None, _) -> Result.Err("empty file")
        Lined.Done(Option.Some(q), _) -> Result.Ok(q)

verify finished
    finished(Lined.Bad("x")) => Result.Err("x")
    finished(Lined.Done(Option.None, 1)) => Result.Err("empty file")

fn trailer(q: P) -> List<Int>
    ? "The trailer, reversed: the four counts, the number of blocks, then for the one block its offset and length (u64) and the first name, level, expression and declaration it defines (u32); last the trailer's own length and the closing signature ZSUS (docs/susz.md)."
    counts = u32(u32(u32(u32([], q.names), q.levels), q.exprs), q.decls)
    block = u32(u32(u32(u32(u64(u64(u32(counts, 1), q.start), q.written - q.start), 1), 1), 0), 0)
    octetsOnto([90, 83, 85, 83], u32(block, List.len(block) + 8))

verify trailer
    List.len(trailer(P(path = "", out = [], written = 10, start = 4, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})))) => 60

fn trailed(q: P) -> Result<String, String>
    ? "The trailer appended."
    ! [Disk.appendBytes]
    t = trailer(q)
    match Disk.appendBytes(q.path, Bytes.fromList(List.reverse(t))?)
        Result.Err(e) -> Result.Err("cannot write: {e}")
        Result.Ok(_) -> Result.Ok("names {q.names - 1}, levels {q.levels - 1}, expressions {q.exprs}, declarations {q.decls}, {q.written + List.len(t)} bytes")

fn withName(q: P, i: Int, out: List<Int>) -> P
    ? "q with a name record appended: the file's name i is the next Susz name."
    P(path = q.path, out = out, written = q.written, start = q.start, names = q.names + 1, levels = q.levels, exprs = q.exprs, decls = q.decls, nr = define(q.nr, i, q.names), lr = q.lr, er = q.er)

fn withLevel(q: P, i: Int, out: List<Int>) -> P
    ? "q with a level record appended."
    P(path = q.path, out = out, written = q.written, start = q.start, names = q.names, levels = q.levels + 1, exprs = q.exprs, decls = q.decls, nr = q.nr, lr = define(q.lr, i, q.levels), er = q.er)

fn withExpr(q: P, i: Int, out: List<Int>) -> P
    ? "q with an expression record appended."
    P(path = q.path, out = out, written = q.written, start = q.start, names = q.names, levels = q.levels, exprs = q.exprs + 1, decls = q.decls, nr = q.nr, lr = q.lr, er = define(q.er, i, q.exprs))

fn withDecl(q: P, out: List<Int>) -> P
    ? "q with a declaration record appended."
    P(path = q.path, out = out, written = q.written, start = q.start, names = q.names, levels = q.levels, exprs = q.exprs, decls = q.decls + 1, nr = q.nr, lr = q.lr, er = q.er)

verify withName
    withName(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), 1, [7]).names => 2

verify withLevel
    withLevel(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), 1, [7]).levels => 2

verify withExpr
    withExpr(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), 0, [7]).exprs => 1

verify withDecl
    withDecl(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), [7]).decls => 1

fn back(q: P, e: Int) -> Result<Int, String>
    ? "How far back expression e is from the next one: at least 1, since only earlier expressions may be named."
    k = lookup(q.er, e)
    match k < 0
        true -> Result.Err("unknown expression index {e}")
        false -> Result.Ok(q.exprs - k)

verify back
    back(P(path = "", out = [], written = 0, start = 0, names = 2, levels = 2, exprs = 2, decls = 0, nr = Ren(below = 2, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 2, m = {})), 0) => Result.Ok(2)
    back(P(path = "", out = [], written = 0, start = 0, names = 2, levels = 2, exprs = 2, decls = 0, nr = Ren(below = 2, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 2, m = {})), 2) => Result.Err("unknown expression index 2")

fn binderByte(bi: Binder) -> Int
    ? "The binder annotation as a byte."
    match bi
        Binder.Default -> 0
        Binder.Implicit -> 1
        Binder.StrictImplicit -> 2
        Binder.InstImplicit -> 3

verify binderByte
    binderByte(Binder.InstImplicit) => 3

fn boolByte(x: Bool) -> Int
    ? "0 or 1."
    match x
        true -> 1
        false -> 0

verify boolByte
    boolByte(true) => 1

fn fresh(r: Ren, kind: String, i: Int) -> Result<Int, String>
    ? "An index a line defines must not be bound already, as the reader's tables require; i when it is not."
    match lookup(r, i) < 0
        true -> Result.Ok(i)
        false -> Result.Err("{kind} index {i} is already bound")

verify fresh
    fresh(Ren(below = 1, m = {}), "name", 0) => Result.Err("name index 0 is already bound")
    fresh(Ren(below = 1, m = {}), "name", 1) => Result.Ok(1)

fn defined(q: P, l: Line) -> Result<Line, String>
    ? "The line, once the index it defines is known to be fresh."
    match l
        Line.App(ie, _, _) -> keep(l, fresh(q.er, "expression", ie))
        Line.Bind(b) -> keep(l, fresh(q.er, "expression", b.ie))
        Line.BVar(ie, _) -> keep(l, fresh(q.er, "expression", ie))
        Line.Sort(ie, _) -> keep(l, fresh(q.er, "expression", ie))
        Line.Const(ie, _, _) -> keep(l, fresh(q.er, "expression", ie))
        Line.LetE(ie, _, _, _, _) -> keep(l, fresh(q.er, "expression", ie))
        Line.NameStr(i, _, _) -> keep(l, fresh(q.nr, "name", i))
        Line.NameNum(i, _, _) -> keep(l, fresh(q.nr, "name", i))
        Line.LevelSucc(i, _) -> keep(l, fresh(q.lr, "level", i))
        Line.LevelParam(i, _) -> keep(l, fresh(q.lr, "level", i))
        Line.LevelPair(i, _, _, _) -> keep(l, fresh(q.lr, "level", i))
        _ -> Result.Ok(l)

verify defined
    defined(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), Line.NameNum(0, 0, 1)) => Result.Err("name index 0 is already bound")
    defined(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), Line.Blank) => Result.Ok(Line.Blank)

fn keep(l: Line, r: Result<Int, String>) -> Result<Line, String>
    ? "l when its index is fresh."
    match r
        Result.Ok(_) -> Result.Ok(l)
        Result.Err(e) -> Result.Err(e)

verify keep
    keep(Line.Blank, Result.Err("x")) => Result.Err("x")
    keep(Line.Blank, Result.Ok(1)) => Result.Ok(Line.Blank)

fn lineOf(q: P, l: Line) -> Result<P, String>
    ? "One parsed line as a record, once the index it defines is known to be fresh."
    recordOf(q, defined(q, l)?)

verify lineOf
    lineOf(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), Line.NameNum(0, 0, 1)) => Result.Err("name index 0 is already bound")

fn recordOf(q: P, l: Line) -> Result<P, String>
    ? "One parsed line as a record."
    match l
        Line.App(ie, f, a) -> app(q, ie, f, a)
        Line.Bind(b) -> binder(q, b.ie, b.nameIdx, b.typeIdx, b.bodyIdx, b.bi, b.isLam)
        Line.NameStr(i, pre, s) -> nameStr(q, i, pre, s)
        Line.NameNum(i, pre, k) -> nameNum(q, i, pre, k)
        Line.LevelSucc(i, a) -> succ(q, i, a)
        Line.LevelParam(i, n) -> param(q, i, n)
        Line.LevelPair(i, a, b, isMax) -> levelPair(q, i, a, b, isMax)
        Line.BVar(ie, k) -> Result.Ok(withExpr(q, ie, uv(List.prepend(7, q.out), k)))
        Line.Sort(ie, lev) -> sort(q, ie, lev)
        Line.Const(ie, n, us) -> cnst(q, ie, n, us)
        Line.LetE(ie, n, ty, v, b) -> letE(q, ie, n, ty, v, b)
        Line.Thm(d) -> thm(q, d.name, d.params, d.ty, d.value, d.all)
        Line.Defn(d, h, s) -> defn(q, d.name, d.params, d.ty, d.value, h, s, d.all)
        Line.Obj(fs) -> obj(q, fs)
        Line.Blank -> Result.Ok(q)
        Line.Bad(e) -> Result.Err(e)

verify recordOf
    recordOf(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), Line.Bad("x")) => Result.Err("x")
    Result.withDefault(recordOf(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), Line.BVar(9, 0)), P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {}))).exprs => 1

fn app(q: P, ie: Int, f: Int, a: Int) -> Result<P, String>
    ? "10: how far back the function and the argument are."
    df = back(q, f)?
    da = back(q, a)?
    Result.Ok(withExpr(q, ie, uv(uv(List.prepend(10, q.out), df), da)))

verify app
    app(P(path = "", out = [], written = 0, start = 0, names = 2, levels = 2, exprs = 2, decls = 0, nr = Ren(below = 2, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 2, m = {})), 2, 0, 1) => Result.Ok(P(path = "", out = [1, 2, 10], written = 0, start = 0, names = 2, levels = 2, exprs = 3, decls = 0, nr = Ren(below = 2, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 3, m = {})))
    app(P(path = "", out = [], written = 0, start = 0, names = 2, levels = 2, exprs = 2, decls = 0, nr = Ren(below = 2, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 2, m = {})), 7, 0, 1) => Result.Ok(P(path = "", out = [1, 2, 10], written = 0, start = 0, names = 2, levels = 2, exprs = 3, decls = 0, nr = Ren(below = 2, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 2, m = {7 => 2})))

fn binder(q: P, ie: Int, n: Int, ty: Int, body: Int, bi: Binder, isLam: Bool) -> Result<P, String>
    ? "11 lambda, 12 pi: the binder annotation, the name, how far back the type and the body are."
    nn = nm(q, n)?
    dt = back(q, ty)?
    db = back(q, body)?
    Result.Ok(withExpr(q, ie, uv(uv(uv(List.prepend(binderByte(bi), List.prepend(binderTag(isLam), q.out)), nn), dt), db)))

verify binder
    binder(P(path = "", out = [], written = 0, start = 0, names = 2, levels = 2, exprs = 2, decls = 0, nr = Ren(below = 2, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 2, m = {})), 2, 1, 0, 1, Binder.Default, true) => Result.Ok(P(path = "", out = [1, 2, 1, 0, 11], written = 0, start = 0, names = 2, levels = 2, exprs = 3, decls = 0, nr = Ren(below = 2, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 3, m = {})))

fn binderTag(isLam: Bool) -> Int
    ? "11 for a lambda, 12 for a pi."
    match isLam
        true -> 11
        false -> 12

verify binderTag
    binderTag(false) => 12

fn sort(q: P, ie: Int, l: Int) -> Result<P, String>
    ? "8: the sort of a level."
    k = lv(q, l)?
    Result.Ok(withExpr(q, ie, uv(List.prepend(8, q.out), k)))

verify sort
    sort(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), 0, 4) => Result.Err("unknown level index 4")

fn cnst(q: P, ie: Int, n: Int, us: List<Int>) -> Result<P, String>
    ? "9: a constant's name and levels."
    nn = nm(q, n)?
    ls = lvs(q, us, [])?
    Result.Ok(withExpr(q, ie, ids(uv(List.prepend(9, q.out), nn), ls)))

verify cnst
    Result.withDefault(cnst(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), 0, 0, [0]), P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {}))).exprs => 1

fn letE(q: P, ie: Int, n: Int, ty: Int, v: Int, b: Int) -> Result<P, String>
    ? "13: the name, how far back the type, the value and the body are."
    nn = nm(q, n)?
    dt = back(q, ty)?
    dv = back(q, v)?
    db = back(q, b)?
    Result.Ok(withExpr(q, ie, uv(uv(uv(uv(List.prepend(13, q.out), nn), dt), dv), db)))

verify letE
    letE(P(path = "", out = [], written = 0, start = 0, names = 2, levels = 2, exprs = 2, decls = 0, nr = Ren(below = 2, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 2, m = {})), 2, 0, 0, 1, 0) => Result.Ok(P(path = "", out = [2, 1, 2, 0, 13], written = 0, start = 0, names = 2, levels = 2, exprs = 3, decls = 0, nr = Ren(below = 2, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 3, m = {})))

fn nameStr(q: P, i: Int, pre: Int, s: String) -> Result<P, String>
    ? "1: the prefix and the text."
    k = nm(q, pre)?
    Result.Ok(withName(q, i, text(uv(List.prepend(1, q.out), k), s)))

verify nameStr
    Result.withDefault(nameStr(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), 1, 0, "a"), P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {}))).names => 2

fn nameNum(q: P, i: Int, pre: Int, k: Int) -> Result<P, String>
    ? "2: the prefix and the number."
    p = nm(q, pre)?
    Result.Ok(withName(q, i, uv(uv(List.prepend(2, q.out), p), k)))

verify nameNum
    nameNum(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), 1, 0, 4) => Result.Ok(P(path = "", out = [4, 0, 2], written = 0, start = 0, names = 2, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 2, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})))

fn succ(q: P, i: Int, a: Int) -> Result<P, String>
    ? "3: the successor of a level."
    k = lv(q, a)?
    Result.Ok(withLevel(q, i, uv(List.prepend(3, q.out), k)))

verify succ
    succ(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), 1, 0) => Result.Ok(P(path = "", out = [0, 3], written = 0, start = 0, names = 1, levels = 2, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 0, m = {})))

fn param(q: P, i: Int, n: Int) -> Result<P, String>
    ? "6: a universe parameter by its name."
    k = nm(q, n)?
    Result.Ok(withLevel(q, i, uv(List.prepend(6, q.out), k)))

verify param
    param(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), 1, 3) => Result.Err("unknown name index 3")

fn levelPair(q: P, i: Int, a: Int, b: Int, isMax: Bool) -> Result<P, String>
    ? "4 max, 5 imax of two levels."
    ka = lv(q, a)?
    kb = lv(q, b)?
    Result.Ok(withLevel(q, i, uv(uv(List.prepend(pairTag(isMax), q.out), ka), kb)))

verify levelPair
    levelPair(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), 1, 0, 0, false) => Result.Ok(P(path = "", out = [0, 0, 5], written = 0, start = 0, names = 1, levels = 2, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 0, m = {})))

fn pairTag(isMax: Bool) -> Int
    ? "4 for max, 5 for imax."
    match isMax
        true -> 4
        false -> 5

verify pairTag
    pairTag(true) => 4

fn head(q: P, acc: List<Int>, name: Int, params: List<Int>, ty: Int) -> Result<List<Int>, String>
    ? "A declaration's name, universe parameters and how far back its type is."
    n = nm(q, name)?
    ps = nms(q, params, [])?
    dt = back(q, ty)?
    Result.Ok(uv(ids(uv(acc, n), ps), dt))

verify head
    head(P(path = "", out = [], written = 0, start = 0, names = 2, levels = 2, exprs = 2, decls = 0, nr = Ren(below = 2, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 2, m = {})), [], 1, [], 0) => Result.Ok([2, 0, 1])

fn thm(q: P, name: Int, params: List<Int>, ty: Int, v: Int, all: List<Int>) -> Result<P, String>
    ? "Kind 2: head, value, group."
    h = head(q, List.prepend(2, List.prepend(18, q.out)), name, params, ty)?
    dv = back(q, v)?
    group = nms(q, all, [])?
    Result.Ok(withDecl(q, ids(uv(h, dv), group)))

verify thm
    thm(P(path = "", out = [], written = 0, start = 0, names = 2, levels = 2, exprs = 2, decls = 0, nr = Ren(below = 2, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 2, m = {})), 1, [], 0, 1, [1]) => Result.Ok(P(path = "", out = [1, 1, 1, 2, 0, 1, 2, 18], written = 0, start = 0, names = 2, levels = 2, exprs = 2, decls = 1, nr = Ren(below = 2, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 2, m = {})))

fn hintsOnto(acc: List<Int>, h: Hints) -> List<Int>
    ? "0 opaque, 1 abbrev, 2 and the height for regular."
    match h
        Hints.Opaque -> List.prepend(0, acc)
        Hints.Abbrev -> List.prepend(1, acc)
        Hints.Regular(k) -> uv(List.prepend(2, acc), k)

verify hintsOnto
    hintsOnto([], Hints.Regular(3)) => [3, 2]

fn safetyByte(s: Safety) -> Int
    ? "0 safe, 1 unsafe, 2 partial."
    match s
        Safety.Safe -> 0
        Safety.Unsafe -> 1
        Safety.Partial -> 2

verify safetyByte
    safetyByte(Safety.Partial) => 2

fn defn(q: P, name: Int, params: List<Int>, ty: Int, v: Int, h: Hints, s: Safety, all: List<Int>) -> Result<P, String>
    ? "Kind 1: head, value, hints, safety, group."
    hd = head(q, List.prepend(1, List.prepend(18, q.out)), name, params, ty)?
    dv = back(q, v)?
    group = nms(q, all, [])?
    Result.Ok(withDecl(q, ids(List.prepend(safetyByte(s), hintsOnto(uv(hd, dv), h)), group)))

verify defn
    defn(P(path = "", out = [], written = 0, start = 0, names = 2, levels = 2, exprs = 2, decls = 0, nr = Ren(below = 2, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 2, m = {})), 1, [], 0, 1, Hints.Abbrev, Safety.Safe, []) => Result.Ok(P(path = "", out = [0, 0, 1, 1, 2, 0, 1, 1, 18], written = 0, start = 0, names = 2, levels = 2, exprs = 2, decls = 1, nr = Ren(below = 2, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 2, m = {})))

fn obj(q: P, fs: List<Tuple<String, J>>) -> Result<P, String>
    ? "A line the reader parses as JSON: a declaration when it has a single key, otherwise a name, level or expression by its index key."
    match fs
        [(k, J.JObj(o))] -> declObj(q, k, o)
        _ -> match Json.Access.has(fs, "ie")
            true -> exprObj(q, fresh(q.er, "expression", Json.Access.int(fs, "ie")?)?, fs)
            false -> match Json.Access.has(fs, "in")
                true -> nameObj(q, fresh(q.nr, "name", Json.Access.int(fs, "in")?)?, fs)
                false -> match Json.Access.has(fs, "il")
                    true -> levelObj(q, fresh(q.lr, "level", Json.Access.int(fs, "il")?)?, fs)
                    false -> Result.Err("unrecognised line")

verify obj
    obj(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), []) => Result.Err("unrecognised line")

fn nameObj(q: P, i: Int, fs: List<Tuple<String, J>>) -> Result<P, String>
    ? "A name line in a form the reader parses as JSON."
    match Json.Access.has(fs, "str")
        true -> nameStrObj(q, i, Json.Access.obj(fs, "str")?)
        false -> nameNumObj(q, i, Json.Access.obj(fs, "num")?)

verify nameObj
    Result.withDefault(nameObj(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), 1, [("num", J.JObj([("i", J.JInt(4)), ("pre", J.JInt(0))]))]), P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {}))).names => 2

fn nameStrObj(q: P, i: Int, o: List<Tuple<String, J>>) -> Result<P, String>
    ? "Its prefix and text."
    nameStr(q, i, Json.Access.int(o, "pre")?, Json.Access.text(o, "str")?)

fn nameNumObj(q: P, i: Int, o: List<Tuple<String, J>>) -> Result<P, String>
    ? "Its prefix and number."
    nameNum(q, i, Json.Access.int(o, "pre")?, Json.Access.int(o, "i")?)

fn levelObj(q: P, i: Int, fs: List<Tuple<String, J>>) -> Result<P, String>
    ? "A level line in a form the reader parses as JSON."
    match Json.Access.has(fs, "succ")
        true -> succ(q, i, Json.Access.int(fs, "succ")?)
        false -> match Json.Access.has(fs, "param")
            true -> param(q, i, Json.Access.int(fs, "param")?)
            false -> match Json.Access.has(fs, "max")
                true -> pairObj(q, i, Json.Access.ints(fs, "max")?, true)
                false -> pairObj(q, i, Json.Access.ints(fs, "imax")?, false)

verify levelObj
    Result.withDefault(levelObj(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), 1, [("succ", J.JInt(0))]), P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {}))).levels => 2

fn pairObj(q: P, i: Int, xs: List<Int>, isMax: Bool) -> Result<P, String>
    ? "Exactly two levels."
    match xs
        [a, b] -> levelPair(q, i, a, b, isMax)
        _ -> Result.Err("max and imax take exactly two levels")

verify pairObj
    pairObj(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), 1, [0], true) => Result.Err("max and imax take exactly two levels")

fn exprObj(q: P, ie: Int, fs: List<Tuple<String, J>>) -> Result<P, String>
    ? "An expression line in a form the reader parses as JSON."
    match Json.Access.has(fs, "app")
        true -> appObj(q, ie, Json.Access.obj(fs, "app")?)
        false -> match Json.Access.has(fs, "lam")
            true -> binderObj(q, ie, Json.Access.obj(fs, "lam")?, true)
            false -> match Json.Access.has(fs, "forallE")
                true -> binderObj(q, ie, Json.Access.obj(fs, "forallE")?, false)
                false -> exprRest(q, ie, fs)

verify exprObj
    Result.withDefault(exprObj(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), 0, [("bvar", J.JInt(0))]), P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {}))).exprs => 1

fn appObj(q: P, ie: Int, o: List<Tuple<String, J>>) -> Result<P, String>
    ? "Function and argument."
    app(q, ie, Json.Access.int(o, "fn")?, Json.Access.int(o, "arg")?)

fn binderObj(q: P, ie: Int, o: List<Tuple<String, J>>, isLam: Bool) -> Result<P, String>
    ? "Name, type, body and annotation."
    bi = binderOf(Json.Access.text(o, "binderInfo")?)?
    binder(q, ie, Json.Access.int(o, "name")?, Json.Access.int(o, "type")?, Json.Access.int(o, "body")?, bi, isLam)

verify binderObj
    binderObj(P(path = "", out = [], written = 0, start = 0, names = 2, levels = 2, exprs = 2, decls = 0, nr = Ren(below = 2, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 2, m = {})), 2, [("binderInfo", J.JStr("x"))], true) => Result.Err("unknown binderInfo 'x'")

fn binderOf(s: String) -> Result<Binder, String>
    ? "The four binder annotations."
    match s
        "default" -> Result.Ok(Binder.Default)
        "implicit" -> Result.Ok(Binder.Implicit)
        "strictImplicit" -> Result.Ok(Binder.StrictImplicit)
        "instImplicit" -> Result.Ok(Binder.InstImplicit)
        _ -> Result.Err("unknown binderInfo '{s}'")

verify binderOf
    binderOf("x") => Result.Err("unknown binderInfo 'x'")

fn exprRest(q: P, ie: Int, fs: List<Tuple<String, J>>) -> Result<P, String>
    ? "The less common expression kinds."
    match Json.Access.has(fs, "bvar")
        true -> Result.Ok(withExpr(q, ie, uv(List.prepend(7, q.out), Json.Access.int(fs, "bvar")?)))
        false -> match Json.Access.has(fs, "sort")
            true -> sort(q, ie, Json.Access.int(fs, "sort")?)
            false -> match Json.Access.has(fs, "const")
                true -> constObj(q, ie, Json.Access.obj(fs, "const")?)
                false -> exprRarer(q, ie, fs)

verify exprRest
    Result.withDefault(exprRest(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), 0, [("sort", J.JInt(0))]), P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {}))).exprs => 1

fn constObj(q: P, ie: Int, o: List<Tuple<String, J>>) -> Result<P, String>
    ? "Name and levels."
    cnst(q, ie, Json.Access.int(o, "name")?, Json.Access.ints(o, "us")?)

fn exprRarer(q: P, ie: Int, fs: List<Tuple<String, J>>) -> Result<P, String>
    ? "Lets, literals, projections and metadata."
    match Json.Access.has(fs, "letE")
        true -> letObj(q, ie, Json.Access.obj(fs, "letE")?)
        false -> match Json.Access.has(fs, "natVal")
            true -> Result.Ok(withExpr(q, ie, text(List.prepend(14, q.out), Json.Access.text(fs, "natVal")?)))
            false -> match Json.Access.has(fs, "strVal")
                true -> Result.Ok(withExpr(q, ie, text(List.prepend(15, q.out), Json.Access.text(fs, "strVal")?)))
                false -> match Json.Access.has(fs, "proj")
                    true -> projObj(q, ie, Json.Access.obj(fs, "proj")?)
                    false -> match Json.Access.has(fs, "mdata")
                        true -> mdataObj(q, ie, Json.Access.obj(fs, "mdata")?)
                        false -> Result.Err("unknown expression kind")

verify exprRarer
    exprRarer(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), 0, []) => Result.Err("unknown expression kind")

fn letObj(q: P, ie: Int, o: List<Tuple<String, J>>) -> Result<P, String>
    ? "Name, type, value and body."
    letE(q, ie, Json.Access.int(o, "name")?, Json.Access.int(o, "type")?, Json.Access.int(o, "value")?, Json.Access.int(o, "body")?)

fn projObj(q: P, ie: Int, o: List<Tuple<String, J>>) -> Result<P, String>
    ? "Structure name, field index and how far back the structure is."
    ds = back(q, Json.Access.int(o, "struct")?)?
    n = nm(q, Json.Access.int(o, "typeName")?)?
    Result.Ok(withExpr(q, ie, uv(uv(uv(List.prepend(16, q.out), n), Json.Access.int(o, "idx")?), ds)))

verify projObj
    projObj(P(path = "", out = [], written = 0, start = 0, names = 2, levels = 2, exprs = 2, decls = 0, nr = Ren(below = 2, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 2, m = {})), 2, [("idx", J.JInt(0)), ("struct", J.JInt(5)), ("typeName", J.JInt(1))]) => Result.Err("unknown expression index 5")

fn mdataObj(q: P, ie: Int, o: List<Tuple<String, J>>) -> Result<P, String>
    ? "How far back the wrapped expression is."
    d = back(q, Json.Access.int(o, "expr")?)?
    Result.Ok(withExpr(q, ie, uv(List.prepend(17, q.out), d)))

verify mdataObj
    Result.withDefault(mdataObj(P(path = "", out = [], written = 0, start = 0, names = 2, levels = 2, exprs = 2, decls = 0, nr = Ren(below = 2, m = {}), lr = Ren(below = 2, m = {}), er = Ren(below = 2, m = {})), 2, [("expr", J.JInt(1))]), P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {}))).exprs => 3

fn declObj(q: P, k: String, o: List<Tuple<String, J>>) -> Result<P, String>
    ? "A declaration line by its kind."
    match k
        "axiom" -> axiomObj(q, o)
        "def" -> defObj(q, o)
        "thm" -> thm(q, Json.Access.int(o, "name")?, Json.Access.ints(o, "levelParams")?, Json.Access.int(o, "type")?, Json.Access.int(o, "value")?, Json.Access.ints(o, "all")?)
        "opaque" -> opaqueObj(q, o)
        "quot" -> quotObj(q, o)
        "inductive" -> inductiveObj(q, o)
        _ -> Result.Err("unknown declaration kind '{k}'")

verify declObj
    declObj(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), "lemma", []) => Result.Err("unknown declaration kind 'lemma'")

fn headObj(q: P, acc: List<Int>, o: List<Tuple<String, J>>) -> Result<List<Int>, String>
    ? "name, levelParams and type."
    head(q, acc, Json.Access.int(o, "name")?, Json.Access.ints(o, "levelParams")?, Json.Access.int(o, "type")?)

fn axiomObj(q: P, o: List<Tuple<String, J>>) -> Result<P, String>
    ? "Decl kind 0: head, unsafe."
    h = headObj(q, List.prepend(0, List.prepend(18, q.out)), o)?
    Result.Ok(withDecl(q, List.prepend(boolByte(Json.Access.bool(o, "isUnsafe")?), h)))

verify axiomObj
    axiomObj(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), []) => Result.Err("missing key 'name'")

fn defObj(q: P, o: List<Tuple<String, J>>) -> Result<P, String>
    ? "A definition the reader parses as JSON."
    h = hintsObj(Json.Access.need(o, "hints")?)?
    s = safetyObj(Json.Access.text(o, "safety")?)?
    defn(q, Json.Access.int(o, "name")?, Json.Access.ints(o, "levelParams")?, Json.Access.int(o, "type")?, Json.Access.int(o, "value")?, h, s, Json.Access.ints(o, "all")?)

verify defObj
    defObj(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), []) => Result.Err("missing key 'hints'")

fn hintsObj(j: J) -> Result<Hints, String>
    ? "opaque, abbrev or a regular height."
    match j
        J.JStr("opaque") -> Result.Ok(Hints.Opaque)
        J.JStr("abbrev") -> Result.Ok(Hints.Abbrev)
        J.JObj(fs) -> Result.Ok(Hints.Regular(Json.Access.int(fs, "regular")?))
        _ -> Result.Err("malformed hints")

verify hintsObj
    hintsObj(J.JStr("abbrev")) => Result.Ok(Hints.Abbrev)

fn safetyObj(s: String) -> Result<Safety, String>
    ? "safe, unsafe or partial."
    match s
        "safe" -> Result.Ok(Safety.Safe)
        "unsafe" -> Result.Ok(Safety.Unsafe)
        "partial" -> Result.Ok(Safety.Partial)
        _ -> Result.Err("unknown safety '{s}'")

verify safetyObj
    safetyObj("x") => Result.Err("unknown safety 'x'")

fn opaqueObj(q: P, o: List<Tuple<String, J>>) -> Result<P, String>
    ? "Decl kind 3: head, value, unsafe, group."
    h = headObj(q, List.prepend(3, List.prepend(18, q.out)), o)?
    dv = back(q, Json.Access.int(o, "value")?)?
    group = nms(q, Json.Access.ints(o, "all")?, [])?
    Result.Ok(withDecl(q, ids(List.prepend(boolByte(Json.Access.bool(o, "isUnsafe")?), uv(h, dv)), group)))

verify opaqueObj
    opaqueObj(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), []) => Result.Err("missing key 'name'")

fn quotObj(q: P, o: List<Tuple<String, J>>) -> Result<P, String>
    ? "Decl kind 4: head and which quotient constant."
    h = headObj(q, List.prepend(4, List.prepend(18, q.out)), o)?
    k = quotByte(Json.Access.text(o, "kind")?)?
    Result.Ok(withDecl(q, List.prepend(k, h)))

verify quotObj
    quotObj(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), []) => Result.Err("missing key 'name'")

fn quotByte(s: String) -> Result<Int, String>
    ? "0 type, 1 ctor, 2 lift, 3 ind."
    match s
        "type" -> Result.Ok(0)
        "ctor" -> Result.Ok(1)
        "lift" -> Result.Ok(2)
        "ind" -> Result.Ok(3)
        _ -> Result.Err("unknown quot kind '{s}'")

verify quotByte
    quotByte("ind") => Result.Ok(3)

fn inductiveObj(q: P, o: List<Tuple<String, J>>) -> Result<P, String>
    ? "Decl kind 5: the types, constructors and recursors, each list with its length first."
    ts = Json.Access.arr(o, "types")?
    cs = Json.Access.arr(o, "ctors")?
    rs = Json.Access.arr(o, "recs")?
    a = listOnto(q, uv(List.prepend(5, List.prepend(18, q.out)), List.len(ts)), ts, 0)?
    b = listOnto(q, uv(a, List.len(cs)), cs, 1)?
    c = listOnto(q, uv(b, List.len(rs)), rs, 2)?
    Result.Ok(withDecl(q, c))

verify inductiveObj
    Result.withDefault(inductiveObj(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), [("ctors", J.JArr([])), ("recs", J.JArr([])), ("types", J.JArr([]))]), P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {}))).decls => 1

fn listOnto(q: P, acc: List<Int>, xs: List<J>, kind: Int) -> Result<List<Int>, String>
    ? "Each type (kind 0), constructor (1) or recursor (2) of a block."
    match xs
        [] -> Result.Ok(acc)
        [J.JObj(o), ..rest] -> listOnto(q, partOnto(q, acc, o, kind)?, rest, kind)
        _ -> Result.Err("expected an object")

verify listOnto
    listOnto(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), [], [J.JNull], 0) => Result.Err("expected an object")

fn partOnto(q: P, acc: List<Int>, o: List<Tuple<String, J>>, kind: Int) -> Result<List<Int>, String>
    ? "One part of an inductive block, its head first."
    h = headObj(q, acc, o)?
    match kind
        0 -> typeOnto(q, h, o)
        1 -> ctorOnto(q, h, o)
        _ -> recOnto(q, h, o)

verify partOnto
    partOnto(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), [], [], 0) => Result.Err("missing key 'name'")

fn typeOnto(q: P, h: List<Int>, o: List<Tuple<String, J>>) -> Result<List<Int>, String>
    ? "unsafe, numParams, numIndices, all, ctors, numNested, isRec, isReflexive."
    a = uv(uv(List.prepend(boolByte(Json.Access.bool(o, "isUnsafe")?), h), Json.Access.int(o, "numParams")?), Json.Access.int(o, "numIndices")?)
    b = uv(ids(ids(a, nms(q, Json.Access.ints(o, "all")?, [])?), nms(q, Json.Access.ints(o, "ctors")?, [])?), Json.Access.int(o, "numNested")?)
    Result.Ok(List.prepend(boolByte(Json.Access.bool(o, "isReflexive")?), List.prepend(boolByte(Json.Access.bool(o, "isRec")?), b)))

verify typeOnto
    typeOnto(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), [], []) => Result.Err("missing key 'isUnsafe'")

fn ctorOnto(q: P, h: List<Int>, o: List<Tuple<String, J>>) -> Result<List<Int>, String>
    ? "unsafe, induct, cidx, numParams, numFields."
    a = uv(List.prepend(boolByte(Json.Access.bool(o, "isUnsafe")?), h), nm(q, Json.Access.int(o, "induct")?)?)
    Result.Ok(uv(uv(uv(a, Json.Access.int(o, "cidx")?), Json.Access.int(o, "numParams")?), Json.Access.int(o, "numFields")?))

verify ctorOnto
    ctorOnto(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), [], []) => Result.Err("missing key 'isUnsafe'")

fn recOnto(q: P, h: List<Int>, o: List<Tuple<String, J>>) -> Result<List<Int>, String>
    ? "unsafe, all, numParams, numIndices, numMotives, numMinors, rules, k."
    a = ids(List.prepend(boolByte(Json.Access.bool(o, "isUnsafe")?), h), nms(q, Json.Access.ints(o, "all")?, [])?)
    b = uv(uv(uv(uv(a, Json.Access.int(o, "numParams")?), Json.Access.int(o, "numIndices")?), Json.Access.int(o, "numMotives")?), Json.Access.int(o, "numMinors")?)
    rules = Json.Access.arr(o, "rules")?
    c = rulesOnto(q, uv(b, List.len(rules)), rules)?
    Result.Ok(List.prepend(boolByte(Json.Access.bool(o, "k")?), c))

verify recOnto
    recOnto(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), [], []) => Result.Err("missing key 'isUnsafe'")

fn rulesOnto(q: P, acc: List<Int>, xs: List<J>) -> Result<List<Int>, String>
    ? "Each rule: ctor, nfields and how far back its right-hand side is."
    match xs
        [] -> Result.Ok(acc)
        [J.JObj(o), ..rest] -> rulesOnto(q, uv(uv(uv(acc, nm(q, Json.Access.int(o, "ctor")?)?), Json.Access.int(o, "nfields")?), back(q, Json.Access.int(o, "rhs")?)?), rest)
        _ -> Result.Err("expected an object")

verify rulesOnto
    rulesOnto(P(path = "", out = [], written = 0, start = 0, names = 1, levels = 1, exprs = 0, decls = 0, nr = Ren(below = 1, m = {}), lr = Ren(below = 1, m = {}), er = Ren(below = 0, m = {})), [], [J.JNull]) => Result.Err("expected an object")


verify oneLaid
    Export.Split.laidMessage2(oneLaid(One(q = started("", "{{}}"), x = x00()))) == "" => false

fn capOf(r: Result<X, String>) -> Result<Int, String>
    ? "How many expressions x has room for, or why there is no x, for examples."
    match r
        Result.Ok(x) -> Result.Ok(x.cap)
        Result.Err(e) -> Result.Err(e)

verify capOf
    capOf(Result.Err("x")) => Result.Err("x")

verify oneLines
    oneLines(Option.None, x00(), [], 3) => OneLined.Done(Option.None, x00(), 3)
    oneLines(Option.None, x00(), ["[]"], 1) => OneLined.Bad("line 1: the header is not an object")

verify oneLine
    oneLine(started("", "{{}}"), x00(), Line.Bad("x"), [], 4) => OneLined.Bad("line 4: x")

verify oneNoted
    oneNoted(Result.Err("x"), started("", "{{}}"), [], 4) => OneLined.Bad("line 4: x")

verify oneHeader
    oneHeader("[]", x00(), [], 1) => OneLined.Bad("line 1: the header is not an object")

verify oneFinished
    oneFinished(OneLined.Bad("x")) => Result.Err("x")
    oneFinished(OneLined.Done(Option.None, x00(), 1)) => Result.Err("empty file")

verify noted
