module Stream
    intent =
        "Reads an export file a chunk at a time and feeds its lines in order,"
        "the header first. Only one chunk's text and lines are held at once:"
        "on mathlib the whole text is 5.9 GB and its lines as much again."
    exposes [Outcome, readFile]
    depends [Bytes, Export.Reader, Export.Tables]
    effects [Disk.readBytesAt]

type Outcome
    Read(Parsed)
    Rejected(String)
    Declined(String)

type Fed
    More(Tables, Int)
    Stop(Outcome)

fn readFile(path: String, workers: Int) -> Outcome
    ? "Reads and parses the whole file, a chunk at a time, the parsing shared out among workers."
    ! [Disk.readBytesAt]
    chunked(path, 0, "", Export.Tables.empty(), 1, workers)

fn chunkBytes() -> Int
    ? "How much of the file one chunk reads."
    67108864

verify chunkBytes
    chunkBytes() > 0 => true

fn chunked(path: String, offset: Int, carry: String, t: Tables, line: Int, workers: Int) -> Outcome
    ? "Reads the chunk at offset; carry is the unfinished last line of the chunk before. At the end of the file, carry is the last line."
    ! [Disk.readBytesAt]
    match Disk.readBytesAt(path, offset, chunkBytes())
        Result.Err(e) -> Outcome.Declined("cannot read {path}: {e}")
        Result.Ok(b) -> match Bytes.len(b) == 0
            true -> atEnd(feed(t, [carry], line, workers))
            false -> decoded(path, offset, carry, t, line, workers, b, 0)

fn decoded(path: String, offset: Int, carry: String, t: Tables, line: Int, workers: Int, b: Bytes, cut: Int) -> Outcome
    ? "The chunk as text, leaving out the bytes of a character its end cuts in two: at most three."
    ! [Disk.readBytesAt]
    match String.fromUtf8(Bytes.take(b, Bytes.len(b) - cut))
        Result.Ok(text) -> splitChunk(path, offset + Bytes.len(b) - cut, splitApart("{carry}{text}"), t, line, workers)
        Result.Err(e) -> match cut >= 3
            true -> Outcome.Declined("cannot read {path}: {e}")
            false -> decoded(path, offset, carry, t, line, workers, b, cut + 1)

fn splitApart(text: String) -> List<String>
    ? "The lines of a chunk, split on a thread of their own, so that their strings sit apart from the terms built from them and go back to the system once the chunk is read."
    match (linesIn(text), nothing())!
        (parts, _) -> parts

verify splitApart
    splitApart("a\nb") => ["a", "b"]

fn linesIn(text: String) -> List<String>
    ? "The lines of a text."
    String.split(text, "\n")

verify linesIn
    linesIn("a\nb") => ["a", "b"]

fn nothing() -> Int
    ? "The other half of the product splitApart runs."
    0

verify nothing
    nothing() => 0

fn splitChunk(path: String, next: Int, parts: List<String>, t: Tables, line: Int, workers: Int) -> Outcome
    ? "Feeds the chunk's complete lines; its last part is unfinished and waits for the next chunk."
    ! [Disk.readBytesAt]
    match feed(t, List.take(parts, List.len(parts) - 1), line, workers)
        Fed.Stop(o) -> o
        Fed.More(fed, at) -> chunked(path, next, lastPart(parts), fed, at, workers)

fn lastPart(parts: List<String>) -> String
    ? "The last of the parts a split gives; a split always gives at least one."
    match List.drop(parts, List.len(parts) - 1)
        [x, .._] -> x
        [] -> ""

verify lastPart
    lastPart(["a", "b"]) => "b"
    lastPart([""]) => ""

fn atEnd(f: Fed) -> Outcome
    ? "The verdict once the last line is fed."
    match f
        Fed.Stop(o) -> o
        Fed.More(t, line) -> ended(line, t)

verify atEnd
    atEnd(Fed.More(Export.Tables.empty(), 1)) => Outcome.Rejected("empty file")

fn whole(lines: List<String>, workers: Int) -> Outcome
    ? "Feeds every line; the verdict is where feeding stopped."
    match feed(Export.Tables.empty(), lines, 1, workers)
        Fed.Stop(o) -> o
        Fed.More(t, line) -> ended(line, t)

verify whole
    whole([""], 1) => Outcome.Rejected("line 1: unexpected end of line at column 0")
    whole(["[]"], 1) => Outcome.Rejected("line 1: the header is not an object")
    whole(["{{\"meta\":{{\"format\":{{\"version\":\"3.1.0\"}}}}}}", ""], 1) => Outcome.Read(Export.Tables.finish(Export.Tables.empty()))
    whole(["{{\"meta\":{{\"format\":{{\"version\":\"3.1.0\"}}}}}}", "", "x"], 4) => Outcome.Rejected("line 3: unexpected character at column 0")

fn ended(line: Int, t: Tables) -> Outcome
    ? "A file with no lines at all has no header and is rejected."
    match line == 1
        true -> Outcome.Rejected("empty file")
        false -> Outcome.Read(Export.Tables.finish(t))

verify ended
    ended(1, Export.Tables.empty()) => Outcome.Rejected("empty file")
    ended(2, Export.Tables.empty()) => Outcome.Read(Export.Tables.finish(Export.Tables.empty()))

fn feed(t: Tables, lines: List<String>, line: Int, workers: Int) -> Fed
    ? "Feeds complete lines; line 1 is the header and is checked first."
    match line == 1
        true -> feedHeader(t, lines, workers)
        false -> fedBody(Export.Reader.readParallel(t, lines, line, workers), line + List.len(lines))

verify feed
    feed(Export.Tables.empty(), [], 3, 1) => Fed.More(Export.Tables.empty(), 3)
    feed(Export.Tables.empty(), ["{{\"meta\":{{\"format\":{{\"version\":\"9.0.0\"}}}}}}"], 1, 1) => Fed.Stop(Outcome.Declined("format version 9.0.0 is not supported"))

fn feedHeader(t: Tables, lines: List<String>, workers: Int) -> Fed
    ? "Checks the header line, then feeds the rest of the chunk."
    match lines
        [] -> Fed.More(t, 1)
        [h, ..rest] -> afterHeader(t, Export.Reader.header(h), rest, workers)

verify feedHeader
    feedHeader(Export.Tables.empty(), [], 1) => Fed.More(Export.Tables.empty(), 1)

fn afterHeader(t: Tables, version: Result<String, String>, rest: List<String>, workers: Int) -> Fed
    ? "An unreadable header rejects; an unknown version declines."
    match version
        Result.Err(e) -> Fed.Stop(Outcome.Rejected("line 1: {e}"))
        Result.Ok(v) -> match Export.Reader.supported(v)
            true -> feed(t, rest, 2, workers)
            false -> Fed.Stop(Outcome.Declined("format version {v} is not supported"))

verify afterHeader
    afterHeader(Export.Tables.empty(), Result.Err("bad"), [], 1) => Fed.Stop(Outcome.Rejected("line 1: bad"))
    afterHeader(Export.Tables.empty(), Result.Ok("3.1.0"), [], 1) => Fed.More(Export.Tables.empty(), 2)

fn fedBody(r: Result<Tables, String>, next: Int) -> Fed
    ? "Continues after the lines of a chunk, or stops at a bad one."
    match r
        Result.Err(e) -> Fed.Stop(Outcome.Rejected(e))
        Result.Ok(t) -> Fed.More(t, next)

verify fedBody
    fedBody(Result.Err("line 4: x"), 9) => Fed.Stop(Outcome.Rejected("line 4: x"))
    fedBody(Result.Ok(Export.Tables.empty()), 9) => Fed.More(Export.Tables.empty(), 9)
