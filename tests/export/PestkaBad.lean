theorem eqSelf : ∀ (A : Type) (x y : A), x = x := fun _ x _ => Eq.refl x

theorem eqSelfGap : ∀ (A : Type) (x : A) (_ : Nat) (y : A), x = x := fun _ x _ _ => Eq.refl x

theorem eqSelfLet : ∀ (A : Type) (x y : A), x = x := fun _ x y => let _z := y; Eq.refl x

theorem lamSelf (A B : Type) : (fun (x : A) (_ : B) (_ : A) => x) = (fun (x : A) (_ : B) (_ : A) => x) := rfl

