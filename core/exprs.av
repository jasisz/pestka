module Exprs
    intent =
        "Lean expressions with de Bruijn indices for bound variables and"
        "numbered free variables for the local context. Every compound node"
        "and every constant carries its metadata (structural hash, loose bound variable range, which free variables may occur,"
        "whether free variables or universe parameters occur, and its size as"
        "a tree, capped, so that traversals know when memoizing pays), packed"
        "into one Int so that every node stays small, computed once"
        "by the constructors here and never by callers."
    exposes [Expr, Binder, Meta, bvar, fvar, sort, cnst, app, lam, pi, letE, natLit, strLit, proj, metaOf, wordOf, hashIn, sizeIn, flagsOf, hashOf, looseRange, hasFVar, hasParam, treeSize, varsOf, varsOfId]
    depends [Core.Hash, Core.Names, Core.Levels]
    effects []

decision MetaInVariants
    date = "2026-10-19"
    reason =
        "A record wrapping a recursive sum type does not build on the Rust"
        "backend, so the metadata rides in the"
        "compound variants as a plain record that holds no expression."
    chosen = "MetaInVariants"
    rejected = ["WrappingRecord"]
    impacts = [Expr, metaOf]

decision MetaFirst
    date = "2026-10-19"
    reason =
        "Equality on Expr is the derived one, which compares fields in order."
        "With the packed metadata first, two different nodes are told apart by"
        "their hashes before any child is visited, as the reference kernel"
        "compares pointers, then hashes, then structure. With it last, a check"
        "that two large, unshared terms are identical walked their common part"
        "first: on the Arena test discarded-argument-match that walk was most"
        "of the 9.5 s."
    chosen = "MetaFirst"
    rejected = ["MetaLast", "HashGuardAtCallers"]
    impacts = [Expr]

decision BindersUnnamed
    date = "2026-10-24"
    reason =
        "Typing never reads a binder's name or annotation, and Lean's own"
        "equality of expressions ignores both, as the reference replay does"
        "when it compares what it generates with an export. Pestka's equality"
        "is the derived one, which compared them: a term met again with"
        "another name for a bound variable was a new key in every cache, and"
        "the quick path of definitional equality fell back to comparing up"
        "to names. Now the constructors put in the anonymous name and the"
        "default annotation, so terms that differ only there are one term."
        "The node has no fields for them."
        "One worker: qb9 135.7 G to 132.0 G instructions, etale 71.3 G to"
        "70.8 G, Init 161.6 G to 158.0 G."
    chosen = "BindersUnnamed"
    rejected = ["BindersNamed"]
    impacts = [lam, pi, letE]

decision VariableBits
    date = "2026-10-24"
    reason =
        "Abstraction turns free variables back into bound ones, and it went"
        "into every subterm holding any free variable: since variables are"
        "counted (CountedVariables) the level every node carried was the"
        "same for all of them, so it only said whether one occurred. In a"
        "theorem with many hypotheses most subterms hold some, and on qb9"
        "59% of the nodes abstraction rebuilt came out as they were. Now the"
        "ten bits that held the level hold the or of the bits of the free"
        "variables in the node, a variable taking one of the ten in turn by"
        "its serial number, and abstraction skips a subterm that shares no"
        "bit with the variables abstracted. One worker: qb9 132.0 G to"
        "128.4 G instructions, etale 70.8 G to 69.1 G, Init 158.0 G to"
        "153.8 G."
    chosen = "VariableBits"
    rejected = ["VariableLevels"]
    impacts = [varsOf, varsOfId]

decision WordsFromWords
    date = "2026-10-24"
    reason =
        "Every node built read its parts' metadata back into records, a"
        "division and a remainder for each of five fields, and packed the"
        "new record with as many multiplications: an application cost two"
        "unpackings and a packing, and substitution builds tens of millions"
        "of them. Now a node's word is made from its parts' words: the"
        "variable bits and parameter flags of both or-ed in one step, the"
        "range the larger of the two lowest fields, the size and the hash"
        "read out alone. pack and unpack stay as what the words mean, and"
        "laws check that the words are what packing the records gives. One"
        "worker: qb9 128.4 G to 124.0 G instructions, etale 69.1 G to"
        "66.9 G, Init 153.8 G to 148.4 G."
    chosen = "WordsFromWords"
    rejected = ["RecordsBetween"]
    impacts = [app, binderWord, letE, proj, cnst, wordOf, joined]

decision ReadersByWord
    date = "2026-10-24"
    reason =
        "Every reader of a node's metadata (wordOf, looseRange, varsOf,"
        "hasFVar, hasParam, treeSize, hashOf) reads the word a compound node"
        "or a constant carries first, through packedOf, and looks at the"
        "node's shape only when it is a leaf without one. A node whose word"
        "is known before it is built is then read without being built, and"
        "a compound node takes one match instead of two."
    chosen = "ReadersByWord"
    rejected = ["LeafFirst"]
    impacts = [wordOf, looseRange, varsOf, hasFVar, hasParam]

type Binder
    Default
    Implicit
    StrictImplicit
    InstImplicit

record Meta
    hash: Int
    range: Int
    vars: Int
    params: Bool
    size: Int

type Expr
    BVar(Int)
    FVar(Int)
    Sort(Level)
    Const(Int, Name, List<Level>)
    App(Int, Expr, Expr)
    Lam(Int, Expr, Expr)
    Pi(Int, Expr, Expr)
    Let(Int, Expr, Expr, Expr)
    NatLit(Int)
    StrLit(String)
    Proj(Int, Name, Int, Expr)

fn bvar(i: Int) -> Expr
    ? "Bound variable by de Bruijn index."
    Expr.BVar(i)

verify bvar
    looseRange(bvar(2)) => 3

fn fvar(i: Int) -> Expr
    ? "Free variable of the local context."
    Expr.FVar(i)

verify fvar
    hasFVar(fvar(0)) => true

fn sort(l: Level) -> Expr
    ? "A universe."
    Expr.Sort(l)

verify sort
    looseRange(sort(Level.Zero)) => 0

fn cnst(n: Name, us: List<Level>) -> Expr
    ? "A constant applied to universe levels. Its metadata is packed in, as a compound node's is: an application meets constants at its head, and walking the levels there again every time cost more than the word."
    Expr.Const(leafWord(Core.Hash.mix2(3, Core.Names.hashOf(n), levelsHash(us, 0)), 0, 0, flag(anyParam(us))), n, us)

verify cnst
    hasParam(cnst(Core.Names.anon(), [Level.Param(Core.Names.anon())])) => true
    hasParam(cnst(Core.Names.anon(), [Level.Zero])) => false

fn app(f: Expr, a: Expr) -> Expr
    ? "Application."
    Expr.App(joined(4, wordOf(f), wordOf(a)), f, a)

verify app
    looseRange(app(bvar(0), bvar(3))) => 4
    hashOf(app(bvar(0), bvar(1))) == hashOf(app(bvar(1), bvar(0))) => false

fn binderMeta(tag: Int, t: Expr, b: Expr) -> Meta
    ? "Metadata of a node that binds one variable over b, as a record: what binderWord packs."
    mt = metaOf(t)
    mb = metaOf(b)
    Meta(hash = Core.Hash.mix(Core.Hash.mix(tag, mt.hash), mb.hash), range = Int.max(mt.range, Int.max(mb.range - 1, 0)), vars = Bits.or(mt.vars, mb.vars), params = Bool.or(mt.params, mb.params), size = sized(mt.size + mb.size))

fn binderWord(tag: Int, t: Expr, b: Expr) -> Int
    ? "The word of a node that binds one variable over b: the body's range seen from outside the binder."
    wt = wordOf(t)
    wb = wordOf(b)
    (Core.Hash.mix2(tag, hashIn(wt), hashIn(wb)) * 64 + Int.min(sizeIn(wt) + sizeIn(wb) + 1, 63)) * 33554432 + flagsOf(wt, wb) + Int.max(Bits.and(wt, 16383), under(Bits.and(wb, 16383)))

verify binderWord
    binderWord(5, sort(Level.Zero), bvar(3)) == pack(binderMeta(5, sort(Level.Zero), bvar(3))) => true

verify binderWord law packsBinderMeta
    given i: Int = 0..6
    given j: Int = 0..6
    binderWord(6, wordSample(i), wordSample(j)) => pack(binderMeta(6, wordSample(i), wordSample(j)))

verify binderMeta
    binderMeta(5, sort(Level.Zero), bvar(0)).range => 0
    binderMeta(5, bvar(1), bvar(2)).range => 2

fn lam(n: Name, t: Expr, b: Expr, bi: Binder) -> Expr
    ? "Lambda abstraction; b refers to the bound variable as index 0. The binder's name and annotation are not kept (BindersUnnamed)."
    Expr.Lam(binderWord(5, t, b), t, b)

verify lam
    looseRange(lam(Core.Names.anon(), sort(Level.Zero), bvar(0), Binder.Default)) => 0
    looseRange(lam(Core.Names.anon(), sort(Level.Zero), bvar(1), Binder.Default)) => 1
    lam(Core.Names.str(Core.Names.anon(), "x"), sort(Level.Zero), bvar(0), Binder.Implicit) == lam(Core.Names.anon(), sort(Level.Zero), bvar(0), Binder.Default) => true

fn pi(n: Name, t: Expr, b: Expr, bi: Binder) -> Expr
    ? "Dependent function type. The binder's name and annotation are not kept (BindersUnnamed)."
    Expr.Pi(binderWord(6, t, b), t, b)

verify pi
    hashOf(pi(Core.Names.anon(), bvar(0), bvar(0), Binder.Default)) == hashOf(lam(Core.Names.anon(), bvar(0), bvar(0), Binder.Default)) => false
    pi(Core.Names.str(Core.Names.anon(), "x"), sort(Level.Zero), bvar(0), Binder.InstImplicit) == pi(Core.Names.anon(), sort(Level.Zero), bvar(0), Binder.Default) => true

fn letE(n: Name, t: Expr, v: Expr, b: Expr) -> Expr
    ? "Local definition; b refers to it as index 0. The name is not kept (BindersUnnamed)."
    wt = wordOf(t)
    wv = wordOf(v)
    wb = wordOf(b)
    Expr.Let((Core.Hash.mix(Core.Hash.mix2(7, hashIn(wt), hashIn(wv)), hashIn(wb)) * 64 + Int.min(sizeIn(wt) + sizeIn(wv) + sizeIn(wb) + 1, 63)) * 33554432 + Bits.or(flagsOf(wt, wv), flagsOf(wb, wb)) + Int.max(Int.max(Bits.and(wt, 16383), Bits.and(wv, 16383)), under(Bits.and(wb, 16383))), t, v, b)

verify letE
    looseRange(letE(Core.Names.anon(), bvar(0), bvar(4), bvar(0))) => 5
    letE(Core.Names.str(Core.Names.anon(), "x"), bvar(0), bvar(4), bvar(0)) == letE(Core.Names.anon(), bvar(0), bvar(4), bvar(0)) => true

fn natLit(n: Int) -> Expr
    ? "Natural number literal."
    Expr.NatLit(n)

verify natLit
    hashOf(natLit(1)) == hashOf(natLit(2)) => false

fn strLit(s: String) -> Expr
    ? "String literal."
    Expr.StrLit(s)

verify strLit
    hashOf(strLit("a")) == hashOf(strLit("b")) => false

fn proj(s: Name, i: Int, e: Expr) -> Expr
    ? "Projection of field i out of a structure value."
    w = wordOf(e)
    Expr.Proj((Core.Hash.mix(Core.Hash.mix2(10, Core.Names.hashOf(s), i), hashIn(w)) * 64 + Int.min(sizeIn(w) + 1, 63)) * 33554432 + flagsOf(w, w) + Bits.and(w, 16383), s, i, e)

verify proj
    looseRange(proj(Core.Names.anon(), 0, bvar(1))) => 2

fn metaOf(e: Expr) -> Meta
    ? "Metadata of any node; leaves compute theirs on the spot."
    match e
        Expr.BVar(i) -> Meta(hash = Core.Hash.mix(1, i), range = i + 1, vars = 0, params = false, size = 1)
        Expr.FVar(i) -> Meta(hash = Core.Hash.mix(11, i), range = 0, vars = varsOfId(i), params = false, size = 1)
        Expr.Sort(l) -> Meta(hash = Core.Hash.mix(2, Core.Levels.hashOf(l)), range = 0, vars = 0, params = Core.Levels.hasParam(l), size = 1)
        Expr.Const(m, _, _) -> unpack(m)
        Expr.App(m, _, _) -> unpack(m)
        Expr.Lam(m, _, _) -> unpack(m)
        Expr.Pi(m, _, _) -> unpack(m)
        Expr.Let(m, _, _, _) -> unpack(m)
        Expr.NatLit(n) -> Meta(hash = Core.Hash.mix(8, Int.mod(n, 2147483647)), range = 0, vars = 0, params = false, size = 1)
        Expr.StrLit(s) -> Meta(hash = Core.Hash.mix(9, Core.Hash.ofText(s)), range = 0, vars = 0, params = false, size = 1)
        Expr.Proj(m, _, _, _) -> unpack(m)

verify metaOf
    metaOf(bvar(0)).range => 1
    metaOf(fvar(3 * 1024)).vars => 1023
    metaOf(fvar(3 * 1024 + 2)).vars => 2
    metaOf(app(fvar(3 * 1024 + 2), fvar(5 * 1024 + 8))).vars => 10
    metaOf(sort(Level.Param(Core.Names.anon()))).params => true
    metaOf(strLit("x")).range => 0

fn levelsHash(us: List<Level>, acc: Int) -> Int
    ? "Hash of a list of levels."
    match us
        [] -> acc
        [u, ..rest] -> levelsHash(rest, Core.Hash.mix(acc, Core.Levels.hashOf(u)))

verify levelsHash
    levelsHash([], 4) => 4
    levelsHash([Level.Zero], 0) => 2

fn anyParam(us: List<Level>) -> Bool
    ? "Whether any level in the list has a parameter."
    match us
        [] -> false
        [u, ..rest] -> Bool.or(Core.Levels.hasParam(u), anyParam(rest))

verify anyParam
    anyParam([]) => false
    anyParam([Level.Zero, Level.Param(Core.Names.anon())]) => true

fn wordOf(e: Expr) -> Int
    ? "The packed metadata of any node: the word a compound node or a constant carries, or a leaf's, made on the spot. The carried word is read first (ReadersByWord)."
    p = packedOf(e)
    match p < 0
        true -> leafWordOf(e)
        false -> p

verify wordOf
    unpack(wordOf(bvar(2))).range => 3
    unpack(wordOf(fvar(3 * 1024 + 4))).vars => 4
    wordOf(app(bvar(0), bvar(1))) == pack(metaOf(app(bvar(0), bvar(1)))) => true

fn leafWordOf(e: Expr) -> Int
    ? "A leaf's word, made on the spot; a node that carries its word gives that."
    match e
        Expr.BVar(i) -> leafWord(Core.Hash.mix(1, i), Int.min(i + 1, 16383), 0, 0)
        Expr.FVar(i) -> leafWord(Core.Hash.mix(11, i), 0, varsOfId(i), 0)
        Expr.Sort(l) -> leafWord(Core.Hash.mix(2, Core.Levels.hashOf(l)), 0, 0, flag(Core.Levels.hasParam(l)))
        Expr.Const(m, _, _) -> m
        Expr.App(m, _, _) -> m
        Expr.Lam(m, _, _) -> m
        Expr.Pi(m, _, _) -> m
        Expr.Let(m, _, _, _) -> m
        Expr.NatLit(n) -> leafWord(Core.Hash.mix(8, Int.mod(n, 2147483647)), 0, 0, 0)
        Expr.StrLit(s) -> leafWord(Core.Hash.mix(9, Core.Hash.ofText(s)), 0, 0, 0)
        Expr.Proj(m, _, _, _) -> m

verify leafWordOf
    unpack(leafWordOf(bvar(2))).range => 3

fn leafWord(hash: Int, range: Int, vars: Int, params: Int) -> Int
    ? "The word of a node of tree size 1, from its parts as pack lays them out."
    hash * 2147483648 + 33554432 + params * 16777216 + vars * 16384 + range

verify leafWord
    leafWord(5, 3, 2, 1) == pack(Meta(hash = 5, range = 3, vars = 2, params = true, size = 1)) => true

fn joined(tag: Int, wf: Int, wa: Int) -> Int
    ? "The word of a node over two parts, from theirs alone: the hashes mixed after the tag, sizes added and capped, variable bits and parameter flags or-ed, the larger range. A saturated range stays saturated."
    (Core.Hash.mix2(tag, hashIn(wf), hashIn(wa)) * 64 + Int.min(sizeIn(wf) + sizeIn(wa) + 1, 63)) * 33554432 + flagsOf(wf, wa) + Int.max(Bits.and(wf, 16383), Bits.and(wa, 16383))

verify joined
    unpack(joined(4, wordOf(bvar(0)), wordOf(bvar(3)))).range => 4

verify joined law packsAppMeta
    given i: Int = 0..6
    given j: Int = 0..6
    joined(4, wordOf(wordSample(i)), wordOf(wordSample(j))) => pack(appMeta(metaOf(wordSample(i)), metaOf(wordSample(j))))

fn appMeta(mf: Meta, ma: Meta) -> Meta
    ? "An application's metadata from its parts', as a record: what joined packs."
    Meta(hash = Core.Hash.mix(Core.Hash.mix(4, mf.hash), ma.hash), range = Int.max(mf.range, ma.range), vars = Bits.or(mf.vars, ma.vars), params = Bool.or(mf.params, ma.params), size = sized(mf.size + ma.size))

verify appMeta
    appMeta(metaOf(bvar(0)), metaOf(bvar(3))).range => 4

fn wordSample(k: Int) -> Expr
    ? "Terms for the laws on words: leaves of every kind, a saturated range, free variables with bits, parameters, and nodes over them."
    match k
        0 -> bvar(0)
        1 -> bvar(20000)
        2 -> fvar(3 * 1024 + 4)
        3 -> sort(Level.Param(Core.Names.anon()))
        4 -> app(fvar(7 * 1024 + 9), bvar(2))
        5 -> lam(Core.Names.anon(), cnst(Core.Names.anon(), [Level.Param(Core.Names.anon())]), bvar(16383), Binder.Default)
        _ -> natLit(12)

verify wordSample
    looseRange(wordSample(1)) >= 20001 => true

fn hashIn(w: Int) -> Int
    ? "The hash in a word."
    Int.div(w, 2147483648)

verify hashIn
    hashIn(leafWord(9, 0, 0, 0)) => 9

fn sizeIn(w: Int) -> Int
    ? "The capped tree size in a word."
    Bits.and(Int.div(w, 33554432), 63)

verify sizeIn
    sizeIn(leafWord(9, 0, 0, 0)) => 1

fn flagsOf(wa: Int, wb: Int) -> Int
    ? "The variable bits and the parameter flag of two words, or-ed, in place."
    Bits.and(Bits.or(wa, wb), 33538048)

verify flagsOf
    flagsOf(leafWord(1, 5, 2, 0), leafWord(1, 7, 4, 1)) => 16777216 + 6 * 16384

fn under(r: Int) -> Int
    ? "A body's stored range seen from outside its binder: one less, a saturated range staying saturated."
    match r == 16383
        true -> r
        false -> Int.max(r - 1, 0)

verify under
    under(0) => 0
    under(5) => 4
    under(16383) => 16383

fn packedOf(e: Expr) -> Int
    ? "The packed metadata of a compound node or a constant, or -1 for another leaf, whose metadata is computed on the spot."
    match e
        Expr.Const(m, _, _) -> m
        Expr.App(m, _, _) -> m
        Expr.Lam(m, _, _) -> m
        Expr.Pi(m, _, _) -> m
        Expr.Let(m, _, _, _) -> m
        Expr.Proj(m, _, _, _) -> m
        _ -> -1

verify packedOf
    packedOf(bvar(0)) => -1
    packedOf(app(bvar(0), bvar(0))) >= 0 => true

fn hashOf(e: Expr) -> Int
    ? "Structural hash, read alone from a compound node."
    p = packedOf(e)
    match p < 0
        true -> metaOf(e).hash
        false -> hashIn(p)

verify hashOf
    hashOf(bvar(0)) == hashOf(bvar(0)) => true

fn looseRange(e: Expr) -> Int
    ? "One more than the largest loose bound variable index; 0 when closed. Read on every node a substitution visits, so it is one mask for a compound node and needs no hash of a leaf."
    p = packedOf(e)
    match p < 0
        true -> leafRange(e)
        false -> rangeOf(Bits.and(p, 16383))

verify looseRange
    looseRange(bvar(4)) => 5
    looseRange(lam(Core.Names.anon(), bvar(2), bvar(5), Binder.Default)) => 5

fn leafRange(e: Expr) -> Int
    ? "A leaf's loose range: a bound variable's index and one, nothing for another leaf."
    match e
        Expr.BVar(i) -> i + 1
        _ -> 0

verify leafRange
    leafRange(bvar(3)) => 4
    leafRange(natLit(3)) => 0


fn hasFVar(e: Expr) -> Bool
    ? "Whether a free variable occurs."
    varsOf(e) > 0

verify hasFVar
    hasFVar(bvar(0)) => false

fn hasParam(e: Expr) -> Bool
    ? "Whether a universe parameter occurs."
    p = packedOf(e)
    match p < 0
        true -> leafParam(e)
        false -> paramsIn(p) == 1

verify leafParam
    leafParam(sort(Level.Param(Core.Names.anon()))) => true
    leafParam(bvar(0)) => false

fn leafParam(e: Expr) -> Bool
    ? "Whether a leaf holds a universe parameter: only a sort can."
    match e
        Expr.Sort(l) -> Core.Levels.hasParam(l)
        _ -> false

verify hasParam
    hasParam(app(cnst(Core.Names.anon(), [Level.Param(Core.Names.anon())]), bvar(0))) => true
    hasParam(sort(Level.Zero)) => false

fn paramsIn(p: Int) -> Int
    ? "The universe parameter flag of a packed word, 1 when one occurs; none for a leaf. Whether a free variable occurs is its variables' bits being other than 0."
    match p < 0
        true -> 0
        false -> Bits.and(Int.div(p, 16777216), 1)

verify paramsIn
    paramsIn(-1) => 0

fn sized(n: Int) -> Int
    ? "Tree size of a node from its children's, plus itself, capped at 63: only whether a node is small is ever asked."
    Int.min(n + 1, 63)

verify sized
    sized(3) => 4
    sized(63) => 63

fn pack(m: Meta) -> Int
    ? "The metadata in one machine word: hash (31 bits), size (6 bits), the universe parameter flag, the bits of the free variables that may occur (10 bits, see varsOfId), and the loose range (14 bits, saturated) lowest, so that the most read field is one remainder away. A free variable occurs where a bit is set. Sixty-two bits in all, which compiled Aver keeps in the word without a box."
    (((m.hash * 64 + Int.min(m.size, 63)) * 2 + flag(m.params)) * 1024 + Int.min(m.vars, 1023)) * 16384 + Int.min(m.range, 16383)

verify pack
    unpack(pack(Meta(hash = 2147483646, range = 3, vars = 7, params = false, size = 7))) => Meta(hash = 2147483646, range = 3, vars = 7, params = false, size = 7)

verify pack law roundTrip
    given hash: Int = [0, 1, 2147483647]
    given range: Int = [0, 1, 16382]
    given vars: Int = [0, 1, 1022]
    given size: Int = [0, 1, 63]
    given params: Bool = [false, true]
    when Bool.and(Bool.and(Bool.and(hash >= 0, hash < 2147483648), Bool.and(range >= 0, range < 16383)), Bool.and(Bool.and(vars >= 0, vars < 1023), Bool.and(size >= 0, size <= 63)))
    unpack(pack(Meta(hash = hash, range = range, vars = vars, params = params, size = size))) => Meta(hash = hash, range = range, vars = vars, params = params, size = size)

verify pack law rangeNeverShrinks
    given hash: Int = [0, 2147483647]
    given range: Int = [0, 1, 16382, 16383, 40000, 1099511627775]
    given size: Int = [0, 200]
    when Bool.and(Bool.and(hash >= 0, hash < 2147483648), Bool.and(Bool.and(range >= 0, range <= 1099511627776), size >= 0))
    unpack(pack(Meta(hash = hash, range = range, vars = 0, params = true, size = size))).range >= range => true

verify pack law varsKept
    given vars: Int = [0, 1, 512, 1022, 1023]
    when Bool.and(vars >= 0, vars <= 1023)
    unpack(pack(Meta(hash = 0, range = 0, vars = vars, params = false, size = 1))).vars => vars

verify pack law fitsSixtyTwoBits
    given hash: Int = [0, 2147483646]
    given range: Int = [0, 16383, 1099511627776]
    given vars: Int = [0, 1023, 5000]
    given size: Int = [0, 63, 200]
    given params: Bool = [false, true]
    when Bool.and(Bool.and(hash >= 0, hash < 2147483647), Bool.and(Bool.and(range >= 0, vars >= 0), size >= 0))
    pack(Meta(hash = hash, range = range, vars = vars, params = params, size = size)) < 4611686018427387904 => true

fn flag(b: Bool) -> Int
    ? "A flag as a bit."
    match b
        true -> 1
        false -> 0

verify flag
    flag(true) => 1

fn unpack(i: Int) -> Meta
    ? "The metadata back; a saturated range reads as unbounded, which only ever makes traversals look further."
    Meta(hash = Int.div(i, 2147483648), range = rangeOf(Int.mod(i, 16384)), vars = Int.mod(Int.div(i, 16384), 1024), params = paramsIn(i) == 1, size = Int.mod(Int.div(i, 33554432), 64))

verify unpack
    unpack(pack(Meta(hash = 5, range = 40000, vars = 0, params = true, size = 63))).range => 1099511627776
    unpack(pack(Meta(hash = 5, range = 40000, vars = 0, params = true, size = 63))).params => true

fn rangeOf(r: Int) -> Int
    ? "The stored range, or a bound larger than any index when it was saturated."
    match r == 16383
        true -> 1099511627776
        false -> r

verify rangeOf
    rangeOf(16383) => 1099511627776
    rangeOf(4) => 4

fn treeSize(e: Expr) -> Int
    ? "How many nodes e has as a tree (a DAG counts shared parts once per use), capped."
    p = packedOf(e)
    match p < 0
        true -> 1
        false -> sizeIn(p)

verify treeSize
    treeSize(app(bvar(0), app(bvar(1), bvar(2)))) => 5

fn varsOfId(i: Int) -> Int
    ? "The bits a free variable's number carries: the number is a serial number times 1024 plus its bits, one bit of ten for the variables the checker makes. A number with none stands for all ten, so that a term holding it is never skipped."
    match Bits.and(i, 1023)
        0 -> 1023
        b -> b

verify varsOfId
    varsOfId(3 * 1024) => 1023
    varsOfId(7 * 1024 + 4) => 4

fn varsOf(e: Expr) -> Int
    ? "The bits of every free variable occurring in e, or-ed together; 0 when none does. Two terms whose bits share none hold no free variable in common."
    p = packedOf(e)
    match p < 0
        true -> leafVars(e)
        false -> Bits.and(Int.div(p, 16384), 1023)

fn leafVars(e: Expr) -> Int
    ? "A leaf's variable bits: a free variable's own, none for another leaf."
    match e
        Expr.FVar(i) -> varsOfId(i)
        _ -> 0

verify leafVars
    leafVars(fvar(5 * 1024 + 2)) => 2
    leafVars(bvar(0)) => 0

verify varsOf
    varsOf(bvar(0)) => 0
    varsOf(app(fvar(3 * 1024 + 1), fvar(2))) => 3

