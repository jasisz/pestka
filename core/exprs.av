module Exprs
    intent =
        "Lean expressions with de Bruijn indices for bound variables and"
        "numbered free variables for the local context. Every compound node"
        "carries its metadata (structural hash, loose bound variable range,"
        "whether free variables or universe parameters occur, and its size as"
        "a tree, capped, so that traversals know when memoizing pays), packed"
        "into one Int so that every node stays small, computed once"
        "by the constructors here and never by callers."
    exposes [Expr, Binder, Meta, bvar, fvar, sort, cnst, app, lam, pi, letE, natLit, strLit, proj, metaOf, hashOf, looseRange, hasFVar, hasParam, treeSize]
    depends [Core.Hash, Core.Names, Core.Levels]
    effects []

decision MetaInVariants
    date = "2026-10-19"
    reason =
        "A record wrapping a recursive sum type does not build on the Rust"
        "backend, so the metadata rides in the"
        "compound variants as a plain record that holds no expression."
    chosen = "MetaInVariants"
    rejected = ["WrappingRecord"]
    impacts = [Expr, metaOf]

decision MetaFirst
    date = "2026-10-19"
    reason =
        "Equality on Expr is the derived one, which compares fields in order."
        "With the packed metadata first, two different nodes are told apart by"
        "their hashes before any child is visited, as the reference kernel"
        "compares pointers, then hashes, then structure. With it last, a check"
        "that two large, unshared terms are identical walked their common part"
        "first: on the Arena test discarded-argument-match that walk was most"
        "of the 9.5 s."
    chosen = "MetaFirst"
    rejected = ["MetaLast", "HashGuardAtCallers"]
    impacts = [Expr]

type Binder
    Default
    Implicit
    StrictImplicit
    InstImplicit

record Meta
    hash: Int
    range: Int
    fvars: Bool
    params: Bool
    size: Int

type Expr
    BVar(Int)
    FVar(Int)
    Sort(Level)
    Const(Name, List<Level>)
    App(Int, Expr, Expr)
    Lam(Int, Name, Expr, Expr, Binder)
    Pi(Int, Name, Expr, Expr, Binder)
    Let(Int, Name, Expr, Expr, Expr)
    NatLit(Int)
    StrLit(String)
    Proj(Int, Name, Int, Expr)

fn bvar(i: Int) -> Expr
    ? "Bound variable by de Bruijn index."
    Expr.BVar(i)

verify bvar
    looseRange(bvar(2)) => 3

fn fvar(i: Int) -> Expr
    ? "Free variable of the local context."
    Expr.FVar(i)

verify fvar
    hasFVar(fvar(0)) => true

fn sort(l: Level) -> Expr
    ? "A universe."
    Expr.Sort(l)

verify sort
    looseRange(sort(Level.Zero)) => 0

fn cnst(n: Name, us: List<Level>) -> Expr
    ? "A constant applied to universe levels."
    Expr.Const(n, us)

verify cnst
    hasParam(cnst(Core.Names.anon(), [Level.Param(Core.Names.anon())])) => true
    hasParam(cnst(Core.Names.anon(), [Level.Zero])) => false

fn app(f: Expr, a: Expr) -> Expr
    ? "Application."
    mf = metaOf(f)
    ma = metaOf(a)
    Expr.App(pack(Meta(hash = Core.Hash.mix(Core.Hash.mix(4, mf.hash), ma.hash), range = Int.max(mf.range, ma.range), fvars = Bool.or(mf.fvars, ma.fvars), params = Bool.or(mf.params, ma.params), size = sized(mf.size + ma.size))), f, a)

verify app
    looseRange(app(bvar(0), bvar(3))) => 4
    hashOf(app(bvar(0), bvar(1))) == hashOf(app(bvar(1), bvar(0))) => false

fn binderMeta(tag: Int, t: Expr, b: Expr) -> Meta
    ? "Metadata of a node that binds one variable over b."
    mt = metaOf(t)
    mb = metaOf(b)
    Meta(hash = Core.Hash.mix(Core.Hash.mix(tag, mt.hash), mb.hash), range = Int.max(mt.range, Int.max(mb.range - 1, 0)), fvars = Bool.or(mt.fvars, mb.fvars), params = Bool.or(mt.params, mb.params), size = sized(mt.size + mb.size))

verify binderMeta
    binderMeta(5, sort(Level.Zero), bvar(0)).range => 0
    binderMeta(5, bvar(1), bvar(2)).range => 2

fn lam(n: Name, t: Expr, b: Expr, bi: Binder) -> Expr
    ? "Lambda abstraction; b refers to the bound variable as index 0."
    Expr.Lam(pack(binderMeta(5, t, b)), n, t, b, bi)

verify lam
    looseRange(lam(Core.Names.anon(), sort(Level.Zero), bvar(0), Binder.Default)) => 0
    looseRange(lam(Core.Names.anon(), sort(Level.Zero), bvar(1), Binder.Default)) => 1

fn pi(n: Name, t: Expr, b: Expr, bi: Binder) -> Expr
    ? "Dependent function type."
    Expr.Pi(pack(binderMeta(6, t, b)), n, t, b, bi)

verify pi
    hashOf(pi(Core.Names.anon(), bvar(0), bvar(0), Binder.Default)) == hashOf(lam(Core.Names.anon(), bvar(0), bvar(0), Binder.Default)) => false

fn letE(n: Name, t: Expr, v: Expr, b: Expr) -> Expr
    ? "Local definition; b refers to it as index 0."
    mt = metaOf(t)
    mv = metaOf(v)
    mb = metaOf(b)
    Expr.Let(pack(Meta(hash = Core.Hash.mix(Core.Hash.mix(Core.Hash.mix(7, mt.hash), mv.hash), mb.hash), range = Int.max(Int.max(mt.range, mv.range), Int.max(mb.range - 1, 0)), fvars = Bool.or(mt.fvars, Bool.or(mv.fvars, mb.fvars)), params = Bool.or(mt.params, Bool.or(mv.params, mb.params)), size = sized(mt.size + mv.size + mb.size))), n, t, v, b)

verify letE
    looseRange(letE(Core.Names.anon(), bvar(0), bvar(4), bvar(0))) => 5

fn natLit(n: Int) -> Expr
    ? "Natural number literal."
    Expr.NatLit(n)

verify natLit
    hashOf(natLit(1)) == hashOf(natLit(2)) => false

fn strLit(s: String) -> Expr
    ? "String literal."
    Expr.StrLit(s)

verify strLit
    hashOf(strLit("a")) == hashOf(strLit("b")) => false

fn proj(s: Name, i: Int, e: Expr) -> Expr
    ? "Projection of field i out of a structure value."
    m = metaOf(e)
    Expr.Proj(pack(Meta(hash = Core.Hash.mix(Core.Hash.mix(Core.Hash.mix(10, Core.Names.hashOf(s)), i), m.hash), range = m.range, fvars = m.fvars, params = m.params, size = sized(m.size))), s, i, e)

verify proj
    looseRange(proj(Core.Names.anon(), 0, bvar(1))) => 2

fn metaOf(e: Expr) -> Meta
    ? "Metadata of any node; leaves compute theirs on the spot."
    match e
        Expr.BVar(i) -> Meta(hash = Core.Hash.mix(1, i), range = i + 1, fvars = false, params = false, size = 1)
        Expr.FVar(i) -> Meta(hash = Core.Hash.mix(11, i), range = 0, fvars = true, params = false, size = 1)
        Expr.Sort(l) -> Meta(hash = Core.Hash.mix(2, Core.Levels.hashOf(l)), range = 0, fvars = false, params = Core.Levels.hasParam(l), size = 1)
        Expr.Const(n, us) -> Meta(hash = Core.Hash.mix(Core.Hash.mix(3, Core.Names.hashOf(n)), levelsHash(us, 0)), range = 0, fvars = false, params = anyParam(us), size = 1)
        Expr.App(m, _, _) -> unpack(m)
        Expr.Lam(m, _, _, _, _) -> unpack(m)
        Expr.Pi(m, _, _, _, _) -> unpack(m)
        Expr.Let(m, _, _, _, _) -> unpack(m)
        Expr.NatLit(n) -> Meta(hash = Core.Hash.mix(8, Int.mod(n, 1099511627689)), range = 0, fvars = false, params = false, size = 1)
        Expr.StrLit(s) -> Meta(hash = Core.Hash.mix(9, Core.Hash.ofText(s)), range = 0, fvars = false, params = false, size = 1)
        Expr.Proj(m, _, _, _) -> unpack(m)

verify metaOf
    metaOf(bvar(0)).range => 1
    metaOf(fvar(3)).fvars => true
    metaOf(sort(Level.Param(Core.Names.anon()))).params => true
    metaOf(strLit("x")).range => 0

fn levelsHash(us: List<Level>, acc: Int) -> Int
    ? "Hash of a list of levels."
    match us
        [] -> acc
        [u, ..rest] -> levelsHash(rest, Core.Hash.mix(acc, Core.Levels.hashOf(u)))

verify levelsHash
    levelsHash([], 4) => 4
    levelsHash([Level.Zero], 0) => 2

fn anyParam(us: List<Level>) -> Bool
    ? "Whether any level in the list has a parameter."
    match us
        [] -> false
        [u, ..rest] -> Bool.or(Core.Levels.hasParam(u), anyParam(rest))

verify anyParam
    anyParam([]) => false
    anyParam([Level.Zero, Level.Param(Core.Names.anon())]) => true

fn packedOf(e: Expr) -> Int
    ? "The packed metadata of a compound node, or -1 for a leaf, whose metadata is computed on the spot."
    match e
        Expr.App(m, _, _) -> m
        Expr.Lam(m, _, _, _, _) -> m
        Expr.Pi(m, _, _, _, _) -> m
        Expr.Let(m, _, _, _, _) -> m
        Expr.Proj(m, _, _, _) -> m
        _ -> -1

verify packedOf
    packedOf(bvar(0)) => -1
    packedOf(app(bvar(0), bvar(0))) >= 0 => true

fn hashOf(e: Expr) -> Int
    ? "Structural hash, read alone from a compound node."
    p = packedOf(e)
    match p < 0
        true -> metaOf(e).hash
        false -> Int.div(p, 8388608)

verify hashOf
    hashOf(bvar(0)) == hashOf(bvar(0)) => true

fn looseRange(e: Expr) -> Int
    ? "One more than the largest loose bound variable index; 0 when closed. Read on every node a substitution visits, so it is one remainder for a compound node and needs no hash of a leaf."
    match e
        Expr.BVar(i) -> i + 1
        _ -> rangeIn(packedOf(e))

verify looseRange
    looseRange(bvar(4)) => 5
    looseRange(lam(Core.Names.anon(), bvar(2), bvar(5), Binder.Default)) => 5

fn rangeIn(p: Int) -> Int
    ? "The loose range in a packed word; a leaf other than a bound variable has none."
    match p < 0
        true -> 0
        false -> rangeOf(Int.mod(p, 32768))

verify rangeIn
    rangeIn(-1) => 0

fn hasFVar(e: Expr) -> Bool
    ? "Whether a free variable occurs."
    match e
        Expr.FVar -> true
        _ -> flagsIn(packedOf(e)) >= 2

verify hasFVar
    hasFVar(bvar(0)) => false

fn hasParam(e: Expr) -> Bool
    ? "Whether a universe parameter occurs."
    match e
        Expr.Sort(l) -> Core.Levels.hasParam(l)
        Expr.Const(_, us) -> anyParam(us)
        _ -> Int.mod(flagsIn(packedOf(e)), 2) == 1

verify hasParam
    hasParam(app(cnst(Core.Names.anon(), [Level.Param(Core.Names.anon())]), bvar(0))) => true
    hasParam(sort(Level.Zero)) => false

fn flagsIn(p: Int) -> Int
    ? "The two flags of a packed word, free variables as 2 and universe parameters as 1; none for a leaf."
    match p < 0
        true -> 0
        false -> Int.mod(Int.div(p, 32768), 4)

verify flagsIn
    flagsIn(-1) => 0

fn sized(n: Int) -> Int
    ? "Tree size of a node from its children's, plus itself, capped at 63: only whether a node is small is ever asked."
    Int.min(n + 1, 63)

verify sized
    sized(3) => 4
    sized(63) => 63

fn pack(m: Meta) -> Int
    ? "The metadata in one machine word: hash (40 bits), size (6 bits), two flags, and the loose range (15 bits, saturated) lowest, so that the most read field is one remainder away."
    ((m.hash * 64 + Int.min(m.size, 63)) * 4 + flag(m.fvars) * 2 + flag(m.params)) * 32768 + Int.min(m.range, 32767)

verify pack
    unpack(pack(Meta(hash = 1099511627688, range = 3, fvars = true, params = false, size = 7))) => Meta(hash = 1099511627688, range = 3, fvars = true, params = false, size = 7)

fn flag(b: Bool) -> Int
    ? "A flag as a bit."
    match b
        true -> 1
        false -> 0

verify flag
    flag(true) => 1

fn unpack(i: Int) -> Meta
    ? "The metadata back; a saturated range reads as unbounded, which only ever makes traversals look further."
    Meta(hash = Int.div(i, 8388608), range = rangeOf(Int.mod(i, 32768)), fvars = flagsIn(i) >= 2, params = Int.mod(flagsIn(i), 2) == 1, size = Int.mod(Int.div(i, 131072), 64))

verify unpack
    unpack(pack(Meta(hash = 5, range = 40000, fvars = false, params = true, size = 63))).range => 1099511627776
    unpack(pack(Meta(hash = 5, range = 40000, fvars = false, params = true, size = 63))).params => true

fn rangeOf(r: Int) -> Int
    ? "The stored range, or a bound larger than any index when it was saturated."
    match r == 32767
        true -> 1099511627776
        false -> r

verify rangeOf
    rangeOf(32767) => 1099511627776
    rangeOf(4) => 4

fn treeSize(e: Expr) -> Int
    ? "How many nodes e has as a tree (a DAG counts shared parts once per use), capped."
    p = packedOf(e)
    match p < 0
        true -> 1
        false -> Int.mod(Int.div(p, 131072), 64)

verify treeSize
    treeSize(app(bvar(0), app(bvar(1), bvar(2)))) => 5
