module Hash
    intent =
        "Structural hashes for names, levels and expressions."
        "Every value stays below 2^31, kept by its low bits, and the"
        "multiplier is below 2^20, so one mixing step never leaves a"
        "machine word."
        "A hash only narrows a comparison; equality is still decided"
        "structurally."
    exposes [mix, ofText, ofInts]
    effects []

fn mix(a: Int, b: Int) -> Int
    ? "Combines a hash with one more ingredient: its low 31 bits, one and where a remainder by a prime took a division."
    Bits.and(a * 1000003 + b, 2147483647)

verify mix
    mix(0, 5) => 5
    mix(1, 0) => 1000003
    mix(2147483646, 2147483646) => Bits.and(2147483646 * 1000004, 2147483647)
    mix(5, 7) < 2147483648 => true

fn ofText(s: String) -> Int
    ? "Hash of a string, over its code points."
    ofChars(String.chars(s), 17)

verify ofText
    ofText("") => 17
    ofText("a") => mix(17, 97)
    ofText("ab") == ofText("ba") => false

fn ofChars(cs: List<String>, acc: Int) -> Int
    ? "Folds code points into the hash."
    match cs
        [] -> acc
        [c, ..rest] -> ofChars(rest, mix(acc, Option.withDefault(String.firstCodePoint(c), 0)))

verify ofChars
    ofChars([], 3) => 3
    ofChars(["a"], 0) => 97

fn ofInts(xs: List<Int>, acc: Int) -> Int
    ? "Folds already reduced hashes into one."
    match xs
        [] -> acc
        [x, ..rest] -> ofInts(rest, mix(acc, x))

verify ofInts
    ofInts([], 9) => 9
    ofInts([1, 2], 0) => mix(mix(0, 1), 2)
