module Alpha
    intent =
        "Equality up to binder names and binder annotations, which is what"
        "Lean's Expr equality means and what the reference replay uses to"
        "compare the constructors and recursors it generates with the ones"
        "an export states. Node hashes already ignore binder names, so"
        "different hashes answer at once; equal subterms found once are"
        "remembered, so a shared subterm is compared once."
    exposes [alphaEq, alphaEqList]
    depends [Core.Names, Core.Levels, Core.Exprs, Core.Cache]
    effects []

record AR
    b: Bool
    memo: Map<Int, Bucket>

fn alphaEq(a: Expr, b: Expr) -> Bool
    ? "a and b are the same term up to binder names and annotations."
    aeq(a, b, Core.Cache.empty()).b

verify alphaEq
    alphaEq(Core.Exprs.lam(Core.Names.anon(), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Default), Core.Exprs.lam(Core.Names.str(Core.Names.anon(), "x"), Core.Exprs.sort(Level.Zero), Core.Exprs.bvar(0), Binder.Implicit)) => true
    alphaEq(Core.Exprs.bvar(0), Core.Exprs.bvar(1)) => false
    alphaEq(Core.Exprs.letE(Core.Names.anon(), Core.Exprs.bvar(0), Core.Exprs.bvar(0), Core.Exprs.bvar(0)), Core.Exprs.letE(Core.Names.str(Core.Names.anon(), "y"), Core.Exprs.bvar(0), Core.Exprs.bvar(0), Core.Exprs.bvar(0))) => true

fn alphaEqList(as: List<Expr>, bs: List<Expr>) -> Bool
    ? "Pairwise alphaEq of lists of the same length."
    match as
        [] -> match bs
            [] -> true
            _ -> false
        [a, ..arest] -> match bs
            [] -> false
            [b, ..brest] -> Bool.and(alphaEq(a, b), alphaEqList(arest, brest))

verify alphaEqList
    alphaEqList([Core.Exprs.bvar(0)], [Core.Exprs.bvar(0)]) => true
    alphaEqList([], [Core.Exprs.bvar(0)]) => false

fn aeq(a: Expr, b: Expr, memo: Map<Int, Bucket>) -> AR
    ? "Identical terms, a hash mismatch, a remembered pair, or a structural comparison."
    match a == b
        true -> AR(b = true, memo = memo)
        false -> match Core.Exprs.hashOf(a) == Core.Exprs.hashOf(b)
            false -> AR(b = false, memo = memo)
            true -> aeqSeen(a, b, memo, Core.Cache.find(memo, Core.Exprs.hashOf(a), a))

verify aeq
    aeq(Core.Exprs.bvar(0), Core.Exprs.bvar(0), Core.Cache.empty()).b => true

fn aeqSeen(a: Expr, b: Expr, memo: Map<Int, Bucket>, seen: Option<Expr>) -> AR
    ? "A pair already found equal is equal again."
    match seen == Option.Some(b)
        true -> AR(b = true, memo = memo)
        false -> aeqStore(aeqNode(a, b, memo), a, b)

verify aeqSeen
    aeqSeen(Core.Exprs.bvar(0), Core.Exprs.bvar(1), Core.Cache.empty(), Option.Some(Core.Exprs.bvar(1))).b => true

fn aeqStore(r: AR, a: Expr, b: Expr) -> AR
    ? "Remembers an equal pair."
    match r.b
        true -> AR(b = true, memo = Core.Cache.add(r.memo, Core.Exprs.hashOf(a), (a, b)))
        false -> r

verify aeqStore
    Core.Cache.size(aeqStore(AR(b = true, memo = Core.Cache.empty()), Core.Exprs.bvar(0), Core.Exprs.bvar(0)).memo) => 1

fn aeqNode(a: Expr, b: Expr, memo: Map<Int, Bucket>) -> AR
    ? "Same constructor, equal parts; binder names and annotations are not compared."
    match a
        Expr.App(_, f, x) -> match b
            Expr.App(_, g, y) -> aeq2(f, g, x, y, memo)
            _ -> AR(b = false, memo = memo)
        Expr.Lam(_, _, t, s, _) -> match b
            Expr.Lam(_, _, u, r, _) -> aeq2(t, u, s, r, memo)
            _ -> AR(b = false, memo = memo)
        Expr.Pi(_, _, t, s, _) -> match b
            Expr.Pi(_, _, u, r, _) -> aeq2(t, u, s, r, memo)
            _ -> AR(b = false, memo = memo)
        Expr.Let(_, _, t, v, s) -> match b
            Expr.Let(_, _, u, w, r) -> aeq3(t, u, v, w, s, r, memo)
            _ -> AR(b = false, memo = memo)
        Expr.Proj(_, n, i, x) -> match b
            Expr.Proj(_, m, j, y) -> match Bool.and(n == m, i == j)
                true -> aeq(x, y, memo)
                false -> AR(b = false, memo = memo)
            _ -> AR(b = false, memo = memo)
        _ -> AR(b = a == b, memo = memo)

verify aeqNode
    aeqNode(Core.Exprs.natLit(1), Core.Exprs.natLit(1), Core.Cache.empty()).b => true

fn aeq2(a1: Expr, b1: Expr, a2: Expr, b2: Expr, memo: Map<Int, Bucket>) -> AR
    ? "Two pairs, the second only if the first is equal."
    r = aeq(a1, b1, memo)
    match r.b
        true -> aeq(a2, b2, r.memo)
        false -> r

verify aeq2
    aeq2(Core.Exprs.bvar(0), Core.Exprs.bvar(0), Core.Exprs.bvar(1), Core.Exprs.bvar(2), Core.Cache.empty()).b => false

fn aeq3(a1: Expr, b1: Expr, a2: Expr, b2: Expr, a3: Expr, b3: Expr, memo: Map<Int, Bucket>) -> AR
    ? "Three pairs in order."
    r = aeq(a1, b1, memo)
    match r.b
        true -> aeq2(a2, b2, a3, b3, r.memo)
        false -> r

verify aeq3
    aeq3(Core.Exprs.bvar(0), Core.Exprs.bvar(0), Core.Exprs.bvar(1), Core.Exprs.bvar(1), Core.Exprs.bvar(2), Core.Exprs.bvar(2), Core.Cache.empty()).b => true
