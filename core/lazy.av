module Lazy
    intent =
        "A theorem's proof that is built only when it is asked for (a proof"
        "block of a Susz 1 file; see the Susz 1 spec, section 6): the bytes of its"
        "block in the file's PROOFS section, the frontier tables of names,"
        "levels and expressions that the reader built from MAIN, and what"
        "the theorem's record says of the block: how many expressions it"
        "holds, how much of the frontier was listed before it, and where it"
        "lies in the file. Decoding builds a fresh term, nothing of it kept"
        "in any table, so the term lives only while checking holds it."
        "Nothing in the block is trusted: every record is checked as the"
        "reader checks one of MAIN, every reference against what was listed"
        "before the declaration, and every constant and projection against"
        "rule P, declared before the theorem; a block that disagrees is an"
        "error of its declaration, the same whenever and however often it is"
        "decoded."
    exposes [Proof, Source, Store, Bounds, Decoded, force, forced, valued, emptyStore, never]
    exposes opaque [LPos]
    depends [Bytes, Core.Names, Core.Levels, Core.Exprs]
    effects []

record Store
    names: Vector<Name>
    levels: Vector<Level>
    exprs: Vector<Expr>
    decls: Vector<Int>

record Bounds
    decl: Int
    names: Int
    levels: Int
    exprs: Int
    count: Int
    at: Int

decision OneDeferredProof
    date = "2026-11-11"
    reason =
        "A proof is either built or deferred, and checking (Check.Decl,"
        "Check.State.valueOf and valued) sees only Proof and forced: it never"
        "knows where a deferred proof's bytes are. A source of bytes is a"
        "variant of Source with a decoder of its own, called by forced. A"
        "decoder builds a fresh term, keeps nothing of it, validates"
        "everything it reads as the reader of its format would, and gives"
        "Term, or Broken with a message naming the record (a rejection of"
        "the declaration, BlockErrorsFirst), or Long (a decline). It must"
        "give the same answer every time it is called on the same source,"
        "so that a declaration fails the same way however its proof is"
        "reached."
    chosen = "OneDeferredProof"
    rejected = ["ProofPerFormat"]
    impacts = [Proof, Source, forced, force]

type Source
    SuszSpot(Int, Int, Bounds)
    SuszBlock(Store, Bytes, Bounds)

type Proof
    Built(Expr)
    Deferred(Source)

type Decoded
    Term(Expr)
    Broken(String)
    Long(String)

fn emptyStore() -> Store
    ? "No frontier."
    Store(names = Vector.fromList([]), levels = Vector.fromList([]), exprs = Vector.fromList([]), decls = Vector.fromList([]))

verify emptyStore
    Vector.len(emptyStore().names) => 0

fn valued(p: Proof) -> Bool
    ? "Every proof has a value; asked without building it."
    match p
        Proof.Built(_) -> true
        Proof.Deferred(_) -> true

verify valued
    valued(Proof.Built(Core.Exprs.bvar(0))) => true

decision DeclaredBefore
    date = "2026-11-12"
    reason =
        "A block of theorem T may name in a constant or a projection only a"
        "name whose declaration index is below T's (rule P, Susz 1 spec,"
        "section 6). Every declared name is declared once (section 5.2), so"
        "a name"
        "has one index, which the reader looks up once per frontier name"
        "when MAIN is read. A block pays one vector read and a comparison"
        "per constant, and keeps no state between records. A name declared"
        "by a declaration Pestka skips passes rule P but is never in the"
        "environment, in any order of checking, so it fails the theorem"
        "the same way wherever the theorem is checked. The constants a"
        "literal stands for are not asked of a block: checking keeps the"
        "declarations up to the last of them in file order (LiteralPrefix in"
        "Check.Decl)."
    chosen = "DeclaredBefore"
    rejected = ["PlaceCodes", "MarksPerRecord"]
    impacts = [never, constOf, projOf, declaredBefore]

fn never() -> Int
    ? "The declaration index of a name no declaration declares: past every declaration (DeclaredBefore)."
    2305843009213693952

verify never
    never() > 0 => true

fn declaredBefore(s: Store, n: Int, decl: Int) -> Bool
    ? "Whether frontier name n is declared by a declaration before decl (DeclaredBefore)."
    match Vector.get(s.decls, n)
        Option.Some(d) -> d < decl
        Option.None -> false

verify declaredBefore
    declaredBefore(Store.update(emptyStore(), decls = Vector.fromList([2])), 0, 3) => true
    declaredBefore(Store.update(emptyStore(), decls = Vector.fromList([3])), 0, 3) => false
    declaredBefore(emptyStore(), 0, 3) => false

fn force(p: Proof) -> Expr
    ? "The proof's term, decoded from its block when packed; a block that does not decode stands for a constant no environment has. Only a declaration's own check reports what is wrong with its block (forced); a theorem unfolded elsewhere is declared before the declaration unfolding it, so its own failure comes first."
    match forced(p)
        Decoded.Term(e) -> e
        _ -> broken()

verify force
    force(Proof.Built(Core.Exprs.natLit(1))) => Core.Exprs.natLit(1)
    force(Proof.Deferred(Source.SuszBlock(emptyStore(), Bytes.fromList([7, 3]), bounds1(1)))) => Core.Exprs.bvar(3)
    force(Proof.Deferred(Source.SuszBlock(emptyStore(), Bytes.fromList([7, 3, 10, 1, 1]), bounds1(2)))) => Core.Exprs.app(Core.Exprs.bvar(3), Core.Exprs.bvar(3))
    force(Proof.Deferred(Source.SuszBlock(emptyStore(), Bytes.fromList([99, 0]), bounds1(1)))) => broken()

fn forced(p: Proof) -> Decoded
    ? "The proof's term, or what is wrong with where it comes from: Broken rejects, Long declines (OneDeferredProof)."
    match p
        Proof.Built(e) -> Decoded.Term(e)
        Proof.Deferred(src) -> sourced(src)

fn sourced(src: Source) -> Decoded
    ? "A deferred proof by its source's decoder (OneDeferredProof)."
    match src
        Source.SuszSpot(_, _, _) -> Decoded.Broken("proof block: never read")
        Source.SuszBlock(s, b, bd) -> decoded(s, b, bd)

verify sourced
    sourced(Source.SuszSpot(0, 0, bounds1(1))) => Decoded.Broken("proof block: never read")

verify forced
    forced(Proof.Deferred(Source.SuszBlock(emptyStore(), Bytes.fromList([99, 0]), Bounds.update(bounds1(1), at = 100)))) => Decoded.Broken("PROOFS @ 100: record 1: unknown record tag 99")
    forced(Proof.Deferred(Source.SuszBlock(emptyStore(), Bytes.fromList([7, 3, 0]), bounds1(1)))) => Decoded.Broken("PROOFS @ 2: record 2: 1 bytes after the last record")
    forced(Proof.Deferred(Source.SuszBlock(emptyStore(), Bytes.fromList([7, 3, 7]), bounds1(2)))) => Decoded.Broken("PROOFS @ 2: record 2: the block ends inside it")

fn broken() -> Expr
    ? "What a block that does not decode stands for: a constant that no environment has."
    Core.Exprs.cnst(Core.Names.str(Core.Names.anon(), "<undecodable proof block>"), [])

decision LazyPositionsInRange
    date = "2026-11-11"
    reason =
        "As PositionsInRange in Export.Susz: a position in a block is -1 or"
        "below 2^62, held as a machine word."
    chosen = "LazyPositionsInRange"
    rejected = ["PositionsAsInts"]
    impacts = [LPos, lposOf, lorNone]

record LPos
    value: Int

fn lposOf(n: Int) -> Result<LPos, String>
    ? "A position: -1 for none, otherwise below 2^62 (LazyPositionsInRange)."
    match Bool.and(n >= -1, n <= 4611686018427387903)
        true -> Result.Ok(LPos(value = n))
        false -> Result.Err("position out of range")

verify lposOf
    lposOf(-2) => Result.Err("position out of range")

fn lorNone(r: Result<LPos, String>) -> LPos
    ? "A position made by lposOf, or none (LazyPositionsInRange)."
    match r
        Result.Ok(p) -> p
        Result.Err(_) -> LPos(value = -1)

verify lorNone
    lorNone(lposOf(-5)).value => -1

record LAt
    value: Int
    at: LPos

record Lvls
    ls: List<Level>
    at: LPos

type Step
    Got(Expr, LPos)
    Bad(String)

fn short() -> Step
    ? "A record that runs past the block."
    Step.Bad("the block ends inside it")

decision MinimalVarints
    date = "2026-11-12"
    reason =
        "Susz 1 varints are minimal and below 2^64 (Susz 1 spec, section 3): a"
        "varint of more than one byte does not end in 0x00, and the tenth"
        "byte, of weight 2^63, is exactly 1. One comparison on the last"
        "byte. A varint that breaks it is malformed, value -1 at none,"
        "which a record tells apart from one that runs past the block"
        "(value 0 at none) by cut."
    chosen = "MinimalVarints"
    rejected = ["AnyEncoding"]
    impacts = [vAt, vMore, cut]

fn vAt(b: Bytes, i: LPos) -> LAt
    ? "The varint at i and where the next field starts; at is -1 when there is none, value -1 when it is malformed (MinimalVarints)."
    match Bytes.get(b, i.value)
        Option.None -> LAt(value = 0, at = LPos(value = -1))
        Option.Some(x) -> match x < 128
            true -> LAt(value = x, at = lorNone(lposOf(i.value + 1)))
            false -> vMore(b, i, Bits.and(x, 127), 1, 128)

verify vAt
    vAt(Bytes.fromList([172, 2]), LPos(value = 0)) => LAt(value = 300, at = LPos(value = 2))
    vAt(Bytes.fromList([172]), LPos(value = 0)).at.value => -1
    vAt(Bytes.fromList([128, 0]), LPos(value = 0)) => LAt(value = -1, at = LPos(value = -1))
    vAt(Bytes.fromList([128, 128, 128, 128, 128, 128, 128, 128, 128, 1]), LPos(value = 0)) => LAt(value = 9223372036854775808, at = LPos(value = 10))
    vAt(Bytes.fromList([255, 255, 255, 255, 255, 255, 255, 255, 255, 1]), LPos(value = 0)) => LAt(value = 18446744073709551615, at = LPos(value = 10))
    vAt(Bytes.fromList([128, 128, 128, 128, 128, 128, 128, 128, 128, 2]), LPos(value = 0)).value => -1

fn vMore(b: Bytes, i: LPos, acc: Int, k: Int, w: Int) -> LAt
    ? "Byte k of the varint at i, of weight w: it may not end the varint as 0x00, and the tenth must be 1 (MinimalVarints)."
    match Bytes.get(b, i.value + k)
        Option.None -> LAt(value = 0, at = LPos(value = -1))
        Option.Some(x) -> match k >= 9
            true -> match x == 1
                true -> LAt(value = acc + w, at = lorNone(lposOf(i.value + 10)))
                false -> LAt(value = -1, at = LPos(value = -1))
            false -> match x < 128
                true -> match x == 0
                    true -> LAt(value = -1, at = LPos(value = -1))
                    false -> LAt(value = acc + x * w, at = lorNone(lposOf(i.value + k + 1)))
                false -> vMore(b, i, acc + Bits.and(x, 127) * w, k + 1, w * 128)

verify vMore
    vMore(Bytes.fromList([128, 1]), LPos(value = 0), 0, 1, 128) => LAt(value = 128, at = LPos(value = 2))

fn cut(xs: List<LAt>) -> Step
    ? "A record whose fields ran out: a malformed varint among them, else the block ends inside it (MinimalVarints)."
    match xs
        [] -> short()
        [x, ..rest] -> match x.value < 0
            true -> Step.Bad("a varint is not minimal or not below 2^64")
            false -> cut(rest)

verify cut
    cut([LAt(value = 0, at = LPos(value = -1))]) => Step.Bad("the block ends inside it")
    cut([LAt(value = -1, at = LPos(value = -1))]) => Step.Bad("a varint is not minimal or not below 2^64")

decision BlockCountBounded
    date = "2026-11-11"
    reason =
        "Decoding makes a vector of as many places as the block holds"
        "expressions before reading any. The count comes from the theorem's"
        "record. The reader already held it to the format's rules when it"
        "read MAIN: at most half the block's length, and at most 2^32 - 1"
        "(Susz 1 spec, section 5.2). A file that breaks them is rejected"
        "there. A count past Aver's largest vector, 2^24, then declines the"
        "declaration. That is an implementation limit, decided by the file's"
        "bytes alone, and ordered with the declaration's other failures."
    chosen = "BlockCountBounded"
    rejected = ["CountTrusted", "CountAtTheBlockHead"]
    impacts = [decoded]

fn decoded(s: Store, b: Bytes, bd: Bounds) -> Decoded
    ? "The block: its count from the theorem's record, then its records; the last expression is the proof (BlockCountBounded)."
    match Vector.new(bd.count, Core.Exprs.bvar(0))
        Result.Ok(xs) -> built(s, b, bd, LPos(value = 0), 0, bd.count, xs)
        Result.Err(e) -> Decoded.Long("PROOFS @ {bd.at}: a block of {bd.count} expressions: {e}")

verify decoded
    decoded(emptyStore(), Bytes.fromList([7, 3]), bounds1(1)) => Decoded.Term(Core.Exprs.bvar(3))

fn built(s: Store, b: Bytes, bd: Bounds, i: LPos, k: Int, n: Int, xs: Vector<Expr>) -> Decoded
    ? "The record at i, the block's record k + 1, after k of its n expressions; xs holds those k."
    match k >= n
        true -> ended(b, bd, i, n, xs)
        false -> match Bytes.get(b, i.value)
            Option.None -> Decoded.Broken("PROOFS @ {bd.at + i.value}: record {k + 1}: the block ends inside it")
            Option.Some(tag) -> withOne(s, b, bd, i, k, n, xs, recordOf(s, b, xs, k, bd, tag, lorNone(lposOf(i.value + 1))))

fn withOne(s: Store, b: Bytes, bd: Bounds, i: LPos, k: Int, n: Int, xs: Vector<Expr>, r: Step) -> Decoded
    ? "Goes on after expression k, or stops at a bad one, named by where its record starts and its number in the block (Susz 1 spec, section 8)."
    match r
        Step.Got(e, at) -> built(s, b, bd, at, k + 1, n, placed(xs, k, e))
        Step.Bad(e) -> Decoded.Broken("PROOFS @ {bd.at + i.value}: record {k + 1}: {e}")

fn ended(b: Bytes, bd: Bounds, i: LPos, n: Int, xs: Vector<Expr>) -> Decoded
    ? "All n expressions read: the block must end there."
    match i.value == Bytes.len(b)
        false -> Decoded.Broken("PROOFS @ {bd.at + i.value}: record {n + 1}: {Bytes.len(b) - i.value} bytes after the last record")
        true -> lastOf(xs, n)

fn placed(v: Vector<Expr>, j: Int, e: Expr) -> Vector<Expr>
    ? "v with e at j; j is always in range."
    Option.withDefault(Vector.set(v, j, e), v)

fn lastOf(xs: Vector<Expr>, n: Int) -> Decoded
    ? "The last expression's term."
    match Vector.get(xs, n - 1)
        Option.Some(e) -> Decoded.Term(e)
        Option.None -> Decoded.Broken("proof block: empty")

fn ref(s: Store, xs: Vector<Expr>, k: Int, bd: Bounds, r: Int) -> Option<Expr>
    ? "Reference r from expression k: r back among the block's own expressions when r is at most k, else frontier expression r - k - 1, which must have been listed before the block's declaration."
    match r <= k
        true -> match r >= 1
            true -> Vector.get(xs, k - r)
            false -> Option.None
        false -> match r - k - 1 < bd.exprs
            true -> Vector.get(s.exprs, r - k - 1)
            false -> Option.None

fn nameAt(s: Store, bd: Bounds, i: Int) -> Option<Name>
    ? "Frontier name i, listed before the block's declaration."
    match i < bd.names
        true -> Vector.get(s.names, i)
        false -> Option.None

fn levelAt(s: Store, bd: Bounds, i: Int) -> Option<Level>
    ? "Frontier level i, listed before the block's declaration."
    match i < bd.levels
        true -> Vector.get(s.levels, i)
        false -> Option.None

fn recordOf(s: Store, b: Bytes, xs: Vector<Expr>, k: Int, bd: Bounds, tag: Int, i: LPos) -> Step
    ? "The record with tag, its fields at i; applications first, the most common. A block holds expression records only, tags 7 to 16 (Susz 1 spec, section 6)."
    match tag
        10 -> appOf(s, xs, k, bd, b, vAt(b, i))
        11 -> binderOf(s, b, xs, k, bd, i, true)
        12 -> binderOf(s, b, xs, k, bd, i, false)
        7 -> bvarOf(vAt(b, i))
        9 -> constOf(s, b, bd, vAt(b, i))
        8 -> sortOf(s, bd, vAt(b, i))
        13 -> letOf(s, b, xs, k, bd, vAt(b, i))
        14 -> natOf(b, vAt(b, i))
        15 -> strOf(b, vAt(b, i))
        16 -> projOf(s, b, xs, k, bd, vAt(b, i))
        _ -> Step.Bad("unknown record tag {tag}")

fn appOf(s: Store, xs: Vector<Expr>, k: Int, bd: Bounds, b: Bytes, f: LAt) -> Step
    ? "10: the function and the argument."
    a = vAt(b, f.at)
    match a.at.value < 0
        true -> cut([f, a])
        false -> match ref(s, xs, k, bd, f.value)
            Option.None -> Step.Bad("unknown expression reference {f.value}")
            Option.Some(fe) -> match ref(s, xs, k, bd, a.value)
                Option.None -> Step.Bad("unknown expression reference {a.value}")
                Option.Some(ae) -> Step.Got(Core.Exprs.app(fe, ae), a.at)

fn binderOf(s: Store, b: Bytes, xs: Vector<Expr>, k: Int, bd: Bounds, i: LPos, isLam: Bool) -> Step
    ? "11 lambda, 12 pi: the annotation byte, the name, the type and the body."
    n = vAt(b, lorNone(lposOf(i.value + 1)))
    ty = vAt(b, n.at)
    body = vAt(b, ty.at)
    match Bool.or(i.value >= Bytes.len(b), body.at.value < 0)
        true -> cut([n, ty, body])
        false -> match binderInfo(Option.withDefault(Bytes.get(b, i.value), 9))
            Option.None -> Step.Bad("unknown binder annotation {Option.withDefault(Bytes.get(b, i.value), 9)}")
            Option.Some(bi) -> binderBuilt(nameAt(s, bd, n.value), n.value, ref(s, xs, k, bd, ty.value), ty.value, ref(s, xs, k, bd, body.value), body.value, bi, isLam, body.at)

fn binderBuilt(n: Option<Name>, ni: Int, ty: Option<Expr>, ti: Int, body: Option<Expr>, bo: Int, bi: Binder, isLam: Bool, at: LPos) -> Step
    ? "The binder from its parts, when all are there; they are looked up in the order of the fields."
    match n
        Option.None -> Step.Bad("unknown name reference {ni}")
        Option.Some(nm) -> match ty
            Option.None -> Step.Bad("unknown expression reference {ti}")
            Option.Some(t) -> match body
                Option.None -> Step.Bad("unknown expression reference {bo}")
                Option.Some(x) -> match isLam
                    true -> Step.Got(Core.Exprs.lam(nm, t, x, bi), at)
                    false -> Step.Got(Core.Exprs.pi(nm, t, x, bi), at)

fn binderInfo(k: Int) -> Option<Binder>
    ? "0 default, 1 implicit, 2 strict implicit, 3 instance implicit."
    match k
        0 -> Option.Some(Binder.Default)
        1 -> Option.Some(Binder.Implicit)
        2 -> Option.Some(Binder.StrictImplicit)
        3 -> Option.Some(Binder.InstImplicit)
        _ -> Option.None

fn bvarOf(x: LAt) -> Step
    ? "7: a bound variable."
    match x.at.value < 0
        true -> cut([x])
        false -> Step.Got(Core.Exprs.bvar(x.value), x.at)

fn sortOf(s: Store, bd: Bounds, l: LAt) -> Step
    ? "8: the sort of a frontier level."
    match l.at.value < 0
        true -> cut([l])
        false -> match levelAt(s, bd, l.value)
            Option.None -> Step.Bad("unknown level reference {l.value}")
            Option.Some(lv) -> Step.Got(Core.Exprs.sort(lv), l.at)

fn constOf(s: Store, b: Bytes, bd: Bounds, n: LAt) -> Step
    ? "9: a frontier name and its frontier levels; the name must be declared before the theorem (DeclaredBefore)."
    c = vAt(b, n.at)
    match Bool.or(n.at.value < 0, c.at.value < 0)
        true -> cut([n, c])
        false -> match nameAt(s, bd, n.value)
            Option.None -> Step.Bad("unknown name reference {n.value}")
            Option.Some(nm) -> match declaredBefore(s, n.value, bd.decl)
                false -> Step.Bad("{Core.Names.render(nm)} is not declared before the theorem")
                true -> constBuilt(nm, levelsFrom(s, bd, b, c.at, c.value))

fn constBuilt(nm: Name, ls: Lvls) -> Step
    ? "The constant, when its levels are there."
    match ls.at.value < 0
        true -> Step.Bad("a level reference is unknown, malformed or runs past the block")
        false -> Step.Got(Core.Exprs.cnst(nm, ls.ls), ls.at)

fn levelsFrom(s: Store, bd: Bounds, b: Bytes, i: LPos, n: Int) -> Lvls
    ? "n frontier levels at i, in order."
    match n <= 0
        true -> Lvls(ls = [], at = i)
        false -> levelThen(s, bd, b, vAt(b, i), n)

fn levelThen(s: Store, bd: Bounds, b: Bytes, x: LAt, n: Int) -> Lvls
    ? "One level read; the rest follow it."
    match x.at.value < 0
        true -> Lvls(ls = [], at = LPos(value = -1))
        false -> match levelAt(s, bd, x.value)
            Option.None -> Lvls(ls = [], at = LPos(value = -1))
            Option.Some(l) -> levelsPrefixed(l, levelsFrom(s, bd, b, x.at, n - 1))

fn levelsPrefixed(l: Level, rest: Lvls) -> Lvls
    ? "l in front of the rest."
    Lvls(ls = List.prepend(l, rest.ls), at = rest.at)

fn letOf(s: Store, b: Bytes, xs: Vector<Expr>, k: Int, bd: Bounds, n: LAt) -> Step
    ? "13: a let, its name, type, value and body."
    ty = vAt(b, n.at)
    v = vAt(b, ty.at)
    body = vAt(b, v.at)
    match body.at.value < 0
        true -> cut([n, ty, v, body])
        false -> letBuilt(nameAt(s, bd, n.value), n.value, ref(s, xs, k, bd, ty.value), ty.value, ref(s, xs, k, bd, v.value), v.value, ref(s, xs, k, bd, body.value), body.value, body.at)

fn letBuilt(n: Option<Name>, ni: Int, ty: Option<Expr>, ti: Int, v: Option<Expr>, vi: Int, body: Option<Expr>, bo: Int, at: LPos) -> Step
    ? "The let, when all its parts are there."
    match n
        Option.None -> Step.Bad("unknown name reference {ni}")
        Option.Some(nm) -> match ty
            Option.None -> Step.Bad("unknown expression reference {ti}")
            Option.Some(t) -> match v
                Option.None -> Step.Bad("unknown expression reference {vi}")
                Option.Some(x) -> match body
                    Option.None -> Step.Bad("unknown expression reference {bo}")
                    Option.Some(y) -> Step.Got(Core.Exprs.letE(nm, t, x, y), at)

fn natOf(b: Bytes, n: LAt) -> Step
    ? "14: a Nat by its minimal little-endian bytes, as Export.Susz reads one in MAIN."
    match n.at.value < 0
        true -> cut([n])
        false -> match n.at.value + n.value <= Bytes.len(b)
            false -> short()
            true -> natRead(b, n.at.value, n.value)

fn natRead(b: Bytes, i: Int, n: Int) -> Step
    ? "The n bytes at i, the last not 0x00, as a number."
    match Bool.and(n > 0, Option.withDefault(Bytes.get(b, i + n - 1), 0) == 0)
        true -> Step.Bad("a Nat literal ends in a zero byte")
        false -> Step.Got(Core.Exprs.natLit(leValue(b, i, i + n - 1, 0)), lorNone(lposOf(i + n)))

fn leValue(b: Bytes, i: Int, j: Int, acc: Int) -> Int
    ? "The bytes from i to j as a little-endian number, read from the last; acc is the value of those after j."
    match j < i
        true -> acc
        false -> leValue(b, i, j - 1, acc * 256 + Option.withDefault(Bytes.get(b, j), 0))

verify leValue
    leValue(Bytes.fromList([1, 2]), 0, 1, 0) => 513

verify natRead
    natRead(Bytes.fromList([0, 1]), 0, 2) => Step.Got(Core.Exprs.natLit(256), LPos(value = 2))

verify natOf
    natOf(Bytes.fromList([14, 2, 0, 1]), LAt(value = 2, at = LPos(value = 2))) => Step.Got(Core.Exprs.natLit(256), LPos(value = 4))
    natOf(Bytes.fromList([14, 1, 0]), LAt(value = 1, at = LPos(value = 2))) => Step.Bad("a Nat literal ends in a zero byte")
    natOf(Bytes.fromList([14, 0]), LAt(value = 0, at = LPos(value = 2))) => Step.Got(Core.Exprs.natLit(0), LPos(value = 2))

fn strOf(b: Bytes, n: LAt) -> Step
    ? "15: a string, well-formed UTF-8."
    match n.at.value < 0
        true -> cut([n])
        false -> match n.at.value + n.value <= Bytes.len(b)
            false -> short()
            true -> match String.fromUtf8(Bytes.take(Bytes.drop(b, n.at.value), n.value))
                Result.Err(e) -> Step.Bad("a string is not UTF-8: {e}")
                Result.Ok(text) -> Step.Got(Core.Exprs.strLit(text), lorNone(lposOf(n.at.value + n.value)))

verify strOf
    strOf(Bytes.fromList([15, 1, 255]), LAt(value = 1, at = LPos(value = 2))) => Step.Bad("a string is not UTF-8: invalid UTF-8")

fn projOf(s: Store, b: Bytes, xs: Vector<Expr>, k: Int, bd: Bounds, n: LAt) -> Step
    ? "16: a projection, the structure's frontier name, the field and the structure; the name must be declared before the theorem (DeclaredBefore)."
    f = vAt(b, n.at)
    x = vAt(b, f.at)
    match x.at.value < 0
        true -> cut([n, f, x])
        false -> match nameAt(s, bd, n.value)
            Option.None -> Step.Bad("unknown name reference {n.value}")
            Option.Some(nm) -> match declaredBefore(s, n.value, bd.decl)
                false -> Step.Bad("{Core.Names.render(nm)} is not declared before the theorem")
                true -> match ref(s, xs, k, bd, x.value)
                    Option.None -> Step.Bad("unknown expression reference {x.value}")
                    Option.Some(e) -> Step.Got(Core.Exprs.proj(nm, f.value, e), x.at)

fn bounds1(n: Int) -> Bounds
    ? "Bounds of declaration 0 with an empty frontier and n expressions, for examples."
    Bounds(decl = 0, names = 0, levels = 0, exprs = 0, count = n, at = 0)

verify bounds1
    bounds1(2).count => 2

verify built
    built(emptyStore(), Bytes.fromList([7, 3]), bounds1(1), LPos(value = 0), 0, 1, Vector.fromList([Core.Exprs.bvar(0)])) => Decoded.Term(Core.Exprs.bvar(3))
    built(emptyStore(), Bytes.fromList([]), bounds1(1), LPos(value = 0), 0, 1, Vector.fromList([Core.Exprs.bvar(0)])) => Decoded.Broken("PROOFS @ 0: record 1: the block ends inside it")

verify withOne
    withOne(emptyStore(), Bytes.fromList([]), Bounds.update(bounds1(1), at = 10), LPos(value = 4), 2, 3, Vector.fromList([Core.Exprs.bvar(0)]), Step.Bad("x")) => Decoded.Broken("PROOFS @ 14: record 3: x")

verify ended
    ended(Bytes.fromList([7, 3]), bounds1(1), LPos(value = 2), 1, Vector.fromList([Core.Exprs.bvar(3)])) => Decoded.Term(Core.Exprs.bvar(3))

verify lastOf
    lastOf(Vector.fromList([]), 1) => Decoded.Broken("proof block: empty")

verify ref
    ref(emptyStore(), Vector.fromList([Core.Exprs.bvar(1)]), 1, bounds1(1), 1) => Option.Some(Core.Exprs.bvar(1))
    ref(emptyStore(), Vector.fromList([Core.Exprs.bvar(1)]), 1, bounds1(1), 0) => Option.None
    ref(Store.update(emptyStore(), exprs = Vector.fromList([Core.Exprs.bvar(7)])), Vector.fromList([]), 0, bounds1(1), 1) => Option.None
    ref(Store.update(emptyStore(), exprs = Vector.fromList([Core.Exprs.bvar(7)])), Vector.fromList([]), 0, Bounds.update(bounds1(1), exprs = 1), 1) => Option.Some(Core.Exprs.bvar(7))

verify nameAt
    nameAt(Store.update(emptyStore(), names = Vector.fromList([Core.Names.anon()])), bounds1(1), 0) => Option.None
    nameAt(Store.update(emptyStore(), names = Vector.fromList([Core.Names.anon()])), Bounds.update(bounds1(1), names = 1), 0) => Option.Some(Core.Names.anon())

verify levelAt
    levelAt(Store.update(emptyStore(), levels = Vector.fromList([Level.Zero])), bounds1(1), 0) => Option.None

verify recordOf
    recordOf(emptyStore(), Bytes.fromList([99]), Vector.fromList([]), 0, bounds1(1), 99, LPos(value = 1)) => Step.Bad("unknown record tag 99")
    recordOf(emptyStore(), Bytes.fromList([17, 1]), Vector.fromList([]), 0, bounds1(1), 17, LPos(value = 1)) => Step.Bad("unknown record tag 17")
    recordOf(emptyStore(), Bytes.fromList([19, 0, 1]), Vector.fromList([]), 0, bounds1(1), 19, LPos(value = 1)) => Step.Bad("unknown record tag 19")

verify appOf
    appOf(emptyStore(), Vector.fromList([]), 0, bounds1(1), Bytes.fromList([1, 1]), LAt(value = 1, at = LPos(value = 1))) => Step.Bad("unknown expression reference 1")
    appOf(emptyStore(), Vector.fromList([]), 0, bounds1(1), Bytes.fromList([10, 1, 129, 0]), LAt(value = 1, at = LPos(value = 2))) => Step.Bad("a varint is not minimal or not below 2^64")

verify binderOf
    binderOf(emptyStore(), Bytes.fromList([9, 0, 1, 1]), Vector.fromList([]), 0, bounds1(1), LPos(value = 0), true) => Step.Bad("unknown binder annotation 9")

verify binderBuilt
    binderBuilt(Option.None, 4, Option.None, 1, Option.None, 1, Binder.Default, true, LPos(value = 0)) => Step.Bad("unknown name reference 4")

verify binderInfo
    binderInfo(3) => Option.Some(Binder.InstImplicit)
    binderInfo(4) => Option.None

verify bvarOf
    bvarOf(LAt(value = 2, at = LPos(value = 1))) => Step.Got(Core.Exprs.bvar(2), LPos(value = 1))

verify sortOf
    sortOf(emptyStore(), bounds1(1), LAt(value = 0, at = LPos(value = 1))) => Step.Bad("unknown level reference 0")

verify constOf
    constOf(emptyStore(), Bytes.fromList([0, 0]), bounds1(1), LAt(value = 0, at = LPos(value = 1))) => Step.Bad("unknown name reference 0")
    constOf(Store(names = Vector.fromList([Core.Names.str(Core.Names.anon(), "C")]), levels = Vector.fromList([]), exprs = Vector.fromList([]), decls = Vector.fromList([4])), Bytes.fromList([0, 0]), Bounds.update(bounds1(1), decl = 4, names = 1), LAt(value = 0, at = LPos(value = 1))) => Step.Bad("C is not declared before the theorem")
    constOf(Store(names = Vector.fromList([Core.Names.str(Core.Names.anon(), "C")]), levels = Vector.fromList([]), exprs = Vector.fromList([]), decls = Vector.fromList([3])), Bytes.fromList([0, 0]), Bounds.update(bounds1(1), decl = 4, names = 1), LAt(value = 0, at = LPos(value = 1))) => Step.Got(Core.Exprs.cnst(Core.Names.str(Core.Names.anon(), "C"), []), LPos(value = 2))

verify constBuilt
    constBuilt(Core.Names.anon(), Lvls(ls = [], at = LPos(value = 2))) => Step.Got(Core.Exprs.cnst(Core.Names.anon(), []), LPos(value = 2))

verify levelsFrom
    levelsFrom(emptyStore(), bounds1(1), Bytes.fromList([]), LPos(value = 0), 0) => Lvls(ls = [], at = LPos(value = 0))

verify levelThen
    levelThen(emptyStore(), bounds1(1), Bytes.fromList([]), LAt(value = 0, at = LPos(value = -1)), 1).at.value => -1

verify letOf
    letOf(emptyStore(), Bytes.fromList([0, 1, 1, 1]), Vector.fromList([]), 0, bounds1(1), LAt(value = 0, at = LPos(value = 1))) => Step.Bad("unknown name reference 0")

verify letBuilt
    letBuilt(Option.None, 3, Option.None, 1, Option.None, 1, Option.None, 1, LPos(value = 0)) => Step.Bad("unknown name reference 3")

verify projOf
    projOf(emptyStore(), Bytes.fromList([0, 0, 1]), Vector.fromList([]), 0, bounds1(1), LAt(value = 0, at = LPos(value = 1))) => Step.Bad("unknown name reference 0")
    projOf(Store(names = Vector.fromList([Core.Names.str(Core.Names.anon(), "S")]), levels = Vector.fromList([]), exprs = Vector.fromList([]), decls = Vector.fromList([never()])), Bytes.fromList([0, 0, 1]), Vector.fromList([]), 0, Bounds.update(bounds1(1), names = 1), LAt(value = 0, at = LPos(value = 1))) => Step.Bad("S is not declared before the theorem")
