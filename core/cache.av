module Cache
    intent =
        "A cache of the checker: a map from a hash to the bucket of"
        "(key, value) pairs whose keys have that hash. The key is"
        "compared structurally, so a shared hash only costs a longer"
        "bucket. The checker hands its state on rather than keeping it,"
        "so a cache is updated in place. A bucket of one entry, nearly"
        "every one, is the entry itself."
    exposes [Bucket, empty, get, add, size, find]
    depends [Core.Exprs]
    effects []

decision MapCaches
    date = "2026-10-21"
    reason =
        "A persistent trie copied a path of ten nodes on every write, and"
        "freed ten, to keep an old version of the cache that nothing ever"
        "went back to: the checker's memory stayed low because no old"
        "version lived. Since Aver moves a Map threaded through record"
        "results, and with the state handed on rather than read after it"
        "is passed, a write finds the map with one owner and changes it in"
        "place. Init: 579.7 G instructions retired with the trie, 480.5 G"
        "with maps on four workers (wall 18.3 s to 15.6 s), 533.4 G to"
        "441.7 G on one, with the same peak memory."
    chosen = "MapCaches"
    rejected = ["PersistentCaches"]
    impacts = [add, get]

decision OneEntryBuckets
    date = "2026-10-22"
    reason =
        "Nearly every bucket holds one entry. As a list it was a vector, a"
        "shared pointer to it and a list node, three allocations for every"
        "result kept and three frees when a cache was emptied, and reading"
        "a missing hash built an empty list, two more. As a variant holding"
        "the pair, a bucket of one sits in the map itself: keeping a result"
        "allocates nothing, and emptying a cache drops two references per"
        "entry. Instructions retired, one worker: Init 287.2 G to 277.5 G,"
        "qb9 257.9 G to 250.1 G, etale 131.3 G to 127.4 G."
    chosen = "OneEntryBuckets"
    rejected = ["ListBuckets"]
    impacts = [Bucket, get, add]

type Bucket
    NoEntry
    OneEntry(Tuple<Expr, Expr>)
    Entries(List<Tuple<Expr, Expr>>)

fn empty() -> Map<Core.Exprs.Key, Bucket>
    ? "No entries."
    {}

verify empty
    size(empty()) => 0

fn size(m: Map<Core.Exprs.Key, Bucket>) -> Int
    ? "Number of hashes with an entry."
    Map.len(m)

verify size
    size(add(add(empty(), Core.Exprs.key(1), (Core.Exprs.bvar(0), Core.Exprs.bvar(1))), Core.Exprs.key(17), (Core.Exprs.bvar(2), Core.Exprs.bvar(3)))) => 2

fn get(m: Map<Core.Exprs.Key, Bucket>, key: Core.Exprs.Key) -> Bucket
    ? "The bucket stored under key, or an empty one."
    match Map.get(m, key)
        Option.Some(b) -> b
        Option.None -> Bucket.NoEntry

verify get
    get(empty(), Core.Exprs.key(3)) => Bucket.NoEntry
    get(add(empty(), Core.Exprs.key(3), (Core.Exprs.bvar(0), Core.Exprs.bvar(1))), Core.Exprs.key(3)) => Bucket.OneEntry((Core.Exprs.bvar(0), Core.Exprs.bvar(1)))

fn add(m: Map<Core.Exprs.Key, Bucket>, key: Core.Exprs.Key, entry: Tuple<Expr, Expr>) -> Map<Core.Exprs.Key, Bucket>
    ? "Prepends entry to key's bucket. The map is read first and then named once, so that the set changes it in place."
    b = get(m, key)
    Map.set(m, key, joined(entry, b))

verify add
    get(add(add(empty(), Core.Exprs.key(3), (Core.Exprs.bvar(0), Core.Exprs.bvar(1))), Core.Exprs.key(3), (Core.Exprs.bvar(2), Core.Exprs.bvar(3))), Core.Exprs.key(3)) => Bucket.Entries([(Core.Exprs.bvar(2), Core.Exprs.bvar(3)), (Core.Exprs.bvar(0), Core.Exprs.bvar(1))])

fn joined(entry: Tuple<Expr, Expr>, b: Bucket) -> Bucket
    ? "A bucket with entry in front."
    match b
        Bucket.NoEntry -> Bucket.OneEntry(entry)
        Bucket.OneEntry(first) -> Bucket.Entries([entry, first])
        Bucket.Entries(es) -> Bucket.Entries(List.prepend(entry, es))

verify joined
    joined((Core.Exprs.bvar(0), Core.Exprs.bvar(1)), Bucket.NoEntry) => Bucket.OneEntry((Core.Exprs.bvar(0), Core.Exprs.bvar(1)))

fn find(m: Map<Core.Exprs.Key, Bucket>, key: Core.Exprs.Key, e: Expr) -> Option<Expr>
    ? "The value paired with an expression equal to e in key's bucket."
    findIn(get(m, key), e)

verify find
    find(add(empty(), Core.Exprs.key(4), (Core.Exprs.bvar(0), Core.Exprs.bvar(1))), Core.Exprs.key(4), Core.Exprs.bvar(0)) => Option.Some(Core.Exprs.bvar(1))
    find(add(empty(), Core.Exprs.key(4), (Core.Exprs.bvar(0), Core.Exprs.bvar(1))), Core.Exprs.key(4), Core.Exprs.bvar(2)) => Option.None

fn findIn(bucket: Bucket, e: Expr) -> Option<Expr>
    ? "The value paired with an expression equal to e in a bucket."
    match bucket
        Bucket.NoEntry -> Option.None
        Bucket.OneEntry((k, v)) -> match k == e
            true -> Option.Some(v)
            false -> Option.None
        Bucket.Entries(es) -> findInList(es, e)

verify findIn
    findIn(Bucket.NoEntry, Core.Exprs.bvar(0)) => Option.None
    findIn(Bucket.OneEntry((Core.Exprs.bvar(0), Core.Exprs.bvar(1))), Core.Exprs.bvar(0)) => Option.Some(Core.Exprs.bvar(1))

fn findInList(es: List<Tuple<Expr, Expr>>, e: Expr) -> Option<Expr>
    ? "Linear search of a bucket's entries."
    match es
        [] -> Option.None
        [(k, v), ..rest] -> match k == e
            true -> Option.Some(v)
            false -> findInList(rest, e)

verify findInList
    findInList([], Core.Exprs.bvar(0)) => Option.None
