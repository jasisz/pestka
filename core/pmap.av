module PMap
    intent =
        "A persistent hash trie from Int keys to buckets of expression pairs,"
        "for the checker's caches. Sixteen-way branching on four bits of the"
        "key at a time; an update copies one path of at most ten nodes. A"
        "copy of the trie is a copy of its root, so a state record holding"
        "it can be shared freely: an update never copies the whole table,"
        "as a Map whose owner was cloned would. A branch keeps a mask of the"
        "children it has and a vector of just those."
    exposes [PMap, empty, get, add, size, find]
    depends [Core.Exprs]
    effects []

decision PersistentCaches
    date = "2026-10-19"
    reason =
        "The checker threads its state through mutually recursive functions;"
        "where the generated Rust borrows the state and clones it, the next"
        "Map.set on a cache copies the whole map. A trie of small nodes makes"
        "that clone cost nothing and an update cost one path."
    chosen = "PersistentCaches"
    rejected = ["MapCaches"]
    impacts = [add, get]

decision CompactBranches
    date = "2026-10-21"
    reason =
        "A branch with all sixteen slots holds 768 bytes, most of them for"
        "empty children: near the leaves a branch has one or two. With a"
        "mask and only the children present, the heaviest mathlib"
        "declaration's caches (eight million entries) take 9.1 GB instead"
        "of 10.5 GB. Finding a child counts the mask's bits below it."
    chosen = "CompactBranches"
    rejected = ["FullBranches"]
    impacts = [addAt, getAt]

type PMap
    Empty
    Leaf(Int, List<Tuple<Expr, Expr>>)
    Branch(Int, Vector<PMap>, Int)

fn empty() -> PMap
    ? "The empty trie."
    PMap.Empty

verify empty
    size(empty()) => 0

fn size(m: PMap) -> Int
    ? "Number of entries."
    match m
        PMap.Empty -> 0
        PMap.Leaf(_, b) -> List.len(b)
        PMap.Branch(_, _, n) -> n

verify size
    size(add(add(empty(), 1, (Core.Exprs.bvar(0), Core.Exprs.bvar(1))), 17, (Core.Exprs.bvar(2), Core.Exprs.bvar(3)))) => 2

fn sampleTrie(n: Int) -> PMap
    ? "A trie of n entries, the i-th under the key 37 * i, for the laws: the keys share and split nibbles at every level."
    match n <= 0
        true -> PMap.Empty
        false -> add(sampleTrie(n - 1), 37 * (n - 1), (Core.Exprs.natLit(n - 1), Core.Exprs.bvar(0)))

verify sampleTrie
    size(sampleTrie(300)) => 300

fn addedSpec(n: Int, i: Int) -> Option<Expr>
    ? "What a trie of the first n sample entries holds for the i-th."
    match Bool.and(i >= 0, i < n)
        true -> Option.Some(Core.Exprs.bvar(0))
        false -> Option.None

verify addedSpec
    addedSpec(3, 3) => Option.None

verify add law findsEachAdded
    given n: Int = [0, 1, 2, 16, 17, 40, 300]
    given i: Int = [0, 1, 15, 16, 39, 299]
    find(sampleTrie(n), 37 * i, Core.Exprs.natLit(i)) => addedSpec(n, i)

fn nibble(key: Int, shift: Int) -> Int
    ? "Four bits of the key starting at bit shift."
    Bits.and(Result.withDefault(Bits.shiftRight(key, shift), 0), 15)

verify nibble
    nibble(255, 4) => 15
    nibble(16, 4) => 1
    nibble(16, 0) => 0

fn get(m: PMap, key: Int) -> List<Tuple<Expr, Expr>>
    ? "The bucket stored under key, or an empty one."
    getAt(m, key, 0)

verify get
    get(empty(), 3) => []
    get(add(empty(), 3, (Core.Exprs.bvar(0), Core.Exprs.bvar(1))), 3) => [(Core.Exprs.bvar(0), Core.Exprs.bvar(1))]
    get(add(add(empty(), 3, (Core.Exprs.bvar(0), Core.Exprs.bvar(1))), 19, (Core.Exprs.bvar(2), Core.Exprs.bvar(3))), 19) => [(Core.Exprs.bvar(2), Core.Exprs.bvar(3))]

fn getAt(m: PMap, key: Int, shift: Int) -> List<Tuple<Expr, Expr>>
    ? "Descends by the key's nibbles."
    match m
        PMap.Empty -> []
        PMap.Leaf(k, b) -> match k == key
            true -> b
            false -> []
        PMap.Branch(mask, v, _) -> getAt(childAt(mask, v, nibble(key, shift)), key, shift + 4)

verify getAt
    getAt(PMap.Leaf(5, []), 6, 0) => []

fn add(m: PMap, key: Int, entry: Tuple<Expr, Expr>) -> PMap
    ? "Prepends entry to key's bucket."
    addAt(m, key, entry, 0)

verify add
    size(add(add(empty(), 3, (Core.Exprs.bvar(0), Core.Exprs.bvar(1))), 3, (Core.Exprs.bvar(2), Core.Exprs.bvar(3)))) => 2

fn addAt(m: PMap, key: Int, entry: Tuple<Expr, Expr>, shift: Int) -> PMap
    ? "Inserts below this node; a leaf with another key becomes a branch."
    match m
        PMap.Empty -> PMap.Leaf(key, [entry])
        PMap.Leaf(k, b) -> match k == key
            true -> PMap.Leaf(k, List.prepend(entry, b))
            false -> addAt(split(k, b, shift), key, entry, shift)
        PMap.Branch(mask, v, n) -> addBelow(mask, v, n, nibble(key, shift), key, entry, shift)

verify addAt
    size(addAt(PMap.Leaf(1, [(Core.Exprs.bvar(0), Core.Exprs.bvar(0))]), 17, (Core.Exprs.bvar(1), Core.Exprs.bvar(1)), 0)) => 2

fn addBelow(mask: Int, v: Vector<PMap>, n: Int, nib: Int, key: Int, entry: Tuple<Expr, Expr>, shift: Int) -> PMap
    ? "Inserts into the child under nib, made when the branch has none."
    bit = bitOf(nib)
    at = Bits.popCount(Bits.and(mask, bit - 1), 16)
    match Bits.and(mask, bit) == 0
        true -> PMap.Branch(Bits.or(mask, bit), inserted(v, at, PMap.Leaf(key, [entry])), n + 1)
        false -> PMap.Branch(mask, setChild(v, at, addAt(Option.withDefault(Vector.get(v, at), PMap.Empty), key, entry, shift + 4)), n + 1)

verify addBelow
    size(addBelow(0, Vector.fromList([]), 0, 3, 3, (Core.Exprs.bvar(0), Core.Exprs.bvar(0)), 0)) => 1

fn childAt(mask: Int, v: Vector<PMap>, nib: Int) -> PMap
    ? "The child under nib, or Empty."
    bit = bitOf(nib)
    match Bits.and(mask, bit) == 0
        true -> PMap.Empty
        false -> Option.withDefault(Vector.get(v, Bits.popCount(Bits.and(mask, bit - 1), 16)), PMap.Empty)

verify childAt
    childAt(0, Vector.fromList([]), 5) => PMap.Empty

fn bitOf(nib: Int) -> Int
    ? "The mask bit of a nibble."
    Result.withDefault(Bits.shiftLeft(1, nib), 0)

verify bitOf
    bitOf(3) => 8

fn inserted(v: Vector<PMap>, at: Int, x: PMap) -> Vector<PMap>
    ? "A vector one longer, with x at position at."
    fillInsert(v, at, x, Result.withDefault(Vector.new(Vector.len(v) + 1, PMap.Empty), v), 0)

verify inserted
    Vector.len(inserted(Vector.fromList([PMap.Empty]), 0, PMap.Empty)) => 2

fn fillInsert(src: Vector<PMap>, at: Int, x: PMap, dst: Vector<PMap>, i: Int) -> Vector<PMap>
    ? "Copies src into dst around position at, where x goes."
    match i > Vector.len(src)
        true -> dst
        false -> fillInsert(src, at, x, Option.withDefault(Vector.set(dst, i, picked(src, at, x, i)), dst), i + 1)

verify fillInsert
    Vector.len(fillInsert(Vector.fromList([]), 0, PMap.Empty, Vector.fromList([PMap.Empty]), 0)) => 1

fn picked(src: Vector<PMap>, at: Int, x: PMap, i: Int) -> PMap
    ? "What goes to position i of the longer vector."
    match i == at
        true -> x
        false -> match i < at
            true -> Option.withDefault(Vector.get(src, i), PMap.Empty)
            false -> Option.withDefault(Vector.get(src, i - 1), PMap.Empty)

verify picked
    picked(Vector.fromList([]), 0, PMap.Empty, 0) => PMap.Empty

fn split(k: Int, b: List<Tuple<Expr, Expr>>, shift: Int) -> PMap
    ? "A branch holding the old leaf under its nibble."
    PMap.Branch(bitOf(nibble(k, shift)), Vector.fromList([PMap.Leaf(k, b)]), List.len(b))

verify split
    size(split(1, [(Core.Exprs.bvar(0), Core.Exprs.bvar(0))], 0)) => 1

fn setChild(v: Vector<PMap>, i: Int, child: PMap) -> Vector<PMap>
    ? "Replaces one child; the index is always in range."
    Option.withDefault(Vector.set(v, i, child), v)

verify setChild
    Vector.len(setChild(Vector.fromList([PMap.Empty]), 0, PMap.Empty)) => 1

fn find(m: PMap, key: Int, e: Expr) -> Option<Expr>
    ? "The value paired with an expression equal to e in key's bucket."
    findIn(get(m, key), e)

verify find
    find(add(empty(), 4, (Core.Exprs.bvar(0), Core.Exprs.bvar(1))), 4, Core.Exprs.bvar(0)) => Option.Some(Core.Exprs.bvar(1))
    find(add(empty(), 4, (Core.Exprs.bvar(0), Core.Exprs.bvar(1))), 4, Core.Exprs.bvar(2)) => Option.None

fn findIn(bucket: List<Tuple<Expr, Expr>>, e: Expr) -> Option<Expr>
    ? "Linear search of a bucket."
    match bucket
        [] -> Option.None
        [(k, v), ..rest] -> match k == e
            true -> Option.Some(v)
            false -> findIn(rest, e)

verify findIn
    findIn([], Core.Exprs.bvar(0)) => Option.None
