#!/bin/sh
# Nanoda, Nanoclo, Nanobruijn and older Sokonanoda builds use a JSON config
# plus the export on stdin.
set -eu

if [ "$#" -ne 2 ]; then
    echo "usage: $0 CHECKER FILE.ndjson" >&2
    exit 2
fi

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if "$1" "$here/config.json" < "$2"; then
    code=0
else
    code=$?
fi

if [ "${NANODA_RAW_STATUS:-0}" = "1" ]; then
    exit "$code"
fi

# Match the Lean Kernel Arena adapter: unsupported input is declined, while
# every other non-success status, including a panic, is a rejection.
case "$code" in
    0) exit 0 ;;
    2) exit 2 ;;
    *) exit 1 ;;
esac
