#!/bin/sh
# Build an isolated, LLVM source-coverage-instrumented Pestka binary.
set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    echo "usage: $0 PESTKA_ROOT [OUTPUT_DIR]" >&2
    exit 2
fi

root=$(cd "$1" && pwd)
out=${2:-"$root/.build-pestycyd"}
aver_bin=${AVER:-aver}

if [ "${PESTYCYD_REUSE_GENERATED:-0}" = "1" ]; then
    generated="$root/.build"
    if [ ! -f "$generated/Cargo.toml" ]; then
        echo "$generated/Cargo.toml does not exist; run Pestka's normal build first" >&2
        exit 2
    fi
else
    generated="$out/generated"
    "$aver_bin" compile "$root/main.av" --module-root "$root" -o "$generated" >/dev/null
fi

mkdir -p "$out/build-profiles"
target=${RUST_TARGET:-$(rustc -vV | sed -n 's/^host: //p')}
LLVM_PROFILE_FILE="$out/build-profiles/pestycyd-%p-%m.profraw" \
RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-C instrument-coverage" \
    cargo build --release --bin main --manifest-path "$generated/Cargo.toml" \
    --target-dir "$out/target" --target "$target"

# Keep the configured binary path independent of the host target triple.
mkdir -p "$out/target/release"
ln -sf "../$target/release/main" "$out/target/release/main"

echo "$out/target/release/main"
