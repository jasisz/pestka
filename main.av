module Main
    intent =
        "Pestka's command line: read one lean4export file and give a verdict."
        "The verdict is the last line printed: accepted, rejected: <why> or"
        "declined: <why>. main returns the exit status: 0 accepted, 1 rejected,"
        "2 declined. An optional third argument picks the core: old (the"
        "default), next, or both, which checks every deferred declaration"
        "with each and rejects at the first where their answers differ."
    depends [Core.Names, Check.State, Check.Decl, Export.Stream, Export.Tables]
    effects [Args.get, Console.print, Disk.readBytesAt]

record Verdict
    code: Int
    held: Option<Check.Decl.Checking>

fn main() -> Int
    ? "Reads the file, checks it and ends with the exit status. The input and what checking found are still held here when main ends, so the process ends without freeing them (FactsHeldToExit)."
    ! [Args.get, Console.print, Disk.readBytesAt]
    args = Args.get()
    o = input(args)
    v = report(o, workersIn(args), coreIn(args))
    v.code

fn input(args: List<String>) -> Outcome
    ? "The file read on as many workers as asked for, or the usage as a decline."
    ! [Disk.readBytesAt]
    match args
        [path] -> Export.Stream.readFile(path, 8)
        [path, n] -> Export.Stream.readFile(path, workersOf(n))
        [path, n, _] -> Export.Stream.readFile(path, workersOf(n))
        _ -> Outcome.Declined("usage: pestka FILE.ndjson [WORKERS [old|next|both]]")

fn workersIn(args: List<String>) -> Int
    ? "The workers the arguments ask for; eight by default."
    match args
        [_, n] -> workersOf(n)
        [_, n, _] -> workersOf(n)
        _ -> 8

verify workersIn
    workersIn(["f", "3"]) => 3
    workersIn(["f"]) => 8

fn coreIn(args: List<String>) -> Core
    ? "The core the arguments pick; the first by default."
    match args
        [_, _, c] -> coreOf(c)
        _ -> Core.Old

verify coreIn
    coreIn(["f", "1", "next"]) => Core.Next
    coreIn(["f"]) => Core.Old

fn workersOf(n: String) -> Int
    ? "The number of workers asked for, at least one; anything unreadable means eight."
    match Int.fromString(n)
        Result.Ok(k) -> Int.max(k, 1)
        Result.Err -> 8

verify workersOf
    workersOf("3") => 3
    workersOf("0") => 1
    workersOf("x") => 8

fn coreOf(c: String) -> Core
    ? "The core asked for; anything else is the first core."
    match c
        "next" -> Core.Next
        "both" -> Core.Both
        _ -> Core.Old

verify coreOf
    coreOf("both") => Core.Both
    coreOf("next") => Core.Next
    coreOf("x") => Core.Old

fn report(o: Outcome, workers: Int, core: Core) -> Verdict
    ? "Prints the verdict."
    ! [Console.print]
    match o
        Outcome.Rejected(why) -> Verdict(code = rejected(why), held = Option.None)
        Outcome.Declined(why) -> Verdict(code = declined(why), held = Option.None)
        Outcome.Read(t) -> summary(t, workers, core)

fn summary(p: Parsed, workers: Int, core: Core) -> Verdict
    ? "Counts of what the file defines, then the checking verdict, with what checking found."
    ! [Console.print]
    Console.print("constants {p.constants}, declarations {List.len(p.decls)}, names {p.names}, levels {p.levels}, expressions {p.exprs}")
    c = Check.Decl.checkHeld(p.decls, workers, core)
    Verdict(code = verdict(c.run), held = Option.Some(c))

fn verdict(r: Result<Run, Fail>) -> Int
    ? "Accepted only when every declaration was checked; admitted inductive blocks make it a decline."
    ! [Console.print]
    match r
        Result.Err(Fail.Reject(m)) -> rejected(m)
        Result.Err(Fail.Decline(m)) -> declined(m)
        Result.Ok(run) -> counted(run)

fn counted(run: Run) -> Int
    ? "Prints what was checked, trusted and skipped."
    ! [Console.print]
    Console.print("checked {run.checked}, admitted unchecked {run.trusted}, skipped {run.skipped}")
    match run.trusted == 0
        true -> accepted()
        false -> declined("{run.trusted} nested inductive blocks are not checked yet")

fn accepted() -> Int
    ? "Every declaration was checked: status 0."
    ! [Console.print]
    Console.print("accepted")
    0

fn rejected(why: String) -> Int
    ? "Prints the rejection: status 1."
    ! [Console.print]
    Console.print("rejected: {why}")
    1

fn declined(why: String) -> Int
    ? "Prints that the input is outside what Pestka handles: status 2."
    ! [Console.print]
    Console.print("declined: {why}")
    2
