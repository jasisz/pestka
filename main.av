module Main
    intent =
        "Pestka's command line: read one lean4export file and give a verdict."
        "The verdict is the last line printed: accepted, rejected: <why> or"
        "declined: <why>. main returns the exit status: 0 accepted, 1 rejected,"
        "2 declined."
    depends [Core.Names, Check.State, Check.Decl, Export.Stream, Export.Tables, Export.Susz, Export.Pack]
    effects [Args.get, Console.print, Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.appendBytes]

record Verdict
    code: Int
    held: Option<Check.Decl.Checking>

fn main() -> Int
    ? "Reads the file, checks it and ends with the exit status. The input and what checking found are still held here when main ends, so the process ends without freeing them (FactsHeldToExit)."
    ! [Args.get, Console.print, Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.appendBytes]
    args = Args.get()
    match args
        ["pack", src, dst] -> packed(Export.Pack.pack(src, dst, 2))
        ["pack", src, dst, "0"] -> packed(Export.Pack.pack(src, dst, 0))
        ["pack", src, dst, "2"] -> packed(Export.Pack.pack(src, dst, 2))
        _ -> checked(args)

fn checked(args: List<String>) -> Int
    ? "Reads and checks the file the arguments name; the exit status."
    ! [Console.print, Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.appendBytes]
    plain = withoutFlag(args, [])
    o = input(plain)
    v = report(o, workersIn(plain), memoryIn(args), List.contains(args, "--reorder-always"), List.contains(args, "--show-placed"))
    v.code

fn packed(r: Result<String, String>) -> Int
    ? "pestka pack FILE.ndjson FILE.susz [VERSION] writes the export in Susz (docs/susz.md), of version 2 or, asked for, 0: 0 when written, 1 when not."
    ! [Console.print]
    match r
        Result.Ok(m) -> printed(m, 0)
        Result.Err(e) -> printed("cannot pack: {e}", 1)

fn printed(m: String, code: Int) -> Int
    ? "Prints m and gives code."
    ! [Console.print]
    Console.print(m)
    code

fn memoryIn(args: List<String>) -> Memory
    ? "The low-memory mode when --low-memory is among the arguments (LowMemoryMode)."
    match List.contains(args, "--low-memory")
        true -> Memory.Low
        false -> match List.contains(args, "--no-carry")
            true -> Memory.Bare
            false -> Memory.Fast

verify memoryIn
    memoryIn(["--low-memory", "f"]) => Memory.Low
    memoryIn(["f", "2"]) => Memory.Fast

fn withoutFlag(args: List<String>, acc: List<String>) -> List<String>
    ? "The arguments without the flags --low-memory, --no-carry, --reorder-always and --show-placed, in their order."
    match args
        [] -> List.reverse(acc)
        [a, ..rest] -> match Bool.or(Bool.or(a == "--low-memory", a == "--no-carry"), Bool.or(a == "--reorder-always", a == "--show-placed"))
            true -> withoutFlag(rest, acc)
            false -> withoutFlag(rest, List.prepend(a, acc))

verify withoutFlag
    withoutFlag(["f", "--low-memory", "2"], []) => ["f", "2"]
    withoutFlag(["--reorder-always", "f", "--low-memory"], []) => ["f"]
    withoutFlag([], []) => []

fn input(args: List<String>) -> Outcome
    ? "The file read on as many workers as asked for, or the usage as a decline."
    ! [Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.appendBytes]
    match args
        [path] -> fileOf(path, 4)
        [path, n] -> fileOf(path, workersOf(n))
        _ -> Outcome.Declined("usage: pestka [--low-memory] [--reorder-always] [--show-placed] FILE [WORKERS] | pestka pack FILE.ndjson FILE.susz [0|2]")

fn fileOf(path: String, workers: Int) -> Outcome
    ? "A Susz file by its signature, otherwise lean4export's ndjson, packed into Susz of version 2 in memory and read as Susz (NdjsonThroughSusz)."
    ! [Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.appendBytes]
    match Export.Susz.isSusz(path)
        true -> Export.Susz.readFile(path)
        false -> packedOf(path, workers, Export.Pack.image(path))

decision NdjsonThroughSusz
    date = "2026-11-11"
    reason =
        "An ndjson export is read one way: packed into Susz of version 2 in"
        "memory (PackedInMemory in Export.Pack) and read by the Susz reader,"
        "which leaves theorems' proofs as bytes until they are checked."
        "Packing and the Susz reader stop at the first bad record they"
        "meet, and a Susz reader names a record by its number in a block"
        "that packing laid out, not by its line. So when packing fails, or"
        "the reader rejects or declines the image, the ndjson reader reads"
        "the file as it always has, and its verdict, the first bad line"
        "named by its number, is the one given: a file that is not read is"
        "reported as the ndjson reader reports it, and only a file that is"
        "read whole goes on to be checked from the image."
    chosen = "NdjsonThroughSusz"
    rejected = ["NdjsonReaderOnly", "PackErrorsAsLines"]
    impacts = [fileOf, packedOf, readPacked]

fn packedOf(path: String, workers: Int, r: Result<Image, String>) -> Outcome
    ? "The image read, or the file read by the ndjson reader when it could not be packed (NdjsonThroughSusz)."
    ! [Disk.readBytesAt, Disk.size]
    match r
        Result.Ok(m) -> readPacked(path, workers, Export.Susz.readImage(m))
        Result.Err(_) -> Export.Stream.readFile(path, workers)

fn readPacked(path: String, workers: Int, o: Outcome) -> Outcome
    ? "The image as read, or the file read by the ndjson reader when the image was not (NdjsonThroughSusz)."
    ! [Disk.readBytesAt, Disk.size]
    match o
        Outcome.Read(_) -> o
        _ -> Export.Stream.readFile(path, workers)

fn workersIn(args: List<String>) -> Int
    ? "The workers the arguments ask for; four by default."
    match args
        [_, n] -> workersOf(n)
        _ -> 4

verify workersIn
    workersIn(["f", "3"]) => 3
    workersIn(["f"]) => 4

fn workersOf(n: String) -> Int
    ? "The number of workers asked for, at least one; anything unreadable means four."
    match Int.fromString(n)
        Result.Ok(k) -> Int.max(k, 1)
        Result.Err -> 4

verify workersOf
    workersOf("3") => 3
    workersOf("0") => 1
    workersOf("x") => 4

fn report(o: Outcome, workers: Int, memory: Memory, always: Bool, show: Bool) -> Verdict
    ? "Prints the verdict; always, from --reorder-always, a tool for tests, checks out of file order on any file the reader allows it on (CheckedByNamespace)."
    ! [Console.print]
    match o
        Outcome.Rejected(why) -> Verdict(code = rejected(why), held = Option.None)
        Outcome.Declined(why) -> Verdict(code = declined(why), held = Option.None)
        Outcome.Read(t) -> summary(t, workers, memory, always, show)

fn summary(p: Parsed, workers: Int, memory: Memory, always: Bool, show: Bool) -> Verdict
    ? "Counts of what the file defines, then the checking verdict, with what checking found. show, from --show-placed, a tool for tests, also prints whether the reader found every declaration naming only constants placed before it (NamesPlacedWhereRead), which decides whether checking may leave file order."
    ! [Console.print]
    Console.print("constants {p.constants}, declarations {List.len(p.decls)}, names {p.names}, levels {p.levels}, expressions {p.exprs}")
    shown(show, p.allPlaced)
    c = Check.Decl.checkHeld(p.decls, workers, memory, p.allPlaced, always)
    Verdict(code = verdict(c.run), held = Option.Some(c))

fn shown(show: Bool, placed: Bool) -> Unit
    ? "Whether every declaration names only constants placed before it, when asked."
    ! [Console.print]
    match show
        true -> Console.print("placed {placed}")
        false -> Unit

fn verdict(r: Result<Run, Fail>) -> Int
    ? "Accepted only when every declaration was checked; admitted inductive blocks make it a decline."
    ! [Console.print]
    match r
        Result.Err(Fail.Reject(m)) -> rejected(m)
        Result.Err(Fail.Decline(m)) -> declined(m)
        Result.Ok(run) -> counted(run)

fn counted(run: Run) -> Int
    ? "Prints what was checked, trusted and skipped."
    ! [Console.print]
    Console.print("checked {run.checked}, admitted unchecked {run.trusted}, skipped {run.skipped}")
    match run.trusted == 0
        true -> accepted()
        false -> declined("{run.trusted} nested inductive blocks are not checked yet")

fn accepted() -> Int
    ? "Every declaration was checked: status 0."
    ! [Console.print]
    Console.print("accepted")
    0

fn rejected(why: String) -> Int
    ? "Prints the rejection: status 1."
    ! [Console.print]
    Console.print("rejected: {why}")
    1

fn declined(why: String) -> Int
    ? "Prints that the input is outside what Pestka handles: status 2."
    ! [Console.print]
    Console.print("declined: {why}")
    2
