module Main
    intent =
        "Pestka's command line: read one lean4export file and give a verdict."
        "The verdict is the last line printed: accepted, rejected: <why> or"
        "declined: <why>. main returns the exit status: 0 accepted, 1 rejected,"
        "2 declined. With --only, a subset check of a Susz file names what it"
        "checked instead: checked: <names> (subset; ...), 0; rejected and"
        "declined as before; index invalid: <why>, 2, which is no verdict on"
        "the file."
    depends [Core.Names, Check.State, Check.Decl, Export.Stream, Export.Tables, Export.Susz, Export.Pack]
    effects [Args.get, Console.print, Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.appendBytes]

record Verdict
    code: Int
    held: Option<Check.Decl.Checking>

record Held
    verdict: Verdict
    input: Option<Outcome>

fn main() -> Int
    ? "Reads the file, checks it and ends with the exit status. The input and what checking found are a local of main when it ends, so the process ends without freeing them (FactsHeldToExit)."
    ! [Args.get, Console.print, Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.appendBytes]
    h = ran(Args.get())
    h.verdict.code

fn ran(args: List<String>) -> Held
    ? "pestka pack, or the check the arguments ask for, with what main holds to the end (FactsHeldToExit)."
    ! [Console.print, Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.appendBytes]
    match args
        ["pack", ..rest] -> statusOnly(packArgs(withoutIndexFlag(rest, []), List.contains(rest, "--no-index") == false))
        _ -> checked(args)

fn statusOnly(code: Int) -> Held
    ? "An exit status with nothing read or checked to hold."
    Held(verdict = Verdict(code = code, held = Option.None), input = Option.None)

verify statusOnly
    statusOnly(2).verdict.code => 2

fn packArgs(args: List<String>, indexOn: Bool) -> Int
    ? "pestka pack [--no-index] FILE.ndjson FILE.susz [WORKERS]: four workers by default."
    ! [Console.print, Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.appendBytes]
    match args
        [src, dst] -> packed(Export.Pack.pack(src, dst, 4, indexOn))
        [src, dst, n] -> packed(Export.Pack.pack(src, dst, workersOf(n), indexOn))
        _ -> printed("usage: pestka pack [--no-index] FILE.ndjson FILE.susz [WORKERS]", 2)

fn withoutIndexFlag(args: List<String>, acc: List<String>) -> List<String>
    ? "The arguments without --no-index, in their order."
    match args
        [] -> List.reverse(acc)
        [a, ..rest] -> match a == "--no-index"
            true -> withoutIndexFlag(rest, acc)
            false -> withoutIndexFlag(rest, List.prepend(a, acc))

verify withoutIndexFlag
    withoutIndexFlag(["--no-index", "a", "b"], []) => ["a", "b"]

fn checked(args: List<String>) -> Held
    ? "Reads and checks the file the arguments name, or with --only NAMES the declarations named; the verdict, with the input."
    ! [Console.print, Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.appendBytes]
    match onlyOf(args)
        Option.Some(names) -> checkedPart(withoutOnly(args, []), names)
        Option.None -> checkedWhole(args)

fn checkedWhole(args: List<String>) -> Held
    ? "Reads and checks the whole file; the verdict, with the input, both handed back for main to hold (FactsHeldToExit)."
    ! [Console.print, Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.appendBytes]
    plain = withoutFlag(args, [])
    o = input(plain)
    v = report(o, workersIn(plain), memoryIn(args), List.contains(args, "--reorder-always"), List.contains(args, "--show-placed"))
    Held(verdict = v, input = Option.Some(o))

fn onlyOf(args: List<String>) -> Option<List<String>>
    ? "The names after --only, split at commas; none without the flag, and no names when it ends the arguments."
    match args
        [] -> Option.None
        ["--only"] -> Option.Some([])
        ["--only", names, .._] -> Option.Some(namesIn(String.split(names, ","), []))
        [_, ..rest] -> onlyOf(rest)

verify onlyOf
    onlyOf(["--only", "a,b.*", "f"]) => Option.Some(["a", "b.*"])
    onlyOf(["f", "--only"]) => Option.Some([])
    onlyOf(["f", "2"]) => Option.None

fn namesIn(xs: List<String>, acc: List<String>) -> List<String>
    ? "The names that are not empty, in order."
    match xs
        [] -> List.reverse(acc)
        [x, ..rest] -> match x == ""
            true -> namesIn(rest, acc)
            false -> namesIn(rest, List.prepend(x, acc))

verify namesIn
    namesIn(["a", "", "b"], []) => ["a", "b"]

fn withoutOnly(args: List<String>, acc: List<String>) -> List<String>
    ? "The arguments without --only and the names after it."
    match args
        [] -> List.reverse(acc)
        ["--only"] -> List.reverse(acc)
        ["--only", _, ..rest] -> withoutOnly(rest, acc)
        [a, ..rest] -> withoutOnly(rest, List.prepend(a, acc))

verify withoutOnly
    withoutOnly(["--only", "a", "f", "2"], []) => ["f", "2"]
    withoutOnly(["f", "--only"], []) => ["f"]

fn checkedPart(args: List<String>, names: List<String>) -> Held
    ? "A subset check of a Susz file with INDEX: the declarations named and what they need (SubsetAdmitsUnchecked in Check.Decl); the verdict, with the input."
    ! [Console.print, Disk.readBytesAt, Disk.size]
    plain = withoutFlag(args, [])
    match plain
        [path] -> partOf(path, names, 4, memoryIn(args))
        [path, n] -> partOf(path, names, workersOf(n), memoryIn(args))
        _ -> statusOnly(declined("usage: pestka --only NAME[,NAME...] FILE.susz [WORKERS]; NAME may be Foo.* for every name under Foo"))

fn partOf(path: String, names: List<String>, workers: Int, memory: Memory) -> Held
    ? "A subset check needs names, and a Susz file: only Susz has INDEX."
    ! [Console.print, Disk.readBytesAt, Disk.size]
    match names
        [] -> statusOnly(declined("--only needs at least one name"))
        _ -> match Export.Susz.isSusz(path)
            false -> statusOnly(declined("--only checks part of a Susz file, by its INDEX: pack the export first (pestka pack FILE.ndjson FILE.susz)"))
            true -> partHeld(Export.Susz.readPart(path, Export.Susz.planOf(names)), names, workers, memory)

fn partHeld(o: Outcome, names: List<String>, workers: Int, memory: Memory) -> Held
    ? "The subset verdict, with the part read, both handed back for main to hold (FactsHeldToExit)."
    ! [Console.print]
    Held(verdict = partReport(o, names, workers, memory), input = Option.Some(o))

fn partReport(o: Outcome, names: List<String>, workers: Int, memory: Memory) -> Verdict
    ? "Prints the subset verdict: a file rejected or declined while reading is so here too; a bad INDEX ends the check as index invalid, status 2, no verdict on the file (Susz 1 spec, section 2)."
    ! [Console.print]
    match o
        Outcome.Rejected(why) -> Verdict(code = rejected(why), held = Option.None)
        Outcome.Declined(why) -> Verdict(code = declined(why), held = Option.None)
        Outcome.IndexInvalid(why) -> Verdict(code = printed("index invalid: {why}", 2), held = Option.None)
        Outcome.Read(p) -> partSummary(p, names, workers, memory)

fn partSummary(p: Parsed, names: List<String>, workers: Int, memory: Memory) -> Verdict
    ? "What was read, then the targets checked; a target Pestka skips, unsafe or partial, declines the check."
    ! [Console.print]
    Console.print("subset: {List.len(p.targets)} declarations asked for; the first {List.len(p.decls)} declarations of the file read")
    match Check.Decl.skippedAmong(p.decls, p.targets, 0, [])
        [n, .._] -> Verdict(code = declined("{Core.Names.render(n)} is unsafe or partial, which Pestka does not check"), held = Option.None)
        [] -> partChecked(Check.Decl.checkPart(p.decls, p.targets, workers, memory), names, List.len(p.targets))

fn partChecked(c: Check.Decl.Part, names: List<String>, n: Int) -> Verdict
    ? "The subset verdict, with what checking found held to the end (FactsHeldToExit)."
    ! [Console.print]
    Verdict(code = partVerdict(c.checking.run, String.join(names, ","), n, c.unchecked), held = Option.Some(c.checking))

fn partVerdict(r: Result<Run, Fail>, what: String, n: Int, unchecked: Int) -> Int
    ? "checked, never accepted: the rest of the file is not checked, and the declarations before the targets were admitted as stated (SubsetAdmitsUnchecked)."
    ! [Console.print]
    match r
        Result.Err(Fail.Reject(m)) -> rejected(m)
        Result.Err(Fail.Decline(m)) -> declined(m)
        Result.Ok(run) -> match run.trusted == 0
            false -> declined("{run.trusted} nested inductive blocks are not checked yet")
            true -> printed("checked: {what} ({targetsSaid(n)}subset; {unchecked} earlier declarations admitted unchecked)", 0)

fn targetsSaid(n: Int) -> String
    ? "How many declarations were asked for, when more than one."
    match n == 1
        true -> ""
        false -> "{n} declarations; "

verify targetsSaid
    targetsSaid(1) => ""
    targetsSaid(3) => "3 declarations; "

fn packed(r: Result<String, String>) -> Int
    ? "pestka pack writes the export in Susz 1 (docs/susz.md), with INDEX unless --no-index: 0 when written, 1 when the export is not valid, 2 when it cannot be packed."
    ! [Console.print]
    match r
        Result.Ok(m) -> printed(m, 0)
        Result.Err(e) -> printed("cannot pack: {e}", packFailure(e))

fn packFailure(e: String) -> Int
    ? "1 when the export is not a valid one, 2 when it cannot be packed: past a limit of the format or of Pestka, or of a format version Pestka does not read (Susz 1 spec, section 9.2)."
    match Bool.or(String.contains(e, "limit: "), String.contains(e, "is not supported"))
        true -> 2
        false -> 1

verify packFailure
    packFailure("line 4: limit: x") => 2
    packFailure("line 3: unknown name index 4") => 1

fn printed(m: String, code: Int) -> Int
    ? "Prints m and gives code."
    ! [Console.print]
    Console.print(m)
    code

fn memoryIn(args: List<String>) -> Memory
    ? "The low-memory mode when --low-memory is among the arguments (LowMemoryMode)."
    match List.contains(args, "--low-memory")
        true -> Memory.Low
        false -> match List.contains(args, "--no-carry")
            true -> Memory.Bare
            false -> Memory.Fast

verify memoryIn
    memoryIn(["--low-memory", "f"]) => Memory.Low
    memoryIn(["f", "2"]) => Memory.Fast

fn withoutFlag(args: List<String>, acc: List<String>) -> List<String>
    ? "The arguments without the flags --low-memory, --no-carry, --reorder-always and --show-placed, in their order."
    match args
        [] -> List.reverse(acc)
        [a, ..rest] -> match Bool.or(Bool.or(a == "--low-memory", a == "--no-carry"), Bool.or(a == "--reorder-always", a == "--show-placed"))
            true -> withoutFlag(rest, acc)
            false -> withoutFlag(rest, List.prepend(a, acc))

verify withoutFlag
    withoutFlag(["f", "--low-memory", "2"], []) => ["f", "2"]
    withoutFlag(["--reorder-always", "f", "--low-memory"], []) => ["f"]
    withoutFlag([], []) => []

fn input(args: List<String>) -> Outcome
    ? "The file read on as many workers as asked for, or the usage as a decline."
    ! [Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.appendBytes]
    match args
        [path] -> fileOf(path, 4)
        [path, n] -> fileOf(path, workersOf(n))
        _ -> Outcome.Declined("usage: pestka [--low-memory] [--reorder-always] [--show-placed] FILE [WORKERS] | pestka --only NAME[,NAME...] FILE.susz [WORKERS] | pestka pack [--no-index] FILE.ndjson FILE.susz [WORKERS]")

fn fileOf(path: String, workers: Int) -> Outcome
    ? "A Susz file by its signature, otherwise lean4export's ndjson, packed into Susz 1 in memory and read as Susz (NdjsonThroughSusz)."
    ! [Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.appendBytes]
    match Export.Susz.isSusz(path)
        true -> Export.Susz.readFile(path)
        false -> packedOf(path, workers, Export.Pack.image(path, workers))

decision NdjsonThroughSusz
    date = "2026-11-11"
    reason =
        "An ndjson export is read one way: packed into Susz 1 in memory"
        "(PackedInMemory in Export.Pack) and read by the Susz reader,"
        "which leaves theorems' proofs as bytes until they are checked."
        "Packing and the Susz reader stop at the first bad record they"
        "meet, and a Susz reader names a record by its number in a block"
        "that packing laid out, not by its line. So when packing fails, or"
        "the reader rejects or declines the image, the ndjson reader reads"
        "the file as it always has, and its verdict, the first bad line"
        "named by its number, is the one given: a file that is not read is"
        "reported as the ndjson reader reports it, and only a file that is"
        "read whole goes on to be checked from the image. A line packing"
        "does not support, an unknown key among them (KeysAsKnown in"
        "Export.Pack), declines the file: the ndjson reader would drop"
        "what that key says."
    chosen = "NdjsonThroughSusz"
    rejected = ["NdjsonReaderOnly", "PackErrorsAsLines"]
    impacts = [fileOf, packedOf, readPacked]

fn packedOf(path: String, workers: Int, r: Result<Image, String>) -> Outcome
    ? "The image read; a decline when packing met something it does not support; otherwise the file read by the ndjson reader when it could not be packed (NdjsonThroughSusz)."
    ! [Disk.readBytesAt, Disk.size]
    match r
        Result.Ok(m) -> readPacked(path, workers, Export.Susz.readImage(m))
        Result.Err(e) -> match String.contains(e, "is not supported")
            true -> Outcome.Declined(e)
            false -> Export.Stream.readFile(path, workers)

fn readPacked(path: String, workers: Int, o: Outcome) -> Outcome
    ? "The image as read, or the file read by the ndjson reader when the image was not (NdjsonThroughSusz)."
    ! [Disk.readBytesAt, Disk.size]
    match o
        Outcome.Read(_) -> o
        _ -> Export.Stream.readFile(path, workers)

fn workersIn(args: List<String>) -> Int
    ? "The workers the arguments ask for; four by default."
    match args
        [_, n] -> workersOf(n)
        _ -> 4

verify workersIn
    workersIn(["f", "3"]) => 3
    workersIn(["f"]) => 4

fn workersOf(n: String) -> Int
    ? "The number of workers asked for, at least one; anything unreadable means four."
    match Int.fromString(n)
        Result.Ok(k) -> Int.max(k, 1)
        Result.Err -> 4

verify workersOf
    workersOf("3") => 3
    workersOf("0") => 1
    workersOf("x") => 4

fn report(o: Outcome, workers: Int, memory: Memory, always: Bool, show: Bool) -> Verdict
    ? "Prints the verdict; always, from --reorder-always, a tool for tests, checks out of file order on any file the reader allows it on (CheckedByNamespace)."
    ! [Console.print]
    match o
        Outcome.Rejected(why) -> Verdict(code = rejected(why), held = Option.None)
        Outcome.Declined(why) -> Verdict(code = declined(why), held = Option.None)
        Outcome.IndexInvalid(why) -> Verdict(code = declined(why), held = Option.None)
        Outcome.Read(t) -> summary(t, workers, memory, always, show)

fn summary(p: Parsed, workers: Int, memory: Memory, always: Bool, show: Bool) -> Verdict
    ? "Counts of what the file defines, then the checking verdict, with what checking found. show, from --show-placed, a tool for tests, also prints whether the reader found every declaration naming only constants placed before it (NamesPlacedWhereRead), which decides whether checking may leave file order."
    ! [Console.print]
    Console.print("constants {p.constants}, declarations {List.len(p.decls)}, names {p.names}, levels {p.levels}, expressions {p.exprs}")
    shown(show, p.allPlaced)
    c = Check.Decl.checkHeld(p.decls, workers, memory, p.allPlaced, always)
    Verdict(code = verdict(c.run), held = Option.Some(c))

fn shown(show: Bool, placed: Bool) -> Unit
    ? "Whether every declaration names only constants placed before it, when asked."
    ! [Console.print]
    match show
        true -> Console.print("placed {placed}")
        false -> Unit

fn verdict(r: Result<Run, Fail>) -> Int
    ? "Accepted only when every declaration was checked; admitted inductive blocks make it a decline."
    ! [Console.print]
    match r
        Result.Err(Fail.Reject(m)) -> rejected(m)
        Result.Err(Fail.Decline(m)) -> declined(m)
        Result.Ok(run) -> counted(run)

fn counted(run: Run) -> Int
    ? "Prints what was checked, trusted and skipped."
    ! [Console.print]
    Console.print("checked {run.checked}, admitted unchecked {run.trusted}, skipped {run.skipped}")
    match run.trusted == 0
        true -> accepted()
        false -> declined("{run.trusted} nested inductive blocks are not checked yet")

fn accepted() -> Int
    ? "Every declaration was checked: status 0."
    ! [Console.print]
    Console.print("accepted")
    0

fn rejected(why: String) -> Int
    ? "Prints the rejection: status 1."
    ! [Console.print]
    Console.print("rejected: {why}")
    1

fn declined(why: String) -> Int
    ? "Prints that the input is outside what Pestka handles: status 2."
    ! [Console.print]
    Console.print("declined: {why}")
    2
